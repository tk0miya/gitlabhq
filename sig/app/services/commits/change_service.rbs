module Commits
  class ChangeService < Commits::CreateService
    @commit: untyped

    @message: untyped

    def initialize: (*untyped args) -> void

    def commit_message: () -> untyped

    private

    attr_reader commit: untyped

    def commit_change: (untyped action) { (untyped) -> untyped } -> untyped
  end
end
