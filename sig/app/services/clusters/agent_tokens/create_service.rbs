module Clusters
  module AgentTokens
    class CreateService
      @agent: untyped

      @current_user: untyped

      @params: untyped

      ALLOWED_PARAMS: ::Array[:agent_id | :description | :name]

      ACTIVE_TOKENS_LIMIT: 2

      attr_reader agent: untyped

      attr_reader current_user: untyped

      attr_reader params: untyped

      def initialize: (agent: untyped, current_user: untyped, params: untyped) -> void

      def execute: () -> untyped

      private

      def error_no_permissions: () -> untyped

      def error_active_tokens_limit_reached: () -> untyped

      def active_tokens_limit_reached?: () -> untyped

      def filtered_params: () -> untyped

      def log_activity_event: (untyped token) -> untyped
    end
  end
end
