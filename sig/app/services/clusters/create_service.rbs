module Clusters
  class CreateService
    @current_user: untyped

    @params: untyped

    @clusterable: untyped

    attr_reader current_user: untyped

    attr_reader params: untyped

    def initialize: (?untyped? user, ?::Hash[untyped, untyped] params) -> void

    def execute: (?access_token: untyped?) -> untyped

    private

    def clusterable: () -> untyped

    def global_params: () -> { user: untyped }

    def clusterable_params: () -> untyped

    def validate_management_project_permissions: (untyped cluster) -> untyped
  end
end
