module Members
  class InviteService < Members::CreateService
    @invites: untyped

    @errors: untyped

    # can't put this in the initializer since `invites_from_params` is called in super class
    # and needs it
    @parsed_emails: untyped

    extend ::Gitlab::Utils::Override

    def initialize: (*untyped args) -> void

    private

    alias formatted_errors errors

    def parsed_emails: () -> untyped

    def formatted_param: (untyped parameter) -> untyped

    def validate_invitable!: () -> (nil | untyped)

    def invalid_emails: () -> untyped

    def blank_invites_message: () -> untyped

    def add_error_for_member: (untyped member, untyped existing_errors) -> untyped

    def invited_object: (untyped member) -> untyped
  end
end
