module Users
  class RejectService < BaseService
    @current_user: untyped

    def initialize: (untyped current_user) -> void

    def execute: (untyped user) -> untyped

    private

    attr_reader current_user: untyped

    def allowed?: () -> untyped

    def after_reject_hook: (untyped user) -> nil

    def log_event: (untyped user) -> untyped
  end
end
