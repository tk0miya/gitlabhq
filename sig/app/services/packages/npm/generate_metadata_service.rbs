module Packages
  module Npm
    class GenerateMetadataService
      @name: untyped

      @packages: untyped

      @dependencies: untyped

      @dependency_ids: untyped

      @tags: untyped

      @tags_updated_at: untyped

      @versions: untyped

      @latest_version: untyped

      include API::Helpers::RelatedResourcesHelpers

      include Gitlab::Utils::StrongMemoize

      # Allowed fields are those defined in the abbreviated form
      # defined here: https://github.com/npm/registry/blob/master/docs/responses/package-metadata.md#abbreviated-version-object
      # except: name, version, dist, dependencies and xDependencies. Those are generated by this service.
      PACKAGE_JSON_ALLOWED_FIELDS: ::Array["deprecated" | "bin" | "directories" | "dist" | "engines" | "_hasShrinkwrap" | "hasInstallScript"]

      def initialize: (untyped name, untyped packages) -> void

      def execute: (?only_dist_tags: bool) -> untyped

      private

      attr_reader name: untyped

      attr_reader packages: untyped

      attr_reader dependencies: untyped

      attr_reader dependency_ids: untyped

      attr_reader tags: untyped

      attr_reader tags_updated_at: untyped

      attr_reader versions: untyped

      attr_accessor latest_version: untyped

      def metadata: (untyped only_dist_tags) -> untyped

      def preload_needed_relations: (untyped batch, untyped only_dist_tags) -> untyped

      def load_dependencies: (untyped packages) -> untyped

      def load_dependency_ids: (untyped packages) -> untyped

      def build_tags: (untyped package) -> untyped

      def store_latest_version: (untyped version) -> (untyped | nil)

      def build_versions: (untyped package) -> (nil | untyped)

      def build_package_version: (untyped package, untyped package_file) -> untyped

      def abbreviated_package_json: (untyped package) -> untyped

      def tarball_url: (untyped package, untyped package_file) -> untyped

      def build_package_dependencies: (untyped package) -> untyped

      def inverted_dependency_types: () -> untyped
    end
  end
end
