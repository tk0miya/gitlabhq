module Packages
  module Protection
    class DeleteRuleService
      @package_protection_rule: untyped

      @current_user: untyped

      include Gitlab::Allowable

      include Gitlab::InternalEventsTracking

      def initialize: (untyped package_protection_rule, current_user: untyped) -> void

      def execute: () -> untyped

      private

      attr_reader package_protection_rule: untyped

      attr_reader current_user: untyped

      def service_response_error: (message: untyped) -> untyped
    end
  end
end
