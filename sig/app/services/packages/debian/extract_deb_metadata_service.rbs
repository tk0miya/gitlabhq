module Packages
  module Debian
    # Returns .deb file metadata
    class ExtractDebMetadataService
      @file_path: untyped

      @cmd: untyped

      @result: untyped

      CommandFailedError: untyped

      def initialize: (untyped file_path) -> void

      def execute: () -> untyped

      private

      def cmd: () -> untyped

      def result: () -> untyped

      def success?: () -> untyped
    end
  end
end
