module Ml
  INITIAL_VERSION: "1.0.0"

  ALLOWED_INCREMENT_TYPES: ::Array[:patch | :minor | :major]

  class IncrementVersionService
    @version: untyped

    @increment_type: untyped

    @parsed_version: untyped

    def initialize: (untyped version, ?untyped? increment_type) -> void

    def execute: () -> untyped
  end
end
