module Ml
  class CreateCandidateService
    @experiment: untyped

    @name: untyped

    @user: untyped

    @start_time: untyped

    @model_version: untyped

    def initialize: (untyped experiment, ?::Hash[untyped, untyped] params) -> void

    def execute: () -> untyped

    private

    def candidate_name: () -> untyped

    def random_candidate_name: () -> untyped

    attr_reader name: untyped

    attr_reader user: untyped

    attr_reader experiment: untyped

    attr_reader start_time: untyped

    attr_reader model_version: untyped
  end
end
