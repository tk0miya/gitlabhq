module Ci
  class ExpirePipelineCacheService
    @url_helpers: untyped

    class UrlHelpers
      include ::Gitlab::Routing

      include ::GitlabRoutingHelper
    end

    def execute: (untyped pipeline, ?delete: bool) -> untyped

    private

    def project_pipelines_path: (untyped project) -> untyped

    def project_pipeline_path: (untyped project, untyped pipeline) -> untyped

    def commit_pipelines_path: (untyped project, untyped commit) -> untyped

    def new_merge_request_pipelines_path: (untyped project) -> untyped

    def pipelines_project_merge_request_path: (untyped merge_request) -> untyped

    def merge_request_widget_path: (untyped merge_request) -> untyped

    def each_pipelines_merge_request_path: (untyped pipeline) { (untyped) -> untyped } -> untyped

    def graphql_pipeline_path: (untyped pipeline) -> untyped

    def graphql_pipeline_sha_path: (untyped sha) -> untyped

    def graphql_project_on_demand_scan_counts_path: (untyped project) -> untyped

    def graphql_project_pipelines_path: (untyped project) -> untyped

    # Updates ETag caches of a pipeline.
    #
    # This logic resides in a separate method so that EE can more easily extend
    # it.
    #
    # @param [Ci::Pipeline] pipeline
    # @param [Gitlab::EtagCaching::Store] store
    def update_etag_cache: (untyped pipeline, untyped store) -> untyped

    def url_helpers: () -> untyped
  end
end
