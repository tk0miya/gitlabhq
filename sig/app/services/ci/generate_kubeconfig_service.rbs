module Ci
  class GenerateKubeconfigService
    @pipeline: untyped

    @token: untyped

    @environment: untyped

    @template: untyped

    def initialize: (untyped pipeline, token: untyped, environment: untyped) -> void

    def execute: () -> untyped

    private

    attr_reader pipeline: untyped

    attr_reader token: untyped

    attr_reader environment: untyped

    attr_reader template: untyped

    def agent_authorizations: () -> untyped

    def cluster_name: () -> "gitlab"

    def user_name: (untyped agent) -> untyped

    def context_name: (untyped agent) -> untyped

    def context_namespace: (untyped authorization) -> untyped

    def agent_token: (untyped agent) -> untyped

    def delimiter: () -> ":"
  end
end
