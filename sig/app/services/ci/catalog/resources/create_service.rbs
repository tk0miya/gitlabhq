module Ci
  module Catalog
    module Resources
      class CreateService
        @current_user: untyped

        @project: untyped

        include Gitlab::Allowable

        attr_reader project: untyped

        attr_reader current_user: untyped

        def initialize: (untyped project, untyped user) -> void

        def execute: () -> untyped
      end
    end
  end
end
