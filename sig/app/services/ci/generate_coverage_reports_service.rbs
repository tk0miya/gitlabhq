module Ci
  # TODO: a couple of points with this approach:
  # + reuses existing architecture and reactive caching
  # - it's not a report comparison and some comparing features must be turned off.
  # see CompareReportsBaseService for more notes.
  # issue: https://gitlab.com/gitlab-org/gitlab/issues/34224
  class GenerateCoverageReportsService < CompareReportsBaseService
    def execute: (untyped base_pipeline, untyped head_pipeline) -> untyped

    def latest?: (untyped base_pipeline, untyped head_pipeline, untyped data) -> untyped

    private

    def error_response: (untyped base_pipeline, untyped head_pipeline) -> { status: :error, key: untyped, status_reason: untyped }

    def track_exception: (untyped error, untyped base_pipeline, untyped head_pipeline) -> untyped

    def key: (untyped base_pipeline, untyped head_pipeline) -> ::Array[untyped]

    def last_update_timestamp: (untyped pipeline_hierarchy) -> untyped
  end
end
