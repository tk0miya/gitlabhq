module Ci
  module Pipelines
    class UpdateMetadataService
      @pipeline: untyped

      @current_user: untyped

      @params: untyped

      def initialize: (untyped pipeline, current_user: untyped, ?params: ::Hash[untyped, untyped]) -> void

      def execute: () -> untyped

      private

      attr_reader pipeline: untyped

      attr_reader current_user: untyped

      attr_reader params: untyped

      def allowed?: () -> untyped

      def forbidden: () -> untyped
    end
  end
end
