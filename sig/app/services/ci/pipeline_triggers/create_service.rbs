module Ci
  module PipelineTriggers
    class CreateService
      @project: untyped

      @current_user: untyped

      @description: untyped

      @expires_at: untyped

      include Gitlab::Allowable

      attr_reader project: untyped

      attr_reader current_user: untyped

      attr_reader description: untyped

      attr_reader expires_at: untyped

      def initialize: (project: untyped, user: untyped, description: untyped, ?expires_at: untyped?) -> void

      def execute: () -> untyped

      private

      def create_params: () -> untyped
    end
  end
end
