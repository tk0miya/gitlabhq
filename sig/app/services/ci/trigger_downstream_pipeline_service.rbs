module Ci
  # Enqueues the downstream pipeline worker.
  class TriggerDownstreamPipelineService
    @bridge: untyped

    @current_user: untyped

    @project: untyped

    @pipeline: untyped

    def initialize: (untyped bridge) -> void

    def execute: () -> untyped

    private

    attr_reader bridge: untyped

    attr_reader current_user: untyped

    attr_reader project: untyped

    attr_reader pipeline: untyped

    def rate_limit_throttled?: () -> untyped

    def create_throttled_log_entry: () -> untyped
  end
end
