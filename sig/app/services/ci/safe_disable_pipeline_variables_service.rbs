module Ci
  class SafeDisablePipelineVariablesService < BaseService
    @current_user: untyped

    @parent_group: untyped

    PROJECTS_BATCH_SIZE: 500

    def initialize: (current_user: untyped, group: untyped) -> void

    def execute: () -> untyped

    private

    attr_reader current_user: untyped

    attr_reader parent_group: untyped

    def authorized?: () -> untyped
  end
end
