module Ci
  class UpdateBuildNamesService
    @pipeline: untyped

    attr_reader pipeline: untyped

    def initialize: (untyped pipeline) -> void

    def execute: () -> untyped

    # rubocop: disable CodeReuse/ActiveRecord -- plucking attributes is more efficient than loading the records
