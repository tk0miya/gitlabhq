module Deployments
  class CreateService
    @environment: untyped

    @current_user: untyped

    @params: untyped

    attr_reader environment: untyped

    attr_reader current_user: untyped

    attr_reader params: untyped

    def initialize: (untyped environment, untyped current_user, untyped params) -> void

    def execute: () -> untyped

    def deployment_attributes: () -> { project_id: untyped, environment_id: untyped, ref: untyped, tag: untyped, sha: untyped, user: untyped, on_stop: untyped }

    private

    def last_deployment: () -> untyped
  end
end
