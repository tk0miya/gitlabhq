module Mcp
  module Tools
    module Concerns
      module ResourceFinder
        private

        def find_project: (untyped project_id) -> untyped

        def find_group: (untyped group_id) -> untyped

        def find_parent_by_id_or_path: (untyped parent_type, untyped identifier) -> untyped

        def find_work_item_in_parent: (untyped parent, untyped iid) -> untyped

        def build_work_item_finder_params: (untyped parent) -> ({ project_id: untyped } | { group_id: untyped, include_descendants: false } | ::Hash[untyped, untyped])

        def authorize_parent_access!: (untyped parent, untyped parent_type, untyped identifier) -> (nil | untyped)

        def can_read_parent?: (untyped parent, untyped parent_type) -> untyped
      end
    end
  end
end
