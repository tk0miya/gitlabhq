module Git
  class BaseHooksService < ::BaseService
    # We only need the newest commit for the event push, and we don't
    # need the full deltas either.
    @event_push_data: untyped

    @push_data: untyped

    include Gitlab::Utils::StrongMemoize

    include ChangeParams

    # The N most recent commits to process in a single push payload.
    PROCESS_COMMIT_LIMIT: 100

    def execute: () -> untyped

    private

    def hook_name: () -> untyped

    # This should return PROCESS_COMMIT_LIMIT commits, ordered with newest last
    def limited_commits: () -> untyped

    def commits_count: () -> untyped

    def event_message: () -> nil

    def invalidated_file_types: () -> ::Array[untyped]

    # Push events in the activity feed only show information for the
    # last commit.
    def create_events: () -> (nil | untyped)

    def removing_ref?: () -> untyped

    def create_pipeline: () -> (nil | untyped)

    def create_pipeline?: () -> untyped

    def execute_project_hooks: () -> (nil | untyped)

    def enqueue_invalidate_cache: () -> (nil | untyped)

    def enqueue_notify_kas: () -> (nil | untyped)

    def pipeline_params: () -> untyped

    def ci_push_options: () -> untyped

    def integration_push_options: () -> untyped

    def push_options: () -> untyped

    def push_data_params: (commits: untyped, ?with_changed_files: bool) -> { oldrev: untyped, newrev: untyped, ref: untyped, project: untyped, user: untyped, commits: untyped, message: untyped, commits_count: untyped, with_changed_files: untyped }

    def event_push_data: () -> untyped

    def push_data: () -> untyped

    # merges with EE override
    def pipeline_options: () -> { inputs: untyped }

    def log_pipeline_errors: (untyped error_message) -> untyped

    def sanitized_pipeline_params: () -> untyped

    def logger: () -> untyped
  end
end
