module Git
  class WikiPushService
    class Change
      @wiki: untyped

      @raw_change: untyped

      @change: untyped

      include Gitlab::Utils::StrongMemoize

      # @param [Wiki] wiki
      # @param [Hash] change - must have keys `:oldrev` and `:newrev`
      # @param [Gitlab::Git::RawDiffChange] raw_change
      def initialize: (untyped wiki, untyped change, untyped raw_change) -> void

      def page: () -> untyped

      # See [Gitlab::Git::RawDiffChange#extract_operation] for the
      # definition of the full range of operation values.
      def event_action: () -> untyped

      def last_known_slug: () -> untyped

      def sha: () -> untyped

      private

      attr_reader raw_change: untyped

      attr_reader change: untyped

      attr_reader wiki: untyped

      def filename: () -> untyped

      def slug: () -> untyped

      def revision: () -> untyped

      def deleted?: () -> untyped

      def strip_extension: (untyped filename) -> (nil | untyped)
    end
  end
end
