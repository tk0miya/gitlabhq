module CloudSeed
  module GoogleCloud
    #
    # GCP keys used to store Google Cloud Service Accounts
    GCP_KEYS: ::Array["GCP_PROJECT_ID" | "GCP_SERVICE_ACCOUNT" | "GCP_SERVICE_ACCOUNT_KEY"]

    class ServiceAccountsService < ::CloudSeed::GoogleCloud::BaseService
      def find_for_project: () -> untyped

      def add_for_project: (untyped ref, untyped gcp_project_id, untyped service_account, untyped service_account_key, untyped is_protected) -> untyped
    end
  end
end
