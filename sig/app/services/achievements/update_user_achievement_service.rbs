# rubocop:disable Gitlab/BoundedContexts -- the Achievements module already exists and holds the other services as well
module Achievements
  class UpdateUserAchievementService
    @current_user: untyped

    @user_achievement: untyped

    @params: untyped

    attr_reader current_user: untyped

    attr_reader user_achievement: untyped

    attr_reader params: untyped

    def initialize: (untyped current_user, untyped user_achievement, untyped params) -> void

    def execute: () -> untyped

    private

    def allowed?: () -> untyped

    def error_no_permissions: () -> untyped

    def error: (untyped message) -> untyped

    def error_updating: () -> untyped
  end
end
