module Achievements
  class UpdateService
    @current_user: untyped

    @achievement: untyped

    @params: untyped

    attr_reader current_user: untyped

    attr_reader achievement: untyped

    attr_reader params: untyped

    def initialize: (untyped current_user, untyped achievement, untyped params) -> void

    def execute: () -> untyped

    private

    def allowed?: () -> untyped

    def error_no_permissions: () -> untyped

    def error: (untyped message) -> untyped

    def error_updating: () -> untyped
  end
end
