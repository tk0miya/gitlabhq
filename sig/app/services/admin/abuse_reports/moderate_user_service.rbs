module Admin
  module AbuseReports
    class ModerateUserService < BaseService
      @abuse_report: untyped

      @current_user: untyped

      @params: untyped

      @action: untyped

      attr_reader abuse_report: untyped

      attr_reader params: untyped

      attr_reader current_user: untyped

      attr_reader action: untyped

      def initialize: (untyped abuse_report, untyped current_user, untyped params) -> void

      def execute: () -> untyped

      private

      def determine_action: () -> untyped

      def perform_action: () -> untyped

      def ban_user: () -> untyped

      def block_user: () -> untyped

      def delete_user: () -> untyped

      def close_report: () -> untyped

      def trust_user: () -> untyped

      def close_similar_open_reports: () -> untyped

      def close_report_and_record_event: () -> untyped

      def close_report?: () -> untyped

      def record_event: (untyped action) -> untyped
    end
  end
end
