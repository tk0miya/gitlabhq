module MergeRequests
  module Mergeability
    class RunChecksService
      @merge_request: untyped

      @params: untyped

      @use_cache: untyped

      @results: untyped

      include Gitlab::Utils::StrongMemoize

      def initialize: (merge_request: untyped, params: untyped) -> void

      def execute: (untyped checks, ?execute_all: bool, ?use_cache: bool) -> untyped

      private

      attr_reader merge_request: untyped

      attr_reader params: untyped

      attr_reader results: untyped

      attr_reader use_cache: untyped

      def run_check: (untyped check) -> untyped

      def cached_results: () -> untyped

      def logger: () -> untyped

      # This name may seem like a double-negative, but it is meaningful because
      # #success? is _not_ the inverse of #unsuccessful?
      def no_result_unsuccessful?: () -> untyped

      def unsuccessful_check: () -> untyped
    end
  end
end
