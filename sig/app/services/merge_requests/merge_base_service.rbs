module MergeRequests
  class MergeBaseService < MergeRequests::BaseService
    include Gitlab::Utils::StrongMemoize

    MergeError: untyped

    attr_reader merge_request: untyped

    # Overridden in EE.
    def hooks_validation_pass?: (untyped merge_request, ?validate_squash_message: bool) -> true

    # Overridden in EE.
    def hooks_validation_error: (untyped merge_request, ?validate_squash_message: bool) -> nil

    private

    # Overridden in EE.
    def check_size_limit: () -> nil

    # Overridden in EE.
    def error_check!: () -> nil

    def raise_error: (untyped message) -> untyped

    def handle_merge_error: (*untyped args) -> nil
  end
end
