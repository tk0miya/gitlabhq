module Issuable
  module Callbacks
    class Base
      @issuable: untyped

      @current_user: untyped

      @params: untyped

      Error: untyped

      include Gitlab::Allowable

      def self.execute_without_params?: () -> false

      def initialize: (issuable: untyped, current_user: untyped, ?params: ::Hash[untyped, untyped]) -> void

      def after_initialize: () -> nil

      def before_create: () -> nil

      def before_update: () -> nil

      def after_create: () -> nil

      def after_update: () -> nil

      def after_save: () -> nil

      def after_update_commit: () -> nil

      def after_save_commit: () -> nil

      private

      attr_reader issuable: untyped

      attr_reader current_user: untyped

      attr_reader params: untyped

      def excluded_in_new_type?: () -> untyped

      def has_permission?: (untyped permission) -> untyped

      def raise_error: (untyped message) -> untyped
    end
  end
end
