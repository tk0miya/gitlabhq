module Issuable
  class DestroyService < IssuableBaseService
    # load sync object before destroy otherwise we cannot access it for
    # deletion of label links in delete_label_links
    @synced_object_to_delete: untyped

    # Capture assignees before destroy: the issue_assignees table has an
    # ON DELETE CASCADE FK, so after issuable.destroy the DB rows are gone
    # and issuable.assignees returns empty, preventing cache invalidation.
    @assignees_before_destroy: untyped

    BATCH_SIZE: 100

    # TODO: this is to be removed once we get to rename the IssuableBaseService project param to container
    def initialize: (container: untyped, ?current_user: untyped?, ?params: ::Hash[untyped, untyped]) -> void

    def execute: (untyped issuable) -> untyped

    private

    def before_destroy: (untyped issuable) -> nil

    def destroy_ci_records: (untyped issuable) -> (nil | untyped)

    def after_destroy: (untyped issuable) -> untyped

    def delete_associated_records: (untyped issuable) -> untyped

    def delete_todos: (untyped issuable) -> untyped

    def delete_label_links: (untyped issuable) -> untyped
  end
end
