module WebHooks
  module Events
    class ResendService
      @web_hook_log: untyped

      @current_user: untyped

      def initialize: (untyped web_hook_log, current_user: untyped) -> void

      def execute: () -> untyped

      private

      def authorized?: () -> untyped

      def unauthorized_response: () -> untyped

      def url_changed_response: () -> untyped

      attr_reader web_hook_log: untyped

      attr_reader current_user: untyped
    end
  end
end
