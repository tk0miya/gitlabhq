module Integrations
  module SlackInteractions
    module IncidentManagement
      class IncidentModalSubmitService
        @params: untyped

        @values: untyped

        @team_id: untyped

        @user_id: untyped

        @additional_message: untyped

        include GitlabRoutingHelper

        include Gitlab::Routing

        IssueCreateError: untyped

        def initialize: (untyped params) -> void

        def execute: () -> untyped

        private

        attr_accessor params: untyped

        attr_accessor values: untyped

        attr_accessor team_id: untyped

        attr_accessor user_id: untyped

        attr_accessor additional_message: untyped

        def incident_params: () -> { title: untyped, severity: untyped, confidential: untyped, description: untyped, escalation_status: { status: untyped }, work_item_type: untyped, assignee_ids: ::Array[untyped], label_ids: untyped }

        def incident_work_item_type: () -> untyped

        def strip_markup: (untyped string) -> untyped

