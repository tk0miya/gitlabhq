module ImportCsv
  class PreprocessMilestonesService < BaseService
    @user: untyped

    @project: untyped

    @provided_titles: untyped

    @results: untyped

    @milestone_errors: untyped

    def initialize: (untyped user, untyped project, untyped provided_titles) -> void

    attr_reader user: untyped

    attr_reader project: untyped

    attr_reader provided_titles: untyped

    attr_reader results: untyped

    attr_reader milestone_errors: untyped

    def execute: () -> untyped

    def find_milestones_by_titles: () -> untyped
  end
end
