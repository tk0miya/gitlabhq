module Ide
  class BaseConfigService < ::BaseService
    @config_content: untyped

    @config: untyped

    ValidationError: untyped

    WEBIDE_CONFIG_FILE: ".gitlab/.gitlab-webide.yml"

    attr_reader config: untyped

    attr_reader config_content: untyped

    def execute: () -> untyped

    def check_access_and_load_config!: () -> untyped

    private

    def check_access!: () -> (untyped | nil)

    def load_config_content!: () -> untyped

    def load_config!: () -> untyped

    def webide_yaml_from_repo: () -> untyped

    def gitlab_webide_yml_for: (untyped sha) -> untyped
  end
end
