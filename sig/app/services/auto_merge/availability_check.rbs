module AutoMerge
  class AvailabilityCheck
    ABORT_REASONS: { forbidden: "they do not have permission to merge the merge request.", mergeability_checks_failed: untyped, merge_trains_disabled: "merge trains are disabled for this project.", missing_diff_head_pipeline: "the pipeline associated with this merge request is missing or out of sync.", incomplete_diff_head_pipeline: "the merge request currently has a pipeline in progress.", default: "this merge request cannot be added to the merge train." }

    VALID_STATUSES: ::Array[:available | :unavailable]

    def self.success: () -> untyped

    def self.error: (?unavailable_reason: ::Symbol, ?unsuccessful_check: untyped?) -> untyped

    attr_reader status: untyped

    attr_reader unavailable_reason: untyped

    attr_reader unsuccessful_check: untyped

    def initialize: (status: untyped, ?unavailable_reason: untyped?, ?unsuccessful_check: untyped?) -> void

    def available?: () -> untyped

    def abort_message: () -> untyped

    private

    attr_writer status: untyped

    attr_writer unavailable_reason: untyped

    attr_writer unsuccessful_check: untyped
  end
end
