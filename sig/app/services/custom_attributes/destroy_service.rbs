# rubocop: disable Gitlab/BoundedContexts -- Custom attributes are a cross-cutting concern for Users, Projects, and Groups
module CustomAttributes
  class DestroyService
    @resource: untyped

    @current_user: untyped

    @key: untyped

    @params: untyped

    ALLOWED_RESOURCES: ::Array[untyped]

    def initialize: (untyped resource, current_user: untyped, key: untyped, ?params: ::Hash[untyped, untyped]) -> void

    def execute: () -> untyped

    private

    attr_reader resource: untyped

    attr_reader current_user: untyped

    attr_reader key: untyped

    attr_reader params: untyped

    def authorized?: () -> untyped

    def validate_resource_type!: () -> (nil | untyped)
  end
end
