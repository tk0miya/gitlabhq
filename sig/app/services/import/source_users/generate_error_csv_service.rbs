module Import
  module SourceUsers
    class GenerateErrorCsvService
      @data: untyped

      # This is just to prevent any potential abuse.
      FILESIZE_LIMIT: untyped

      COLUMN_MAPPING: { "Source host" => :source_host, "Import type" => :import_type, "Source user identifier" => :source_user_identifier, "Source user name" => :source_user_name, "Source username" => :source_username, "GitLab username" => :gitlab_username, "GitLab public email" => :gitlab_public_email, "Error" => :error }

      # @param data [Array<Hash>] An array of hashes to be converted into CSV
      #   rows. Hash keys must match the values of COLUMN_MAPPING.
      def initialize: (untyped data) -> void

      def execute: () -> untyped

      private

      attr_reader data: untyped

      def csv_data: () -> untyped
    end
  end
end
