module JiraConnectInstallations
  class ProxyLifecycleEventService
    # To ensure the event is sent to the right instance, this makes
    # a copy of the installation and assigns the instance_url
    #
    # The installation might be modified already with a new instance_url.
    # This can be the case for an uninstalled event.
    # The installation is updated first, and the uninstalled event has to be sent to
    # the old instance_url.
    @installation: untyped

    @installation_id: untyped

    @event: untyped

    @jwt_token: untyped

    SUPPOERTED_EVENTS: ::Array[:installed | :uninstalled]

    def self.execute: (untyped installation, untyped event, untyped instance_url) -> untyped

    def initialize: (untyped installation, untyped event, untyped instance_url) -> void

    def execute: () -> untyped

    private

    attr_reader installation: untyped

    attr_reader event: untyped

    def send_hook: () -> untyped

    def hook_uri: () -> untyped

    def body: () -> untyped

    def base_body: () -> { clientKey: untyped, jwt: untyped, eventType: untyped }

    def installed_body: () -> { sharedSecret: untyped, baseUrl: untyped }

    def jwt_token: () -> untyped

    def log_unsuccessful_response: (untyped status_code, untyped body) -> untyped
  end
end
