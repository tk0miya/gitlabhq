module Projects
  class DetectRepositoryLanguagesService < BaseService
    attr_reader programming_languages: untyped

    # rubocop: disable CodeReuse/ActiveRecord
    def execute: () -> untyped

    private

    # rubocop: disable CodeReuse/ActiveRecord
    def ensure_programming_languages: (untyped detection) -> untyped

    # rubocop: disable CodeReuse/ActiveRecord
    def create_language: (untyped name, untyped color, ?untyped? language_id) -> untyped

    def set_detected_repository_languages: () -> (nil | untyped)
  end
end
