module Projects
  module GroupLinks
    class CreateService < BaseService
      @shared_with_group: untyped

      @link: untyped

      include GroupLinkable

      def initialize: (untyped project, untyped shared_with_group, untyped user, untyped params) -> void

      private

      def valid_to_create?: () -> untyped

      def build_link: () -> untyped

      def setup_authorizations: () -> untyped

      def remove_unallowed_params: () -> nil
    end
  end
end
