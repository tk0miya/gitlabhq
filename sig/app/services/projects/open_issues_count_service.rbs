module Projects
  # Service class for counting and caching the number of open issues of a
  # project.
  class OpenIssuesCountService < Projects::CountService
    @user: untyped

    # Cache keys used to store issues count
    PUBLIC_COUNT_KEY: "public_open_issues_count"

    TOTAL_COUNT_KEY: "total_open_issues_count"

    def initialize: (untyped project, ?untyped? user) -> void

    def cache_key_name: () -> untyped

    def public_only?: () -> untyped

    def relation_for_count: () -> untyped

    def public_count_cache_key: () -> untyped

    def total_count_cache_key: () -> untyped

    # rubocop: disable CodeReuse/ActiveRecord
    def refresh_cache: () { (?) -> untyped } -> untyped

    def delete_cache: () -> untyped

    def self.query: (untyped projects, ?public_only: bool) -> untyped
  end
end
