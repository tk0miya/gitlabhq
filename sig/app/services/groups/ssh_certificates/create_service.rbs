module Groups
  module SshCertificates
    class CreateService
      @group: untyped

      @params: untyped

      @current_user: untyped

      def initialize: (untyped group, untyped params, untyped current_user) -> void

      def execute: () -> untyped

      private

      attr_reader group: untyped

      attr_reader params: untyped

      attr_reader current_user: untyped

      def generate_fingerprint: (untyped key) -> untyped
    end
  end
end
