module Groups
  # Service class for counting and caching the number of open issues of a group.
  class OpenIssuesCountService < Groups::CountService
    @fast_timeout: untyped

    extend ::Gitlab::Utils::Override

    PUBLIC_COUNT_KEY: "group_public_open_issues_count"

    TOTAL_COUNT_KEY: "group_total_open_issues_count"

    def initialize: (*untyped args, ?fast_timeout: bool) -> void

    def clear_all_cache_keys: () -> untyped

    private

    def uncached_count: () -> untyped

    def cache_key_name: () -> untyped

    def public_only?: () -> untyped

    def relation_for_count: () -> untyped

    def issuable_key: () -> "open_issues"
  end
end
