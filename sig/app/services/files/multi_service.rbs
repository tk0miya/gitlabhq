module Files
  class MultiService < Files::BaseService
    UPDATE_FILE_ACTIONS: ::Array["update" | "move" | "delete" | "chmod"]

    def create_commit!: () -> untyped

    private

    def actions_after_lfs_transformation: (untyped transformer, untyped actions) -> untyped

    # When moving a file, `content: nil` means "use the contents of the previous
    # file", while `content: ''` means "move the file and set it to empty"
    def transform_move_actions: (untyped actions) -> untyped

    def commit_actions!: (untyped actions) -> untyped

    def validate!: () -> untyped

    def validate_file_status!: (untyped action) -> (nil | untyped)
  end
end
