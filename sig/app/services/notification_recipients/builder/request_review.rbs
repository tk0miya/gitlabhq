module NotificationRecipients
  module Builder
    class RequestReview < Base
      @merge_request: untyped

      @current_user: untyped

      @reviewer: untyped

      attr_reader merge_request: untyped

      attr_reader current_user: untyped

      attr_reader reviewer: untyped

      def initialize: (untyped merge_request, untyped current_user, untyped reviewer) -> void

      def target: () -> untyped

      def build!: () -> untyped
    end
  end
end
