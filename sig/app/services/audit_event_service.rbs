class AuditEventService
  @author: untyped

  @entity: untyped

  @details: untyped

  @ip_address: untyped

  @save_type: untyped

  @created_at: untyped

  @file_logger: untyped

  @authentication_event: untyped

  include AuditEventSaveType

  include ::Gitlab::Audit::Logging

  include ::Gitlab::Audit::ScopeValidation

  # Instantiates a new service
  #
  # @deprecated This service is deprecated. Use Gitlab::Audit::Auditor instead.
  # More information: https://docs.gitlab.com/ee/development/audit_event_guide/#how-to-instrument-new-audit-events
  #
  # @param [User, token String] author the entity who authors the change
  # @param [User, Project, Group] entity the scope which audit event belongs to
  #   This param is also used to determine the visibility of the audit event.
  #   - Project: events are visible at Project and Instance level
  #   - Group: events are visible at Group and Instance level
  #   - User: events are visible at Instance level
  # @param [Hash] details extra data of audit event
  # @param [Symbol] save_type the type to save the event
  #   Can be selected from the following, :database, :stream, :database_and_stream .
  # @params [DateTime] created_at the time the action occured
  #
  # @return [AuditEventService]
  def initialize: (untyped author, untyped entity, ?::Hash[untyped, untyped] details, ?::Symbol save_type, ?untyped created_at) -> void

  # Builds the @details attribute for authentication
  #
  # This uses the @author as the target object being audited
  #
  # @return [AuditEventService]
  def for_authentication: () -> self

  # Writes event to a file and creates an event record in DB
  #
  # @return [AuditEvent] persisted if saves and non-persisted if fails
  def security_event: () -> untyped

  # Writes event to a file
  def log_security_event_to_file: () -> untyped

  private

  attr_reader ip_address: untyped

  def build_author: (untyped author) -> untyped

  def resolve_ip_address: (untyped author) -> untyped

  def base_payload: () -> { author_id: untyped, author_name: untyped, entity_id: untyped, entity_type: untyped, created_at: untyped }

  def authentication_event_payload: () -> { user: untyped, user_name: untyped, ip_address: untyped, result: untyped, provider: untyped, organization: untyped }

  def author_if_user: () -> (untyped | nil)

  def file_logger: () -> untyped

  def formatted_details: () -> untyped

  def mark_as_authentication_event!: () -> untyped

  def authentication_event?: () -> untyped

  def log_security_event_to_database: () -> (nil | untyped)

  def build_event: () -> untyped

  def stream_event_to_external_destinations: (untyped _event) -> nil

  def log_authentication_event_to_database: () -> (nil | untyped)

  def save_or_track: (untyped event) -> untyped

  def log_initialization: () -> untyped
end
