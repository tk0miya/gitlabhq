module Environments
  class RecalculateAutoStopService
    @deployable: untyped

    @environment: untyped

    attr_reader deployable: untyped

    attr_reader environment: untyped

    def initialize: (untyped deployable) -> void

    def execute: () -> (nil | untyped)

    private

    # Jobs that start an environment (using `action: start`) can also
    # specify a stop time, however this is handled by the deployment
    # process. Actions other than `start` do not create deployments,
    # so these must be processed separately.
    def can_set_auto_stop?: () -> untyped

    def can_reset_timer?: () -> untyped

    def last_successful_deployable: () -> untyped
  end
end
