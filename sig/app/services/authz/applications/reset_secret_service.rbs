module Authz
  module Applications
    class ResetSecretService
      @application: untyped

      @current_user: untyped

      attr_reader application: untyped

      attr_reader current_user: untyped

      def initialize: (application: untyped, current_user: untyped) -> void

      def execute: () -> untyped

      private

      def error: (message: untyped) -> untyped

      def can_reset_secret?: (untyped current_user) -> untyped
    end
  end
end
