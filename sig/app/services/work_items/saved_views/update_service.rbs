module WorkItems
  module SavedViews
    class UpdateService < BaseService
      @current_user: untyped

      @saved_view: untyped

      @params: untyped

      @container: untyped

      attr_reader current_user: untyped

      attr_reader saved_view: untyped

      attr_reader params: untyped

      attr_reader container: untyped

      def initialize: (current_user: untyped, saved_view: untyped, params: untyped) -> void

      def execute: () -> untyped

      private

      def updating_visibility?: () -> untyped

      def can_update_visibility?: () -> untyped

      def normalize_filters!: () -> untyped

      def changing_to_private?: () -> untyped

      def track_saved_view_update: () -> untyped
    end
  end
end
