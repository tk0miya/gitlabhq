module WorkItems
  module SavedViews
    class FilterBaseService < BaseService
      attr_reader filters: untyped

      attr_reader container: untyped

      attr_reader current_user: untyped

      # Filters with values which don't need to be validated on load or save. The values are validated on the GQL layer
      # Overridden in EE
      def self.static_filters: () -> ::Array[:state | :confidential | :subscribed | :issue_types | :in | :search | :my_reaction_emoji | :closed_before | :closed_after | :assignee_wildcard_id | :milestone_wildcard_id | :release_tag_wildcard_id | :iid | :due_before | :due_after | :created_before | :created_after | :updated_before | :updated_after | :exclude_projects | :exclude_group_work_items | :include_descendants | :include_descendant_work_items | :label_wildcard_id]

      def self.static_negated_filters: () -> ::Array[:milestone_wildcard_id | :my_reaction_emoji | :issue_types]
    end
  end
end
