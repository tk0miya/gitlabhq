module WorkItems
  module DataSync
    class MoveService < ::WorkItems::DataSync::BaseService
      def self.transaction_callback: (untyped new_work_item, untyped original_work_item, untyped current_user) -> untyped

      private

      def self.move_system_notes: (untyped current_user, untyped new_work_item, untyped original_work_item) -> untyped

      def self.close_original_work_item: (untyped current_user, untyped new_work_item, untyped original_work_item) -> untyped

      def self.track_work_item_move: (untyped work_item, untyped current_user) -> untyped

      def verify_work_item_action_permission: () -> untyped

      def data_sync_action: () -> untyped

      def verify_can_move_work_item: (untyped work_item, untyped target_namespace) -> untyped

      def same_namespace?: (untyped target_namespace, untyped work_item) -> untyped

      def move_work_item: () -> untyped

      def move_any_work_item_type: () -> untyped
    end
  end
end
