      def track_tag_rule_creation: (untyped protection_rule) -> untyped

      def track_tag_rule_deletion: (untyped protection_rule) -> untyped

      def track_tag_rule_update: (untyped protection_rule) -> untyped

      def track_repository_rule_creation: (untyped protection_rule) -> untyped

      def track_repository_rule_deletion: (untyped protection_rule) -> untyped

