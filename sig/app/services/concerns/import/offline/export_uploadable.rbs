module Import
  module Offline
    module ExportUploadable
      COMPRESSED_FILE_EXTENSION: ".gz"

      # For Offline Transfer, we skip the creation of `ExportUpload` records and
      # send the created file directly to the object storage associated with the
      # export.
      def upload_directly_to_object_storage: () -> untyped

      private

      def offline_storage_client: (untyped configuration) -> untyped

      def offline_storage_filename: (untyped config) -> untyped

      def extension: () -> ::String

      def validate_upload_url!: (untyped url) -> untyped
    end
  end
end
