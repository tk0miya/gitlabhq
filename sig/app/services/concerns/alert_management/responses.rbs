module AlertManagement
  # Module to hold common response logic for AlertManagement services.
  module Responses
    def success: (untyped alerts) -> untyped

    def created: () -> untyped

    def bad_request: () -> untyped

    def unauthorized: () -> untyped

    def unprocessable_entity: () -> untyped

    def forbidden: () -> untyped
  end
end
