module Ci
  module JobTokenScope
    module EditScopeValidations
      ValidationError: untyped

      NotFoundError: untyped

      TARGET_PROJECT_UNAUTHORIZED_OR_UNFOUND: "The target_project that you are attempting to access does not exist or you don't have permission to perform this action"

      TARGET_GROUP_UNAUTHORIZED_OR_UNFOUND: "The target_group that you are attempting to access does not exist or you don't have permission to perform this action"

      TARGET_DOES_NOT_EXIST: "The group or project does not exist."

      def validate_source_project_and_target_project_access!: (untyped source_project, untyped target_project, untyped current_user) -> untyped

      def validate_source_project_and_target_group_access!: (untyped source_project, untyped target_group, untyped current_user) -> untyped

      def validate_group_remove!: (untyped source_project, untyped current_user) -> (untyped | nil)

      def validate_target_exists!: (untyped target) -> (untyped | nil)
    end
  end
end
