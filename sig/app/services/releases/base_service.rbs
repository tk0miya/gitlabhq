module Releases
  class BaseService
    @project: untyped

    @current_user: untyped

    @params: untyped

    include BaseServiceUtility

    include Gitlab::Utils::StrongMemoize

    ReleaseProtectedTagAccessError: untyped

    attr_accessor project: untyped

    attr_accessor current_user: untyped

    attr_accessor params: untyped

    def initialize: (untyped project, ?untyped? user, ?::Hash[untyped, untyped] params) -> void

    def tag_name: () -> untyped

    def tag_message: () -> untyped

    def ref: () -> untyped

    def name: () -> untyped

    def description: () -> untyped

    def released_at: () -> untyped

    def release: () -> untyped

    def repository: () -> untyped

    def existing_tag: () -> untyped

    def milestones: () -> (::Array[untyped] | untyped)

    def inexistent_milestone_titles: () -> (::Array[untyped] | untyped)

    def inexistent_milestone_ids: () -> (::Array[untyped] | untyped)

    def param_for_milestone_titles_provided?: () -> untyped

    def param_for_milestone_ids_provided?: () -> untyped

    def param_for_milestones_provided?: () -> untyped

    def param_for_milestones_exists?: () -> untyped

    def execute_hooks: (untyped release, ?::String action) -> untyped

    # overridden in EE
    def project_group_id: () -> nil

    def audit: (untyped release, action: untyped) -> nil
  end
end
