module Labels
  class CreateService < Labels::BaseService
    @current_user: untyped

    @params: untyped

    include Gitlab::InternalEvents::ServiceTracking

    attr_reader current_user: untyped

    def initialize: (?untyped? current_user, ?::Hash[untyped, untyped] params) -> void

    # returns the created label
    def execute: (untyped target_params) -> untyped
  end
end
