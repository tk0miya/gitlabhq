# frozen_string_literal: true
module Labels
  class AvailableLabelsService
    @current_user: untyped

    @parent: untyped

    @params: untyped

    @available_labels: untyped

    attr_reader current_user: untyped

    attr_reader parent: untyped

    attr_reader params: untyped

    def initialize: (untyped current_user, untyped parent, untyped params) -> void

    def find_or_create_by_titles: (?::Symbol key, ?find_only: bool) -> (::Array[untyped] | untyped)

    def filter_labels_ids_in_param: (untyped key) -> (::Array[untyped] | untyped)

    def filter_locked_label_ids: (untyped ids) -> untyped

    def available_labels: () -> untyped

    private

    def finder_params: (?untyped? titles) -> untyped
  end
end
