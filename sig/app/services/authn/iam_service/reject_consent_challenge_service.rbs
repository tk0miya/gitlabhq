module Authn
  module IamService
    class RejectConsentChallengeService
      # rubocop:enable Metrics/ParameterLists
      @challenge: untyped

      @user: untyped

      @client_id: untyped

      @client_name: untyped

      @requested_scopes: untyped

      @client_scopes: untyped

      @ip_address: untyped

      @user_agent: untyped

      @client: untyped

      REJECT_PATH: "/oauth2/internal/auth/requests/consent/reject"

      # rubocop:disable Metrics/ParameterLists -- all arguments needed
      def initialize: (challenge: untyped, user: untyped, client_id: untyped, client_name: untyped, requested_scopes: untyped, client_scopes: untyped, ?ip_address: untyped?, ?user_agent: untyped?, ?client: untyped) -> void

      def execute: () -> untyped

      private

      def request_body: () -> { error: "access_denied", error_description: "The user denied the request" }

      def emit_audit_event: () -> untyped

      def http_error: (untyped response) -> untyped

      def missing_redirect_error: () -> untyped

      def invalid_redirect_error: () -> untyped

      def invalid_body_error: () -> untyped

      def log_failure: (reason: untyped, ?http_status: untyped?) -> untyped
    end
  end
end
