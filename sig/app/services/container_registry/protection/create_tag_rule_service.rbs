module ContainerRegistry
  module Protection
    class CreateTagRuleService < BaseProjectService
      include ContainerRegistry::Protection::InternalEventsTracking

      ALLOWED_ATTRIBUTES: ::Array[:tag_name_pattern | :minimum_access_level_for_push | :minimum_access_level_for_delete]

      def execute: () -> untyped

      private

      def service_response_error: (message: untyped) -> untyped

      def tag_rule_count_less_than_maximum?: () -> untyped

      # Overridden in EE
      def validate: (untyped _protection_rule) -> nil
    end
  end
end
