module Gitlab
  module BitbucketImport
    module StageMethods
      extend ActiveSupport::Concern

      # project_id - The ID of the GitLab project to import the data into.
      def perform: (untyped project_id) -> untyped

      def find_project: (untyped id) -> untyped

      GONE_MESSAGE: "The requested resource is no longer available. The repository may have been deleted or the issue tracker may have been disabled on the source."

      def abort_on_failure: () -> false

      private

      def fail_import_for_non_retryable_error: (untyped project_id, untyped exception) -> untyped

      def bitbucket_error_message: (untyped exception, ?untyped http_status) -> untyped

      def info: (untyped project_id, ?::Hash[untyped, untyped] extra) -> untyped

      def log_attributes: (untyped project_id, ?::Hash[untyped, untyped] extra) -> untyped
    end
  end
end
