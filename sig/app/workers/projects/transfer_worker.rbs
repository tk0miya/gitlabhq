# rubocop:disable Scalability/IdempotentWorker -- transfer service itself is not idempotent
module Projects
  class TransferWorker
    include ApplicationWorker

    include Namespaces::TransferWorkerHelper

    LEASE_TIMEOUT: untyped

    def self.lease_key: (untyped project_id) -> ::String

    def perform: (untyped project_id, untyped new_namespace_id, untyped user_id) -> (nil | untyped)

    private

    def execute_transfer: (untyped project, untyped new_namespace, untyped user, untyped exclusive_lease) -> untyped

    def handle_lease_conflict: (untyped project, untyped lease_key, untyped exclusive_lease) -> (nil | untyped)

    def cancel_transfer_if_in_progress: (untyped project_namespace) -> (untyped | nil)
  end
end
