class RunPipelineScheduleWorker
  @failed_creation_counter: untyped

  include ApplicationWorker

  include PipelineQueue

  def perform: (untyped schedule_id, untyped user_id, ?::Hash[untyped, untyped] options) -> (nil | untyped)

  def schedule_valid?: (untyped schedule, untyped schedule_id, untyped user, untyped options) -> (false | true)

  def run_pipeline_schedule: (untyped schedule, untyped user) -> untyped

  private

  def update_next_run_at_for: (untyped schedule) -> untyped

  def schedule_owner_not_available?: (untyped schedule) -> untyped

  def notify_project_owner_and_deactivate_schedule: (untyped schedule) -> untyped

  def error: (untyped schedule, untyped error) -> untyped

  def log_error: (untyped schedule_id, untyped message) -> untyped

  def track_error: (untyped schedule, untyped error) -> untyped

  def failed_creation_counter: () -> untyped
end
