module Gitlab
  module GithubImport
    module Stage
      class ImportRepositoryWorker
        include ApplicationWorker

        include StageMethods

        # client - An instance of Gitlab::GithubImport::Client.
        # project - An instance of Project.
        def import: (untyped client, untyped project) -> untyped

        def counter: () -> untyped

        private

        def preallocate_iids!: (untyped project, untyped client) -> (nil | untyped)

        def collect_issue_iids: (untyped project, untyped client, untyped max_iids) -> (nil | untyped)

        def collect_merge_request_iids: (untyped project, untyped client, untyped max_iids) -> (nil | untyped)

        def collect_milestone_iids: (untyped project, untyped client, untyped max_iids) -> (nil | untyped)

        def iid_allocated?: (untyped project, untyped usage) -> untyped

        def fetch_max_issue_number: (untyped project, untyped client) -> untyped

        def fetch_max_pull_request_number: (untyped project, untyped client) -> untyped

        # The GitHub Milestones API does not support sorting by number,
        # so we fetch all milestones and compute the max client-side.
        def fetch_max_milestone_number: (untyped project, untyped client) -> untyped
      end
    end
  end
end
