module Gitlab
  module Import
    module StuckImportJob
      extend ActiveSupport::Concern

      StuckImportJobError: untyped

      IMPORT_JOBS_EXPIRATION: untyped

      def perform: () -> untyped

      private

      def track_metrics: (untyped with_jid_count, untyped without_jid_count) -> untyped

      def mark_imports_without_jid_as_failed!: () -> untyped

      def mark_imports_with_jid_as_failed!: () -> (0 | untyped)

      def mark_as_failed: (untyped import_state) -> untyped

      def enqueued_import_states: () -> untyped

      def enqueued_import_states_with_jid: () -> untyped

      def enqueued_import_states_without_jid: () -> untyped

      def error_message: () -> untyped
    end
  end
end
