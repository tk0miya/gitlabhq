module Analytics
  module CycleAnalytics
    class StageEntity < Grape::Entity
      include ActionView::Context

      include LabelsHelper

      include ActionView::Helpers::TagHelper

      def id: () -> untyped

      def start_event_html_description: () -> untyped

      def end_event_html_description: () -> untyped

      # Avoid including ActionView::Helpers::UrlHelper
      def link_to: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      private

      def html_description: (untyped event) -> untyped
    end
  end
end
