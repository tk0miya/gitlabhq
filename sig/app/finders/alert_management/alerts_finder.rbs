module AlertManagement
  class AlertsFinder
    @current_user: untyped

    @project: untyped

    @params: untyped

    # @return [Hash<Symbol,Integer>] Mapping of status id to count
    #          ex) { triggered: 6, ...etc }
    def self.counts_by_status: (untyped current_user, untyped project, ?::Hash[untyped, untyped] params) -> untyped

    def initialize: (untyped current_user, untyped project, untyped params) -> void

    def execute: () -> untyped

    private

    attr_reader current_user: untyped

    attr_reader project: untyped

    attr_reader params: untyped

    def by_domain: (untyped collection) -> untyped

    def by_iid: (untyped collection) -> untyped

    def by_status: (untyped collection) -> untyped

    def by_search: (untyped collection) -> untyped

    def sort: (untyped collection) -> untyped

    def by_assignee: (untyped collection) -> untyped

    def authorized?: () -> untyped
  end
end
