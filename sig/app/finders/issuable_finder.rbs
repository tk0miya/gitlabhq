# IssuableFinder
#
# Used to filter Issues and MergeRequests collections by set of params
#
# Note: This class is NOT meant to be instantiated. Instead you should
#       look at IssuesFinder or EpicsFinder, which inherit from this.
#
# Arguments:
#   klass - actual class like Issue or MergeRequest
#   current_user - which user use
#   params:
#     scope: 'created_by_me' or 'assigned_to_me' or 'all'
#     state: 'opened' or 'closed' or 'locked' or 'all'
#     group_id: integer
#     project_id: integer
#     milestone_title: string (cannot be simultaneously used with milestone_wildcard_id)
#     milestone_wildcard_id: 'none', 'any', 'upcoming', 'started' (cannot be simultaneously used with milestone_title)
#     release_tag: string
#     author_id: integer
#     author_username: username string or a group handle (e.g., '@group/subgroup')
#     assignee_id: integer or 'None' or 'Any'
#     closed_by_id: integer
#     assignee_username: string
#     search: string
#     in: 'title', 'description', or a string joining them with comma
#     label_name: string
#     sort: string
#     non_archived: boolean
#     iids: integer[]
#     my_reaction_emoji: string
#     created_after: datetime
#     created_before: datetime
#     updated_after: datetime
#     updated_before: datetime
#     attempt_group_search_optimizations: boolean
#     attempt_project_search_optimizations: boolean
#     crm_contact_id: integer
#     crm_organization_id: integer
#
class IssuableFinder
  self.@scalar_params: untyped

  self.@array_params: untyped

  self.@negatable_scalar_params: untyped

  self.@negatable_array_params: untyped

  self.@negatable_params: untyped

  self.@valid_params: untyped

  @current_user: untyped

  @original_params: untyped

  @params: untyped

  @parent: untyped

  prepend FinderWithCrossProjectAccess

  include FinderMethods

  include CreatedAtFilter

  include Gitlab::Utils::StrongMemoize

  include UpdatedAtFilter

  FULL_TEXT_SEARCH_TERM_PATTERN: "[\\u0000-\\u02FF\\u1E00-\\u1EFF\\u2070-\\u218F]*"

  FULL_TEXT_SEARCH_TERM_REGEX: ::Regexp

  NEGATABLE_PARAMS_HELPER_KEYS: ::Array[:project_id | :scope | :status | :include_subgroups]

  attr_accessor current_user: untyped

  attr_accessor params: untyped

  attr_reader original_params: untyped

  attr_writer parent: untyped

  def self.scalar_params: () -> untyped

  def self.array_params: () -> untyped

  # This should not be used in controller strong params!
  def self.negatable_scalar_params: () -> untyped

  # This should not be used in controller strong params!
  def self.negatable_array_params: () -> untyped

  # This should not be used in controller strong params!
  def self.negatable_params: () -> untyped

  def self.valid_params: () -> untyped

  def params_class: () -> untyped

  def klass: () -> untyped

  def initialize: (untyped current_user, ?::Hash[untyped, untyped] params) -> void

  def execute: () -> untyped

  def filter_items: (untyped items) -> untyped

  def should_filter_negated_args?: () -> untyped

  # Negates all params found in `negatable_params`
  def filter_negated_items: (untyped items) -> untyped

  def row_count: () -> untyped

  # We often get counts for each state by running a query per state, and
  # counting those results. This is typically slower than running one query
  # (even if that query is slower than any of the individual state queries) and
  # grouping and counting within that query.
  #
  # rubocop: disable CodeReuse/ActiveRecord
  def count_by_state: () -> untyped

  def search: () -> untyped

  def use_cte_for_search?: () -> untyped

  def parent_param=: (untyped obj) -> untyped

  def parent_param: () -> untyped

  private

  attr_reader parent: untyped

  def use_minimum_char_limit?: () -> untyped

  def not_params: () -> untyped

  def init_collection: () -> untyped

  def default_or_simple_sort?: () -> untyped

  def attempt_group_search_optimizations?: () -> untyped

  def attempt_project_search_optimizations?: () -> untyped

  def count_key: (untyped value) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_scope: (untyped items) -> untyped

  def by_closed_at: (untyped items) -> untyped

  def by_state: (untyped items) -> untyped

  def by_parent: (untyped items) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def filter_by_namespace: (untyped items) -> untyped

  def filter_by_project: (untyped items) -> untyped

  def accessible_projects: () -> untyped

  def use_namespace_filtering?: () -> untyped

  def use_join_strategy_for_project?: () -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_search: (untyped items) -> untyped

  def use_full_text_search?: () -> untyped

  def filter_by_full_text_search: (untyped items) -> untyped

  def by_iids: (untyped items) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_negated_iids: (untyped items) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def sort: (untyped items) -> untyped

  def by_author: (untyped items) -> untyped

  def by_assignee: (untyped items) -> untyped

  def assignee_filter: () -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_closed_by: (untyped items) -> untyped

  def by_label: (untyped items) -> untyped

  def label_filter: () -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_milestone: (untyped items) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_negated_milestone: (untyped items) -> untyped

  def by_release: (untyped items) -> untyped

  def by_negated_release: (untyped items) -> untyped

  def by_my_reaction_emoji: (untyped items) -> untyped

  def by_negated_my_reaction_emoji: (untyped items) -> untyped

  def by_non_archived: (untyped items) -> untyped

  def by_crm_contact: (untyped items) -> untyped

  def by_crm_organization: (untyped items) -> untyped

  def by_subscribed: (untyped items) -> untyped

  def use_legacy_milestone_filtering?: () -> untyped
end
