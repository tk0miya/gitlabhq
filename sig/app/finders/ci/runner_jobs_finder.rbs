module Ci
  class RunnerJobsFinder
    @runner: untyped

    @user: untyped

    @params: untyped

    attr_reader runner: untyped

    attr_reader params: untyped

    ALLOWED_INDEXED_COLUMNS: ::Array["id"]

    def initialize: (untyped runner, untyped current_user, ?::Hash[untyped, untyped] params) -> void

    def execute: () -> untyped

    private

    def by_permission: (untyped items) -> untyped

    def by_status: (untyped items) -> untyped

    # rubocop: disable CodeReuse/ActiveRecord
    def sort_items: (untyped items) -> untyped
  end
end
