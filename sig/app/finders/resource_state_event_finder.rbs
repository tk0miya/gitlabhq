class ResourceStateEventFinder
  @current_user: untyped

  @eventable: untyped

  include FinderMethods

  def initialize: (untyped current_user, untyped eventable) -> void

  def execute: () -> untyped

  def can_read_eventable?: () -> (nil | untyped)

  private

  attr_reader current_user: untyped

  attr_reader eventable: untyped

  def read_ability: () -> ::Symbol
end
