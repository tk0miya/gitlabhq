module Packages
  module Cargo
    class PackageFinder
      @project: untyped

      @package_name: untyped

      @package_version: untyped

      def initialize: (untyped project, package_name: untyped, package_version: untyped) -> void

      def execute: () -> untyped

      private

      attr_reader project: untyped

      attr_reader package_name: untyped

      attr_reader package_version: untyped
    end
  end
end
