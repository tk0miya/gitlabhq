      def execute: () -> untyped

      private

      attr_reader user: untyped

      attr_reader namespace: untyped

      attr_reader params: untyped

      def by_visibility: (untyped items) -> untyped

      def by_id: (untyped items) -> untyped

      def by_subscription: (untyped items) -> untyped

      def by_search: (untyped items) -> untyped

