# ProtectedBranchesFinder
#
# Used to filter protected branches by set of params
#
# Arguments:
#   project - which project to scope to
#   params:
#     search: string
class ProtectedBranchesFinder
  @project_or_group: untyped

  @params: untyped

  LIMIT: 100

  attr_accessor project_or_group: untyped

  attr_accessor params: untyped

  def initialize: (untyped project_or_group, ?::Hash[untyped, untyped] params) -> void

  def execute: () -> untyped

  private

  def by_name: (untyped protected_branches) -> untyped
end
