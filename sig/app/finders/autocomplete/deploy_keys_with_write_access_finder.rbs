module Autocomplete
  # Finder for retrieving deploy keys to use for autocomplete data sources.
  class DeployKeysWithWriteAccessFinder
    @current_user: untyped

    @project: untyped

    attr_reader current_user: untyped

    attr_reader project: untyped

    def initialize: (untyped current_user, untyped project) -> void

    def execute: (?title_search_term: untyped?) -> untyped
  end
end
