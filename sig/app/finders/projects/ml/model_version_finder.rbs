module Projects
  module Ml
    class ModelVersionFinder
      @model: untyped

      @params: untyped

      @versions: untyped

      include Gitlab::Utils::StrongMemoize

      include ValidOrDefault

      VALID_ORDER_BY: ::Array["version" | "created_at" | "id"]

      VALID_SORT: ::Array["asc" | "desc"]

      def initialize: (untyped model, ?::Hash[untyped, untyped] params) -> void

      def execute: () -> untyped

      private

      def relation: () -> untyped

      def by_version: () -> untyped

      def ordered: () -> untyped

      attr_reader params: untyped

      attr_reader model: untyped

      attr_reader versions: untyped
    end
  end
end
