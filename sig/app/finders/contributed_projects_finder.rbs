# Finds the projects "@user" contributed to, limited to either public projects
# or projects visible to the given user.
#
# Arguments:
#   user: User to find contributed projects for
#   current_user: The current user
#   params:
#     organization:  Scope the projects to the Organizations::Organization
#     search: Return only projects that match search filter
#     ignore_visibility: When true the list of projects will include all contributed
#                        projects, regardless of their visibility to the current_user.
#     min_access_level: Return only projects where user has at least the access level.
#     programming_language_name: Return only projects that use the provided programming language.
#     sort: Order projects
#
# Returns an ActiveRecord::Relation.
class ContributedProjectsFinder
  @user: untyped

  @current_user: untyped

  @params: untyped

  include Projects::SearchFilter

  attr_reader user: untyped

  attr_reader current_user: untyped

  attr_reader params: untyped

  def initialize: (user: untyped, ?current_user: untyped?, ?params: ::Hash[untyped, untyped]) -> void

  def execute: () -> untyped

  private

  def can_read_profile?: (untyped current_user) -> untyped

  def init_collection: () -> untyped

  def filter_projects: (untyped collection) -> untyped

  def by_organization: (untyped collection) -> untyped

  def by_programming_language: (untyped collection) -> untyped

  def by_active: (untyped collection) -> untyped
end
