module Releases
  class EvidencePipelineFinder
    @project: untyped

    @params: untyped

    include Gitlab::Utils::StrongMemoize

    attr_reader project: untyped

    attr_reader params: untyped

    def initialize: (untyped project, ?::Hash[untyped, untyped] params) -> void

    def execute: () -> (untyped | nil)

    private

    def repository: () -> untyped

    def existing_tag: () -> untyped

    def tag_name: () -> untyped

    def ref: () -> untyped
  end
end
