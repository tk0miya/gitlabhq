# Finders::MergeRequest class
#
# Used to filter MergeRequests collections by set of params
#
# Arguments:
#   current_user - which user use
#   params:
#     scope: 'created_by_me' or 'assigned_to_me' or 'all'
#     state: 'open', 'closed', 'merged', 'locked', or 'all'
#     group_id: integer
#     project_id: integer
#     milestone_title: string
#     release_tag: string
#     author_id: integer
#     author_username: string
#     assignee_id: integer
#     search: string
#     in: 'title', 'description', or a string joining them with comma
#     label_name: string
#     sort: string
#     non_archived: boolean
#     merged_without_event_source: boolean
#     my_reaction_emoji: string
#     source_branch: string
#     target_branch: string
#     created_after: datetime
#     created_before: datetime
#     updated_after: datetime
#     updated_before: datetime
#     review_states: 'unreviewed', 'reviewed', 'requested_changes' or 'approved'
#     not:
#       only_reviewer: boolean
#       reviewer_username: string
#       review_states: 'unreviewed', 'reviewed', 'requested_changes' or 'approved'
#     or:
#       only_reviewer_username: boolean
#       reviewer_wildcard: string
#       review_states: 'unreviewed', 'reviewed', 'requested_changes' or 'approved'
#
class MergeRequestsFinder < IssuableFinder
  self.@scalar_params: untyped

  self.@array_params: untyped

  @group_mr_in_optimization_applied: untyped

  # Temporarily skip the parent (project IN subquery) filter so we can hand off
  # the per-project iteration to InOperatorOptimization::QueryBuilder. The
  # project scope is enforced via `array_scope` instead, which is already
  # restricted to projects that are visible to the current user.
  @skip_parent_filter: untyped

  @source_branch: untyped

  @target_branch: untyped

  @source_project_id: untyped

  extend ::Gitlab::Utils::Override

  include MergedAtFilter

  include MergeUserFilter

  # The optimization is activated only when we can satisfy the
  # full index prefix of:
  #
  #   idx_mrs_on_target_id_and_created_at_and_state_id
  #   (target_project_id, state_id, created_at, id)
  #
  # A specific state_id equality filter is therefore required (see
  # specific_state_filter?) so that PostgreSQL can pin the first two columns
  # before ranging over (created_at, id).
  IN_OPERATOR_OPTIMIZABLE_SORTS: ::Array["created_at_asc" | "created_at_desc"]

  # The complete set of params that are safe to have present when the
  # in-operator optimization is active.  Any param outside this list adds a
  # WHERE clause beyond what idx_mrs_on_target_id_and_created_at_and_state_id
  # covers and therefore blocks the optimization.
  #
  # Derived directly from the params shape the group MR API endpoint sends:
  #   state, sort/order_by, group_id, include_subgroups      - handled separately
  #   page, per_page, non_archived
  #   with_labels_details, with_merge_status_recheck, attempt_group_search_optimizations - not query filters
  OPTIMIZABLE_FILTER_PARAMS: ::Array[:state | :sort | :order_by | :group_id | :include_subgroups | :page | :per_page | :non_archived | :with_labels_details | :with_merge_status_recheck | :attempt_group_search_optimizations]

  def self.scalar_params: () -> untyped

  def self.array_params: () -> untyped

  def klass: () -> untyped

  def params_class: () -> untyped

  def execute: () -> untyped

  def group_mr_in_optimization_applied?: () -> untyped

  def filter_items: (untyped _items) -> untyped

  def filter_negated_items: (untyped items) -> untyped

  private

  def use_in_operator_optimization?: () -> (false | true)

  # Returns true only when params[:state] resolves to a single state_id equality
  # predicate.  'all' and a blank value produce no WHERE state_id = ? clause,
  # leaving the second column of the index prefix unused and forcing a broader
  # range scan over every state for each project.
  def specific_state_filter?: () -> untyped

  # Returns true if any param outside OPTIMIZABLE_FILTER_PARAMS has a value, or
  # if the not:/or: sub-hashes contain any non-blank values.  In that case the
  # query adds WHERE clauses the index cannot satisfy and the standard execution
  # path is faster.
  def any_active_filters?: () -> untyped

  def filter_value_present?: (untyped value) -> untyped

  def execute_with_in_operator_optimization: () -> untyped

  def by_parent: (untyped items) -> untyped

  def sort: (untyped items) -> untyped

  def by_author: (untyped items) -> untyped

  def by_commit: (untyped items) -> untyped

  def source_branch: () -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_source_branch: (untyped items) -> untyped

  def target_branch: () -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_target_branch: (untyped items) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_negated_target_branch: (untyped items) -> untyped

  def by_negated_source_branch: (untyped items) -> untyped

  def by_negated_approved_by: (untyped items) -> untyped

  def source_project_id: () -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_source_project_id: (untyped items) -> untyped

  def by_resource_event_state: (untyped items) -> untyped

  # rubocop: disable CodeReuse/ActiveRecord
  def by_draft: (untyped items) -> untyped

  def draft_match: (untyped table) -> untyped

  # Filter by merge requests that had been approved by specific users
  # rubocop: disable CodeReuse/Finder
  def by_approvals: (untyped items) -> untyped

  def by_deployments: (untyped items) -> untyped

  def by_reviewer: (untyped items) -> untyped

  def by_review_state: (untyped items) -> untyped

  def by_negated_review_states: (untyped items) -> untyped

  def by_negated_reviewer: (untyped items) -> untyped

  def by_negated_only_reviewer: (untyped items) -> untyped

  def by_review_states_or_no_reviewer: (untyped items) -> untyped

  def by_no_review_requested_or_only_user: (untyped items) -> untyped

  def by_valid_or_no_reviewers: (untyped items) -> untyped

  def by_assignee_or_reviewer: (untyped items) -> untyped

  def by_blob_path: (untyped items) -> untyped

  def by_closed_at: (untyped items) -> untyped

  def parse_datetime: (untyped input) -> untyped

  def use_grouping_columns?: () -> (false | untyped)

  def or_params: () -> untyped

  def or_only_user: () -> untyped

  def should_apply_reviewer_filter?: () -> (false | true)
end
