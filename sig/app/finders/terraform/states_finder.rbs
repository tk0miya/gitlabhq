module Terraform
  class StatesFinder
    @project: untyped

    @current_user: untyped

    @params: untyped

    def initialize: (untyped project, untyped current_user, ?params: ::Hash[untyped, untyped]) -> void

    def execute: () -> untyped

    private

    attr_reader project: untyped

    attr_reader current_user: untyped

    attr_reader params: untyped

    def can_read_terraform_states?: () -> untyped
  end
end
