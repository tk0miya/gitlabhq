class PersonalProjectsFinder < UnionFinder
  @user: untyped

  @params: untyped

  include Gitlab::Allowable

  def initialize: (untyped user, ?::Hash[untyped, untyped] params) -> void

  # Finds the projects belonging to the user in "@user", limited to either
  # public projects or projects visible to the given user.
  #
  # current_user - When given the list of projects is limited to those only
  #                visible by this user.
  # params       - Optional query parameters
  #                  min_access_level: integer
  #
  # Returns an ActiveRecord::Relation.
  def execute: (?untyped? current_user) -> untyped

  private

  def all_projects: (untyped current_user) -> (::Array[untyped] | untyped)

  def projects_with_min_access_level: (untyped current_user) -> untyped

  def min_access_level?: () -> untyped

  def find_user: (untyped user) -> untyped
end
