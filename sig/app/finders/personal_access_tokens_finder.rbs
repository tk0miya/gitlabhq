  def by_users: (untyped tokens) -> untyped

  def sort: (untyped tokens) -> untyped

  def by_impersonation: (untyped tokens) -> untyped

  def by_state: (untyped tokens) -> untyped

  def by_revoked_state: (untyped tokens) -> untyped

  def by_created_before: (untyped tokens) -> untyped

  def by_created_after: (untyped tokens) -> untyped

  def by_expires_before: (untyped tokens) -> untyped

  def by_expires_after: (untyped tokens) -> untyped

  def by_last_used_before: (untyped tokens) -> untyped

  def by_last_used_after: (untyped tokens) -> untyped

