module Environments
  class EnvironmentsFinder
    @project: untyped

    @current_user: untyped

    @params: untyped

    attr_reader project: untyped

    attr_reader current_user: untyped

    attr_reader params: untyped

    InvalidStatesError: untyped

    def initialize: (untyped project, untyped current_user, ?::Hash[untyped, untyped] params) -> void

    def execute: () -> untyped

    private

    def by_type: (untyped environments) -> untyped

    def by_name: (untyped environments) -> untyped

    def by_search: (untyped environments) -> untyped

    def by_states: (untyped environments) -> untyped

    def by_ids: (untyped environments) -> untyped

    def environments_with_states: (untyped environments) -> untyped

    def valid_states?: (untyped states) -> untyped
  end
end
