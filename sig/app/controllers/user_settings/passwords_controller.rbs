module UserSettings
  class PasswordsController < ApplicationController
    @hide_search_settings: untyped

    @user: untyped

    include Gitlab::Tracking::Helpers::WeakPasswordErrorEvent

    def new: () -> (untyped | nil)

    def create: () -> (nil | untyped)

    def edit: () -> nil

    def update: () -> (nil | untyped)

    def reset: () -> untyped

    private

    def set_hide_search_settings: () -> untyped

    def set_user: () -> untyped

    def determine_layout: () -> ("minimal" | "profile")

    def authorize_change_password!: () -> (untyped | nil)

    def handle_invalid_current_password_attempt!: () -> untyped

    def user_params: () -> untyped

    def password_attributes: () -> { password: untyped, password_confirmation: untyped, password_automatically_set: false }
  end
end
