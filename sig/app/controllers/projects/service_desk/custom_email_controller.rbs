module Projects
  module ServiceDesk
    class CustomEmailController < Projects::ApplicationController
      def create: () -> untyped

      def update: () -> (nil | untyped)

      def destroy: () -> untyped

      def show: () -> untyped

      private

      def update_setting_params: () -> untyped

      def json_response: (?error_message: untyped?, ?status: ::Symbol, ?service_response: untyped?) -> untyped

      def custom_email_attributes: (error_message: untyped) -> { custom_email: untyped, custom_email_enabled: untyped, custom_email_verification_state: untyped, custom_email_verification_error: untyped, custom_email_smtp_address: untyped, error_message: untyped }
    end
  end
end
