class Projects::PagesController < Projects::ApplicationController
  @pipeline_wizard_data: untyped

  # rubocop: disable CodeReuse/ActiveRecord
  @domains: untyped

  def new: () -> untyped

  def show: () -> (nil | untyped)

  def destroy: () -> untyped

  def update: () -> untyped

  def regenerate_unique_domain: () -> untyped

  private

  def project_params: () -> untyped

  def project_params_attributes: () -> ::Array[:pages_https_only | { project_setting_attributes: untyped }]

  # overridden in EE
  def project_setting_attributes: () -> ::Array[:pages_unique_domain_enabled | :pages_primary_domain]
end
