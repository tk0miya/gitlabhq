# == SessionlessAuthentication
#
# Controller concern to handle PAT, RSS, and static objects token authentication methods
#
module SessionlessAuthentication
  @request_authenticator: untyped

  @sessionless_sign_in: untyped

  # This filter handles personal access tokens, atom requests with rss tokens, and static object tokens
  def authenticate_sessionless_user!: (untyped request_format) -> untyped

  def request_authenticator: () -> untyped

  def sessionless_user?: () -> untyped

  def sessionless_sign_in: (untyped user) -> untyped

  def sessionless_bypass_admin_mode!: () { () -> untyped } -> untyped
end
