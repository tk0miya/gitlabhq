class ProjectsController < Projects::ApplicationController
  @namespace: untyped

  @parent_group: untyped

  @current_user_group: untyped

  @project: untyped

  @badge_api_endpoint: untyped

  # Refresh the repo in case anything changed
  @repository: untyped

  @id: untyped

  @path: untyped

  @ref_type: untyped

  @wiki: untyped

  @wiki_home: untyped

  @issues: untyped

  @issuable_meta_data: untyped

