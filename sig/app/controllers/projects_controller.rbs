  def execute_sync_transfer: (untyped namespace) -> untyped

  def destroy_immediately: () -> untyped

  def refs_params: () -> untyped

  # Render project landing depending of which features are available
  # So if page is not available in the list it renders the next page
  #
  # pages list order: repository readme, wiki home, issues list, customize workflow
  def render_landing_page: () -> untyped

  def finder_type: () -> untyped

  def determine_layout: () -> ("dashboard" | "project_settings" | "project")

  # rubocop: disable CodeReuse/ActiveRecord
  def load_events: () -> untyped

  def project_params: (?attributes: untyped) -> untyped

