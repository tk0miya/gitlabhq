class PasswordsController < Devise::PasswordsController
  include GitlabRecaptcha

  include Gitlab::Tracking::Helpers::WeakPasswordErrorEvent

  # rubocop: disable CodeReuse/ActiveRecord
  def edit: () -> untyped

  def update: () -> untyped

  # overridden in EE
  def log_audit_reset_failure: (untyped _user) -> nil

  def resource_from_email: () -> untyped

  def check_password_authentication_available: () -> (nil | untyped)

  def check_recaptcha: () -> (nil | untyped)

  def throttle_reset: () -> (nil | untyped)

  def context_user: () -> untyped

  def resource_params: () -> untyped

  private

  def redirect_blocked_user: () -> untyped
end
