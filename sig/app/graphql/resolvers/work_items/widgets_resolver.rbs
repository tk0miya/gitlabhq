module Resolvers
  module WorkItems
    class WidgetsResolver < BaseResolver
      MAX_TYPES: 100

      def ready?: (**untyped args) -> untyped

      def resolve: (ids: untyped, ?union: bool) -> (::Array[untyped] | untyped)

      private

      def resource_parent: () -> untyped
    end
  end
end
