module Resolvers
  module Projects
    class UserContributedProjectsResolver < BaseResolver
      prepend ::Projects::LookAheadPreloads

      alias user object

      def resolve_with_lookahead: (**untyped args) -> untyped

      private

      def finder_params: (untyped args) -> { organization: untyped, search: untyped, sort: untyped, min_access_level: untyped, programming_language_name: untyped, active: untyped }
    end
  end
end
