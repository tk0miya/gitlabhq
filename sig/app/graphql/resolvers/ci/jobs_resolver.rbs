module Resolvers
  module Ci
    class JobsResolver < BaseResolver
      alias pipeline object

      def resolve: (?job_kind: untyped?, ?retried: untyped?, ?security_report_types: untyped, ?statuses: untyped?, ?when_executed: untyped?) -> untyped

      def init_collection: (untyped security_report_types) -> untyped
    end
  end
end
