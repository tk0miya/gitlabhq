module Resolvers
  module Ci
    class RunnersResolver < BaseResolver
      include LooksAhead

      include Gitlab::Graphql::Authorize::AuthorizeResource

      def resolve_with_lookahead: (**untyped args) -> untyped

      def handle_access_denied_error!: () -> untyped

      def runners_finder_params: (untyped params) -> untyped

      def parent_param: () -> (::Hash[untyped, untyped] | untyped)

      private

      def parent: () -> untyped

      def preloads: () -> untyped
    end
  end
end
