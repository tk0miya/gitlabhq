module Types
  module WorkItems
    module Widgets
      # Disabling widget level authorization as it might be too granular
      # and we already authorize the parent work item
      # rubocop:disable Graphql/AuthorizeTypes -- reason above
      class ErrorTrackingType < BaseObject
        @latest_event: untyped

        def stack_trace: () -> (::Array[untyped] | untyped)

        def status: () -> (:not_found | untyped)

        private

        def latest_event_result: () -> untyped
      end
    end
  end
end
