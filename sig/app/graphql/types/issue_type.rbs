module Types
  class IssueType < BaseObject
    def author: () -> untyped

    def updated_by: () -> untyped

    def milestone: () -> untyped

    def moved_to: () -> untyped

    def closed_as_duplicate_of: () -> untyped

    def discussion_locked: () -> untyped

    def create_note_email: () -> untyped

    def escalation_status: () -> (untyped | nil)
  end
end
