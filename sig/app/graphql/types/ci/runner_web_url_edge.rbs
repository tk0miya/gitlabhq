module Types
  module Ci
    class RunnerWebUrlEdge < ::Types::BaseEdge
      @runner: untyped

      def initialize: (untyped node, untyped connection) -> void

      # here parent is a Keyset::Connection
      def edit_url: (parent: untyped) -> untyped

      def web_url: (parent: untyped) -> untyped

