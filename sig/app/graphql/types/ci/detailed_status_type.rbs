module Types
  module Ci
    # rubocop: disable Graphql/AuthorizeTypes
    # This is presented through `PipelineType` that has its own authorization
    class DetailedStatusType < BaseObject
      def id: (parent: untyped) -> ::String

      def favicon: () -> untyped

      def action: () -> (nil | { button_title: untyped, icon: untyped, method: untyped, path: untyped, title: untyped, confirmation_message: untyped })
    end
  end
end
