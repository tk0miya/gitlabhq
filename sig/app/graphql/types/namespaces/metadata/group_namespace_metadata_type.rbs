module Types
  module Namespaces
    module Metadata
      class GroupNamespaceMetadataType < BaseObject
        alias group object

        def issue_repositioning_disabled?: () -> untyped

        def show_new_work_item?: () -> (false | untyped)

        def has_projects?: () -> untyped

        def group_id: () -> untyped
      end
    end
  end
end
