module Mutations
  module WorkItems
    module UserPreference
      class Update < BaseMutation
        include Mutations::SpamProtection

        include FindsNamespace

        def resolve: (namespace_path: untyped, ?work_item_type_id: untyped?, **untyped attributes) -> { user_preferences: untyped, errors: untyped }
      end
    end
  end
end
