module Mutations
  module Packages
    module DeleteProtection
      extend ActiveSupport::Concern

      private

      DELETION_PROTECTED_ERROR_MESSAGE: "Package is deletion protected."

      def protected_for_delete?: (untyped package, ?in_project: untyped?) -> (false | untyped)

      def deletion_protected_error_message: (?untyped? package_name) -> (untyped | ::String)
    end
  end
end
