module Mutations
  module Notes
    module Create
      class LatestDiffNote < Base
        def ready?: (**untyped args) -> untyped

        private

        def validate_line_range!: (untyped args) -> untyped

        def validate_end_line_has_start!: (untyped end_line, untyped start_line, untyped start_name, untyped end_name) -> (nil | untyped)

        def create_note_params: (untyped noteable, untyped args) -> untyped

        def position: (untyped noteable, untyped args) -> untyped
      end
    end
  end
end
