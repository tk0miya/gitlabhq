module Mutations
  module Snippets
    class Create < BaseMutation
      include ServiceCompatibility

      include Mutations::SpamProtection

      include Gitlab::InternalEventsTracking

      def resolve: (?project_path: untyped?, **untyped args) -> { snippet: untyped, errors: untyped }

      private

      def find_object: (untyped full_path) -> untyped

      # process_args_for_params!(args)    -> nil
      #
      # Modifies/adds/deletes mutation resolve args as necessary to be passed as params to service layer.
      def process_args_for_params!: (untyped args) -> nil
    end
  end
end
