module Mutations
  module Namespace
    module PackageSettings
      class Update < Mutations::BaseMutation
        include Mutations::ResolvesNamespace

        def resolve: (namespace_path: untyped, **untyped args) -> { package_settings: untyped, errors: untyped }

        private

        def find_object: (namespace_path: untyped) -> untyped
      end
    end
  end
end
