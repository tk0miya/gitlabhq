module Mutations
  module Ci
    module Pipeline
      class Destroy < Base
        def resolve: (id: untyped) -> (untyped | { success: untyped, errors: untyped })

        private

        def undergoing_refresh_error: (untyped project) -> { success: false, errors: ::Array["Action temporarily disabled. The project this pipeline belongs to is undergoing stats refresh."] }
      end
    end
  end
end
