class AvatarUploader < GitlabUploader
  include UploaderHelper

  include RecordsUploads::Concern

  include ObjectStorage::Concern

  prepend ObjectStorage::Extension::RecordsUploads

  MIME_ALLOWLIST: ::Array["image/png" | "image/jpeg" | "image/gif" | "image/bmp" | "image/tiff" | "image/vnd.microsoft.icon"]

  def exists?: () -> untyped

  def move_to_store: () -> false

  def move_to_cache: () -> false

  def absolute_path: () -> untyped

  def mounted_as: () -> untyped

  def content_type_whitelist: () -> untyped

  private

  def dynamic_segment: () -> untyped

  def clear_avatar_caches: (*untyped) -> (nil | untyped)
end
