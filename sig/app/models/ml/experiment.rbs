module Ml
  class Experiment < ApplicationRecord
    include AtomicInternalId

    include Sortable

    include Presentable

    PACKAGE_PREFIX: "ml_experiment_"

    def package_name: () -> (untyped | ::String)

    def for_model?: () -> untyped

    def stop_destroy: () -> (nil | untyped)

    def self.by_project_id_and_iid: (untyped project_id, untyped iid) -> untyped

    def self.by_project_id_and_name: (untyped project_id, untyped name) -> untyped

    def self.package_for_experiment?: (untyped package_name) -> (false | untyped)

    def self.find_or_create: (untyped project, untyped name, untyped user) -> untyped

    private

    def self.numeric?: (untyped value) -> untyped
  end
end
