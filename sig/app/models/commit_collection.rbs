# A collection of Commit instances for a specific container and Git reference.
class CommitCollection
  @container: untyped

  @commits: untyped

  @ref: untyped

  @pagination: untyped

  include Enumerable

  include Gitlab::Utils::StrongMemoize

  attr_reader container: untyped

  attr_reader ref: untyped

  attr_reader commits: untyped

  # container - The object the commits belong to.
  # commits - The Commit instances to store.
  # ref - The name of the ref (e.g. "master").
  def initialize: (untyped container, untyped commits, ?untyped? ref, ?page: untyped?, ?per_page: untyped?, ?count: untyped?) -> void

  def each: () { (?) -> untyped } -> untyped

  def committers: (?with_merge_commits: bool, ?lazy: bool, ?include_author_when_signed: bool) -> untyped

  def committers_lazy: (?with_merge_commits: bool, ?include_author_when_signed: bool) -> untyped

  alias add_committers_to_batch_loader committers_lazy

  def committer_user_ids: () -> untyped

  def without_merge_commits: () -> untyped

  # Returns the collection with the latest pipeline for every commit pre-set.
  #
  # Setting the pipeline for each commit ahead of time removes the need for running
  # a query for every commit we're displaying.
  def with_latest_pipeline: (?untyped? ref) -> self

  # Returns the collection with markdown fields preloaded.
  #
  # Get the markdown cache from redis using pipeline to prevent n+1 requests
  # when rendering the markdown of an attribute (e.g. title, full_title,
  # description).
  def with_markdown_cache: () -> self

  def unenriched: () -> untyped

  def fully_enriched?: () -> untyped

  # Batch load any commits that are not backed by full gitaly data, and
  # replace them in the collection.
  def enrich!: () -> self

  def respond_to_missing?: (untyped message, ?bool inc_private) -> untyped

  # rubocop:disable GitlabSecurity/PublicSend
  def method_missing: (untyped message, *untyped args) { (?) -> untyped } -> untyped

  def next_page: () -> untyped

  def load_tags: () -> self

  private

  def committers_emails: (?with_merge_commits: bool, ?include_author_when_signed: bool) -> untyped

  def committer_emails_for: (untyped commits, ?include_author_when_signed: bool) -> untyped
end
