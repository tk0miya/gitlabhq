module WorkItems
  module TypesFramework
    module SystemDefined
      module Definitions
        module Incident
          def self.widgets: () -> ::Array["ai_session" | "assignees" | "award_emoji" | "crm_contacts" | "current_user_todos" | "description" | "development" | "email_participants" | "hierarchy" | "iteration" | "labels" | "linked_items" | "linked_resources" | "milestone" | "notes" | "notifications" | "participants" | "time_tracking"]

          def self.widget_options: () -> ::Hash[untyped, untyped]

