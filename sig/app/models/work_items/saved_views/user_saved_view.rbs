module WorkItems
  module SavedViews
    class UserSavedView < ApplicationRecord
      include RelativePositioning

      def self.subscribe: (user: untyped, saved_view: untyped, ?auto_unsubscribe: bool) -> untyped

      def self.unsubscribe: (user: untyped, saved_view: untyped) -> true

      def self.unsubscribe_last_saved_view: (user: untyped, namespace: untyped) -> (true | untyped)

      def self.at_subscription_limit?: (user: untyped, namespace: untyped) -> untyped

      def self.relative_positioning_query_base: (untyped user_saved_view) -> untyped

      def self.relative_positioning_parent_column: () -> :user_id

      # Overridden in EE
      def self.user_saved_view_limit: (untyped _namespace) -> 5

      private

      def set_initial_position: () -> (untyped | nil)
    end
  end
end
