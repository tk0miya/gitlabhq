module Packages
  module Cargo
    class Package < Packages::Package
      RESERVED_NAMES: ::Array["nul" | "con" | "prn" | "aux" | "com1" | "com2" | "com3" | "com4" | "com5" | "com6" | "com7" | "com8" | "com9" | "lpt1" | "lpt2" | "lpt3" | "lpt4" | "lpt5" | "lpt6" | "lpt7" | "lpt8" | "lpt9"]

      def self.cargo_package_already_taken?: (untyped project_id, untyped package_name, untyped package_version) -> untyped

      def cargo_reserved_name: () -> (nil | untyped)

      def cargo_package_version_already_taken: () -> (nil | untyped)
    end
  end
end
