  FORBIDDEN_KEY_VALUE: untyped

  VALID_RUNNER_REGISTRAR_TYPES: ::Array["project" | "group"]

  DEFAULT_PROTECTED_PATHS: ::Array["/users/password" | "/users/sign_in" | "/api/v3/session.json" | "/api/v3/session" | "/api/v4/session.json" | "/api/v4/session" | "/users" | "/users/confirmation" | "/unsubscribes/" | "/import/github/personal_access_token" | "/admin/session"]

  DEFAULT_PROTECTED_PATHS_FOR_GET_REQUEST: ::Array["/users/sign_in_path"]

  DEFAULT_MINIMUM_PASSWORD_LENGTH: 8

  DEFAULT_NUMBER_OF_DAYS_BEFORE_REMOVAL: 30

