module Namespaces
  class VerifiedNamespace < ::ApplicationRecord
    VERIFICATION_LEVELS: { gitlab_maintained: 100, gitlab_partner_maintained: 50, verified_creator_maintained: 10, verified_creator_self_managed: 1, unverified: 0 }

    def self.for_project: (untyped project) -> untyped

    def self.find_or_create_by_namespace!: (untyped namespace) -> untyped
  end
end
