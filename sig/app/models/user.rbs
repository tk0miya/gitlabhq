class User < ApplicationRecord
  self.@reference_pattern: untyped

  @reset_token: untyped

  @owned_projects: untyped

  @ldap_identity: untyped

  @project_deploy_keys: untyped

  @global_notification_setting: untyped

  @free_or_trial_owned_group_ids: untyped

  @composite_identity_enforced_override: untyped

  @callouts_by_feature_name: untyped

  @group_callouts_by_feature_name: untyped

  extend Gitlab::ConfigHelper

  include Gitlab::ConfigHelper

  include Gitlab::SQL::Pattern

  include AfterCommitQueue

  include Avatarable

  include Referable

  include Sortable

  include CaseSensitivity

  include TokenAuthenticatable

  include FeatureGate

  include CreatedAtFilterable

  include BulkMemberAccessLoad

  include BlocksUnsafeSerialization

  include WithUploads

  include OptionallySearch

  include FromUnion

  include BatchDestroyDependentAssociations

  include BatchDeleteDependentAssociations

  include BatchNullifyDependentAssociations

  include UpdateHighestRole

  include HasUserType

  include Gitlab::Auth::Otp::Fortinet

  include Gitlab::Auth::Otp::DuoAuth

  include RestrictedSignup

  include StripAttribute

  include EachBatch

  include IgnorableColumns

  include UseSqlFunctionForPrimaryKeyLookups

  include Todoable

  include Gitlab::InternalEventsTracking

  include Ci::PipelineScheduleOwnershipValidator

  include Users::DependentAssociations

  include Users::EmailOtpEnrollment

  include Cells::Claimable

  DEFAULT_NOTIFICATION_LEVEL: :participating

  INSTANCE_ACCESS_REQUEST_APPROVERS_TO_BE_NOTIFIED_LIMIT: 10

  BLOCKED_PENDING_APPROVAL_STATE: "blocked_pending_approval"

  COUNT_CACHE_VALIDITY_PERIOD: untyped

  # Number of random bytes used to generate the OTP secret via ROTP::Base32.random.
  # 20 bytes produces a 32-character Base32 string (160-bit key), matching the
  # devise-two-factor v6+ default and RFC 4226 recommended key length.
  # NOTE: In devise-two-factor < 6.0, this value was a character count; from v6.0
  # it is a byte count. 20 bytes -> 32 Base32 chars (same output as the old 32-char default).
  OTP_SECRET_LENGTH: 20

  OTP_SECRET_TTL: untyped

  MAX_USERNAME_LENGTH: 255

  MIN_USERNAME_LENGTH: 2

  MAX_NAME_LENGTH: 127

  SECONDARY_EMAIL_ATTRIBUTES: ::Array[:commit_email | :notification_email | :public_email]

  FORBIDDEN_SEARCH_STATES: ::Array["blocked" | "banned" | "ldap_blocked"]

  INCOMING_MAIL_TOKEN_PREFIX: "glimt-"

  FEED_TOKEN_PREFIX: "glft-"

  FIRST_GROUP_PATHS_LIMIT: 200

  SERVICE_ACCOUNT_PREFIX: "service_account"

  NOREPLY_EMAIL_DOMAIN: ::String

  CI_PROJECT_RUNNERS_BATCH_SIZE: 15000

  CI_RUNNERS_PROJECT_COUNT_LIMIT: 10000

  RESERVED_AI_USERNAME_PREFIXES: ::Array["duo-" | "duo_" | "ai-" | "ai_"]

  # Must be included after `devise`
  include EncryptedUserPassword

  include RecoverableByAnyEmail

  include AdminChangedPasswordNotifier

  # This module adds async behaviour to Devise emails
  # and should be added after Devise modules are initialized.
  include AsyncDeviseEmail

  include ForcedEmailConfirmation

  include RequireEmailVerification

  MINIMUM_DAYS_CREATED: 7

  # Override Devise::Models::Trackable#update_tracked_fields!
  # to limit database writes to at most once every hour
  # rubocop: disable CodeReuse/ServiceClass
  def update_tracked_fields!: (untyped request) -> (nil | untyped)

  attr_accessor force_random_password: untyped

  attr_accessor skip_ai_prefix_validation: untyped

  # Virtual attribute for authenticating by either username or email
  attr_accessor login: untyped

  # Virtual attribute for impersonator
  attr_accessor impersonator: untyped

  # Override enum setter for `dashboard` to support flipped mapping for rollout
  def dashboard=: (untyped value) -> untyped

  # Returns the effective dashboard value for routing purposes
  # For GitLab team members with feature flag enabled, flips homepage/projects values
  def effective_dashboard_for_routing: () -> untyped

  def dashboard_enum_mapping: () -> untyped

  # Determines if this user should use flipped dashboard enum mapping
  def should_use_flipped_dashboard_mapping_for_rollout?: () -> (false | true)

  def self.supported_keyset_orderings: () -> { id: ::Array[:asc | :desc], name: ::Array[:asc | :desc], username: ::Array[:asc | :desc], created_at: ::Array[:asc | :desc], updated_at: ::Array[:asc | :desc] }

  def preferred_language: () -> untyped

  def active_for_authentication?: () -> (false | untyped)

  # The messages for these keys are defined in `devise.en.yml`
  def inactive_message: () -> (:blocked_pending_approval | :blocked | :forbidden | untyped)

  def self.with_visible_profile: (untyped user) -> untyped

  # Limits the users to those that have TODOs, optionally in the given state.
  #
  # user - The user to get the todos for.
  #
  # with_todos - If we should limit the result set to users that are the
  #              authors of todos.
  #
  # todo_state - An optional state to require the todos to be in.
  def self.limit_to_todo_authors: (?user: untyped?, ?with_todos: bool, ?todo_state: untyped?) -> untyped

  # Returns a relation that optionally includes the given user.
  #
  # user_id - The ID of the user to include.
  def self.union_with_user: (?untyped? user_id) -> untyped

  def self.with_two_factor: () -> untyped

  def self.without_two_factor: () -> untyped

  # Devise method overridden to allow support for dynamic password lengths
  def self.password_length: () -> ::Range[untyped]

  # Generate a random password that conforms to the current password length settings
  def self.random_password: () -> untyped

  # extracted and modified from original Devise method in
  # https://github.com/heartcombo/devise/blob/731074bf09c2a0cd498c1b8a2a01434e722f94d5/lib/devise/models/recoverable.rb#L134C1-L150C12
  # rubocop:disable Gitlab/AvoidCurrentOrganization -- this is only called by Devise from PasswordsController
  def self.reset_password_by_token: (?::Hash[untyped, untyped] attributes) -> untyped

  # override, from Devise in
  # https://github.com/heartcombo/devise/blob/e9c534d363cc9d552662049b38582eead87bedd6/lib/devise/models/lockable.rb#L189-L197
  def self.unlock_access_by_token: (untyped unlock_token) -> untyped

  # Devise method overridden to allow sign in with email or username
  def self.find_for_database_authentication: (untyped warden_conditions) -> untyped

  # override from Devise
  # https://github.com/heartcombo/devise/blob/e9c534d363cc9d552662049b38582eead87bedd6/lib/devise/models/confirmable.rb#L329C1-L354C12
  # modified to use Current.organization in primary query
  # rubocop:disable Gitlab/AvoidCurrentOrganization -- this method is only called by Devise::ConfirmationsController
  def self.confirm_by_token: (untyped confirmation_token) -> untyped

  def self.sort_by_attribute: (untyped method) -> untyped

  # Find a User by their primary email or any associated confirmed secondary email
  def self.find_by_any_email: (untyped email, ?confirmed: bool) -> (nil | untyped)

  # Returns a relation containing all found users by their primary email
  # or any associated confirmed secondary email
  #
  # @param emails [String, Array<String>] email addresses to check
  # @param confirmed [Boolean] Only return users where the primary email is confirmed
  def self.by_any_email: (untyped emails, ?confirmed: bool) -> untyped

  def self.filter_items: (untyped filter_name) -> untyped

  def self.filter_by_state: (untyped filter_name) -> untyped

  # Searches users matching the given query.
  #
  # This method uses ILIKE on PostgreSQL.
  #
  # query - The search query as a String
  # with_private_emails - include private emails in search
  # partial_email_search - only for admins to preserve email privacy. Only for self-managed instances.
  #
  # Returns an ActiveRecord::Relation.
  def self.search: (untyped query, **untyped options) -> untyped

  # This should be kept in sync with the frontend filtering in
  # https://gitlab.com/gitlab-org/gitlab/-/blob/5d34e3488faa3982d30d7207773991c1e0b6368a/app/assets/javascripts/gfm_auto_complete.js#L68 and
  # https://gitlab.com/gitlab-org/gitlab/-/blob/5d34e3488faa3982d30d7207773991c1e0b6368a/app/assets/javascripts/gfm_auto_complete.js#L1053
  def self.gfm_autocomplete_search: (untyped query) -> untyped

  # Limits the result set to users _not_ in the given query/list of IDs.
  #
  # users - The list of users to ignore. This can be an
  #         `ActiveRecord::Relation`, or an Array.
  def self.where_not_in: (?untyped? users) -> untyped

  def self.reorder_by_name: () -> untyped

  # searches user by given pattern
  # it compares name and username fields with given pattern
  # This method uses ILIKE on PostgreSQL.
  def self.search_by_name_or_username: (untyped query, ?use_minimum_char_limit: untyped?) -> untyped

  def self.with_public_email: (untyped email_address) -> untyped

  def self.with_primary_or_secondary_email: (untyped query, ?use_minimum_char_limit: bool, ?partial_email_search: bool) -> untyped

  # This method is overridden in JiHu.
  # https://gitlab.com/gitlab-org/gitlab/-/issues/348509
  def self.user_search_minimum_char_limit: () -> true

  def self.find_by_login: (untyped login) -> untyped

  def self.find_by_username: (untyped username) -> untyped

  def self.find_by_username!: (untyped username) -> untyped

  # Returns a user for the given SSH key. Deploy keys are excluded.
  def self.find_by_ssh_key_id: (untyped key_id) -> untyped

  def self.find_by_full_path: (untyped path, ?follow_redirects: bool) -> untyped

  def self.reference_prefix: () -> "@"

  # Pattern used to extract `@user` user references from text
  def self.reference_pattern: () -> untyped

  # Return true if there is only single non-internal user in the deployment,
  # ghost user is ignored.
  def self.single_user?: () -> untyped

  def self.single_user: () -> (untyped | nil)

  def self.get_ids_by_ids_or_usernames: (untyped ids, untyped usernames) -> untyped

  def self.generate_incoming_mail_token: () -> ::String

  def self.prefix_for_incoming_mail_token: () -> untyped

  def self.username_exists?: (untyped username) -> untyped

  def self.id_exists?: (untyped id) -> untyped

  def self.ends_with_reserved_file_extension?: (untyped username) -> untyped

  def get_all_webauthn_credential_ids: () -> untyped

  def full_path: () -> untyped

  def to_param: () -> untyped

  def build_default_user_detail: () -> untyped

  def to_reference: (?untyped? _from, ?target_container: untyped?, ?full: untyped?) -> ::String

  def readable_by?: (untyped user) -> untyped

  def skip_confirmation=: (untyped bool) -> (untyped | nil)

  def skip_reconfirmation=: (untyped bool) -> (untyped | nil)

  def generate_reset_token: () -> untyped

  def recently_sent_password_reset?: () -> untyped

  # Overwrites valid_password? from Devise::Models::DatabaseAuthenticatable
  # In constant-time, check both that the password isn't on a denylist AND
  # that the password is the user's password
  def valid_password?: (untyped password) -> (false | untyped)

  def generate_otp_backup_codes!: () -> untyped

  # Overrides Devise::Models::TwoFactorBackupable#invalidate_otp_backup_code! to
  # return false on read-only replicas, and to dispatch to the FIPS-compliant
  # PBKDF2 implementation when applicable.
  #
  # Backup code authentication requires a DB write to consume the code. On a
  # read-only replica we cannot perform that write, so we treat the attempt as
  # failed. This preserves the pre-existing behaviour: backup code auth was
  # always denied on replicas because the external save! would raise.
  def invalidate_otp_backup_code!: (untyped code) -> (false | untyped)

  # See https://gitlab.com/gitlab-org/security/gitlab/-/issues/638
  DISALLOWED_PASSWORDS: ::Array["123qweQWE!@#000000000"]

  def password_allowed?: (untyped password) -> untyped

  # Override Devise Rememberable#remember_me!
  #
  # In Devise this method sets `remember_created_at` and writes the session token
  # to the session cookie. When remember me is disabled this method ensures these
  # values aren't set.
  def remember_me!: () -> (untyped | nil)

  def forget_me!: () -> (untyped | nil)

  # This is a copy of #forget_me! without the check for `expire_all_remember_me_on_sign_out`
  # https://github.com/heartcombo/devise/blob/v4.9.4/lib/devise/models/rememberable.rb#L58-L63
  #
  # We need a separate method because we disabled that setting but we also need to be able to
  # manually expire these tokens when a session is manually destroyed
  def invalidate_all_remember_tokens!: () -> (nil | untyped)

  # Override Devise Rememberable#remember_me?
  #
  # In Devise this method compares the remember me token received from the user session
  # and compares to the stored value. When remember me is disabled this method ensures
  # the upstream comparison does not happen.
  def remember_me?: (untyped token, untyped generated_at) -> (false | untyped)

  def disable_two_factor!: () -> untyped

  def disable_two_factor_otp!: () -> untyped

  def disable_second_factor_webauthn!: () -> untyped

  def destroy_second_factor_webauthn_device: (untyped device_id) -> untyped

  def reset_backup_codes!: () -> untyped

  def two_factor_enabled?: () -> untyped

  def two_factor_otp_enabled?: () -> untyped

  def two_factor_webauthn_enabled?: () -> untyped

  def allow_passkey_authentication?: () -> (false | untyped)

  def passkeys_enabled?: () -> untyped

  def passkey_via_2fa_enabled?: () -> untyped

  # This method allows either passkeys or second_factor_webauthn_registrations
  # to be used as a 2FA method without breaking existing 2FA implementations.
  #
  # Once passkeys enable two-factor authentication for the user
  # `passkey_via_2fa_enabled?` method will become `allow_passkey_authentication? && passkeys_enabled?`
  #  and
  # `two_factor_webauthn_enabled?` method will become `second_factor_webauthn_registrations.any? || passkey_via_2fa_enabled?`
  #  and
  #  this method will be removed in favor of `two_factor_webauthn_enabled?` method.
  def can_use_existing_webauthn_authenticator_for_2fa?: () -> untyped

  def needs_new_otp_secret?: () -> untyped

  def otp_secret_expired?: () -> (true | untyped)

  # Centralised location while transitioning from Feature Flag to
  # Application Setting.
  # TODO: Remove after https://gitlab.com/gitlab-org/gitlab/-/work_items/599948
  def email_otp_available?: () -> untyped

  def email_based_otp_required?: () -> untyped

  def update_otp_secret!: () -> untyped

  def namespace_move_dir_allowed: () -> (untyped | nil)

  # will_save_change_to_attribute? is used by Devise to check if it is necessary
  # to clear any existing reset_password_tokens before updating an authentication_key
  # and login in our case is a virtual attribute to allow login by username or email.
  def will_save_change_to_login?: () -> untyped

  def unique_email: () -> untyped

  def commit_email_or_default: () -> untyped

  def notification_email_or_default: () -> untyped

  def private_commit_email: () -> untyped

  # see if the new email is already a verified secondary email
  def check_for_verified_email: () -> (untyped | nil)

  def update_invalid_gpg_signatures: () -> untyped

  # Returns the groups a user has access to, either through direct or inherited membership or a project authorization
  # with_minimal_access is used in EE only
  def authorized_groups: (?with_minimal_access: bool, ?include_project_authorizations: bool) -> untyped

  def authorized_root_ancestor_ids: () -> untyped

  # Used to search on the user's authorized_groups effeciently by using a CTE
  def search_on_authorized_groups: (untyped query, ?use_minimum_char_limit: bool) -> untyped

  # Returns the groups a user is a member of, either directly or through a parent group
  def membership_groups: () -> untyped

  # Returns a relation of groups the user has access to, including their parent
  # and child groups (recursively).
  def all_expanded_groups: () -> untyped

  def expanded_groups_requiring_two_factor_authentication: () -> untyped

  def source_groups_of_two_factor_authentication_requirement: () -> untyped

  def direct_groups_with_route: () -> untyped

  def first_group_paths: () -> (nil | untyped)

  # rubocop: disable CodeReuse/ServiceClass
  def refresh_authorized_projects: (?source: untyped?) -> untyped

  def authorized_projects: (?untyped? min_access_level) -> untyped

  def authorized_project?: (untyped project, ?untyped? min_access_level) -> untyped

  # Typically used in conjunction with projects table to get projects
  # a user has been given access to.
  # The param `related_project_column` is the column to compare to the
  # project_authorizations. By default is projects.id
  #
  # Example use:
  # `Project.where('EXISTS(?)', user.authorizations_for_projects)`
  def authorizations_for_projects: (?min_access_level: untyped?, ?related_project_column: ::String) -> untyped

  def owned_projects: () -> untyped

  # Returns projects which user can admin issues on (for example to move an issue to that project).
  #
  # This logic is duplicated from `Ability#project_abilities` into a SQL form.
  def projects_where_can_admin_issues: () -> untyped

