class PushEvent < Event
  alias commits_count commit_count

  # Returns events of pushes that either pushed to an existing ref or created a
  # new one.
  def self.created_or_pushed: () -> untyped

  # Returns events of pushes to a branch.
  def self.branch_events: () -> untyped

  # Returns PushEvent instances for which no merge requests have been created.
  def self.without_existing_merge_requests: () -> untyped

  def self.sti_name: () -> untyped

  def push_action?: () -> true

  def push_with_commits?: () -> untyped

  def new_ref?: () -> untyped

  def rm_ref?: () -> untyped

  def md_ref?: () -> untyped

  def ref_name: () -> untyped

  alias branch_name ref_name

  alias tag_name ref_name

  def commit_id: () -> untyped

  def last_push_to_non_root?: () -> untyped

  def validate_push_action: () -> (nil | untyped)

  private

  def project_as_target?: (untyped target_type) -> (false | untyped)
end
