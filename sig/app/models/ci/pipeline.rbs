module Ci
  class Pipeline < Ci::ApplicationRecord
    self.@auto_devops_pipelines_completed_total: untyped

    @commit: untyped

    @retried: untyped

    @variables_builder: untyped

    @all_merge_requests: untyped

    @upstream_root: untyped

    # We purposely cast the builds to an Array here. Because we always use the
    # rows if there are more than 0 this prevents us from having to run two
    # queries: one to get the count and one to get the rows.
    @latest_builds_with_artifacts: untyped

    @persistent_ref: untyped

    include Ci::Partitionable

    include Ci::HasStatus

    include Ci::HasCompletionReason

    include Importable

    include AfterCommitQueue

    include Presentable

    include Gitlab::Allowable

    include Gitlab::Utils::StrongMemoize

    include AtomicInternalId

    include Ci::HasRef

    include ShaAttribute

    include FromUnion

    include UpdatedAtFilterable

    include EachBatch

    include FastDestroyAll::Helpers

    include Gitlab::InternalEventsTracking

    MAX_OPEN_MERGE_REQUESTS_REFS: 4

    YAML_ERRORS_MAX_LENGTH: untyped

    MAX_SHA_LENGTH: 64

    MAX_REF_LENGTH: 300

    PROJECT_ROUTE_AND_NAMESPACE_ROUTE: { project: ::Array[:project_feature | :route | { namespace: :route }] }

    DEFAULT_CONFIG_PATH: ".gitlab-ci.yml"

    UNLOCKABLE_STATUSES: untyped

    # UI only shows 100+. TODO: pass constant to UI for SSoT
    COUNT_FAILED_JOBS_LIMIT: 101

    INPUTS_LIMIT: 20

    # Ci::CreatePipelineService returns Ci::Pipeline so this is the only place
    # where we can pass additional information from the service. This accessor
    # is used for storing the processed metadata for linting purposes.
    # There is an open issue to address this:
    # https://gitlab.com/gitlab-org/gitlab/-/issues/259010
    attr_accessor config_metadata: untyped

    # This is used to retain access to the method defined by `Ci::HasRef`
    # before being overridden in this class.
    alias jobs_git_ref git_ref

    def self.find_by_id: (untyped id) -> untyped

    # Returns the pipelines in descending order (= newest first), optionally
    # limited to a number of references.
    #
    # ref - The name (or names) of the branch(es)/tag(s) to limit the list of
    #       pipelines to.
    # sha - The commit SHA (or multiple SHAs) to limit the list of pipelines to.
    # limit - Number of pipelines to return. Chaining with sampling methods (#pick, #take)
    #         will cause unnecessary subqueries.
    def self.newest_first: (?ref: untyped?, ?sha: untyped?, ?limit: untyped?, ?source: untyped?) -> untyped

    def self.newest_without_schedules: (?ref: untyped?, ?sha: untyped?) -> untyped

    def self.latest_status: (?untyped? ref) -> untyped

    def self.latest_successful_for_ref: (untyped ref) -> untyped

    def self.latest_successful_for_sha: (untyped sha) -> untyped

    def self.latest_successful_for_refs: (untyped refs) -> untyped

    def self.latest_pipelines_for_ref_by_statuses: (untyped ref, ?untyped statuses) -> untyped

    def self.latest_running_for_ref: (untyped ref) -> untyped

    def self.latest_failed_for_ref: (untyped ref) -> untyped

    def self.jobs_count_in_alive_pipelines: () -> untyped

    # Returns a Hash containing the latest pipeline for every given
    # commit.
    #
    # The keys of this Hash are the commit SHAs, the values the pipelines.
    #
    # commits - The list of commit SHAs to get the pipelines for.
    # ref - The ref to scope the data to (e.g. "master"). If the ref is not
    #       given we simply get the latest pipelines for the commits, regardless
    #       of what refs the pipelines belong to.
    def self.latest_pipeline_per_commit: (untyped commits, ?untyped? ref) -> untyped

    # Returns a hash containing latest pipeline for each ref which aligns with
    # the sha value. This allows us to look up all of the latest pipelines for
    # a list of refs, ensuring that we are referencing the correct sha. If a
    # pipeline is started for a commit in the history of one of the refs, we
    # will ignore this in favor of the older pipeline for the correct commit.
    #
    # Supplied refs must be uniq, we only return a single pipeline per ref.
    #
    # ref_sha_pairs - An array of ref and a sha pairs
    #           value e.g.
    #           [
    #             ['master', '6b9027b'],
    #             ['dev', '2a207bd']
    #           ]
    def self.latest_pipeline_per_ref: (untyped ref_sha_pairs) -> untyped

    def self.latest_successful_ids_per_project: () -> untyped

    def self.last_finished_for_ref_id: (untyped ci_ref_id) -> untyped

    def self.truncate_sha: (untyped sha) -> untyped

    def self.total_duration: () -> untyped

    def self.internal_sources: () -> untyped

    def self.bridgeable_statuses: () -> untyped

    def self.auto_devops_pipelines_completed_total: () -> untyped

    def self.current_partition_value: () -> untyped

    def self.object_hierarchy: (untyped relation, ?::Hash[untyped, untyped] options) -> untyped

    def self.internal_id_scope_usage: () -> :ci_pipelines

    def self.projects_with_variables: (untyped project_ids, untyped limit) -> untyped

    def self.parse_transition_args: (untyped transition) -> untyped

    def ci_pipeline_statuses_rate_limited?: () -> untyped

    def trigger_status_change_subscriptions: () -> (nil | untyped)

    def uses_needs?: () -> untyped

    def stages_count: () -> untyped

    def total_size: () -> untyped

    def stages_names: () -> untyped

    def ref_status_name: () -> untyped

    def ref_exists?: () -> untyped

    def triggered_pipelines_with_preloads: () -> untyped

    def valid_commit_sha: () -> (untyped | nil)

    def git_author_name: () -> untyped

    def git_author_email: () -> untyped

    def git_author_full_text: () -> untyped

    def git_author_login: () -> untyped

    def git_commit_message: () -> untyped

    def git_commit_title: () -> untyped

    def git_commit_full_title: () -> untyped

    def git_commit_description: () -> untyped

    def git_commit_timestamp: () -> untyped

    def before_sha: () -> untyped

    def short_sha: () -> untyped

    # NOTE: This is loaded lazily and will never be nil, even if the commit
    # cannot be found.
    #
    # Use constructs like: `pipeline.commit.present?`
    def commit: () -> untyped

    def stuck?: () -> untyped

    def retryable?: () -> (false | untyped)

    def archived?: (?log: bool) -> untyped

    def cancelable?: () -> untyped

    def auto_canceled?: () -> untyped

    # rubocop: disable CodeReuse/ServiceClass
    def retry_failed: (untyped current_user) -> untyped

    def lazy_ref_commit: () -> untyped

    def latest?: () -> (false | untyped)

    def retried: () -> untyped

    def coverage: () -> untyped

    def update_builds_coverage: () -> untyped

    def batch_lookup_report_artifact_for_file_type: (untyped file_type) -> untyped

    def batch_lookup_report_artifact_for_file_types: (untyped file_types) -> untyped

    # Returns a Ci::Build relation wrapped in a CTE to force the query planner
    # to use `p_ci_builds_commit_id_status_type_idx` instead of the primary key
    # index. Without the CTE, queries with `ORDER BY id LIMIT 1` (from
    # each_batch) trick the planner into scanning via pkey, causing timeouts.
    # See: https://gitlab.com/gitlab-org/gitlab/-/issues/582836
    def builds_with_cte: () -> untyped

    # This batch loads the latest reports for each CI job artifact
    # type (e.g. sast, dast, etc.) in a single SQL query to eliminate
    # the need to do N different `job_artifacts.where(file_type:
    # X).last` calls.
    #
    # Return a hash of file type => array of 1 job artifact
    def latest_report_artifacts: () -> untyped

    def has_kubernetes_active?: () -> untyped

    def freeze_period?: () -> untyped

    def has_warnings?: () -> untyped

    def number_of_warnings: () -> untyped

    def needs_processing?: () -> untyped

    def has_yaml_errors?: () -> untyped

    def add_error_message: (untyped content) -> untyped

    def add_warning_message: (untyped content) -> untyped

    # Like #drop!, but does not persist the pipeline nor trigger any state
    # machine callbacks.
    def set_failed: (untyped failure_reason) -> untyped

    # We can't use `messages.error` scope here because messages should also be
    # read when the pipeline is not persisted. Using the scope will return no
    # results as it would query persisted data.
    def error_messages: () -> untyped

    def warning_messages: (?limit: untyped?) -> untyped

    # Manually set the notes for a Ci::Pipeline
    # There is no ActiveRecord relation between Ci::Pipeline and notes
    # as they are related to a commit sha. This method helps importing
    # them using the +Gitlab::ImportExport::Project::RelationFactory+ class.
    def notes=: (untyped notes_to_save) -> untyped

    def notes: () -> untyped

    # rubocop: disable Metrics/CyclomaticComplexity -- breaking apart hurts readability
    def set_status: (untyped new_status, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

    def protected_ref?: () -> untyped

    def variables: () -> untyped

    def variables_builder: () -> untyped

    def persisted_variables: () -> untyped

    def queued_duration: () -> (nil | untyped)

    def update_duration: () -> (nil | untyped)

    # All the merge requests for which the current pipeline runs/ran against
    def all_merge_requests: () -> untyped

    def all_merge_requests_by_recency: () -> untyped

    # This returns a list of MRs that point
    # to the same source project/branch
    def related_merge_requests: () -> untyped

    # We cannot use `all_merge_requests`, due to race condition
    # This returns a list of at most 4 open MRs
    def open_merge_requests_refs: () -> untyped

    def same_family_pipeline_ids: () -> untyped

    def build_with_artifacts_in_self_and_project_descendants: (untyped name) -> untyped

    def builds_in_self_and_project_descendants: () -> untyped

    def bridges_in_self_and_project_descendants: () -> untyped

    def jobs_in_self_and_project_descendants: () -> untyped

    def environments_in_self_and_project_descendants: (?deployment_status: untyped?) -> untyped

    # With multi-project and parent-child pipelines
    def self_and_upstreams: () -> untyped

    # With multi-project and parent-child pipelines
    def self_and_downstreams: () -> untyped

    # With multi-project and parent-child pipelines
    def upstream_and_all_downstreams: () -> untyped

    # With only parent-child pipelines
    def self_and_project_ancestors: () -> untyped

    # With only parent-child pipelines
    def self_and_project_descendants: () -> untyped

    # With only parent-child pipelines
    def all_child_pipelines: () -> untyped

    # Follow the parent-child relationships and return the top-level parent
    def root_ancestor: () -> (self | untyped)

    # Follow the upstream pipeline relationships, regardless of multi-project or
    # parent-child, and return the top-level ancestor.
    def upstream_root: () -> untyped

    # Applies to all parent-child and multi-project pipelines
    def complete_hierarchy_count: () -> untyped

    def bridge_triggered?: () -> untyped

    def bridge_waiting?: () -> untyped

    def child?: () -> untyped

    def parent?: () -> untyped

    def created_successfully?: () -> untyped

    def filtered_as_empty?: () -> untyped

    def detailed_status: (untyped current_user) -> untyped

    def find_job_with_archive_artifacts: (untyped name) -> untyped

    def latest_builds_with_artifacts: () -> untyped

    def latest_report_builds: (?untyped reports_scope) -> untyped

    def latest_test_report_builds_in_self_and_project_descendants: () -> untyped

    def latest_test_report_builds: () -> untyped

    def latest_report_builds_in_self_and_project_descendants: (?untyped reports_scope) -> untyped

    # Expired artifacts are still valid if
    # "Keep artifacts from most recent successful jobs" is enabled
    def downloadable_artifacts_in_self_and_project_descendants: () -> untyped

    def builds_with_coverage: () -> untyped

    def builds_with_failed_tests: (?limit: untyped?) -> untyped

    def has_reports?: (untyped reports_scope) -> untyped

    def complete_and_has_reports?: (untyped reports_scope) -> untyped

    def complete_and_has_self_or_descendant_reports?: (untyped reports_scope) -> untyped

    def complete_or_manual_and_has_reports?: (untyped reports_scope) -> untyped

    def has_coverage_reports?: () -> untyped

    def has_codequality_mr_diff_report?: () -> untyped

    def can_generate_codequality_reports?: () -> untyped

    def test_report_summary: () -> untyped

    def test_reports: () -> untyped

    def accessibility_reports: () -> untyped

    def codequality_reports: () -> untyped

    def terraform_reports: () -> untyped

    def has_archive_artifacts?: () -> untyped

    def has_exposed_artifacts?: () -> untyped

    def has_erasable_artifacts?: () -> untyped

    def branch_updated?: () -> untyped

    # Returns the modified paths, the results are subject to
    # https://docs.gitlab.com/user/gitlab_com/#diff-display-limits
    # See #changed_paths for a similar method that returns all
    # changes, regardless of the diff display limits.
    #
    # The returned value is
    # * Array: List of modified paths that should be evaluated
    # * nil: Modified path can not be evaluated
    def modified_paths: () -> untyped

    def modified_paths_since: (untyped compare_to_sha) -> untyped

    # Returns the changed paths from Gitaly ChangedPaths RPC.
    # This method is similar to #modified_paths, but the results
    # are not subject to the diff display limits. This method is
    # thus suited well for use in e.g. `rules:changes:`, when
    # needing to make decisions based on the complete changeset.
    #
    # The returned value is
    # * Array: List of Gitlab::Git::ChangedPath objects
    # * empty list: No paths were changed
    def changed_paths: () -> untyped

    def all_worktree_paths: () -> untyped

    def top_level_worktree_paths: () -> untyped

    def default_branch?: () -> untyped

    def merge_request?: () -> untyped

    def workload?: () -> untyped

    def merge_request_from_forked_project?: () -> untyped

    def external_pull_request?: () -> untyped

    def detached_merge_request_pipeline?: () -> untyped

    def legacy_detached_merge_request_pipeline?: () -> untyped

    def merged_result_pipeline?: () -> untyped

    def tag_pipeline?: () -> untyped

    def type: () -> ("merge_train" | "merged_result" | "merge_request" | "tag" | "branch")

    def merge_request_ref?: () -> untyped

    def full_ref_path: () -> (untyped | ::String | untyped | ::String)

    def matches_sha_or_source_sha?: (untyped sha) -> untyped

    def triggered_by?: (untyped current_user) -> untyped

    def source_ref: () -> untyped

    def source_ref_slug: () -> untyped

    def stage: (untyped name) -> untyped

    def full_error_messages: () -> (untyped | "")

    def merge_request_event_type: () -> (nil | untyped)

    def persistent_ref: () -> untyped

    def dangling?: () -> untyped

    def only_workload_variables?: () -> untyped

    def source_ref_path: () -> (untyped | untyped | untyped | nil)

    def ci_config_ref_uri: () -> ::String

    # Set scheduling type of processables if they were created before scheduling_type
    # data was deployed (https://gitlab.com/gitlab-org/gitlab/-/merge_requests/22246).
    def ensure_scheduling_type!: () -> untyped

    def ensure_ci_ref!: () -> untyped

    def ensure_persistent_ref: () -> untyped

    # For dependent bridge jobs we reset the upstream bridge recursively
    # to reflect that a downstream pipeline is running again
    def reset_source_bridge!: (untyped current_user) -> (nil | untyped)

    # EE-only
    def merge_train_pipeline?: () -> false

    def build_matchers: () -> untyped

    def cluster_agent_authorizations: () -> untyped

    def has_test_reports?: () -> untyped

    def age_in_minutes: () -> (0 | untyped)

    def merge_request_diff: () -> (nil | untyped)

    def auto_cancel_on_job_failure: () -> untyped

    def auto_cancel_on_new_commit: () -> untyped

    def cancel_async_on_job_failure: () -> untyped

    def merge_request_diff_sha: () -> (nil | untyped)

    private

    # rubocop: disable CodeReuse/ServiceClass -- mirrors FastDestroyAll pattern used by Ci::JobArtifact
    def destroy_job_artifact_associations: () -> untyped

    def add_message: (untyped severity, untyped content) -> untyped

    def push_details: () -> untyped

    def git_ref: () -> untyped

    def keep_around_commits: () -> (nil | untyped)

    def observe_age_in_minutes: () -> (nil | untyped)

    def latest_builds_report_results_in_self_and_descendants: () -> untyped

    def age_metric_enabled?: () -> untyped

    # Without using `unscoped`, caller scope is also included into the query.
    # Using `unscoped` here will be redundant after Rails 6.1
    def object_hierarchy: (?::Hash[untyped, untyped] options) -> untyped

    def pipelines_from_hierarchy: (untyped relation, ?except: untyped) -> untyped

    def internal_pipeline?: () -> untyped

    def track_ci_pipeline_created_event: () -> untyped

    def protected_for_merge_request?: () -> untyped

    def read_variables_from_pipeline_artifact: () -> (nil | untyped)

    def in_pipelines_and_partitions: (untyped scope, untyped pipelines) -> untyped
  end
end
