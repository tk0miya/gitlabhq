module Ci
  module Preloaders
    class RunnerManagerPolicyPreloader
      @runner_managers: untyped

      @current_user: untyped

      def initialize: (untyped runner_managers, untyped current_user) -> void

      def execute: () -> (nil | untyped)

      private

      attr_reader runner_managers: untyped

      attr_reader current_user: untyped
    end
  end
end
