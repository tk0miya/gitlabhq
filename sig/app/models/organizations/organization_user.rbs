module Organizations
  class OrganizationUser < ApplicationRecord
    @other_owners: untyped

    include ActiveModel::Dirty

    def self.update_home_organization_record_for: (untyped user, user_is_admin: untyped) -> untyped

    def self.home_organization_access_level: (?user_is_admin: bool) -> (:owner | :default)

    def self.create_organization_record_for: (untyped user_id, untyped organization_id) -> untyped

    def last_owner?: () -> (false | untyped)

    private

    def other_owners: () -> untyped

    def ensure_user_has_an_organization: () -> (nil | untyped)

    def last_owner_access_level_change: () -> (nil | untyped)
  end
end
