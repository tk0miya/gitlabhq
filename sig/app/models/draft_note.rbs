# frozen_string_literal: true
class DraftNote < ApplicationRecord
  @commit: untyped

  include DiffPositionableNote

  include Gitlab::Utils::StrongMemoize

  include Sortable

  include ShaAttribute

  include BulkInsertSafe

  PUBLISH_ATTRS: ::Array[:noteable | :type | :note | :internal]

  DIFF_ATTRS: ::Array[:position | :original_position | :change_position | :commit_id]

  # Attribute used to store quick actions changes and users referenced.
  attr_accessor commands_changes: untyped

  attr_accessor users_referenced: untyped

  attr_accessor suggestions: untyped

  attr_accessor review: untyped

  # Text with quick actions filtered out
  attr_accessor rendered_note: untyped

  def self.positions: () -> untyped

  def self.bulk_insert_and_keep_commits!: (untyped items, **untyped options) -> untyped

  def self.keep_commits_for_records: (untyped records) -> untyped

  # noteable_id and noteable_type methods
  # are used to generate discussion_id on Discussion.discussion_id
  def noteable_id: () -> untyped

  def noteable: () -> untyped

  def noteable_type: () -> "MergeRequest"

  def for_commit?: () -> false

  def importing?: () -> false

  def resolvable?: () -> false

  def emoji_awardable?: () -> false

  def on_diff?: () -> untyped

  def type: () -> (untyped | "DiffNote" | "DiscussionNote")

  def references: () -> { users: untyped, commands: untyped }

  def line_code: () -> untyped

  def find_line_code: () -> untyped

  def publish_params: () -> untyped

  def self.preload_author: (untyped draft_notes) -> untyped

  def diff_file: () -> untyped

  def commit: () -> (untyped | nil)

  private

  def valid_commit_id: () -> (nil | untyped)

  def set_project: () -> untyped
end
