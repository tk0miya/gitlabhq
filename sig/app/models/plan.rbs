class Plan < ApplicationRecord
  DEFAULT: "default"

  ALL_PLANS: ::Array[untyped]

  DEFAULT_PLANS: ::Array[untyped]

  PLAN_NAME_UID_LIST: { default: 1, free: 2, bronze: 3, silver: 4, premium: 5, gold: 6, ultimate: 7, ultimate_trial: 8, premium_trial: 9, ultimate_trial_paid_customer: 10, opensource: 11, early_adopter: 12 }

  # This always returns an object
  def self.default: () -> untyped

  def self.all_plans: () -> untyped

  def self.default_plans: () -> untyped

  def self.uids_for_names: (untyped names) -> untyped

  # rubocop: disable Database/AvoidUsingPluckWithoutLimit -- This method is prepared for manual usage in
  # Rails console on SaaS. Using pluck without limit in this case should be enough safe.
  def self.names_for_ids: (untyped plan_ids) -> untyped

  # rubocop: disable Database/AvoidUsingPluckWithoutLimit -- This method is prepared for manual usage in
  # Rails console on SaaS. Using pluck without limit in this case should be enough safe.
  def self.ids_for_plan_name_uids: (untyped uids) -> untyped

  def actual_limits: () -> untyped

  def default?: () -> untyped

  def paid?: () -> false

  def ultimate_or_ultimate_trial_plans?: () -> false

  private

  def set_plan_name_uid: () -> (nil | untyped)
end
