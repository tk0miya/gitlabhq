class ProjectCiCdSetting < ApplicationRecord
  include ChronicDurationAttribute

  include EachBatch

  DEFAULT_GIT_DEPTH: 20

  NO_ONE_ALLOWED_ROLE: 1

  DEVELOPER_ROLE: 2

  MAINTAINER_ROLE: 3

  OWNER_ROLE: 4

  PIPELINE_VARIABLES_OVERRIDE_ROLES: { no_one_allowed: untyped, developer: untyped, maintainer: untyped, owner: untyped }

  PRIVILEGED_PIPELINE_VARIABLES_ROLES: ::Array["owner" | "no_one_allowed"]

  ALLOWED_SUB_CLAIM_COMPONENTS: ::Array["project_path" | "ref_type" | "ref" | "ref_protected" | "environment_protected" | "deployment_tier"]

  def self.pluck_project_id: (untyped limit) -> untyped

  def self.bulk_restrict_pipeline_variables!: (project_ids: untyped) -> untyped

  def self.project_ids_not_using_variables: (untyped settings_relation, untyped limit) -> untyped

  def keep_latest_artifacts_available?: () -> untyped

  def pipeline_override_role_privileged?: () -> untyped

  def override_pipeline_variables_allowed?: (untyped role_access_level, untyped user) -> (true | false | untyped)

  def restrict_user_defined_variables=: (untyped value) -> (nil | untyped)

  def restrict_user_defined_variables?: () -> untyped

  private

  def set_pipeline_variables_secure_defaults: () -> untyped

  def role_map_pipeline_variables_minimum_override_role: () -> ::Hash[untyped, untyped]

  def set_default_git_depth: () -> untyped

  def validate_sub_claim_components: () -> untyped
end
