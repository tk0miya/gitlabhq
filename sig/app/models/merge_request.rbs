class MergeRequest < ApplicationRecord
  self.@reference_pattern: untyped

  self.@link_reference_pattern: untyped

  @context_commits: untyped

  @target_branch_sha: untyped

  @merge_event: untyped

  @closed_event: untyped

  @merge_commit: untyped

  @squash_commit: untyped

  extend Gitlab::Cache::RequestCache

  include AtomicInternalId

  include IidRoutes

  include Issuable

  include Noteable

  include Referable

  include Presentable

  include TimeTrackable

  include ManualInverseAssociation

  include EachBatch

  include ThrottledTouch

  include Gitlab::Utils::StrongMemoize

  include LabelEventable

  include ReactiveCaching

  include FromUnion

  include DeprecatedAssignee

  include ShaAttribute

  include MilestoneEventable

  include StateEventable

  include Approvable

  include IdInOrdered

  include Todoable

  include Spammable

  extend ::Gitlab::Utils::Override

  SORTING_PREFERENCE_FIELD: :merge_requests_sort

  CI_MERGE_REQUEST_DESCRIPTION_MAX_LENGTH: 2700

  MERGE_LEASE_TIMEOUT: untyped

  # method overridden in EE
  def suggested_reviewer_users: () -> untyped

  # This is the same as latest_merge_request_diff unless:
  # 1. There are arguments - in which case we might be trying to force-reload.
  # 2. This association is already loaded.
  # 3. The latest diff does not exist.
  # 4. It doesn't have any merge_request_diffs - it returns an empty MergeRequestDiff
  #
  # The second one in particular is important - MergeRequestDiff#merge_request
  # is the inverse of MergeRequest#merge_request_diff, which means it may not be
  # the latest diff, because we could have loaded any diff from this particular
  # MR. If we haven't already loaded a diff, then it's fine to load the latest.
  def merge_request_diff: () -> untyped

  KNOWN_MERGE_PARAMS: ::Array[:auto_merge_strategy | :should_remove_source_branch | :force_remove_source_branch | :commit_message | :squash_commit_message | :sha | :skip_ci]

  # When this attribute is true some MR validation is ignored
  # It allows us to close or modify broken merge requests
  attr_accessor allow_broken: untyped

  # When this attribute is true some MR validation is ignored
  # It allows us to close or modify broken merge requests
  attr_accessor skip_branch_existence_check: untyped

  # Temporary flag to skip merge_request_diff creation on create.
  # See https://gitlab.com/gitlab-org/gitlab/-/merge_requests/100390
  attr_accessor skip_ensure_merge_request_diff: untyped

  # Temporary fields to store compare vars
  # when creating new merge request
  attr_accessor can_be_created: untyped

  # Temporary fields to store compare vars
  # when creating new merge request
  attr_accessor compare_commits: untyped

  # Temporary fields to store compare vars
  # when creating new merge request
  attr_accessor diff_options: untyped

  # Temporary fields to store compare vars
  # when creating new merge request
  attr_accessor compare: untyped

  # Flag to skip triggering mergeRequestMergeStatusUpdated GraphQL subscription.
  attr_accessor skip_merge_status_trigger: untyped

  # Keep states definition to be evaluated before the state_machine block to
  #   avoid spec failures. If this gets evaluated after, the `merged` and `locked`
  #   states (which are overridden) can be nil.
  #
  def self.available_state_names: () -> untyped

  # NOTE: Batch transition merge_status to unchecked/cannot_be_merged_recheck.
  # This bypasses state machine callbacks for performance but mimics their behavior.
  #
  # Transitions mirror the `mark_as_unchecked` event defined above.
  # Process batch updates in batches as there can be many target merge requests.
  def self.batch_mark_as_unchecked: (untyped mr_ids, ?mrs_to_trigger: untyped, ?batch_size: ::Integer) -> (nil | untyped)

  # NOTE: Batch transition merge_status to checking/cannot_be_merged_rechecking.
  # This bypasses state machine callbacks for performance but mimics their behavior.
  #
  # Transitions mirror the `mark_as_checking` event defined above.
  def self.batch_mark_as_checking: (untyped mr_ids, ?batch_size: ::Integer) -> (nil | untyped)

  def self.batch_clear_merge_error: (untyped mr_ids, ?batch_size: ::Integer) -> (nil | untyped)

  # Returns current merge_status except it returns `cannot_be_merged_rechecking` as `checking`
  # to avoid exposing unnecessary internal state
  def public_merge_status: () -> ("checking" | untyped)

  def self.total_time_to_merge: () -> untyped

  alias project target_project

  alias project= target_project=

  alias issuing_parent target_project

  RebaseLockTimeout: untyped

  def self.reference_prefix: () -> "!"

  def self.order_by_metric_column: (untyped metric, untyped direction) -> untyped

  # Returns the top 100 target branches
  #
  # The returned value is a Array containing branch names
  # sort by updated_at of merge request:
  #
  #     ['master', 'develop', 'production']
  #
  # limit - The maximum number of target branch to return.
  def self.recent_target_branches: (?limit: ::Integer) -> untyped

  def self.recent_source_branches: (?limit: ::Integer) -> untyped

  def self.distinct_source_branches: () -> untyped

  def self.sort_by_attribute: (untyped method, ?excluded_labels: untyped) -> untyped

  def self.reviewers_subquery: () -> untyped

  def rebase_in_progress?: () -> untyped

  def permits_force_push?: () -> (true | untyped)

  # Use this method whenever you need to make sure the head_pipeline is synced with the
  # branch head commit, for example checking if a merge request can be merged.
  # For more information check: https://gitlab.com/gitlab-org/gitlab-foss/issues/40004
  def diff_head_pipeline: () -> (untyped | nil)

  def merge_pipeline: () -> (untyped | nil)

  def diff_head_pipeline_success?: () -> untyped

  # Pattern used to extract `!123` merge request references from text
  #
  # This pattern supports cross-project references.
  def self.reference_pattern: () -> untyped

  def self.link_reference_pattern: () -> untyped

  def self.reference_valid?: (untyped reference) -> untyped

  def self.project_foreign_key: () -> "target_project_id"

  # Returns all the merge requests from an ActiveRecord:Relation.
  #
  # This method uses a UNION as it usually operates on the result of
  # ProjectsFinder#execute. PostgreSQL in particular doesn't always like queries
  # using multiple sub-queries especially when combined with an OR statement.
  # UNIONs on the other hand perform much better in these cases.
  #
  # relation - An ActiveRecord::Relation that returns a list of Projects.
  #
  # Returns an ActiveRecord::Relation.
  def self.in_projects: (untyped relation) -> untyped

  # This is used after project import, to reset the IDs to the correct
  # values. It is not intended to be called without having already scoped the
  # relation.
  #
  # Only set `regular` merge request diffs as latest so `merge_head` diff
  # won't be considered as `MergeRequest#merge_request_diff`.
  def self.set_latest_merge_request_diff_ids!: () -> untyped

  DRAFT_REGEX: ::Regexp

  def self.draft?: (untyped title) -> untyped

  def self.draftless_title: (untyped title) -> untyped

  def self.draft_title: (untyped title) -> (untyped | ::String)

  alias self.work_in_progress? self.draft?

  alias self.wipless_title self.draftless_title

  alias self.wip_title self.draft_title

  def self.participant_includes: () -> untyped

