  def commits_count: () -> (untyped | untyped | 0)

  def commit_shas: (?limit: untyped?, ?bypass_preloaded: bool) -> untyped

  def supports_suggestion?: () -> true

  def supports_lock_on_merge?: () -> (false | untyped)

  # Calls `MergeWorker` to proceed with the merge process and
