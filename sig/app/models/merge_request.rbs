  def skipped_auto_merge_checks: (?::Hash[untyped, untyped] options) -> { skip_ci_check: untyped, skip_approved_check: untyped, skip_conflict_check: untyped, skip_draft_check: untyped, skip_blocked_check: untyped, skip_discussions_check: untyped, skip_external_status_check: untyped, skip_requested_changes_check: untyped, skip_locked_paths_check: untyped, skip_jira_check: untyped, skip_locked_lfs_files_check: untyped, skip_security_policy_check: untyped, skip_security_policy_pipeline_check: untyped, skip_merge_time_check: untyped, skip_merge_request_title_check: untyped }

  # Checks whether the merge request is eligible for auto-merge with the given strategy.
  # Unlike `mergeable?`, this skips checks that the auto-merge process will re-evaluate
  # later (e.g., CI status, approvals, discussions), focusing only on preconditions that
  # must be met to accept the auto-merge request.
  def auto_merge_eligible?: (strategy: untyped, ?check_mergeability_retry_lease: bool, ?use_cache: bool) -> untyped

  # mergeable_state_check_params allows a hash of merge checks to skip or not
  # skip_ci_check
  # skip_conflict_check
  # skip_discussions_check
  # skip_draft_check
  # skip_approved_check
  # skip_blocked_check
  # skip_external_status_check
  # skip_requested_changes_check
  # skip_locked_paths_check
  # skip_jira_check
  # skip_locked_lfs_files_check
  def mergeable?: (?check_mergeability_retry_lease: bool, ?skip_rebase_check: bool, ?skip_conflict_check: bool, ?use_cache: bool, **untyped mergeable_state_check_params) -> (false | untyped)

  def self.mergeable_state_checks: () -> untyped

  # Checks grouped by cost tier for fail-fast optimization.
  # EE prepends additional checks into each tier via override.
  # Tiers are executed in order: cheapest first, so we can
  # fail fast before running the more expensive ones.
  # Checks within each tier are ordered by P99 latency ascending.
  #
  # Thresholds based on production P99 latency:
  # - trivial: P99 < 0.005s
  # - light:   P99 0.005s - 0.019s
  # - heavy:   P99 >= 0.020s
  def self.mergeable_state_checks_by_tier: () -> { trivial: ::Array[untyped], light: ::Array[untyped], heavy: ::Array[untyped] }

  def self.mergeable_git_state_checks: () -> ::Array[untyped]

  def self.all_mergeability_checks: () -> untyped

  # mergeable_state_check_params allows a hash of merge checks to skip or not
  # skip_ci_check
  # skip_discussions_check
  # skip_draft_check
  # skip_approved_check
  # skip_blocked_check
  # skip_external_status_check
  # skip_requested_changes_check
  # skip_jira_check
  def mergeable_state?: (?use_cache: bool, **untyped params) -> untyped

  # This runs only git related checks
  def mergeable_git_state?: (?use_cache: bool, **untyped params) -> untyped

  # This runs all the checks
  def mergeability_checks_pass?: (**untyped params) -> untyped

  def all_mergeability_checks_results: () -> untyped

