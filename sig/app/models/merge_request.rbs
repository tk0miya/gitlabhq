  def committers: (?with_merge_commits: bool, ?lazy: bool, ?include_author_when_signed: bool) -> untyped

  def committer_ids_to_filter_from_approvers: () -> untyped

  def committers_to_filter_from_approvers: () -> untyped

  # Verifies if title has changed not taking into account Draft prefix
