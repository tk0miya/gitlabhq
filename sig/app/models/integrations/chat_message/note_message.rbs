module Integrations
  module ChatMessage
    class NoteMessage < BaseMessage
      @note: untyped

      @note_url: untyped

      @target: untyped

      @title: untyped

      attr_reader note: untyped

      attr_reader note_url: untyped

      attr_reader title: untyped

      attr_reader target: untyped

      def initialize: (untyped params) -> void

      def attachments: () -> untyped

      def activity: () -> { title: ::String, subtitle: ::String, text: untyped, image: untyped }

      private

      def message: () -> ::String

      def format_title: (untyped title) -> untyped

      def formatted_title: () -> untyped

      def create_issue_note: (untyped issue) -> ::Array[::String | untyped]

      def create_commit_note: (untyped commit) -> ::Array[::String | untyped]

      def create_merge_note: (untyped merge_request) -> ::Array[::String | untyped]

      def create_snippet_note: (untyped snippet) -> ::Array[::String | untyped]

      def description_message: () -> ::Array[{ text: untyped, color: untyped }]

      def project_link: () -> untyped
    end
  end
end
