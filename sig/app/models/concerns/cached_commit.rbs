module CachedCommit
  extend ActiveSupport::Concern

  def to_hash: (?exclude_keys: untyped) -> untyped

  # We don't save these, because they would need a table or a serialized
  # field. They aren't used anywhere, so just pretend the commit has no parents.
  def parent_ids: () -> ::Array[untyped]

  # These are not saved
  def referenced_by: () -> ::Array[untyped]

  def extended_trailers: () -> ::Hash[untyped, untyped]
end
