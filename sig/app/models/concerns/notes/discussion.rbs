module Notes
  module Discussion
    @discussion: untyped

    extend ActiveSupport::Concern

    include Gitlab::Utils::StrongMemoize

    def ensure_discussion_id: () -> (nil | untyped)

    def derive_discussion_id: () -> untyped

    # See `Discussion.override_discussion_id` for details.
    def discussion_id: (?untyped? noteable) -> untyped

    # Returns a discussion containing just this note.
    # This method exists as an alternative to `#discussion` to use when the methods
    # we intend to call on the Discussion object don't require it to have all of its notes,
    # and just depend on the first note or the type of discussion. This saves us a DB query.
    def to_discussion: (?untyped? noteable) -> untyped

    # Set the discussion manually.
    # This is used to setup the inverse relationship between the note and its discussion
    def discussion=: (untyped discussion) -> untyped

    # Returns the entire discussion this note is part of.
    # Consider using `#to_discussion` if we do not need to render the discussion
    # and all its notes and if we don't care about the discussion's resolvability status.
    def discussion: () -> untyped

    def start_of_discussion?: () -> untyped

    def part_of_discussion?: () -> untyped

    def discussion_class: (?untyped? other_noteable) -> untyped

    def in_reply_to?: (untyped other) -> untyped

    private

    def current_noteable?: (untyped other_noteable) -> untyped
  end
end
