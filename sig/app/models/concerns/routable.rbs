# Store object full path in separate table for easy lookup and uniq validation
# Object must have name and path db fields and respond to parent and parent_changed? methods.
module Routable
  extend ActiveSupport::Concern

  include CaseSensitivity

  def self.find_by_full_path: (untyped path, ?follow_redirects: bool, ?route_scope: untyped?) -> (nil | untyped)

  def full_name: () -> untyped

  def full_path: () -> untyped

  def full_path_components: () -> untyped

  def build_full_path: () -> (::String | untyped)

  # Group would override this to check from association
  def owned_by?: (untyped user) -> untyped

  private

  # rubocop: disable GitlabSecurity/PublicSend
  def full_attribute: (untyped attribute) -> untyped

  def set_path_errors: () -> untyped

  def full_name_changed?: () -> untyped

  def full_path_changed?: () -> untyped

  def build_full_name: () -> (::String | untyped)

  def prepare_route: () -> (nil | untyped)
end
