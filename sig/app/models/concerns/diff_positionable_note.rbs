module DiffPositionableNote
  extend ActiveSupport::Concern

  include Gitlab::Utils::StrongMemoize

  def should_update_position?: () -> untyped

  def on_text?: () -> untyped

  def on_file?: () -> untyped

  def on_image?: () -> untyped

  def supported?: () -> untyped

  def active?: (?untyped? diff_refs) -> (false | true | untyped)

  def set_original_position: () -> (nil | untyped)

  def update_position: () -> (nil | untyped)

  def diff_refs_match_commit: () -> (nil | untyped)

  def sync_keep_around_commits: () -> (nil | untyped)

  def enqueue_keep_around_commits: () -> (nil | untyped)

  def keep_around_commits: () -> untyped

  def repository: () -> untyped

  def async_keep_around_refs?: () -> untyped

  def shas: () -> untyped
end
