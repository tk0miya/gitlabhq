# The BulkImport::Entity represents a Group or Project to be imported during the
# bulk import process. An entity is nested under the parent group when it is not
# a top level group.
#
# A full bulk import entity structure might look like this, where the links are
# parents:
#
#          **Before Import**              **After Import**
#
#             GroupEntity                      Group
#              |      |                        |   |
#     GroupEntity   ProjectEntity          Group   Project
#          |                                 |
#    ProjectEntity                        Project
#
# The tree structure of the entities results in the same structure for imported
# Groups and Projects.
class BulkImports::Entity < ApplicationRecord
  @source_version: untyped

  include AfterCommitQueue

  include Gitlab::Utils::StrongMemoize

  GROUP_ENTITY_SOURCE_TYPE: "group_entity"

  PROJECT_ENTITY_SOURCE_TYPE: "project_entity"

  FailedError: untyped

  def self.all_human_statuses: () -> untyped

  def encoded_source_full_path: () -> untyped

  def pipelines: () -> untyped

  def pipeline_exists?: (untyped name) -> untyped

  def entity_type: () -> untyped

  def pluralized_name: () -> untyped

  def portable_class: () -> untyped

  def base_resource_url_path: () -> ::String

  def base_xid_resource_url_path: () -> ::String

  def base_resource_path: () -> untyped

  def export_relations_url_path_base: () -> untyped

  def export_relations_url_path: () -> untyped

  def relation_download_url_path: (untyped relation, ?untyped? batch_number) -> untyped

  def wikis_url_path: () -> ::String

  def project?: () -> untyped

  def group?: () -> untyped

  def update_service: () -> untyped

  def full_path: () -> untyped

  def full_path_with_fallback: () -> untyped

  def default_visibility_level: () -> untyped

  def update_has_failures: () -> (nil | untyped)

  def source_version: () -> untyped

  def checksums: () -> untyped

  def propagate_cancel: () -> untyped

  private

  def validate_parent_is_a_group: () -> (untyped | nil)

  def validate_imported_entity_type: () -> untyped

  def validate_destination_namespace_ascendency: () -> (nil | untyped)

  def validate_source_full_path_format: () -> (nil | untyped)

  def validate_bulk_import_organization_matches: () -> (nil | untyped)
end
