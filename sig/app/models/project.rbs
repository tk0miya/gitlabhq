  MAX_MERGE_REQUEST_TITLE_REGEX: 255

  MAX_MERGE_REQUEST_TITLE_REGEX_DESCRIPTION: 255

  INSTANCE_RUNNER_RUNNING_JOBS_MAX_BUCKET: 5

  DEFAULT_MERGE_COMMIT_TEMPLATE: untyped

  DEFAULT_SQUASH_COMMIT_TEMPLATE: "%{title}"

