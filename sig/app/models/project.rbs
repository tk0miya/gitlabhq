  # 1: repository
  # 2: attachments
  LATEST_STORAGE_VERSION: 2

  HASHED_STORAGE_FEATURES: { repository: 1, attachments: 2 }

  VALID_IMPORT_PORTS: ::Array[80 | 443]

  VALID_IMPORT_PROTOCOLS: ::Array["http" | "https" | "git"]

  VALID_MIRROR_PORTS: ::Array[22 | 80 | 443]

