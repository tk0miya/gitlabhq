class IssuableSeverity < ApplicationRecord
  DEFAULT: "unknown"

  SEVERITY_LABELS: { unknown: "Unknown", low: "Low - S4", medium: "Medium - S3", high: "High - S2", critical: "Critical - S1" }

  SEVERITY_QUICK_ACTION_PARAMS: { unknown: ::Array["Unknown" | "0"], low: ::Array["Low" | "S4" | "4"], medium: ::Array["Medium" | "S3" | "3"], high: ::Array["High" | "S2" | "2"], critical: ::Array["Critical" | "S1" | "1"] }
end
