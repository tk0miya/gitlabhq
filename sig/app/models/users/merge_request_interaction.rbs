module Users
  class MergeRequestInteraction
    @user: untyped

    @merge_request: untyped

    @current_user: untyped

    @reviewer: untyped

    def initialize: (user: untyped, merge_request: untyped, ?current_user: untyped?) -> void

    def declarative_policy_subject: () -> untyped

    def can_merge?: () -> untyped

    def can_update?: () -> untyped

    def review_state: () -> untyped

    def reviewed?: () -> untyped

    def approved?: () -> untyped

    private

    def reviewer: () -> untyped

    attr_reader user: untyped

    attr_reader merge_request: untyped

    attr_reader current_user: untyped
  end
end
