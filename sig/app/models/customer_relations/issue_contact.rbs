class CustomerRelations::IssueContact < ApplicationRecord
  include EachBatch

  BATCH_DELETE_SIZE: 1000

  def self.find_contact_ids_by_emails: (untyped issue_id, untyped emails) -> untyped

  def self.delete_for_project: (untyped project_id) -> untyped

  def self.delete_for_group: (untyped group) -> untyped

  private

  def contact_belongs_to_crm_group: () -> (nil | untyped)
end
