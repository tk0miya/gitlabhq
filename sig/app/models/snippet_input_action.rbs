class SnippetInputAction
  @action: untyped

  @previous_path: untyped

  @file_path: untyped

  @content: untyped

  @allowed_actions: untyped

  include ActiveModel::Validations

  ACTIONS: ::Array[:create | :update | :delete | :move]

  attr_reader action: untyped

  attr_reader previous_path: untyped

  attr_reader file_path: untyped

  attr_reader content: untyped

  def initialize: (?action: untyped?, ?previous_path: untyped?, ?file_path: untyped?, ?content: untyped?, ?allowed_actions: untyped?) -> void

  def to_commit_action: () -> { action: untyped, previous_path: untyped, file_path: untyped, content: untyped }

  private

  def build_previous_path: () -> untyped

  def ensure_same_file_path_and_previous_path: () -> (nil | untyped)

  def ensure_different_file_path_and_previous_path: () -> (nil | untyped)

  def ensure_allowed_action: () -> (nil | untyped)
end
