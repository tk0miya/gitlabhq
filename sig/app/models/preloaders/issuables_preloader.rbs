module Preloaders
  class IssuablesPreloader
    @projects: untyped

    @current_user: untyped

    @associations: untyped

    attr_reader projects: untyped

    attr_reader current_user: untyped

    attr_reader associations: untyped

    def initialize: (untyped nodes, untyped current_user, untyped associations) -> void

    def preload_all: () -> untyped
  end
end
