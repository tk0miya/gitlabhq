module Preloaders
  module Projects
    class NotesPreloader
      @project: untyped

      @current_user: untyped

      include RendersNotes

      def initialize: (untyped project, untyped current_user) -> void

      def call: (untyped notes) -> untyped

      private

      attr_reader current_user: untyped
    end
  end
end
