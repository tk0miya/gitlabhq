class Repository
  @full_path: untyped

  @shard: untyped

  @disk_path: untyped

  @container: untyped

  @commit_cache: untyped

  @repo_type: untyped

  @raw_repository: untyped

  @path_to_repo: untyped

  @tags: untyped

  @tag_names_include: untyped

  @local_branches: untyped

  @branch_exists_memo: untyped

  @branch_names_include: untyped

  @head_commit: untyped

  @head_tree: untyped

  @root_ref_sha: untyped

  @submodule_links: untyped

  @cache: untyped

  @redis_set_cache: untyped

  @redis_hash_cache: untyped

  @request_store_cache: untyped

  REF_MERGE_REQUEST: "merge-requests"

  REF_KEEP_AROUND: "keep-around"

  REF_ENVIRONMENTS: "environments"

  REF_PIPELINES: "pipelines"

  REF_TMP: "tmp"

  REF_WORKLOADS: "workloads"

  ARCHIVE_CACHE_TIME: 60

  ARCHIVE_CACHE_TIME_IMMUTABLE: 3600

  RESERVED_REFS_NAMES: ::Array["heads" | "tags" | "replace" | ::String]

  FORMAT_SHA1: "sha1"

  FORMAT_SHA256: "sha256"

  include Gitlab::RepositoryCacheAdapter

  attr_accessor full_path: untyped

  attr_accessor shard: untyped

  attr_accessor disk_path: untyped

  attr_accessor container: untyped

  attr_accessor repo_type: untyped

  CreateTreeError: untyped

  AmbiguousRefError: untyped

  # Methods that cache data from the Git repository.
  #
  # Each entry in this Array should have a corresponding method with the exact
  # same name. The cache key used by those methods must also match method's
  # name.
  #
  # For example, for entry `:commit_count` there's a method called `commit_count` which
  # stores its data in the `commit_count` cache key.
  CACHED_METHODS: ::Array[:size | :recent_objects_size | :commit_count | :readme_path | :contribution_guide | :changelog | :license_blob | :license_gitaly | :gitignore | :branch_names | :tag_names | :branch_count | :tag_count | :avatar | :exists? | :root_ref | :merged_branch_names | :has_visible_content? | :issue_template_names_hash | :merge_request_template_names_hash | :xcode_project? | :has_ambiguous_refs?]

  # Certain method caches should be refreshed when certain types of files are
  # changed. This Hash maps file types (as returned by Gitlab::FileDetector) to
  # the corresponding methods to call for refreshing caches.
  METHOD_CACHES_FOR_FILE_TYPES: { readme: ::Array[:readme_path], changelog: :changelog, license: ::Array[:license_blob | :license_gitaly], contributing: :contribution_guide, gitignore: :gitignore, avatar: :avatar, issue_template: :issue_template_names_hash, merge_request_template: :merge_request_template_names_hash, xcode_config: :xcode_project? }

  def initialize: (untyped full_path, untyped container, shard: untyped, ?disk_path: untyped?, ?repo_type: untyped) -> void

  def ==: (untyped other) -> untyped

  alias eql? ==

  def hash: () -> untyped

  def raw_repository: () -> (nil | untyped)

  alias raw raw_repository

  def flipper_id: () -> untyped

  # Don't use this! It's going away. Use Gitaly to read or write from repos.
  def path_to_repo: () -> untyped

  def inspect: () -> ::String

  def commit: (?untyped? ref) -> (nil | untyped)

  # Finding a commit by the passed SHA
  # Also takes care of caching, based on the SHA
  def commit_by: (oid: untyped) -> untyped

  def commits_by: (oids: untyped) -> (::Array[untyped] | untyped)

  def commits: (?untyped? ref, ?::Hash[untyped, untyped] opts) -> untyped

  def commits_between: (untyped from, untyped to, ?limit: untyped?) -> untyped

  # Returns a list of commits that are not present in any reference
  def new_commits: (untyped newrev) -> untyped

  # Gitaly migration: https://gitlab.com/gitlab-org/gitaly/issues/384
  def find_commits_by_message: (untyped query, ?untyped? ref, ?untyped? path, ?::Integer limit, ?::Integer offset) -> (::Array[untyped] | untyped)

  def list_commits: (ref: untyped, ?query: untyped?, ?author: untyped?, ?path: untyped?, ?committed_before: untyped?, ?committed_after: untyped?, ?pagination_params: ::Hash[untyped, untyped], ?literal_pathspec: bool) -> untyped

  def find_branch: (untyped name) -> untyped

  def find_tag: (untyped name) -> untyped

  def ambiguous_ref?: (untyped ref) -> untyped

  # It's possible for a tag name to be a prefix (including slash) of a branch
  # name, or vice versa. For instance, a tag named `foo` means we can't create a
  # tag `foo/bar`, but we _can_ create a branch `foo/bar`.
  #
  # If we know a repository has no refs of this type (which is the common case)
  # then separating refs from paths - as in ExtractsRef - can be faster.
  #
  # This method only checks one level deep, so only prefixes that contain no
  # slashes are considered. If a repository has a tag `foo/bar` and a branch
  # `foo/bar/baz`, it will return false.
  def has_ambiguous_refs?: () -> (false | untyped)

  def expand_ref: (untyped ref) -> (untyped | untyped | nil)

  def add_branch: (untyped user, untyped branch_name, untyped ref, ?expire_cache: bool, ?skip_ci: bool, ?raise_on_invalid_ref: bool) -> untyped

  def add_tag: (untyped user, untyped tag_name, untyped target, ?untyped? message) -> untyped

  def rm_branch: (untyped user, untyped branch_name, ?target_sha: untyped?) -> true

  def rm_tag: (untyped user, untyped tag_name) -> true

  def ref_names: () -> untyped

  def lazy_ref_exists?: (untyped ref_name) -> untyped

  def branch_exists?: (untyped branch_name) -> (false | true | untyped)

  def tag_exists?: (untyped tag_name) -> (false | untyped)

  def ref_exists?: (untyped ref) -> untyped

  def branch_or_tag?: (untyped ref) -> (false | untyped)

  def search_branch_names: (untyped pattern) -> untyped

  def languages: () -> (::Array[untyped] | untyped)

  def keep_around: (*untyped shas, source: untyped) -> untyped

  def archive_metadata: (untyped ref, untyped storage_path, ?::String format, append_sha: untyped, ?path: untyped?) -> untyped

  def cached_methods: () -> untyped

  def expire_tags_cache: () -> untyped

  def expire_branches_cache: () -> untyped

  def expire_protected_branches_cache: () -> (untyped | nil)

  def expire_statistics_caches: () -> untyped

  def expire_all_method_caches: () -> untyped

  # Refreshes the method caches of this repository.
  #
  # types - An Array of file types (e.g. `:readme`) used to refresh extra
  #         caches.
  def refresh_method_caches: (untyped types) -> (nil | untyped)

  def expire_branch_cache: (?untyped? branch_name) -> untyped

  def expire_root_ref_cache: () -> untyped

  # Expires the cache(s) used to determine if a repository is empty or not.
  def expire_emptiness_caches: () -> (nil | untyped)

  def expire_exists_cache: () -> untyped

  # expire cache that doesn't depend on repository data (when expiring)
  def expire_content_cache: () -> untyped

  def expire_status_cache: () -> untyped

  # Runs code after a repository has been created.
  def after_create: () -> untyped

  # Runs code just before a repository is deleted.
  def before_delete: () -> untyped

  # Runs code just before the HEAD of a repository is changed.
  def before_change_head: () -> untyped

  # Runs code before pushing (= creating or removing) a tag.
  #
  # Note that this doesn't expire the tags. You may need to call
  # expire_caches_for_tags or expire_tags_cache.
  def before_push_tag: () -> untyped

  def expire_caches_for_tags: () -> untyped

  # Runs code before removing a tag.
  def before_remove_tag: () -> untyped

  # Runs code after removing a tag.
  def after_remove_tag: () -> untyped

  # Runs code after the HEAD of a repository is changed.
  def after_change_head: () -> untyped

  # Runs code after a new commit has been pushed.
  def after_push_commit: (untyped branch_name) -> untyped

  # Runs code after a new branch has been created.
  def after_create_branch: (?expire_cache: bool) -> untyped

  # Runs code before removing an existing branch.
  def before_remove_branch: () -> untyped

  # Runs code after an existing branch has been removed.
  def after_remove_branch: (?expire_cache: bool) -> (untyped | nil)

  def lookup: (untyped sha) -> untyped

  def blob_at: (untyped sha, untyped path, ?limit: untyped) -> untyped

  # items is an Array like: [[oid, path], [oid1, path1]]
  def blobs_at: (untyped items, ?blob_size_limit: untyped) -> untyped

  def root_ref: () -> untyped

  # Gitaly migration: https://gitlab.com/gitlab-org/gitaly/issues/314
  def exists?: () -> (false | untyped)

  # We don't need to cache the output of this method because both exists? and
  # has_visible_content? are already memoized and cached. There's no guarantee
  # that the values are expired and loaded atomically.
  def empty?: () -> (true | untyped)

  # The size of this repository in megabytes.
  def size: () -> (untyped | ::Float)

  # The recent objects size of this repository in mebibytes.
  def recent_objects_size: () -> (untyped | ::Float)

  def commit_count: () -> (untyped | 0)

  def commit_count_for_ref: (untyped ref) -> (0 | untyped)

  def avatar: () -> untyped

  # store issue_template_names as hash
  def issue_template_names_hash: () -> untyped

  def merge_request_template_names_hash: () -> untyped

  def readme: () -> untyped

  def readme_path: () -> untyped

  def contribution_guide: () -> untyped

  def changelog: () -> untyped

  def license_blob: () -> untyped

  def license_key: () -> untyped

  def license: () -> untyped

  def license_gitaly: () -> (nil | untyped)

  def gitignore: () -> untyped

  def jenkinsfile?: () -> untyped

  def xcode_project?: () -> untyped

  def head_commit: () -> untyped

  def head_tree: (?skip_flat_paths: bool) -> (nil | untyped)

  def tree: (?::Symbol sha, ?untyped? path, ?recursive: bool, ?skip_flat_paths: bool, ?pagination_params: untyped?, ?ref_type: untyped?, ?rescue_not_found: bool) -> (nil | untyped)

  def blob_at_branch: (untyped branch_name, untyped path) -> untyped

  def list_last_commits_for_tree: (untyped sha, untyped path, ?offset: ::Integer, ?limit: ::Integer, ?literal_pathspec: bool) -> untyped

  def last_commit_for_path: (untyped sha, untyped path, ?literal_pathspec: bool) -> untyped

  def last_commit_id_for_path: (untyped sha, untyped path, ?literal_pathspec: bool) -> untyped

  def next_branch: (untyped name, ?::Hash[untyped, untyped] opts) -> (untyped | ::String)

  def branches_sorted_by: (untyped sort_by, ?untyped? pagination_params) -> untyped

  def tags_sorted_by: (untyped value, ?untyped? pagination_params) -> untyped

  # Params:
  #
  # order_by: name|email|commits
  # sort: asc|desc default: 'asc'
  def contributors: (?ref: untyped?, ?order_by: untyped?, ?sort: ::String) -> untyped

  def health: (untyped generate) -> untyped

  def branch_names_contains: (untyped sha, ?limit: ::Integer, ?exclude_refs: untyped) -> untyped

  def tag_names_contains: (untyped sha, ?limit: ::Integer, ?exclude_refs: untyped) -> untyped

  def local_branches: () -> untyped

  alias branches local_branches

  def tags: () -> untyped

  def create_dir: (untyped user, untyped path, **untyped options) -> untyped

  def create_file_actions: (untyped path, untyped content, ?execute_filemode: untyped?) -> untyped

  def create_file: (untyped user, untyped path, untyped content, **untyped options) -> untyped

  def update_file_actions: (untyped path, untyped content, ?previous_path: untyped?, ?execute_filemode: untyped?) -> untyped

  def update_file: (untyped user, untyped path, untyped content, **untyped options) -> untyped

  def move_dir_files_actions: (untyped path, untyped previous_path, ?branch_name: untyped?) -> untyped

  def delete_file: (untyped user, untyped path, **untyped options) -> untyped

  def with_cache_hooks: () { () -> untyped } -> (nil | untyped)

  def commit_files: (untyped user, **untyped options) -> untyped

  def merge: (untyped user, untyped source_sha, untyped merge_request, untyped message) -> untyped

  def merge_to_branch: (untyped user, source_sha: untyped, target_branch: untyped, message: untyped, ?target_sha: untyped?) ?{ (untyped) -> untyped } -> untyped

  def delete_refs: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def merge_to_ref: (untyped user, source_sha: untyped, branch: untyped, target_ref: untyped, message: untyped, first_parent_ref: untyped, ?expected_old_oid: ::String) -> untyped

  def ff_merge: (untyped user, untyped source, untyped target_branch, ?target_sha: untyped?, ?merge_request: untyped?) -> untyped

  def revert: (untyped user, untyped commit, untyped branch_name, untyped message, ?start_branch_name: untyped?, ?start_project: untyped, ?dry_run: bool) -> untyped

  def cherry_pick: (untyped user, untyped commit, untyped branch_name, untyped message, ?start_branch_name: untyped?, ?start_project: untyped, ?author_name: untyped?, ?author_email: untyped?, ?dry_run: bool) -> untyped

  def merged_to_root_ref?: (untyped branch_or_name) -> (nil | untyped)

  def root_ref_sha: () -> untyped

  # If this method is not provided a set of branch names to check merge status,
  # it fetches all branches.
  def merged_branch_names: (?untyped branch_names, ?include_identical: bool) -> untyped

  def merge_base: (*untyped commits_or_ids) -> untyped

  def ancestor?: (untyped ancestor_id, untyped descendant_id) -> (false | untyped)

  def expire_ancestor_cache: (untyped ancestor_id, untyped descendant_id) -> untyped

  def clone_as_mirror: (untyped url, ?http_authorization_header: ::String, ?resolved_address: ::String) -> untyped

  def fetch_as_mirror: (untyped url, ?forced: bool, ?refmap: ::Symbol, ?prune: bool, ?http_authorization_header: ::String, ?resolved_address: ::String) -> untyped

  def fetch_source_branch!: (untyped source_repository, untyped source_branch, untyped local_ref) -> untyped

  def compare_source_branch: (untyped target_branch_name, untyped source_repository, untyped source_branch_name, straight: untyped) -> untyped

  def create_ref: (untyped ref, untyped ref_path) -> untyped

  def ls_files: (untyped ref) -> untyped

  def search_files_by_content: (untyped query, untyped ref, ?::Hash[untyped, untyped] options) -> (::Array[untyped] | untyped)

  def search_files_by_name: (untyped query, untyped ref) -> (::Array[untyped] | untyped)

  def search_files_by_wildcard_path: (untyped path, ?::String ref) -> untyped

  def file_on_head: (untyped type, ?::Symbol object_type) -> (nil | untyped)

  def route_map_for: (untyped sha) -> untyped

  def lfsconfig_for: (untyped sha) -> untyped

  def has_gitattributes?: () -> untyped

  def changelog_config: (untyped ref, untyped path) -> untyped

  def fetch_ref: (untyped source_repository, source_ref: untyped, target_ref: untyped) -> untyped

  def fork_from: (untyped source_repository, ?untyped? branch) -> untyped

  def rebase: (untyped user, untyped merge_request, ?skip_ci: bool) -> untyped

  def squash: (untyped user, untyped merge_request, untyped message) -> untyped

  # Squashes commits between start_sha and end_sha into a single commit.
  # Unlike #squash which takes a merge_request, this method takes explicit SHAs.
  #
  # NOTE: This method is similar to #squash but takes explicit SHAs instead of
  # a merge request. If you modify #squash, consider if this method needs the
  # same changes (e.g., adding caching, metrics, or hooks).
  #
  # @param user [User] The user performing the squash
  # @param start_sha [String] The SHA to use as parent of the squashed commit
  # @param end_sha [String] The SHA whose tree will be used for the squashed commit
  # @param message [String] Commit message for the squashed commit
  # @return [String] The SHA of the new squashed commit
  def squash_commits: (untyped user, start_sha: untyped, end_sha: untyped, message: untyped) -> untyped

  # Returns the initial commit (first commit with no parents) for the given ref
  #
  # @param ref [String] The reference to start from (default: default branch)
  # @return [Commit, nil]
  def initial_commit: (?untyped? ref) -> (nil | untyped)

  def submodule_links: () -> untyped

  def update_submodule: (untyped user, untyped submodule, untyped commit_sha, message: untyped, branch: untyped) -> untyped

  def blob_data_at: (untyped sha, untyped path) -> (nil | untyped)

  def create_if_not_exists: (?untyped? default_branch) -> untyped

  def create_from_bundle: (untyped bundle_path) -> untyped

  def project: () -> untyped

  # Choose one of the available repository storage options based on a normalized weighted probability.
  # We should always use the latest settings, to avoid picking a deleted shard.
  def self.pick_storage_shard: (?expire: bool) -> untyped

  def change_head: (untyped branch) -> (untyped | false)

  def cache: () -> untyped

  def remove_prohibited_refs: () -> (nil | untyped)

  def get_patch_id: (untyped old_revision, untyped new_revision) -> untyped

  def object_pool: () -> (nil | untyped)

  def get_file_attributes: (untyped revision, untyped paths, untyped attributes) -> untyped

  def object_format: () -> untyped

  def empty_tree_id: () -> untyped

  def blank_ref: () -> untyped

  def ignore_revs_file_blob: () -> (nil | untyped)

  def diffs_by_changed_paths: (untyped diff_refs, ?::Integer offset, ?::Integer batch_size) { (untyped) -> untyped } -> untyped

  # Update ref cache incrementally for a single ref change.
  # @param ref [String] Full ref path (e.g., "refs/heads/main")
  # @param deleted [Boolean] Whether the ref was deleted
  def incremental_ref_cache_update: (untyped ref, untyped deleted) -> (nil | untyped)

  private

  def expand_author_with_user_emails: (untyped author) -> untyped

  # A ref is prohibited if its name matches a SHA-like pattern
  # or if, after stripping the refs/heads/ or refs/tags/ prefix,
  # the branch/tag name fails GitRefValidator validation (e.g. names
  # starting with refs/heads/ which create ambiguous nested refs
  # like refs/heads/refs/heads/main).
  def prohibited_ref?: (untyped ref_name) -> (true | untyped)

  def determine_follow_option: (untyped opts) -> (false | untyped)

  def empty_commit_collection_with_next_cursor: () -> untyped

  # Increase the limit by number of excluded refs
  # to prevent a situation when we return less refs than requested
  def adjust_containing_limit: (limit: untyped, exclude_refs: untyped) -> untyped

  # Limit number of returned refs
  # in case the result has more refs than requested
  def adjust_containing_refs: (limit: untyped, refs: untyped) -> untyped

  def ancestor_cache_key: (untyped ancestor_id, untyped descendant_id) -> ::String

  # TODO Genericize finder, later split this on finders by Ref or Oid
  # https://gitlab.com/gitlab-org/gitlab/issues/19877
  def find_commit: (untyped oid_or_ref) -> untyped

  def redis_set_cache: () -> untyped

  def redis_hash_cache: () -> untyped

  def request_store_cache: () -> untyped

  def repository_event: (untyped event, ?::Hash[untyped, untyped] tags) -> untyped

  def initialize_raw_repository: () -> untyped

  def sign_commits?: () -> untyped
end
