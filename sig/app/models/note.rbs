# A note on the root of an issue, merge request, commit, or snippet.
#
# A note of this type is never resolvable.
class Note < ApplicationRecord
  @commit: untyped

  extend ActiveModel::Naming

  extend Gitlab::Utils::Override

  include Notes::ActiveRecord

  include Notes::Discussion

  include Gitlab::Utils::StrongMemoize

  include Participable

  include Mentionable

  include Awardable

  include Importable

  include Import::HasImportSource

  include FasterCacheKeys

  include Redactable

  include CacheMarkdownField

  include AfterCommitQueue

  include ResolvableNote

  include Editable

  include Gitlab::SQL::Pattern

  include ThrottledTouch

  include FromUnion

  include Sortable

  include EachBatch

  include Spammable

  TYPES_RESTRICTED_BY_PROJECT_ABILITY: { branch: :download_code }

  TYPES_RESTRICTED_BY_GROUP_ABILITY: { contact: :read_crm_contact }

  NON_DIFF_NOTE_TYPES: ::Array["Note" | "DiscussionNote" | nil]

  # Attribute containing rendered and redacted Markdown as generated by
  # Banzai::ObjectRenderer.
  attr_accessor redacted_note_html: untyped

  # Total of all references as generated by Banzai::ObjectRenderer
  attr_accessor total_reference_count: untyped

  # Number of user visible references as generated by Banzai::ObjectRenderer
  attr_accessor user_visible_reference_count: untyped

  # Attribute used to store the attributes that have been changed by quick actions.
  attr_writer commands_changes: untyped

  # Attribute used to store the status of quick actions.
  attr_accessor quick_actions_status: untyped

  # Attribute used to determine whether keep_around_commits will be skipped for diff notes.
  attr_accessor skip_keep_around_commits: untyped

  # Attribute used to skip updates of `updated_at` for the noteable when it could impact database health.
  attr_accessor skip_touch_noteable: untyped

  def trigger_note_subscription_create: () -> (nil | untyped)

  def trigger_note_subscription_update: () -> (nil | untyped)

  def trigger_note_subscription_destroy: () -> (nil | untyped)

  def trigger_work_item_updated_subscription: () -> (nil | untyped)

  extend Gitlab::Utils::Override

  def self.model_name: () -> untyped

  def self.parent_object_field: () -> :noteable

  # Group diff discussions by line code or file path.
  # It is not needed to group by line code when comment is
  # on an image.
  def self.grouped_diff_discussions: (?untyped? diff_refs) -> untyped

  def self.positions: () -> untyped

  def self.count_for_collection: (untyped ids, untyped type, ?::String count_column) -> untyped

  def self.search: (untyped query) -> untyped

  def self.simple_sorts: () -> untyped

  def self.cherry_picked_merge_requests: (untyped shas) -> untyped

  def self.with_web_entity_associations: () -> untyped

  # rubocop: disable CodeReuse/ServiceClass
  def system_note_with_references?: () -> (nil | untyped)

  def diff_note?: () -> false

  def active?: () -> true

  def hook_attrs: () -> untyped

  def supports_suggestion?: () -> false

  def for_commit?: () -> untyped

  def for_issue?: () -> untyped

  def for_work_item?: () -> untyped

  def for_merge_request?: () -> untyped

  def for_snippet?: () -> untyped

  def for_alert_mangement_alert?: () -> untyped

  def for_vulnerability?: () -> untyped

  def for_compliance_violation?: () -> untyped

  def for_project_snippet?: () -> untyped

  def for_personal_snippet?: () -> untyped

  def for_wiki_page?: () -> untyped

  def for_project_noteable?: () -> untyped

  def group_level_issue?: () -> untyped

  def for_design?: () -> untyped

  def for_issuable?: () -> untyped

  def for_abuse_report?: () -> untyped

  def skip_project_check?: () -> untyped

  def commit: () -> (untyped | nil)

  # Notes on merge requests and commits can be traced back to one or several
  # MRs. This method returns a relation if the note is for one of these types,
  # or nil if it is a note on some other object.
  def merge_requests: () -> (untyped | untyped | nil)

  # override to return commits, which are not active record
  def noteable: () -> untyped

  # FIXME: Hack for polymorphic associations with STI
  #        For more information visit http://api.rubyonrails.org/classes/ActiveRecord/Associations/ClassMethods.html#label-Polymorphic+Associations
  def noteable_type=: (untyped noteable_type) -> untyped

  def contributor?: () -> untyped

  # overridden in ee
  def human_max_access: () -> untyped

  def noteable_author?: (untyped noteable) -> untyped

  def project_name: () -> untyped

  def confidential?: (?include_noteable: bool) -> (true | untyped)

  def editable?: () -> untyped

  # We used `last_edited_at` as an alias of `updated_at` before.
  # This makes it compatible with the previous way without data migration.
  def last_edited_at: () -> untyped

  # Since we used `updated_at` as `last_edited_at`, it could be touched by transforming / resolving a note.
  # This makes sure it is only marked as edited when the note body is updated.
  def edited?: () -> (false | untyped)

  def award_emoji?: () -> untyped

  def emoji_awardable?: () -> untyped

  def can_be_award_emoji?: () -> untyped

  def contains_emoji_only?: () -> untyped

  def noteable_ability_name: () -> ("snippet" | "alert_management_alert" | "security_resource" | "wiki_page" | "compliance_violations_report" | untyped)

  def can_be_discussion_note?: () -> untyped

  def can_create_todo?: () -> untyped

  def references: () -> untyped

  def bump_updated_at: () -> untyped

  def broadcast_noteable_notes_changed: () -> untyped

  def touch: (*untyped args, **untyped kwargs) -> untyped

  # By default Rails will issue an "SELECT *" for the relation, which is
  # overkill for just updating the timestamps. To work around this we manually
  # touch the data so we can SELECT only the columns we need.
  def touch_noteable: () -> (nil | untyped)

  def notify_after_create: () -> untyped

  def notify_after_destroy: () -> untyped

  def banzai_render_context: (untyped field) -> untyped

  def retrieve_upload: (untyped _identifier, untyped paths) -> untyped

  def resource_parent: () -> untyped

  def user_mentions: () -> untyped

  def system_note_visible_for?: (untyped user) -> (true | untyped)

  def parent_user: () -> (untyped | nil)

  def skip_notification?: () -> untyped

  def post_processed_cache_key: () -> untyped

  def user_mention_class: () -> (nil | untyped)

  def user_mention_identifier: () -> (nil | untyped)

  def show_outdated_changes?: () -> (false | untyped)

  def commands_changes: () -> untyped

  def mentioned_users: (?untyped? current_user) -> untyped

  def mentioned_filtered_user_ids_for: (untyped references) -> (untyped | ::Array[untyped])

  def issuable_ability_name: () -> (:read_internal_note | :read_note)

  def exportable_record?: (untyped user) -> (true | untyped)

  # Override method defined in Spammable
  # Wildcard argument because user: argument is not used
  def check_for_spam?: (*untyped) -> (false | true)

  private

  # Use attributes.keys instead of attribute_names to filter out the fields that are skipped during export:
  #
  # - note_html
  # - cached_markdown_version
  #
  # Note: This method is an override of an existing private ActiveRecord method
  def attribute_names_for_serialization: () -> untyped

  def touch_noteable?: () -> untyped

  def trigger_note_subscription?: () -> untyped

  def system_note_viewable_by?: (untyped user) -> (true | untyped)

  def system_note_viewable_by_project_ability?: (untyped user) -> untyped

  def system_note_viewable_by_group_ability?: (untyped user) -> untyped

  def keep_around_commit: () -> (nil | untyped)

  def enqueue_keep_around_commit: () -> (nil | untyped)

  def async_keep_around_refs?: () -> untyped

  def ensure_organization_id: () -> (nil | untyped)

  def ensure_namespace_id: () -> (nil | untyped)

  def nullify_blank_type: () -> (untyped | nil)

  def nullify_blank_line_code: () -> (untyped | nil)

  def all_referenced_mentionables_allowed?: (untyped user) -> (true | untyped)

  def force_cross_reference_regex_check?: () -> (nil | untyped)

  def does_not_exceed_notes_limit?: () -> (nil | untyped)

  def noteable_label_url_method: () -> (:project_merge_requests_url | :project_issues_url)

  def ensure_confidentiality_not_changed: () -> (nil | untyped)

  def ensure_confidentiality_discussion_compliance: () -> untyped

  def ensure_noteable_can_have_confidential_note: () -> (nil | untyped)

  def ensure_note_type_can_be_confidential: () -> (nil | untyped)

  def noteable_can_have_confidential_note?: () -> untyped

  def set_internal_flag: () -> (untyped | nil)

  def system_note_work_item_reference?: () -> untyped
end
