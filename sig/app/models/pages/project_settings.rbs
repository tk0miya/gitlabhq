module Pages
  class ProjectSettings
    @project: untyped

    def initialize: (untyped project) -> void

    def url: () -> untyped

    def deployments: () -> untyped

    def unique_domain_enabled?: () -> untyped

    def force_https?: () -> untyped

    def pages_primary_domain: () -> untyped

    private

    attr_reader project: untyped
  end
end
