class Snippet < ApplicationRecord
  self.@reference_pattern: untyped

  self.@link_reference_pattern: untyped

  @blob: untyped

  @repository: untyped

  @storage: untyped

  @full_path: untyped

  include Gitlab::VisibilityLevel

  include Redactable

  include CacheMarkdownField

  include Noteable

  include Participable

  include Sortable

  include Awardable

  include Mentionable

  include Spammable

  include Editable

  include Gitlab::SQL::Pattern

  include FromUnion

  include HasRepository

  include CanMoveRepositoryStorage

  include AfterCommitQueue

  extend ::Gitlab::Utils::Override

  include CreatedAtFilterable

  include EachBatch

  include Import::HasImportSource

  include Gitlab::EncryptedAttribute

  MAX_FILE_COUNT: 10

  DESCRIPTION_LENGTH_MAX: untyped

  # If file_name changes, it invalidates content
  alias default_content_html_invalidator content_html_invalidated?

  def content_html_invalidated?: () -> untyped

  alias resource_parent project

  # Searches for snippets with a matching title, description or file name.
  #
  # This method uses ILIKE on PostgreSQL.
  #
  # query - The search query as a String.
  #
  # Returns an ActiveRecord::Relation.
  def self.search: (untyped query) -> untyped

  def self.parent_class: () -> untyped

  def self.sanitized_file_name: (untyped file_name) -> untyped

  def self.with_optional_visibility: (?untyped? value) -> untyped

  def self.only_personal_snippets: () -> untyped

  def self.only_project_snippets: () -> untyped

  def self.only_include_projects_visible_to: (?untyped? current_user) -> untyped

  def self.only_include_projects_with_snippets_enabled: (?include_private: bool) -> untyped

  def self.only_include_authorized_projects: (untyped current_user) -> untyped

  def self.for_project_with_user: (untyped project, ?untyped? user) -> untyped

  def self.visible_to_or_authored_by: (untyped user) -> untyped

  def self.reference_prefix: () -> "$"

  # Pattern used to extract `$123` snippet references from text
  #
  # This pattern supports cross-project references.
  def self.reference_pattern: () -> untyped

  def self.link_reference_pattern: () -> untyped

  def self.find_by_id_and_project: (id: untyped, project: untyped) -> untyped

  def self.find_by_project_title_trunc_created_at: (untyped project, untyped title, untyped created_at) -> untyped

  def self.max_file_limit: () -> untyped

  def initialize: (?::Hash[untyped, untyped] attributes) -> void

  def to_reference: (?untyped? from, ?full: bool) -> untyped

  def all_files: () -> untyped

  def blob: () -> untyped

  def blobs: (?untyped paths) -> (::Array[untyped] | untyped)

  def hook_attrs: () -> { id: untyped, title: untyped, description: untyped, content: untyped, author_id: untyped, project_id: untyped, created_at: untyped, updated_at: untyped, file_name: untyped, type: untyped, visibility_level: untyped, url: untyped }

  def file_name: () -> untyped

  def visibility_level_field: () -> :visibility_level

  def embeddable?: () -> untyped

  def notes_with_associations: () -> untyped

  def check_for_spam?: (*untyped) -> untyped

  def supports_recaptcha?: () -> true

  def to_ability_name: () -> "snippet"

  def as_json: (?::Hash[untyped, untyped] options) -> untyped

  def repository: () -> untyped

  def repository_size_checker: () -> untyped

  def storage: () -> untyped

  def full_path: () -> (nil | untyped)

  def default_branch: () -> untyped

  def repository_storage: () -> untyped

  def create_repository: () -> (nil | untyped)

  def track_snippet_repository: (untyped shard) -> untyped

  def can_cache_field?: (untyped field) -> untyped

  def hexdigest: () -> untyped

  def file_name_on_repo: () -> (nil | untyped)

  def list_files: (?untyped? ref) -> (::Array[untyped] | untyped)

  def multiple_files?: () -> untyped

  def hidden_due_to_author_ban?: () -> untyped
end
