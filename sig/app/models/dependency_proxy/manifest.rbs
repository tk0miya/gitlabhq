class DependencyProxy::Manifest < ApplicationRecord
  include FileStoreMounter

  include ObjectStorable

  include TtlExpirable

  include Packages::Destructible

  include EachBatch

  include UpdateNamespaceStatistics

  alias namespace group

  STORE_COLUMN: :file_store

  MAX_FILE_SIZE: untyped

  DIGEST_HEADER: "Docker-Content-Digest"

  ACCEPTED_TYPES: ::Array[untyped]

  def self.find_by_file_name_or_digest: (file_name: untyped, digest: untyped) -> untyped
end
