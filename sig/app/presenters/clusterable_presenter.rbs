class ClusterablePresenter < Gitlab::View::Presenter::Delegated
  def self.fabricate: (untyped clusterable, **untyped attributes) -> untyped

  def can_add_cluster?: () -> untyped

  def can_admin_cluster?: () -> untyped

  def can_create_cluster?: () -> untyped

  def index_path: (?::Hash[untyped, untyped] options) -> untyped

  def connect_path: () -> untyped

  def new_cluster_docs_path: () -> untyped

  def create_user_clusters_path: () -> untyped

  def create_cluster_migration_path: (untyped cluster) -> untyped

  def update_cluster_migration_path: (untyped cluster) -> untyped

  def cluster_status_cluster_path: (untyped cluster, ?::Hash[untyped, untyped] params) -> untyped

  def clear_cluster_cache_path: (untyped cluster) -> untyped

  def cluster_path: (untyped cluster, ?::Hash[untyped, untyped] params) -> untyped

  # Will be overridden in EE
  def environments_cluster_path: (untyped cluster) -> nil

  def empty_state_help_text: () -> nil

  def sidebar_text: () -> untyped

  def learn_more_link: () -> untyped
end
