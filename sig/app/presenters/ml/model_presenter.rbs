module Ml
  class ModelPresenter < Gitlab::View::Presenter::Delegated
    def latest_version_name: () -> untyped

    def author: () -> untyped

    def version_count: () -> untyped

    def candidate_count: () -> untyped

    def latest_package_path: () -> untyped

    def latest_version_path: () -> untyped

