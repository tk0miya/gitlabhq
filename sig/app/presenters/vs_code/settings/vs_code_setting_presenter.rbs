module VsCode
  module Settings
    class VsCodeSettingPresenter < Gitlab::View::Presenter::Simple
      @setting: untyped

      attr_reader setting: untyped

      def initialize: (untyped setting) -> void

      def content: () -> (nil | untyped)

      def machines: () -> (untyped | nil)

      def version: () -> untyped

      def machine_id: () -> (untyped | nil)
    end
  end
end
