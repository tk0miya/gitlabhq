# Renders a GlAlert root element
module Pajamas
  class AlertComponent < Pajamas::Component
    @title: untyped

    @variant: untyped

    @dismissible: untyped

    @alert_options: untyped

    @close_button_options: untyped

    VARIANT_ICONS: { info: "information-o", warning: "warning", success: "check-circle", danger: "error", tip: "bulb" }

    # @param [String] title
    # @param [Symbol] variant
    # @param [Boolean] dismissible
    # @param [Hash] alert_options
    # @param [Hash] close_button_options
    def initialize: (?title: untyped?, ?variant: ::Symbol, ?dismissible: bool, ?alert_options: ::Hash[untyped, untyped], ?close_button_options: ::Hash[untyped, untyped]) -> void

    def base_class: () -> untyped

    private

    def icon: () -> untyped

    def icon_classes: () -> ::String

    def dismissible_button_options: () -> untyped
  end
end
