    def initialize: (untyped title, ?description: untyped?, ?count: untyped?, ?icon: untyped?, ?icon_class: untyped?, ?toggle_text: untyped?, ?options: ::Hash[untyped, untyped], ?count_options: ::Hash[untyped, untyped], ?body_options: ::Hash[untyped, untyped], ?form_options: ::Hash[untyped, untyped], ?toggle_options: ::Hash[untyped, untyped], ?footer_options: ::Hash[untyped, untyped], ?is_collapsible: bool, ?container_tag: ::String, ?title_tag: ::String) -> void

    def id: () -> untyped

