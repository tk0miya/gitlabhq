    @icon: untyped

    @icon_class: untyped

    @toggle_text: untyped

    @options: untyped

    @count_options: untyped

    @body_options: untyped

    @form_options: untyped

    @toggle_options: untyped

    @footer_options: untyped

    @is_collapsible: untyped

    @container_tag: untyped

    @title_tag: untyped

