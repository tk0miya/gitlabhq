module MergeRequests
  class DraftStateChangeEvent < Gitlab::EventStore::Event
    def schema: () -> { "type" => "object", "required" => ::Array["current_user_id" | "merge_request_id"], "properties" => { "current_user_id" => { "type" => "integer" }, "merge_request_id" => { "type" => "integer" }, "new_draft_status" => { "type" => "boolean" } } }
  end
end
