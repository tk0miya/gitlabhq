module Projects
  class ProjectFeaturesChangedEvent < ::Gitlab::EventStore::Event
    def schema: () -> { "type" => "object", "properties" => { "project_id" => { "type" => "integer" }, "namespace_id" => { "type" => "integer" }, "root_namespace_id" => { "type" => "integer" }, "features" => { "type" => "array" } }, "required" => ::Array["project_id" | "namespace_id" | "root_namespace_id" | "features"] }

    def pages_related?: () -> untyped
  end
end
