module Milestones
  class MilestoneUpdatedEvent < Gitlab::EventStore::Event
    def schema: () -> { "type" => "object", "required" => ::Array["id"], "properties" => { "id" => { "type" => "integer" }, "group_id" => { "type" => "integer" }, "project_id" => { "type" => "integer" }, "updated_attributes" => { "type" => "array", "items" => { "type" => "string" } } } }
  end
end
