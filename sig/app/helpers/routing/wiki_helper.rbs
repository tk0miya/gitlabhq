module Routing
  module WikiHelper
    def wiki_path: (untyped wiki, **untyped options) -> untyped

    def wiki_page_path: (untyped wiki, untyped page, **untyped options) -> untyped

    def project_wiki_page_url: (untyped wiki_meta, **untyped options) -> untyped

    def group_wiki_page_url: (untyped wiki_meta, **untyped options) -> untyped
  end
end
