module ImportHelper
  include ::Gitlab::Utils::StrongMemoize

  def has_ci_cd_only_params?: () -> false

  def sanitize_project_name: (untyped name) -> untyped

  def import_project_target: (untyped owner, untyped name) -> ::String

  def provider_project_link_url: (untyped provider_url, untyped full_path) -> untyped

  def import_by_url_data_attributes: (untyped project, untyped ci_cd_only, untyped git_timeout, untyped repository_mirrors_available) -> { project_id: untyped, import_by_url_validate_path: untyped, import_from_url: untyped, import_path: untyped, git_timeout: untyped, ci_cd_only: untyped, has_repository_mirrors_feature: untyped }

  def import_will_timeout_message: (untyped _ci_cd_only) -> untyped

  def import_svn_message: (untyped _ci_cd_only) -> untyped

  def import_in_progress_title: () -> untyped

  def import_wait_and_refresh_message: () -> untyped

  def import_github_authorize_message: () -> untyped

  def import_configure_github_admin_message: () -> untyped
end
