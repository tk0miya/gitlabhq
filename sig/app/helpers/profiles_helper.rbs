  def email_profile_data: (untyped user) -> { email: untyped, public_email: untyped, commit_email: untyped, public_email_options: untyped, commit_email_options: untyped, email_help_text: untyped, email_resend_confirmation_link: untyped, is_email_readonly: untyped, email_change_disabled: untyped, managing_group_name: untyped, needs_password_confirmation: untyped, password_automatically_set: untyped, allow_password_authentication_for_web: untyped, provider_label: untyped }

