module ErrorTracking
  class SentryClient
    module IssueLink
      # Creates a link in Sentry corresponding to the provided
      # Sentry issue and GitLab issue
      # @param integration_id [Integer, nil] Representing a global
      #          GitLab integration in Sentry. Nil for plugins.
      # @param sentry_issue_id [Integer] Id for an issue from Sentry
      # @param issue [Issue] Issue for which the link should be created
      def create_issue_link: (untyped integration_id, untyped sentry_issue_id, untyped issue) -> untyped

      private

      def create_global_integration_link: (untyped integration_id, untyped sentry_issue_id, untyped issue) -> untyped

      def global_integration_link_api_url: (untyped integration_id, untyped sentry_issue_id) -> untyped

      def create_plugin_link: (untyped sentry_issue_id, untyped issue) -> untyped

      def plugin_link_api_url: (untyped sentry_issue_id) -> untyped
    end
  end
end
