module Tasks
  module Gitlab
    module Permissions
      module Graphql
        class ValidateTask < ::Tasks::Gitlab::Permissions::BaseValidateTask
          @violations: untyped

          @valid_permissions: untyped

          def initialize: () -> void

          private

          attr_reader violations: untyped

          def validate!: () -> untyped

          def each_directive: () { (?) -> untyped } -> untyped

          def each_type_directive: () { (untyped, untyped) -> untyped } -> untyped

          def each_mutation_directive: () { (untyped, untyped) -> untyped } -> untyped

          def each_field_directive: () { (untyped, untyped) -> untyped } -> untyped

          def graphql_object_type?: (untyped name, untyped type) -> (false | untyped)

          # Resolves the mutation class from a field on the Mutation type.
          # GraphQL Ruby exposes the resolver differently depending on context:
          # - `resolver_class` is available on most field objects
          # - `resolver` and `mutation` are fallbacks for different GraphQL Ruby versions
          # Returns the resolver only if it's a BaseMutation subclass.
          def resolve_mutation_class: (untyped field) -> untyped

          def find_mutation_directives: (untyped field, untyped resolver) -> untyped

          def valid_permissions: () -> untyped

          def validate_permission_exists: (untyped item, untyped permission) -> (nil | untyped)

          def validate_boundary_type: (untyped item, untyped permission, untyped boundary_type) -> (nil | untyped)

          def format_all_errors: () -> untyped

          def format_graphql_errors: (untyped kind) -> ("" | ::String)

          def format_boundary_mismatch_errors: () -> ("" | ::String)

          def class_source_path: (untyped klass) -> untyped

          def error_messages: () -> { invalid_permission: untyped, boundary_mismatch: untyped }

          def print_success_message: () -> untyped

          def json_schema_file: () -> nil
        end
      end
    end
  end
end
