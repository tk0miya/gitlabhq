module Atlassian
  module JiraConnect
    module Jwt
      class Asymmetric
        @token: untyped

        @verification_claims: untyped

        @public_key_cdn_url_setting: untyped

        include Gitlab::Utils::StrongMemoize

        KeyFetchError: untyped

        ALGORITHM: "RS256"

        DEFAULT_PUBLIC_KEY_CDN_URL: "https://connect-install-keys.atlassian.com"

        PROXY_PUBLIC_KEY_PATH: "/-/jira_connect/public_keys"

        KEY_ID_REGEX: ::Regexp

        def initialize: (untyped token, untyped verification_claims) -> void

        def valid?: () -> untyped

        def iss_claim: () -> (nil | untyped)

        private

        def claims: () -> untyped

        def decoded_claims: (untyped public_key) -> untyped

        def decode_token: (?untyped? key, ?bool verify, **untyped claims) -> untyped

        def retrieve_public_key: (untyped key_id) -> untyped

        def relevant_claims: () -> untyped

        def verification_qsh: () -> untyped

        def public_key_cdn_url: () -> untyped

        def public_key_cdn_url_setting: () -> untyped
      end
    end
  end
end
