module ContainerRegistry
  class Config
    @tag: untyped

    @blob: untyped

    @data: untyped

    attr_reader tag: untyped

    attr_reader blob: untyped

    attr_reader data: untyped

    def initialize: (untyped tag, untyped blob) -> void

    def []: (untyped key) -> (nil | untyped)
  end
end
