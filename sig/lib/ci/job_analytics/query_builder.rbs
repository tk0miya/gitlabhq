module Ci
  module JobAnalytics
    class QueryBuilder
      @project: untyped

      @current_user: untyped

      @select_fields: untyped

      @aggregations: untyped

      @sort: untyped

      @source: untyped

      @ref: untyped

      @from_time: untyped

      @to_time: untyped

      @name_search: untyped

      attr_reader project: untyped

      attr_reader current_user: untyped

      attr_reader select_fields: untyped

      attr_reader aggregations: untyped

      attr_reader sort: untyped

      attr_reader source: untyped

      attr_reader ref: untyped

      attr_reader from_time: untyped

      attr_reader to_time: untyped

      attr_reader name_search: untyped

      # @param project [Project] The project to find jobs for
      # @param options [Hash] options for filtering and configuring the query builder
      # @option options [Array] :select_fields Fields to select
      # @option options [Array] :aggregations Aggregations to perform
      # @option options [String] :sort Sort order (ex. rate_of_success_asc)
      # @option options [String] :source Pipeline source
      # @option options [String] :ref Git reference
      # @option options [Time] :from_time Start time for filtering (defaults to 7 days ago)
      # @option options [Time] :to_time End time for filtering
      # @option options [String] :name_search Search by name of the pipeline jobs.
      def initialize: (project: untyped, current_user: untyped, ?options: ::Hash[untyped, untyped]) -> void

      def execute: () -> (nil | untyped)

      private

      def build_finder: () -> untyped

      def base_finder: () -> untyped

      def use_deduplicated_finder?: () -> untyped

      def extract_sort_info: (untyped value) -> ::Array[untyped]
    end
  end
end
