module WebIde
  module SettingsSync
    # Due to a bug where resource url template was not included
    # "web_ide_https://open-vsx.org/vscode/gallery_https://open-vsx.org/vscode/item_"
    # This hash is used out in the wild, so we don't want to change it...
    # See https://gitlab.com/gitlab-org/gitlab/-/merge_requests/178491
    HASH_CONVERSION: { "e36c431c0e2e1ee82c86" => "2e0d3e8c1107f9ccc5ea", "55b10685e181429abe78" => "2e0d3e8c1107f9ccc5ea", "372ad9a36594931b612d" => "2e0d3e8c1107f9ccc5ea" }

    def self.settings_context_hash: (extension_marketplace_settings: untyped) -> (nil | untyped)

    private

    def self.optionally_transform_hash: (untyped hash) -> untyped
  end
end
