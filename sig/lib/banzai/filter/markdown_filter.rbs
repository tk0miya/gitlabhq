module Banzai
  module Filter
    class MarkdownFilter < HTML::Pipeline::TextFilter
      @renderer: untyped

      @text: untyped

      GLFM_ENGINE: :glfm_markdown

      DEFAULT_ENGINE: untyped

      def initialize: (untyped text, ?untyped? context, ?untyped? result) -> void

      def call: () -> untyped

      def render_engine: () -> untyped

      private

      def engine: () -> untyped

      # Parses string representing a sourcepos in format
      # "start_line:start_column-end_line:end_column" into 0-based
      # byte indices. For example, "1:10-14:1" becomes
      # {
      #   start: { line: 0, column: 9 },
      #   end: { line: 13, column: 0 }
      # }
      def self.parse_sourcepos: (untyped sourcepos) -> (nil | { start: { line: untyped, column: untyped }, end: { line: untyped, column: untyped } })

      def self.glfm_markdown?: (untyped context) -> untyped
    end
  end
end
