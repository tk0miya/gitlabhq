module Banzai
  module Filter
    # Replaces placeholders for broadcast messages with data from the current
    # user or the instance.
    class BroadcastMessagePlaceholdersFilter < HTML::Pipeline::Filter
      prepend Concerns::PipelineTimingCheck

      def call: () -> untyped

      private

      def replace_placeholders: (untyped node) -> untyped

      def link_href: (untyped node) -> untyped

      def replace_content: (untyped content, ?url_safe_encoding: bool) -> untyped

      def placeholders: () -> { "email" => untyped, "name" => untyped, "user_id" => untyped, "username" => untyped, "instance_id" => untyped }

      def current_user: () -> untyped
    end
  end
end
