module Banzai
  module Filter
    module References
      class FeatureFlagReferenceFilter < IssuableReferenceFilter
        def object_sym: () -> :feature_flag

        def parent_records: (untyped parent, untyped ids) -> untyped

        def url_for_object: (untyped feature_flag, untyped project) -> untyped

        def object_link_title: (untyped object, untyped matches) -> untyped
      end
    end
  end
end
