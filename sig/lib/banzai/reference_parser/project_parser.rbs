module Banzai
  module ReferenceParser
    class ProjectParser < BaseParser
      @project_ids_by_user: untyped

      include Gitlab::Utils::StrongMemoize

      def references_relation: () -> untyped

      private

      # Returns an Array of Project ids that can be read by the given user.
      #
      # user - The User for which to check the projects
      def readable_project_ids_for: (untyped user) -> untyped

      def can_read_reference?: (untyped user, untyped ref_project, untyped node) -> untyped
    end
  end
end
