module Gitlab
  # noinspection RubyClassModuleNamingConvention -- JetBrains is changing this to allow shorter names
  module Fp
    module RopHelpers
      # @param [Class] base
      # @return void
      def self.extended: (untyped base) -> untyped

      # @param [Class] fp_module_or_class
