module Gitlab
  # Parser/renderer for markups without other special support code.
  module OtherMarkup
    RENDER_TIMEOUT: untyped

    # Public: Converts the provided markup into HTML.
    #
    # input         - the source text in a markup format
    #
    def self.render: (untyped file_name, untyped input, untyped context) -> untyped

    def self.render_markup: (untyped file_name, untyped input, untyped context) -> untyped
  end
end
