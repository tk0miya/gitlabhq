module Gitlab
  module GithubImport
    module Importer
      class LfsObjectImporter
        @lfs_object: untyped

        @project: untyped

        attr_reader lfs_object: untyped

        attr_reader project: untyped

        RETRY_DELAY: 120

        # lfs_object - An instance of `Gitlab::GithubImport::Representation::LfsObject`.
        # project - An instance of `Project`.
        def initialize: (untyped lfs_object, untyped project, untyped _) -> void

        def lfs_download_object: () -> untyped

        def execute: () -> untyped
      end
    end
  end
end
