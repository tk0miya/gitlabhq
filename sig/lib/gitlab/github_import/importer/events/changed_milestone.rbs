module Gitlab
  module GithubImport
    module Importer
      module Events
        class ChangedMilestone < BaseImporter
          # GitHub API doesn't provide the historical state of an issue for
          # de/milestoned issue events. So we'll assign the default state to
          # those events that are imported from GitHub.
          DEFAULT_STATE: untyped

          def execute: (untyped issue_event) -> untyped

          private

          def create_event: (untyped issue_event) -> (nil | untyped)

          def action: (untyped event_type) -> untyped
        end
      end
    end
  end
end
