module Gitlab
  module GithubImport
    module Importer
      class ProtectedBranchesImporter
        include ParallelScheduling

        # The method that will be called for traversing through all the objects to
        # import, yielding them to the supplied block.
        def each_object_to_import: () { (untyped) -> untyped } -> untyped

        def importer_class: () -> untyped

        def representation_class: () -> untyped

        def sidekiq_worker_class: () -> untyped

        def object_type: () -> :protected_branch

        def collection_method: () -> :protected_branches

        def id_for_already_imported_cache: (untyped protected_branch) -> untyped
      end
    end
  end
end
