module Gitlab
  module GithubImport
    module Importer
      class ReplayEventsImporter
        @project: untyped

        @client: untyped

        @replay_event: untyped

        SUPPORTED_EVENTS: ::Array["review_request_removed" | "review_requested"]

        # replay_event - An instance of `Gitlab::GithubImport::Representation::ReplayEvent`.
        # project - An instance of `Project`
        # client - An instance of `Gitlab::GithubImport::Client`
        def initialize: (untyped replay_event, untyped project, untyped client) -> void

        def execute: () -> (nil | untyped)

        private

        attr_reader project: untyped

        attr_reader client: untyped

        attr_reader replay_event: untyped

        def handle_review_requests: (untyped association, untyped events) -> untyped
      end
    end
  end
end
