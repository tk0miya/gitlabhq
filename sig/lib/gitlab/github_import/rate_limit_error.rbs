module Gitlab
  module GithubImport
    # Error that will be raised when we're about to reach (or have reached) the
    # GitHub API's rate limit.
    class RateLimitError < StandardError
      @reset_in: untyped

      attr_reader reset_in: untyped

      def initialize: (?untyped? message, ?untyped? reset_in) -> void
    end
  end
end
