module Gitlab
  module GithubImport
    module Representation
      class User
        @attributes: untyped

        include Representable

        # Builds a user from a GitHub API response.
        #
        # user - An instance of `Hash` containing the user details.
        def self.from_api_response: (untyped user, ?::Hash[untyped, untyped] additional_data) -> untyped

        # Builds a user using a Hash that was built from a JSON payload.
        def self.from_json_hash: (untyped raw_hash) -> untyped

        # attributes - A Hash containing the user details. The keys of this
        #              Hash (and any nested hashes) must be symbols.
        def initialize: (untyped attributes) -> void
      end
    end
  end
end
