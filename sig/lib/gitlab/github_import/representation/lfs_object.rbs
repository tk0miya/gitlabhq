module Gitlab
  module GithubImport
    module Representation
      class LfsObject
        @attributes: untyped

        include Representable

        # Builds a lfs_object
        def self.from_api_response: (untyped lfs_object, ?::Hash[untyped, untyped] additional_data) -> untyped

        # Builds a new lfs_object using a Hash that was built from a JSON payload.
        def self.from_json_hash: (untyped raw_hash) -> untyped

        # attributes - A Hash containing the raw lfs_object details. The keys of this
        #              Hash must be Symbols.
        def initialize: (untyped attributes) -> void

        def github_identifiers: () -> { oid: untyped, size: untyped }
      end
    end
  end
end
