module Gitlab
  class StringPlaceholderReplacer
    def self.replace_string_placeholders: (untyped text, ?untyped? placeholder_regex, ?in_uri: bool, ?limit: ::Integer) { (untyped) -> untyped } -> untyped

    def self.placeholder_full_regex: (untyped placeholder_regex, in_uri: untyped) -> ::Regexp
  end
end
