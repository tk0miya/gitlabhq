module Gitlab
  module Database
    module HealthStatus
      module Indicators
        class WalRate < PrometheusAlertIndicator
          private

          def enabled?: () -> untyped

          def sli_query_key: () -> :wal_rate_sli_query

          def slo_key: () -> :wal_rate_slo

          def alert_condition: () -> untyped
        end
      end
    end
  end
end
