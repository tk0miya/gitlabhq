module Gitlab
  module Database
    module Partitioning
      self.@registered_models: untyped

      self.@registered_tables: untyped

      PARTITION_EXCLUDED_DATABASES: ::Array["embedding" | "jh" | "geo"]

      class TableWithoutModel < Gitlab::Database::SharedModel
        include PartitionedTable
      end

      def self.register_models: (untyped models) -> untyped

      def self.clear_registered_models: () -> untyped

      def self.register_tables: (untyped tables) -> untyped

      def self.clear_registered_tables: () -> untyped

      def self.sync_partitions_ignore_db_error: (?analyze: bool) -> untyped

      def self.sync_partitions: (?untyped models_to_sync, ?only_on: untyped?, ?analyze: bool, ?owner_db_only: untyped) -> (nil | untyped)

      def self.report_metrics: (?untyped models_to_monitor) -> untyped

      def self.drop_detached_partitions: () -> (nil | untyped)

      def self.registered_models: () -> untyped

      def self.registered_tables: () -> untyped

      private

      def self.registered_for_sync: () -> untyped

      def self.table_without_model: (table_name: untyped, partitioned_column: untyped, strategy: untyped, ?limit_connection_names: untyped?, **untyped strategy_args) -> untyped
    end
  end
end
