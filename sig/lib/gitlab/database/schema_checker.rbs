module Gitlab
  module Database
    class SchemaChecker
      @structure_sql_path: untyped

      @database_name: untyped

      @database_model: untyped

      @database: untyped

      @structure_sql: untyped

      @validators: untyped

      def initialize: (database_name: untyped) -> void

      def execute: () -> untyped

      private

      attr_reader database_name: untyped

      attr_reader database_model: untyped

      attr_reader structure_sql_path: untyped

      attr_reader database: untyped

      attr_reader structure_sql: untyped

      attr_reader validators: untyped

      def check_inconsistencies: () -> { schema_check_results: ::Hash[untyped, untyped], metadata: { last_run_at: untyped } }

      def format_inconsistencies: (untyped inconsistencies) -> untyped
    end
  end
end
