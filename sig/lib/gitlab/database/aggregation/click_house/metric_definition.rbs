module Gitlab
  module Database
    module Aggregation
      module ClickHouse
        class MetricDefinition < PartDefinition
          @secondary_expression: untyped

          def initialize: (*untyped args, **untyped kwargs) -> void

          def to_inner_arel: (untyped context) -> untyped

          def to_outer_arel: (untyped context) -> untyped

          def requires_window?: () -> false
        end
      end
    end
  end
end
