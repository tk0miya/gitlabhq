    module Aggregation
      module ClickHouse
        class Quantile < MetricDefinition
          include ParameterizedDefinition

          DEFAULT_QUANTILE: ::Float

          def initialize: (untyped name, ?::Symbol type, ?untyped? expression, **untyped kwargs) -> void

