module Gitlab
  module Database
    module Aggregation
      module ClickHouse
        class RetainedCount < BitmapWindow
          def initialize: (untyped name, ?::Symbol type, ?untyped? expression, over: untyped, ?lag_offset: ::Integer, **untyped kwargs) -> void

          # No inner aggregation: the expression column (ex: user_id) is already
          # projected via the primary key passthrough in the inner query.
          def to_inner_arel: (untyped _context) -> nil

          def to_outer_arel: (untyped context) -> untyped

          # Already Array(UInt64) from to_outer_arel so no finalization needed.
          def finalization_sql: (untyped alias_name) -> untyped
        end
      end
    end
  end
end
