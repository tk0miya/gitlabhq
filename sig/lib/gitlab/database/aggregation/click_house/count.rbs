module Gitlab
  module Database
    module Aggregation
      module ClickHouse
        class Count < MetricDefinition
          @distinct: untyped

          attr_reader distinct: untyped

          def initialize: (?::String name, ?::Symbol type, ?untyped? expression, ?distinct: bool, **untyped kwargs) -> void

          def identifier: () -> ::Symbol

          def to_inner_arel: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

          def to_outer_arel: (untyped context) -> untyped

          def regular_count: (untyped context) -> untyped
        end
      end
    end
  end
end
