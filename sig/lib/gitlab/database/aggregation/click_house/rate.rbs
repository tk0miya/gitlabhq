module Gitlab
  module Database
    module Aggregation
      module ClickHouse
        class Rate < MetricDefinition
          # Uses regular expression as numerator condition and "if" expression as denominator condition
          def initialize: (untyped name, ?::Symbol type, numerator_if: untyped, ?denominator_if: untyped?, **untyped kwargs) -> void

          def identifier: () -> ::Symbol

          def to_outer_arel: (untyped context) -> untyped
        end
      end
    end
  end
end
