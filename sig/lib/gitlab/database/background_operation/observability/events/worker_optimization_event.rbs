module Gitlab
  module Database
    module BackgroundOperation
      module Observability
        module Events
          # Event responsible for logging batch size optimization events
          # E.g: from => 1_000, to => 15_000
          class WorkerOptimizationEvent < Event
            LOG_EVENT: "background_operation_worker_optimization_event"

            def payload: () -> { message: untyped, old_batch_size: untyped, new_batch_size: untyped, on_hold_until: untyped, priority: untyped, job_class_name: untyped, batch_class_name: untyped, table_name: untyped, column_name: untyped, gitlab_schema: untyped, job_arguments: untyped }
          end
        end
      end
    end
  end
end
