module Gitlab
  module Database
    module Reindexing
      class Coordinator
        @index: untyped

        @notifier: untyped

        include AsyncDdlExclusiveLeaseGuard

        # Maximum lease time for the global Redis lease
        # This should be higher than the maximum time for any
        # long running step in the reindexing process (compare with
        # statement timeouts).
        TIMEOUT_PER_ACTION: untyped

        attr_reader index: untyped

        attr_reader notifier: untyped

        def initialize: (untyped index, ?untyped notifier) -> void

        def perform: () -> (nil | untyped)

        def drop: () -> (nil | untyped)

        private

        def with_notifications: (untyped action) { () -> untyped } -> untyped

        def perform_for: (untyped index, untyped action) -> untyped

        def lease_timeout: () -> untyped

        def full_index_name: () -> untyped

        # We need to check the time explicitly because we execute 4 reindexing
        # action per rake invocation and one action can take up to 24 hours.
        # This means that it can span for more than the weekend.
        def too_late_for_reindexing?: () -> (false | untyped)
      end
    end
  end
end
