module Gitlab
  module Database
    module Partitioning
      class MultipleNumericListPartition
        @table: untyped

        @values: untyped

        @partition_name: untyped

        @schema: untyped

        @conn: untyped

        include Comparable

        def self.from_sql: (untyped table, untyped partition_name, untyped definition, schema: untyped) -> untyped

        attr_reader table: untyped

        attr_reader values: untyped

        def initialize: (untyped table, untyped values, ?partition_name: untyped?, ?schema: untyped?) -> void

        def partition_name: () -> untyped

        def data_size: () -> untyped

        def to_create_sql: () -> untyped

        def to_attach_sql: () -> untyped

        def to_detach_sql: () -> untyped

        def ==: (untyped other) -> untyped

        alias eql? ==

        def hash: () -> untyped

        def <=>: (untyped other) -> (nil | untyped)

        def before?: (untyped partition_id) -> untyped

        def fully_qualified_partition: () -> untyped

        private

        def full_partition_name: () -> untyped

        def quoted_values: () -> untyped

        def conn: () -> untyped
      end
    end
  end
end
