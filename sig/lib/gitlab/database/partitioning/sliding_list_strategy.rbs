module Gitlab
  module Database
    module Partitioning
      class SlidingListStrategy < BaseStrategy
        @model: untyped

        @partitioning_key: untyped

        @next_partition_if: untyped

        @detach_partition_if: untyped

        @analyze_interval: untyped

        attr_reader model: untyped

        attr_reader partitioning_key: untyped

        attr_reader next_partition_if: untyped

        attr_reader detach_partition_if: untyped

        attr_reader analyze_interval: untyped

        def initialize: (untyped model, untyped partitioning_key, next_partition_if: untyped, detach_partition_if: untyped, ?analyze_interval: untyped?) -> void

        def current_partitions: () -> untyped

        def missing_partitions: () -> untyped

        def initial_partition: () -> untyped

        def next_partition: () -> untyped

        def extra_partitions: () -> untyped

        # The partition manager is initialized with both connections and creates
        # partitions in both databases, but here we change the default on the model's
        # connection, meaning that it will not respect the manager's connection config
        # so we need to check that it's changing the default only when called
        # with the model's connection. Also since we prevent writes in the other
        # database, we should not change the default there.
        #
        def after_adding_partitions: () -> (nil | untyped)

        def active_partition: () -> untyped

        def no_partitions_exist?: () -> untyped

        def validate_and_fix: () -> (nil | untyped)

        private

        def different_connection_names?: () -> untyped

        def current_default_value: () -> untyped

        def ensure_partitioning_column_ignored_or_readonly!: () -> (untyped | nil)

        def key_ignored_or_readonly?: () -> untyped

        def with_lock_retries: () { (?) -> untyped } -> untyped
      end
    end
  end
end
