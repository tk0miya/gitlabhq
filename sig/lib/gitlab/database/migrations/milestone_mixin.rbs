module Gitlab
  module Database
    module Migrations
      module MilestoneMixin
        @version: untyped

        @milestone: untyped

        extend ActiveSupport::Concern

        include Gitlab::ClassAttributes

        MilestoneNotSetError: untyped

        def type_from_path: (untyped path) -> (:post | :regular | untyped)

        def initialize: (?untyped name, ?untyped? version) -> void

        def milestone: () -> untyped
      end
    end
  end
end
