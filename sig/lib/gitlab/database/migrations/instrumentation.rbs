module Gitlab
  module Database
    module Migrations
      class Instrumentation
        @observer_classes: untyped

        @result_dir: untyped

        STATS_FILENAME: "migration-stats.json"

        def initialize: (result_dir: untyped, ?observer_classes: untyped) -> void

        def observe: (version: untyped, name: untyped, connection: untyped, ?meta: ::Hash[untyped, untyped]) { () -> untyped } -> untyped

        def observe_no_batches_processed: () -> untyped

        private

        attr_reader observer_classes: untyped

        def record_observation: (untyped observation, destination_dir: untyped) -> untyped

        def on_each_observer: (untyped observers) { (untyped) -> untyped } -> untyped
      end
    end
  end
end
