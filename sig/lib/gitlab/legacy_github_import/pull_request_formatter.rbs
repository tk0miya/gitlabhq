module Gitlab
  module LegacyGithubImport
    class PullRequestFormatter < IssuableFormatter
      @source_branch: untyped

      @source_branch_name: untyped

      @target_branch: untyped

      @target_branch_name: untyped

      def attributes: () -> { iid: untyped, title: untyped, description: untyped, source_project: untyped, source_branch: untyped, source_branch_sha: untyped, target_project: untyped, target_branch: untyped, target_branch_sha: untyped, state: untyped, milestone: untyped, author_id: untyped, assignee_id: untyped, created_at: untyped, updated_at: untyped, imported_from: untyped }

      def project_association: () -> :merge_requests

      def valid?: () -> untyped

      def source_branch: () -> untyped

      def source_branch_name: () -> untyped

      def source_branch_name_prefixed: () -> ::String

      def source_branch_exists?: () -> untyped

      def target_branch: () -> untyped

      def target_branch_name: () -> untyped

      def target_branch_name_prefixed: () -> ::String

      def cross_project?: () -> (true | untyped)

      def opened?: () -> untyped

      def project_assignee_association: () -> :merge_request_assignees

      def contributing_user_formatters: () -> { author_id: untyped }

      def contributing_assignee_formatters: () -> { user_id: untyped }

      def target_branch_sha: () -> untyped

      private

      def state: () -> ("merged" | untyped)
    end
  end
end
