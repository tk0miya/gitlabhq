module Gitlab
  module Sanitizers
    class Exif
      @logger: untyped

      # these tags are not removed from the image
      ALLOWLISTED_TAGS: ::Array["ResolutionUnit" | "XResolution" | "YResolution" | "YCbCrSubSampling" | "YCbCrPositioning" | "BitsPerSample" | "ImageHeight" | "ImageWidth" | "ImageSize" | "Orientation"]

      EXCLUDE_PARAMS: untyped

      ALLOWED_MIME_TYPES: ::Array["image/jpeg" | "image/tiff"]

      attr_reader logger: untyped

      def initialize: (?logger: untyped) -> void

      # rubocop: disable CodeReuse/ActiveRecord
      def batch_clean: (?start_id: untyped?, ?stop_id: untyped?, ?dry_run: bool, ?sleep_time: untyped?, ?uploader: untyped?, ?since: untyped?) -> untyped

      def clean: (untyped uploader, ?dry_run: bool) -> untyped

      def clean_existing_path: (untyped src_path, ?dry_run: bool, ?content: untyped?, ?skip_unallowed_types: bool) -> (nil | untyped)

      private

      def remove_and_store: (untyped tmpdir, untyped src_path, untyped uploader) -> untyped

      def exec_remove_exif!: (untyped path) -> untyped

      def fetch_upload_to_file: (untyped uploader, untyped dir) -> untyped

      def check_for_allowed_types: (untyped contents, ?raise_error: bool) -> untyped

      def upload_ref: (untyped upload) -> ::String
    end
  end
end
