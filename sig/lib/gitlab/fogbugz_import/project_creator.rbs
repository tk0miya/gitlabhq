module Gitlab
  module FogbugzImport
    class ProjectCreator
      @repo: untyped

      @name: untyped

      @namespace: untyped

      @current_user: untyped

      @fb_session: untyped

      @user_map: untyped

      attr_reader repo: untyped

      attr_reader name: untyped

      attr_reader fb_session: untyped

      attr_reader namespace: untyped

      attr_reader current_user: untyped

      attr_reader user_map: untyped

      def initialize: (untyped repo, untyped name, untyped namespace, untyped current_user, untyped fb_session, ?untyped? user_map) -> void

      def execute: () -> untyped
    end
  end
end
