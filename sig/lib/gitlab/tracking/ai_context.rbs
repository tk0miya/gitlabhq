      def to_context: () -> untyped

      def to_h: () -> { session_id: untyped, workflow_id: untyped, flow_type: untyped, agent_name: untyped, agent_type: untyped, input_tokens: untyped, output_tokens: untyped, total_tokens: untyped, ephemeral_5m_input_tokens: untyped, ephemeral_1h_input_tokens: untyped, cache_read: untyped, model_engine: untyped, model_name: untyped, model_provider: untyped, flow_version: untyped, flow_registry_version: untyped }

