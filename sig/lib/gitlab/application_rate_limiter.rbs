module Gitlab
  # This module implements a simple rate limiter that can be used to throttle
  # certain actions. Unlike Rack Attack and Rack::Throttle, which operate at
  # the middleware level, this can be used at the controller or API level.
  # See CheckRateLimit concern for usage.
  module ApplicationRateLimiter
    self.@application_rate_limiter_histogram: untyped

    InvalidKeyError: untyped

    InvalidScopeError: untyped

    LIMIT_USAGE_BUCKET: ::Array[::Float | 1]

    extend ::Gitlab::Utils::StrongMemoize

    # Application rate limits
    #
    # Threshold value can be either an Integer or a Proc
    # in order to not evaluate its value every time this method is called
    # and only do that when it's needed.
    def self.rate_limits: () -> { ai_action: { threshold: untyped, interval: untyped }, auto_rollback_deployment: { threshold: 1, interval: untyped }, autocomplete_users: { threshold: untyped, interval: untyped }, autocomplete_users_unauthenticated: { threshold: untyped, interval: untyped }, bitbucket_server_import: { threshold: 6, interval: untyped }, bulk_delete_todos: { threshold: 6, interval: untyped }, bulk_import: { threshold: 6, interval: untyped }, ci_job_processed_subscription: { threshold: 50, interval: untyped }, ci_pipeline_statuses_subscription: { threshold: 50, interval: untyped }, code_suggestions_api_endpoint: { threshold: untyped, interval: untyped }, create_organization_api: { threshold: untyped, interval: untyped }, delete_all_todos: { threshold: 1, interval: untyped }, downstream_pipeline_trigger: { threshold: untyped, interval: untyped }, email_verification: { threshold: 10, interval: untyped }, email_verification_code_send: { threshold: 10, interval: untyped }, expanded_diff_files: { threshold: 6, interval: untyped }, fetch_google_ip_list: { threshold: 10, interval: untyped }, github_import: { threshold: 6, interval: untyped }, fogbugz_import: { threshold: 1, interval: untyped }, geo_proxy: { threshold: 60, interval: untyped }, gitea_import: { threshold: 6, interval: untyped }, gitlab_shell_operation: { threshold: untyped, interval: untyped }, glql: { threshold: 1, interval: untyped }, group_api: { threshold: untyped, interval: untyped }, group_archive_unarchive_api: { threshold: untyped, interval: untyped }, group_download_export: { threshold: untyped, interval: untyped }, group_export: { threshold: untyped, interval: untyped }, group_import: { threshold: untyped, interval: untyped }, group_invited_groups_api: { threshold: untyped, interval: untyped }, group_projects_api: { threshold: untyped, interval: untyped }, group_shared_groups_api: { threshold: untyped, interval: untyped }, groups_api: { threshold: untyped, interval: untyped }, import_source_user_notification: { threshold: 1, interval: untyped }, issues_create: { threshold: untyped, interval: untyped }, jobs_index: { threshold: untyped, interval: untyped }, large_blob_download: { threshold: 5, interval: untyped }, members_delete: { threshold: untyped, interval: untyped }, namespace_exists: { threshold: 20, interval: untyped }, notes_create: { threshold: untyped, interval: untyped }, notification_emails: { threshold: 1000, interval: untyped }, oauth_dynamic_registration: { threshold: 5, interval: untyped }, offline_export: { threshold: 6, interval: untyped }, offline_import: { threshold: 6, interval: untyped }, permanent_email_failure: { threshold: 5, interval: untyped }, phone_verification_send_code: { threshold: 5, interval: untyped }, phone_verification_verify_code: { threshold: 5, interval: untyped }, pipelines_create: { threshold: untyped, interval: untyped }, pipelines_created_per_user: { threshold: untyped, interval: untyped }, play_pipeline_schedule: { threshold: 1, interval: untyped }, profile_add_new_email: { threshold: 5, interval: untyped }, profile_resend_email_confirmation: { threshold: 5, interval: untyped }, profile_update_username: { threshold: 10, interval: untyped }, project_api: { threshold: untyped, interval: untyped }, project_members_api: { threshold: untyped, interval: untyped }, project_download_export: { threshold: untyped, interval: untyped }, project_export: { threshold: untyped, interval: untyped }, project_fork_sync: { threshold: 10, interval: untyped }, project_generate_new_export: { threshold: untyped, interval: untyped }, project_import: { threshold: untyped, interval: untyped }, project_invited_groups_api: { threshold: untyped, interval: untyped }, project_repositories_archive: { threshold: 5, interval: untyped }, project_repositories_changelog: { threshold: 5, interval: untyped }, project_repositories_health: { threshold: 5, interval: untyped }, project_testing_integration: { threshold: 5, interval: untyped }, projects_api: { threshold: untyped, interval: untyped }, projects_api_rate_limit_unauthenticated: { threshold: untyped, interval: untyped }, raw_blob: { threshold: untyped, interval: untyped }, raw_blob_unauthenticated: { threshold: untyped, interval: untyped }, runner_jobs_request_api: { threshold: untyped, interval: untyped }, runner_jobs_patch_trace_api: { threshold: untyped, interval: untyped }, runner_jobs_api: { threshold: untyped, interval: untyped }, search_rate_limit: { threshold: untyped, interval: untyped }, search_rate_limit_unauthenticated: { threshold: untyped, interval: untyped }, service_account_creation: { threshold: 10, interval: untyped }, temporary_email_failure: { threshold: 300, interval: untyped }, update_environment_canary_ingress: { threshold: 1, interval: untyped }, update_namespace_name: { threshold: untyped, interval: untyped }, user_large_commit_request: { threshold: 3, interval: untyped }, user_contributed_projects_api: { threshold: untyped, interval: untyped }, user_followers: { threshold: untyped, interval: untyped }, user_following: { threshold: untyped, interval: untyped }, user_gpg_key: { threshold: untyped, interval: untyped }, user_gpg_keys: { threshold: untyped, interval: untyped }, user_projects_api: { threshold: untyped, interval: untyped }, user_sign_in: { threshold: 5, interval: untyped }, user_sign_up: { threshold: 20, interval: untyped }, user_ssh_key: { threshold: untyped, interval: untyped }, user_ssh_keys: { threshold: untyped, interval: untyped }, user_starred_projects_api: { threshold: untyped, interval: untyped }, user_status: { threshold: untyped, interval: untyped }, username_exists: { threshold: 20, interval: untyped }, users_get_by_id: { threshold: untyped, interval: untyped }, web_hook_calls: { interval: untyped }, web_hook_calls_low: { interval: untyped }, web_hook_calls_mid: { interval: untyped }, web_hook_event_resend: { threshold: 5, interval: untyped }, web_hook_test: { threshold: 5, interval: untyped } }

    # Increments the given key and returns true if the action should
    # be throttled.
    #
    # @param key [Symbol] Key attribute registered in `.rate_limits`
    # @param scope [Array<ActiveRecord>] Array of ActiveRecord models, Strings
    #     or Symbols to scope throttling to a specific request (e.g. per user
    #     per project)
    # @param resource [ActiveRecord] An ActiveRecord model to count an action
    #     for (e.g. limit unique project (resource) downloads (action) to five
    #     per user (scope))
    # @param threshold [Integer] Optional threshold value to override default
    #     one registered in `.rate_limits`
    # @param interval [Integer] Optional interval value to override default
    #     one registered in `.rate_limits`
    # @param users_allowlist [Array<String>] Optional list of usernames to
    #     exclude from the limit. This param will only be functional if Scope
    #     includes a current user.
    # @param peek [Boolean] Optional. When true the key will not be
    #     incremented but the current throttled state will be returned.
    #
    # @return [Boolean] Whether or not a request should be throttled
    def self.throttled?: (untyped key, scope: untyped, ?resource: untyped?, ?threshold: untyped?, ?interval: untyped?, ?users_allowlist: untyped?, ?peek: bool) -> untyped

    # Increments the resource usage for a given key and returns true if the action should
    # be throttled.
    #
    # @param key [Symbol] Key attribute registered in `.rate_limits`
    # @param scope [<ActiveRecord>] Array of ActiveRecord models, Strings
    #     or Symbols to scope throttling to a specific request (e.g. per user
    #     per project)
    # @param resource_key [Symbol] Key attribute in SafeRequestStore
    # @param threshold [Integer] Threshold value to override default
    #     one registered in `.rate_limits`
    # @param interval [Integer] Interval value to override default
    #     one registered in `.rate_limits`
    #
    # @return [Boolean] Whether or not a request should be throttled
    def self.resource_usage_throttled?: (untyped key, scope: untyped, resource_key: untyped, threshold: untyped, interval: untyped, ?peek: bool) -> untyped

    # Similar to #throttled? above but checks for the bypass header in the request and logs the request when it is over the rate limit
    #
    # @param request [Http::Request] - Web request used to check the header and log
    # @param current_user [User] Current user of the request, it can be nil
    # @param key [Symbol] Key attribute registered in `.rate_limits`
    # @param scope [Array<ActiveRecord>] Array of ActiveRecord models, Strings
    #     or Symbols to scope throttling to a specific request (e.g. per user
    #     per project)
    # @param resource [ActiveRecord] An ActiveRecord model to count an action
    #     for (e.g. limit unique project (resource) downloads (action) to five
    #     per user (scope))
    # @param threshold [Integer] Optional threshold value to override default
    #     one registered in `.rate_limits`
    # @param interval [Integer] Optional interval value to override default
    #     one registered in `.rate_limits`
    # @param users_allowlist [Array<String>] Optional list of usernames to
    #     exclude from the limit. This param will only be functional if Scope
    #     includes a current user.
    # @param peek [Boolean] Optional. When true the key will not be
    #     incremented but the current throttled state will be returned.
    #
    # @return [Boolean] Whether or not a request should be throttled
    def self.throttled_request?: (untyped request, untyped current_user, untyped key, scope: untyped, **untyped options) -> (false | untyped)

    # Returns the current rate limited state without incrementing the count.
    #
    # @param key [Symbol] Key attribute registered in `.rate_limits`
    # @param scope [Array<ActiveRecord>] Array of ActiveRecord models to scope throttling to a specific request (e.g. per user per project)
    # @param threshold [Integer] Optional threshold value to override default one registered in `.rate_limits`
    # @param interval [Integer] Optional interval value to override default one registered in `.rate_limits`
    # @param users_allowlist [Array<String>] Optional list of usernames to exclude from the limit. This param will only be functional if Scope includes a current user.
    #
    # @return [Boolean] Whether or not a request is currently throttled
    def self.peek: (untyped key, scope: untyped, ?threshold: untyped?, ?interval: untyped?, ?users_allowlist: untyped?) -> untyped

    def self.report_metrics: (untyped key, untyped value, untyped threshold, untyped peek) -> (nil | untyped)

    def self.application_rate_limiter_histogram: () -> untyped

    # Logs request using provided logger
    #
    # @param request [Http::Request] - Web request to be logged
    # @param type [Symbol] A symbol key that represents the request
    # @param current_user [User] Current user of the request, it can be nil
    # @param logger [Logger] Logger to log request to a specific log file. Defaults to Gitlab::AuthLogger
    def self.log_request: (untyped request, untyped type, untyped current_user, ?untyped logger) -> untyped

    # Returns the interval value for a given rate limit key
    #
    # @param key [Symbol] Key attribute registered in `.rate_limits`
    # @return [Integer, nil] The interval value in seconds, or nil if not configured
    def self.interval: (untyped key) -> untyped

    # Returns the threshold value for a given rate limit key, resolving any
    # Proc against the current application settings.
    #
    # @param key [Symbol] Key attribute registered in `.rate_limits`
    # @return [Integer] The resolved threshold; 0 when the key disables itself.
    def self.threshold: (untyped key) -> untyped

    private

    def self._throttled?: (untyped key, scope: untyped, strategy: untyped, ?threshold: untyped?, ?interval: untyped?, ?users_allowlist: untyped?, ?peek: bool) -> (false | untyped)

    # Computes the throttle decision via the legacy Redis counter shape
    # (application_rate_limiter:<key>:<scope>:<period_key>). Increments
    # the counter unless +peek+, then compares against +threshold_value+.
    # Returns false when the counter is missing (peek with no prior
    # increment) so callers treat "no counter" as "not throttled".
    def self.legacy_throttled?: (untyped key, scope: untyped, strategy: untyped, peek: untyped, threshold_value: untyped, interval_value: untyped) -> (false | untyped)

    # Routes a check through the labkit adapter when applicable, returning
    # labkit's boolean decision or nil if the adapter does not handle this
    # call. The adapter only takes the plain IncrementPerAction strategy;
    # per-resource and resource-usage strategies stay on the legacy path.
    # Peek dispatches to a read-only Redis round-trip so the labkit counter
    # only advances via paired non-peek call sites.
    def self.dispatch_to_labkit: (untyped key, scope: untyped, strategy: untyped, peek: untyped, threshold: untyped, interval: untyped) -> (nil | untyped)

    def self.rate_limit_value: (untyped value) -> untyped

    def self.rate_limit_value_by_key: (untyped key, untyped setting) -> untyped

    def self.cache_key: (untyped key, untyped scope, untyped period_key) -> ::String

    def self.application_settings: () -> untyped

    def self.scoped_user_in_allowlist?: (untyped scope, untyped users_allowlist) -> (nil | untyped)

    def self.request_path: (untyped request) -> untyped

    def self.other_filtered_path: (untyped request) -> untyped

    def self.initialize_filtered_params: () -> untyped

    def self.validate_scope!: (untyped key, untyped scope, ?untyped logger) -> (nil | untyped)
  end
end
