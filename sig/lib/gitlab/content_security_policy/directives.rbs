module Gitlab
  module ContentSecurityPolicy
    module Directives
      def self.connect_src: () -> "'self'"

      def self.frame_src: () -> "https://www.google.com/recaptcha/ https://www.recaptcha.net/ https://www.googletagmanager.com/ns.html"

      def self.script_src: () -> "'strict-dynamic' 'self' 'unsafe-eval' https://www.google.com/recaptcha/ https://www.recaptcha.net"

      def self.style_src: () -> "'self' 'unsafe-inline'"

      def self.worker_src: () -> ::String
    end
  end
end
