module Gitlab
  module GitalyClient
    class CommitService
      @gitaly_repo: untyped

      @repository: untyped

      include Gitlab::EncodingHelper

      include WithFeatureFlagActors

      WHITESPACE_CHANGES: { "ignore_all_spaces" => untyped, "ignore_spaces" => untyped, "unspecified" => untyped }

      MERGE_COMMIT_DIFF_MODES: { all_parents: untyped, include_merges: untyped }

      TREE_ENTRIES_DEFAULT_LIMIT: 100000

      def initialize: (untyped repository) -> void

      def ls_files: (untyped revision) -> untyped

      def ancestor?: (untyped ancestor_id, untyped child_id) -> untyped

      def diff: (untyped from, untyped to, ?::Hash[untyped, untyped] options) -> untyped

      def diff_from_parent: (untyped commit, ?::Hash[untyped, untyped] options) -> untyped

      def commit_deltas: (untyped commit) -> untyped

      def tree_entry: (untyped ref, untyped path, ?untyped? limit) -> untyped

      def tree_entries: (untyped repository, untyped revision, untyped path, untyped recursive, untyped skip_flat_paths, untyped pagination_params) -> untyped

      # Count commits in the repository.
      #
      # @param revisions [String, Array<String>] Single revision or array of revisions to count.
      #   Strings are automatically wrapped in an array.
      #   Supports pseudo-revisions like --all, --branches, --tags, --not, --glob.
      # @param options [Hash] Options for counting commits
      # @option options [Boolean] :first_parent Only follow first parent commits
      # @option options [Time] :after Only count commits after this time
      # @option options [Time] :before Only count commits before this time
      # @option options [String] :path Only count commits that touch this path
      # @option options [Integer] :max_count Maximum number of commits to count
      #
      # @return [Integer] The number of commits
      #
      # @example Count commits in a single branch
      #   commit_count('master')
      #
      # @example Count commits across multiple branches
      #   commit_count(['feature-a', 'feature-b'])
      #
      # @example Count commits in all branches
      #   commit_count('--all')
      #
      # @example Count commits in branch-2 but not in branch-1
      #   commit_count(['branch-2', '--not', 'branch-1'])
      #
      # @example Count commits with filters
      #   commit_count('master', path: 'app/', after: 1.week.ago)
      #
      def commit_count: (untyped revisions, ?::Hash[untyped, untyped] options) -> untyped

      def diverging_commit_count: (untyped from, untyped to, max_count: untyped) -> ::Array[untyped]

      def list_last_commits_for_tree: (untyped revision, untyped path, ?offset: ::Integer, ?limit: ::Integer, ?literal_pathspec: bool) -> untyped

      def last_commit_for_path: (untyped revision, untyped path, ?literal_pathspec: bool) -> (nil | untyped)

      def diff_stats: (untyped left_commit_sha, untyped right_commit_sha) -> untyped

      # When finding changed paths and passing a sha for a merge commit we can
      # specify how to diff the commit.
      #
      # When diffing a merge commit and merge_commit_diff_mode is :all_parents
      # file paths are only returned if changed in both parents (or all parents
      # if diffing an octopus merge)
      #
      # This means if we create a merge request that includes a merge commit
      # of changes already existing in the target branch, we can omit those
      # changes when looking up the changed paths.
      #
      # e.g.
      #   1. User branches from master to new branch named feature/foo_bar
      #   2. User changes ./foo_bar.rb and commits change to feature/foo_bar
      #   3. Another user merges a change to ./bar_baz.rb to master
      #   4. User merges master into feature/foo_bar
      #   5. User pushes to GitLab
      #   6. GitLab checks which files have changed
      #
      # case merge_commit_diff_mode
      # when :all_parents
      #   ['foo_bar.rb']
      # when :include_merges
      #   ['foo_bar.rb', 'bar_baz.rb'],
      # else # defaults to :include_merges behavior
      #   ['foo_bar.rb', 'bar_baz.rb'],
      #
      def find_changed_paths: (untyped objects, ?merge_commit_diff_mode: untyped?, ?find_renames: bool, ?diff_filters: untyped?) -> (::Array[untyped] | untyped)

      def find_all_commits: (?::Hash[untyped, untyped] opts) -> untyped

      def list_commits: (untyped revisions, ?::Hash[untyped, untyped] params) -> untyped

      # List all commits which are new in the repository. If commits have been pushed into the repo
      def list_new_commits: (untyped revisions) -> untyped

      def list_commits_by_oid: (untyped oids) -> untyped

      def commits_by_message: (untyped query, ?revision: ::String, ?path: ::String, ?limit: ::Integer, ?offset: ::Integer, ?literal_pathspec: bool) -> untyped

      def languages: (?untyped? ref) -> untyped

      def raw_blame: (untyped revision, untyped path, range: untyped, ?ignore_revisions_blob: untyped?) -> untyped

      def find_commit: (untyped revision) -> (untyped | nil)

      def commit_stats: (untyped revision) -> untyped

      def find_commits: (untyped options) -> untyped

      # Check whether the given revisions exist. Returns a hash mapping the revision name to either `true` if the
      # revision exists, or `false` otherwise. This function accepts all revisions as specified by
      # gitrevisions(1).
      def object_existence_map: (untyped revisions, ?gitaly_repo: untyped) -> (::Hash[untyped, untyped] | untyped)

      def filter_shas_with_signatures: (untyped shas) -> untyped

      def get_commit_signatures: (untyped commit_ids) -> untyped

      def get_commit_messages: (untyped commit_ids) -> untyped

      def list_commits_by_ref_name: (untyped refs) -> untyped

      def get_patch_id: (untyped old_revision, untyped new_revision) -> untyped

      private

      def parse_global_options!: (untyped options) -> untyped

      def call_commit_diff: (untyped request_params, ?::Hash[untyped, untyped] options) -> untyped

      def diff_from_parent_request_params: (untyped commit, ?::Hash[untyped, untyped] options) -> untyped

      def diff_between_commits_request_params: (untyped from_id, untyped to_id, untyped options) -> { repository: untyped, left_commit_id: untyped, right_commit_id: untyped, paths: untyped }

      def consume_commits_response: (untyped response) -> untyped

      def encode_repeated: (untyped array) -> untyped

      def call_find_commit: (untyped revision) -> untyped

      def find_changed_paths_request: (untyped objects, untyped merge_commit_diff_mode, untyped find_renames, ?untyped? diff_filters) -> (nil | untyped)

      def path_error_message: (untyped path_error) -> untyped
    end
  end
end
