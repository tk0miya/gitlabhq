module Gitlab
  module GitalyClient
    class RepositoryService
      @repository: untyped

      @gitaly_repo: untyped

      @storage: untyped

      include Gitlab::EncodingHelper

      include WithFeatureFlagActors

      MAX_MSG_SIZE: untyped

      def initialize: (untyped repository) -> void

      def exists?: () -> untyped

      # Optimize the repository. By default, this will perform heuristical housekeeping in the repository, which
      # is the recommended approach and will only optimize what needs to be optimized. If `eager = true`, then
      # Gitaly will instead be asked to perform eager housekeeping. As a consequence the housekeeping run will take a
      # _lot_ longer. It is not recommended to use eager housekeeping in general, but only in situations where it is
      # explicitly required.
      def optimize_repository: (?eager: bool) -> untyped

      def prune_unreachable_objects: () -> untyped

      def repository_size: () -> untyped

      def repository_info: () -> untyped

      def get_object_directory_size: () -> untyped

      def migrate_reference_backend: (?to_reftable: bool) -> untyped

      def info_attributes: () -> untyped

      # rubocop: disable Metrics/ParameterLists
      # The `remote` parameter is going away soonish anyway, at which point the
      # Rubocop warning can be enabled again.
      def fetch_remote: (untyped url, refmap: untyped, ssh_auth: untyped, forced: untyped, no_tags: untyped, timeout: untyped, ?prune: bool, ?http_authorization_header: ::String, ?resolved_address: ::String) -> untyped

      def create_repository: (?untyped? default_branch, ?object_format: untyped?) -> untyped

      def has_local_branches?: () -> untyped

      def find_merge_base: (*untyped revisions) -> untyped

      def fork_repository: (untyped source_repository, ?untyped? branch) -> untyped

      def import_repository: (untyped source, ?http_authorization_header: ::String, ?mirror: bool, ?resolved_address: ::String) -> untyped

      def fetch_source_branch: (untyped source_repository, untyped source_branch, untyped local_ref) -> untyped

      def fsck: () -> untyped

      def create_bundle: (untyped save_path) -> untyped

      def create_from_bundle: (untyped bundle_path) -> untyped

      def write_ref: (untyped ref_path, untyped ref, untyped old_ref) -> untyped

      def find_license: () -> untyped

      def calculate_checksum: () -> untyped

      def raw_changes_between: (untyped from, untyped to) -> untyped

      def search_files_by_name: (untyped ref, untyped query, ?limit: ::Integer, ?offset: ::Integer) -> untyped

      def search_files_by_content: (untyped ref, untyped query, ?::Hash[untyped, untyped] options) -> untyped

      def search_files_by_regexp: (untyped ref, untyped filter, ?limit: ::Integer, ?offset: ::Integer) -> untyped

      def disconnect_alternates: () -> untyped

      def remove: () -> untyped

      def replicate: (untyped source_repository, ?partition_hint: ::String) -> untyped

      def object_pool: () -> untyped

      def get_file_attributes: (untyped revision, untyped paths, untyped attributes) -> untyped

      def object_format: () -> untyped

      private

      def search_results_from_response: (untyped gitaly_response, ?::Hash[untyped, untyped] options) -> untyped

      def gitaly_fetch_stream_to_file: (untyped save_path, untyped rpc_name, untyped request_class, untyped timeout) -> untyped

      def write_stream_to_file: (untyped response, untyped save_path) -> untyped

      def gitaly_repo_stream_request: (untyped file_path, untyped rpc_name, untyped request_class, untyped timeout) -> untyped

      def build_set_config_entry: (untyped key, untyped value) -> untyped

      def gitaly_object_format: (untyped format) -> untyped
    end
  end
end
