module Gitlab
  module GitalyClient
    # Meant for extraction of server data, and later maybe to perform misc task
    #
    # Not meant for connection logic, look in Gitlab::GitalyClient
    class ServerService
      @storage: untyped

      def initialize: (untyped storage) -> void

      def info: () -> untyped

      def disk_statistics: () -> untyped

      def server_signature: () -> untyped

      def storage_info: () -> untyped

      def storage_disk_statistics: () -> untyped

      private

      def storage_specific: (untyped response) -> untyped
    end
  end
end
