module Gitlab
  class HotlinkingDetector
    IMAGE_FORMATS: ::Array["image/jpeg" | "image/apng" | "image/png" | "image/webp" | "image/svg+xml" | "image/*"]

    MEDIA_FORMATS: ::Array["video/webm" | "video/ogg" | "video/*" | "application/ogg" | "audio/webm" | "audio/ogg" | "audio/wav" | "audio/*"]

    CSS_FORMATS: ::Array["text/css"]

    INVALID_FORMATS: untyped

    INVALID_FETCH_MODES: ::Array["cors" | "no-cors" | "websocket"]

    def self.intercept_hotlinking?: (untyped request) -> untyped

    private

    def self.sec_fetch_invalid?: (untyped request) -> (false | untyped)

    def self.parse_request_accepts: (untyped request) -> (untyped | ::Array[untyped])
  end
end
