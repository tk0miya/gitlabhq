# This wraps calls to a gem which support mime type detection.
# We use the `ruby-magic` gem instead of `mimemagic` due to licensing issues
module Gitlab
  module Utils
    class MimeType
      def self.from_io: (untyped io) -> (nil | untyped)

      def self.from_string: (untyped string) -> (nil | untyped)

      def self.from_filename: (untyped filename, ?default: ::String) -> untyped
    end
  end
end
