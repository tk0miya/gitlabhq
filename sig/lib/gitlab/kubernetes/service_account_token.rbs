module Gitlab
  module Kubernetes
    class ServiceAccountToken
      @name: untyped

      @service_account_name: untyped

      @namespace_name: untyped

      attr_reader name: untyped

      attr_reader service_account_name: untyped

      attr_reader namespace_name: untyped

      def initialize: (untyped name, untyped service_account_name, untyped namespace_name) -> void

      def generate: () -> untyped

      private

      # as per https://kubernetes.io/docs/reference/access-authn-authz/service-accounts-admin/#to-create-additional-api-tokens
      def service_acount_token_type: () -> "kubernetes.io/service-account-token"

      def metadata: () -> { name: untyped, namespace: untyped, annotations: { :"kubernetes.io/service-account.name" => untyped } }
    end
  end
end
