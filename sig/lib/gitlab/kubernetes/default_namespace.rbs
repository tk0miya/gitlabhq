module Gitlab
  module Kubernetes
    class DefaultNamespace
      @cluster: untyped

      @project: untyped

      attr_reader cluster: untyped

      attr_reader project: untyped

      #
      # Ideally we would just use an environment record here instead of
      # passing a project and name/slug separately, but we need to be able
      # to look up namespaces before the environment has been persisted.
      def initialize: (untyped cluster, project: untyped) -> void

      def from_environment_name: (untyped name) -> untyped

      def from_environment_slug: (untyped slug) -> untyped

      private

      def default_platform_namespace: (untyped slug) -> (nil | untyped)

      def default_project_namespace: (untyped environment_slug) -> untyped

      def project_path_slug: (untyped max_length) -> untyped

      #
      # Environment slug can be predicted given an environment
      # name, so even if the environment isn't persisted yet we
      # still know what to look for.
      def generate_slug: (untyped name) -> untyped
    end
  end
end
