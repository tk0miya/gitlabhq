module Gitlab
  module Git
    class Repository
      @storage: untyped

      @relative_path: untyped

      @gl_repository: untyped

      @gl_project_path: untyped

      @container: untyped

      @name: untyped

      @new_blobs: untyped

      @raw_changes_between: untyped

      @refs_hash: untyped

      @info_attributes: untyped

      @gitaly_ref_client: untyped

      @gitaly_commit_client: untyped

      @gitaly_repository_client: untyped

      @gitaly_operation_client: untyped

      @gitaly_remote_client: untyped

      @gitaly_blob_client: untyped

      @gitaly_diff_client: untyped

      @praefect_info_client: untyped

      @gitaly_analysis_client: untyped

      include Gitlab::Git::RepositoryMirroring

      include Gitlab::Git::WrapsGitalyErrors

      include Gitlab::EncodingHelper

      include Gitlab::Utils::StrongMemoize

      REV_LIST_COMMIT_LIMIT: 2000

      GITALY_INTERNAL_URL: "ssh://gitaly/internal.git"

      GITLAB_PROJECTS_TIMEOUT: untyped

      EMPTY_REPOSITORY_CHECKSUM: "0000000000000000000000000000000000000000"

      DEFAULT_LOG_OPTIONS: { limit: 10, offset: 0, path: nil, author: nil, follow: false, skip_merges: false, after: nil, before: nil, all: false, message_regex: nil }

      NoRepository: untyped

      CommitNotFound: untyped

      RepositoryExists: untyped

      InvalidRepository: untyped

      InvalidBlobName: untyped

      InvalidRef: untyped

      GitError: untyped

      DeleteBranchError: untyped

      TagExistsError: untyped

      ChecksumError: untyped

      class CreateTreeError < ::Gitlab::Git::BaseError
        # The value coming from Gitaly is an uppercase String (e.g., "EMPTY")
        @error_code: untyped

        attr_reader error_code: untyped

        def initialize: (untyped error_code) -> void
      end

      # Directory name of repo
      attr_reader name: untyped

      # Relative path of repo
      attr_reader relative_path: untyped

      attr_reader storage: untyped

      attr_reader gl_repository: untyped

      attr_reader gl_project_path: untyped

      attr_reader container: untyped

      # This remote name has to be stable for all types of repositories that
      # can join an object pool. If it's structure ever changes, a migration
      # has to be performed on the object pools to update the remote names.
      # Else the pool can't be updated anymore and is left in an inconsistent
      # state.
      alias object_pool_remote_name gl_repository

      def initialize: (untyped storage, untyped relative_path, untyped gl_repository, untyped gl_project_path, ?container: untyped?) -> void

      def to_s: () -> ::String

      # Support Feature Flag Repository actor
      def flipper_id: () -> ::String

      def ==: (untyped other) -> untyped

      alias eql? ==

      def hash: () -> untyped

      # Default branch in the repository
      def root_ref: (?head_only: bool) -> untyped

      def exists?: () -> untyped

      def create_repository: (?untyped? default_branch, ?object_format: untyped?) -> untyped

      # Returns an Array of branch names
      # sorted by name ASC
      def branch_names: () -> untyped

      # Returns an Array of Branches
      def branches: () -> untyped

      # Directly find a branch with a simple name (e.g. master)
      #
      def find_branch: (untyped name) -> untyped

      def find_tag: (untyped name) -> untyped

      def local_branches: (?sort_by: untyped?, ?pagination_params: untyped?) -> untyped

      # Returns the number of valid branches
      def branch_count: () -> untyped

      def remove: () -> untyped

      def replicate: (untyped source_repository, ?partition_hint: ::String) -> untyped

      def fork_repository: (untyped source_repository, ?untyped? branch) -> untyped

      def expire_has_local_branches_cache: () -> untyped

      def has_local_branches?: () -> untyped

      # Git repository can contains some hidden refs like:
      #   /refs/notes/*
      #   /refs/git-as-svn/*
      #   /refs/pulls/*
      # This refs by default not visible in project page and not cloned to client side.
      alias has_visible_content? has_local_branches?

      # Returns the number of valid tags
      def tag_count: () -> untyped

      # Returns an Array of tag names
      def tag_names: () -> untyped

      # Returns an Array of Tags
      #
      def tags: (?sort_by: untyped?, ?pagination_params: untyped?) -> untyped

      # Returns true if the given ref name exists
      #
      # Ref names must start with `refs/`.
      def ref_exists?: (untyped ref_name) -> untyped

      # Returns true if the given tag exists
      #
      # name - The name of the tag as a String.
      def tag_exists?: (untyped name) -> untyped

      # Returns true if the given branch exists
      #
      # name - The name of the branch as a String.
      def branch_exists?: (untyped name) -> untyped

      # Returns an Array of branch and tag names
      def ref_names: () -> untyped

      def delete_all_refs_except: (untyped prefixes) -> untyped

      def archive_metadata: (untyped ref, untyped storage_path, untyped project_path, ?::String format, append_sha: untyped, ?path: untyped?) -> (::Hash[untyped, untyped] | { "ArchivePrefix" => untyped, "ArchivePath" => untyped, "CommitId" => untyped, "GitalyRepository" => untyped, "StoragePath" => untyped })

      private

      # This is both the filename of the archive (missing the extension) and the
      # name of the top-level member of the archive under which all files go
      def archive_prefix: (untyped ref, untyped sha, untyped project_path, append_sha: untyped, path: untyped) -> untyped

      # The full path on disk where the archive should be stored. This is used
      # to cache the archive between requests.
      #
      # The path is a global namespace, so needs to be globally unique. This is
      # achieved by including `gl_repository` in the path.
      #
      # Archives relating to a particular ref when the SHA is not present in the
      # filename must be invalidated when the ref is updated to point to a new
      # SHA. This is achieved by including the SHA in the path.
      #
      # As this is a full path on disk, it is not "cloud native". This should
      # be resolved by either removing the cache, or moving the implementation
      # into Gitaly and removing the ArchivePath parameter from the git-archive
      # senddata response.
      def archive_file_path: (untyped storage_path, untyped sha, untyped name, ?::String format) -> (nil | untyped)

      def archive_version_path: () -> "@v2"

      public

      # Return repo size in megabytes
      def size: () -> untyped

      # Return repository recent objects size in mebibytes
      #
      # This differs from the #size method in that it does not include the size of:
      # - stale objects
      # - cruft packs of unreachable objects
      #
      # see: https://gitlab.com/gitlab-org/gitaly/-/blob/257ee33ca268d48c8f99dcbfeaaf7d8b19e07f06/internal/gitaly/service/repository/repository_info.go#L41-62
      def recent_objects_size: () -> untyped

      # Return git object directory size in bytes
      def object_directory_size: () -> untyped

      # Build an array of commits.
      #
      # Usage.
      #   repo.log(
      #     ref: 'master',
      #     path: 'app/models',
      #     limit: 10,
      #     offset: 5,
      #     after: Time.new(2016, 4, 21, 14, 32, 10),
      #     message_regex: 'project'
      #   )
      def log: (untyped options) -> untyped

      def new_commits: (untyped newrevs) -> untyped

      def check_objects_exist: (untyped refs) -> untyped

      def new_blobs: (untyped newrevs, ?dynamic_timeout: untyped?) -> (::Array[untyped] | untyped)

      # List blobs reachable via a set of revisions. Supports the
      # pseudo-revisions `--not` and `--all`. Uses the minimum of
      # GitalyClient.medium_timeout and dynamic timeout if the dynamic
      # timeout is set, otherwise it'll always use the medium timeout.
      def blobs: (untyped revisions, ?with_paths: bool, ?dynamic_timeout: untyped?) -> (::Array[untyped] | untyped)

      # Returns a hash mapping file paths to their object types (:blob, :tree, or :commit).
      #
      # revision_paths - Array of [revision, path] tuples
      # limit - Maximum bytes to fetch per blob (default: -1 for no limit)
      #
      def get_blob_types: (untyped revision_paths, ?::Integer limit) -> untyped

      def count_commits: (untyped options) -> untyped

      # Counts the amount of commits between `from` and `to`.
      def count_commits_between: (untyped from, untyped to, ?::Hash[untyped, untyped] options) -> untyped

      # old_rev and new_rev are commit ID's
      # the result of this method is an array of Gitlab::Git::RawDiffChange
      def raw_changes_between: (untyped old_rev, untyped new_rev) -> untyped

      # Returns the SHA of the most recent common ancestor of +from+ and +to+
      def merge_base: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      # Returns true is +from+ is direct ancestor to +to+, otherwise false
      def ancestor?: (untyped from, untyped to) -> untyped

      def merged_branch_names: (?untyped branch_names, ?include_identical: bool) -> (::Array[untyped] | untyped)

      # Returns an array of DiffBlob objects that represent a diff between
      # two blobs in a repository. For each diff generated, the pre-image and
      # post-image blob IDs should be obtained using `find_changed_paths` method.
      def diff_blobs: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      # Returns an array of DiffBlob objects that represent diffs between
      # pairs of blobs in a repository using raw changed path information.
      # More efficient for large batches of files compared to diff_blobs.
      def diff_blobs_with_raw_info: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      # Return an array of Diff objects that represent the diff
      # between +from+ and +to+.  See Diff::filter_diff_options for the allowed
      # diff options.  The +options+ hash can also include :break_rewrites to
      # split larger rewrites into delete/add pairs.
      def diff: (untyped from, untyped to, ?::Hash[untyped, untyped] options, *untyped paths) -> untyped

      def diff_stats: (untyped left_id, untyped right_id) -> untyped

      def find_changed_paths: (untyped treeish_objects, ?merge_commit_diff_mode: untyped?, ?find_renames: bool, ?diff_filters: untyped?) -> untyped

      # Get refs hash which key is the commit id
      # and value is a Gitlab::Git::Tag or Gitlab::Git::Branch
      # Note that both inherit from Gitlab::Git::Ref
      def refs_hash: () -> untyped

      # Returns matching refs for OID
      #
      # Limit of 0 means there is no limit.
      def refs_by_oid: (oid: untyped, ?limit: ::Integer, ?ref_patterns: untyped?) -> untyped

      # Returns url for submodule
      #
      # Ex.
      #   @repository.submodule_url_for('master', 'rack')
      #   # => git@localhost:rack.git
      #
      def submodule_url_for: (untyped ref, untyped path) -> untyped

      # Returns path to url mappings for submodules
      #
      # Ex.
      #   @repository.submodule_urls_for('master')
      #   # => { 'rack' => 'git@localhost:rack.git' }
      #
      def submodule_urls_for: (untyped ref) -> untyped

      # Return total diverging commits count
      def diverging_commit_count: (untyped from, untyped to, ?max_count: ::Integer) -> untyped

      # Mimic the `git clean` command and recursively delete untracked files.
      # Valid keys that can be passed in the +options+ hash are:
      #
      # :d - Remove untracked directories
      # :f - Remove untracked directories that are managed by a different
      #      repository
      # :x - Remove ignored files
      #
      # The value in +options+ must evaluate to true for an option to take
      # effect.
      #
      # Examples:
      #
      #   repo.clean(d: true, f: true) # Enable the -d and -f options
      #
      #   repo.clean(d: false, x: true) # -x is enabled, -d is not
      def clean: (?::Hash[untyped, untyped] options) -> untyped

      def add_branch: (untyped branch_name, user: untyped, target: untyped, ?skip_ci: bool) -> untyped

      def add_tag: (untyped tag_name, user: untyped, target: untyped, ?message: untyped?) -> untyped

      def update_branch: (untyped branch_name, user: untyped, newrev: untyped, oldrev: untyped) -> untyped

      def rm_branch: (untyped branch_name, user: untyped, ?target_sha: untyped?) -> untyped

      def rm_tag: (untyped tag_name, user: untyped) -> untyped

      def merge_to_ref: (untyped user, **untyped kwargs) -> untyped

      def merge: (untyped user, source_sha: untyped, target_branch: untyped, message: untyped, ?target_sha: untyped?, ?sign: bool) { (?) -> untyped } -> untyped

      def ff_merge: (untyped user, source_sha: untyped, target_branch: untyped, ?target_sha: untyped?) -> untyped

      # rubocop:disable Metrics/ParameterLists -- all arguments needed
      def revert: (user: untyped, commit: untyped, branch_name: untyped, message: untyped, start_branch_name: untyped, start_repository: untyped, ?dry_run: bool, ?target_sha: untyped?, ?sign: bool) -> untyped

      def cherry_pick: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      def update_submodule: (user: untyped, submodule: untyped, commit_sha: untyped, message: untyped, branch: untyped) -> untyped

      # Delete the specified branch from the repository
      # Note: No Git hooks are executed for this action
      def delete_branch: (untyped branch_name) -> untyped

      def async_delete_refs: (*untyped refs) -> untyped

      # Update a list of references from X -> Y
      #
      # Ref list is expected to be an array of hashes in the form:
      # old_sha:
      # new_sha
      # reference:
      #
      # When new_sha is Gitlab::Git::SHA1_BLANK_SHA, then this will be deleted
      def update_refs: (untyped ref_list) -> untyped

      def delete_refs: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      # Create a new branch named **ref+ based on **stat_point+, HEAD by default
      # Note: No Git hooks are executed for this action
      #
      # Examples:
      #   create_branch("feature")
      #   create_branch("other-feature", "master")
      def create_branch: (untyped ref, ?::String start_point) -> untyped

      def find_remote_root_ref: (untyped remote_url, ?untyped? authorization) -> (nil | untyped)

      # Returns result like "git ls-files" , recursive and full file path
      #
      # Ex.
      #   repo.ls_files('master')
      #
      def ls_files: (untyped ref) -> untyped

      def info_attributes: () -> untyped

      # Returns the Git attributes for the given file path.
      #
      # See `Gitlab::Git::Attributes` for more information.
      def attributes: (untyped path) -> untyped

      def gitattribute: (untyped path, untyped name) -> untyped

      # Returns parsed .gitattributes for a given ref
      #
      # This only parses the root .gitattributes file,
      # it does not traverse subfolders to find additional .gitattributes files
      #
      # This method is around 30 times slower than `attributes`, which uses
      # `$GIT_DIR/info/attributes`. Consider caching AttributesAtRefParser
      # and reusing that for multiple calls instead of this method.
      def attributes_at: (untyped ref) -> untyped

      def languages: (?untyped? ref) -> untyped

      def license: () -> untyped

      def fetch_source_branch!: (untyped source_repository, untyped source_branch, untyped local_ref) -> untyped

      def compare_source_branch: (untyped target_branch_name, untyped source_repository, untyped source_branch_name, straight: untyped) -> untyped

      def write_ref: (untyped ref_path, untyped ref, ?old_ref: untyped?) -> untyped

      # peel_tags slows down the request by a factor of 3-4
      def list_refs: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      # Refactoring aid; allows us to copy code from app/models/repository.rb
      def commit: (?::String ref) -> untyped

      def empty?: () -> untyped

      # Fetch remote for repository
      #
      # remote - remote name
      # url - URL of the remote to fetch. `remote` is not used in this case.
      # refmap - if url is given, determines which references should get fetched where
      # ssh_auth - SSH known_hosts data and a private key to use for public-key authentication
      # forced - should we use --force flag?
      # no_tags - should we use --no-tags flag?
      # prune - should we use --prune flag?
      # resolved_address - resolved IP address for provided URL
      def fetch_remote: (untyped url, ?refmap: untyped?, ?ssh_auth: untyped?, ?forced: bool, ?no_tags: bool, ?prune: bool, ?http_authorization_header: ::String, ?resolved_address: ::String) -> untyped

      def import_repository: (untyped url, ?http_authorization_header: ::String, ?mirror: bool, ?resolved_address: ::String) -> untyped

      def blob_at: (untyped sha, untyped path, ?limit: untyped) -> (untyped | nil)

      # Items should be of format [[commit_id, path], [commit_id1, path1]]
      def batch_blobs: (untyped items, ?blob_size_limit: untyped) -> untyped

      def fsck: () -> untyped

      def create_from_bundle: (untyped bundle_path) -> untyped

      def rebase: (untyped user, untyped rebase_id, branch: untyped, branch_sha: untyped, remote_repository: untyped, remote_branch: untyped, ?push_options: untyped) { (?) -> untyped } -> untyped

      def rebase_to_ref: (untyped user, source_sha: untyped, target_ref: untyped, first_parent_ref: untyped, ?expected_old_oid: ::String) -> untyped

      def squash: (untyped user, start_sha: untyped, end_sha: untyped, author: untyped, message: untyped, ?sign: bool) -> untyped

      def bundle_to_disk: (untyped save_path) -> true

      # Returns the initial commit (first commit with no parents) for the given ref
      # @param ref [String] The reference to start from (default: root_ref)
      # @return [Gitlab::Git::Commit, nil]
      def initial_commit: (?untyped? ref) -> (nil | untyped)

      # Creates a commit
      #
      # @param [User] user The committer of the commit.
      # @param [String] branch_name: The name of the branch to be created/updated.
      # @param [String] message: The commit message.
      # @param [Array<Hash>] actions: An array of files to be added/updated/removed.
      # @option actions: [Symbol] :action One of :create, :create_dir, :update, :move, :delete, :chmod
      # @option actions: [String] :file_path The path of the file or directory being added/updated/removed.
      # @option actions: [String] :previous_path The path of the file being moved. Only used for the :move action.
      # @option actions: [String,IO] :content The file content for :create or :update
      # @option actions: [String] :encoding One of text, base64
      # @option actions: [Boolean] :execute_filemode True sets the executable filemode on the file.
      # @option actions: [Boolean] :infer_content True uses the existing file contents instead of using content on move.
      # @param [String] author_email: The authors email, if unspecified the committers email is used.
      # @param [String] author_name: The authors name, if unspecified the committers name is used.
      # @param [String] start_branch_name: The name of the branch to be used as the parent of the commit. Only used if start_sha: is unspecified.
      # @param [String] start_sha: The sha to be used as the parent of the commit.
      # @param [Gitlab::Git::Repository] start_repository: The repository that contains the start branch or sha. Defaults to use this repository.
      # @param [Boolean] force: Force update the branch.
      # @param [String] target_sha: The latest sha of the target branch (optional). Used to prevent races in updates between different clients.
      # @return [Gitlab::Git::OperationService::BranchUpdate]
      #
      # rubocop:disable Metrics/ParameterLists
      def commit_files: (untyped user, branch_name: untyped, message: untyped, actions: untyped, ?author_email: untyped?, ?author_name: untyped?, ?start_branch_name: untyped?, ?start_sha: untyped?, ?start_repository: untyped?, ?force: bool, ?sign: bool, ?target_sha: untyped?) -> untyped

      def disconnect_alternates: () -> untyped

      def gitaly_repository: () -> untyped

      def gitaly_ref_client: () -> untyped

      def gitaly_commit_client: () -> untyped

      def gitaly_repository_client: () -> untyped

      def gitaly_operation_client: () -> untyped

      def gitaly_remote_client: () -> untyped

      def gitaly_blob_client: () -> untyped

      def gitaly_diff_client: () -> untyped

      def gitaly_conflicts_client: (untyped our_commit_oid, untyped their_commit_oid) -> untyped

      def praefect_info_client: () -> untyped

      def gitaly_analysis_client: () -> untyped

      def branch_names_contains_sha: (untyped sha, ?limit: ::Integer) -> untyped

      def tag_names_contains_sha: (untyped sha, ?limit: ::Integer) -> untyped

      def search_files_by_content: (untyped query, untyped ref, ?::Hash[untyped, untyped] options) -> (::Array[untyped] | untyped)

      def can_be_merged?: (untyped source_sha, untyped target_branch) -> (untyped | false)

      def search_files_by_name: (untyped query, untyped ref, ?limit: ::Integer, ?offset: ::Integer) -> (::Array[untyped] | untyped)

      def search_files_by_regexp: (untyped filter, ?::String ref, ?limit: ::Integer, ?offset: ::Integer) -> untyped

      def find_commits_by_message: (untyped query, untyped ref, untyped path, untyped limit, untyped offset) -> untyped

      def list_commits: (ref: untyped, ?query: untyped?, ?author: untyped?, ?path: untyped?, ?committed_before: untyped?, ?committed_after: untyped?, ?pagination_params: ::Hash[untyped, untyped], ?literal_pathspec: bool) -> untyped

      def list_last_commits_for_tree: (untyped sha, untyped path, ?offset: ::Integer, ?limit: ::Integer, ?literal_pathspec: bool) -> untyped

      def list_commits_by_ref_name: (untyped refs) -> untyped

      def last_commit_for_path: (untyped sha, untyped path, ?literal_pathspec: bool) -> untyped

      def checksum: () -> untyped

      def replicas: () -> untyped

      def get_patch_id: (untyped old_revision, untyped new_revision) -> untyped

      def object_pool: () -> untyped

      # Note: this problem should be addressed in https://gitlab.com/gitlab-org/gitlab/-/issues/441770
      # Gitlab::Git::Repository shouldn't call Repository directly
      # Instead empty_tree_id value should be passed to Gitaly client
      # via method arguments
      def empty_tree_id: () -> untyped

      def object_format: () -> untyped

      def get_file_attributes: (untyped revision, untyped file_paths, untyped attributes) -> untyped

      # rubocop: disable CodeReuse/ActiveRecord -- not an active record operation
      def detect_generated_files: (untyped base, untyped head, untyped changed_paths) -> untyped

      private

      def valid_message_regex?: (untyped pattern) -> untyped

      def check_blobs_generated: (untyped base, untyped head, untyped changed_paths) -> untyped

      def repository_info_size_megabytes: () -> untyped

      def empty_diff_stats: () -> untyped

      def uncached_has_local_branches?: () -> untyped

      def gitaly_merged_branch_names: (untyped branch_names, untyped root_sha, untyped root_branch_name, ?include_identical: bool) -> untyped

      def process_count_commits_options: (untyped options) -> untyped

      def gitaly_submodule_url_for: (untyped ref, untyped path) -> (nil | untyped)

      def gitaly_submodule_urls_for: (untyped ref) -> (nil | untyped)

      # Returns true if the given ref name exists
      #
      # Ref names must start with `refs/`.
      def gitaly_ref_exists?: (untyped ref_name) -> untyped

      def gitaly_delete_refs: (*untyped ref_names) -> (untyped | nil)

      # The order is based on git priority to resolve ambiguous references
      #
      # `git show <ref>`
      #
      # In case of name clashes, it uses this order:
      # 1. Commit
      # 2. Tag
      # 3. Branch
      def extract_commit_id_from_ref: (untyped ref) -> untyped
    end
  end
end
