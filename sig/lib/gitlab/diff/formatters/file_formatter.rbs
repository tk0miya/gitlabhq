module Gitlab
  module Diff
    module Formatters
      class FileFormatter < BaseFormatter
        @ignore_whitespace_change: untyped

        @key: untyped

        def initialize: (untyped attrs) -> void

        def key: () -> untyped

        def position_type: () -> "file"

        def complete?: () -> untyped

        def ==: (untyped other) -> untyped
      end
    end
  end
end
