module Gitlab
  module Diff
    class ImagePoint
      @width: untyped

      @height: untyped

      @x: untyped

      @y: untyped

      attr_reader width: untyped

      attr_reader height: untyped

      attr_reader x: untyped

      attr_reader y: untyped

      def initialize: (untyped width, untyped height, untyped new_x, untyped new_y) -> void

      def to_h: () -> { width: untyped, height: untyped, x: untyped, y: untyped }
    end
  end
end
