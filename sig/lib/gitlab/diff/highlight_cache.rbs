module Gitlab
  module Diff
    class HighlightCache
      @diff_collection: untyped

      include Gitlab::Utils::Gzip

      include Gitlab::Utils::StrongMemoize

      EXPIRATION: untyped

      VERSION: 2

      def initialize: (untyped diff_collection) -> void

      # - Reads from cache
      # - Assigns DiffFile#highlighted_diff_lines for cached files
      #
      def decorate: (untyped diff_file) -> (::Array[untyped] | untyped)

      # For every file that isn't already contained in the redis hash, store the
      #   result of #highlighted_diff_lines, then submit the uncached content
      #   to #write_to_redis_hash to submit a single write. This avoids excessive
      #   IO generated by N+1's (1 writing for each highlighted line or file).
      #
      def write_if_empty: () -> (nil | untyped)

      def clear: () -> untyped

      def key: () -> untyped

      private

      def set_highlighted_diff_lines: (untyped diff_file, untyped content) -> untyped

      def recache_due_to_size?: (untyped diff_file) -> untyped

      def cacheable_files: () -> untyped

      # Given a hash of:
      #   { "file/to/cache" =>
      #   [ { line_code: "a5cc2925ca8258af241be7e5b0381edf30266302_19_19",
      #       rich_text: " <span id=\"LC19\" class=\"line\" lang=\"plaintext\">config/initializers/secret_token.rb</span>\n",
      #       text: " config/initializers/secret_token.rb",
      #       type: nil,
      #       index: 3,
      #       old_pos: 19,
      #       new_pos: 19 }
      #   ] }
      #
      #   ...it will write/update a Gitlab::Redis hash (HSET)
      #
      def write_to_redis_hash: (untyped hash) -> untyped

      def record_memory_usage: (untyped memory_usage) -> (untyped | nil)

      def fetch_memory_usage: (untyped redis, untyped key) -> (nil | untyped)

      def file_paths: () -> untyped

      def read_file: (untyped diff_file) -> untyped

      def cached_content: () -> untyped

      def read_cache: () -> (::Hash[untyped, untyped] | untyped)

      def cacheable?: (untyped diff_file) -> untyped

      def diff_files: () -> untyped

      def current_transaction: () -> untyped

      def with_redis: () { (?) -> untyped } -> untyped

      def record_hit_ratio: (untyped results) -> untyped
    end
  end
end
