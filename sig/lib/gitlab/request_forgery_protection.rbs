module Gitlab
  module RequestForgeryProtection
    self.@app: untyped

    class Controller < BaseActionController
      def initialize: () -> void

      def index: () -> untyped
    end

    def self.app: () -> untyped

    def self.call: (untyped env) -> untyped

    def self.verified?: (untyped env) -> untyped
  end
end
