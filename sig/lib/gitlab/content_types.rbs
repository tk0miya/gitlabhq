module Gitlab
  module ContentTypes
    extend ::Gitlab::ContentTypes

    SAFE_CONTENT_TYPES: ::Array["application/octet-stream" | "application/gzip" | "application/zip" | "application/x-7z-compressed" | "application/x-xz" | "application/x-debian-package" | "application/java-archive" | "application/vnd.android.package-archive" | "application/x-apple-diskimage" | "application/x-tar" | "application/x-gtar" | "application/x-bzip2" | "application/x-iso9660-image"]

    DEFAULT_CONTENT_TYPE: "application/octet-stream"

    def sanitize_content_type: (untyped content_type) -> untyped
  end
end
