module Gitlab
  module SidekiqConfig
    # For queues that don't have explicit workers - default and mailers
    class DummyWorker
      @attributes: untyped

      ATTRIBUTE_METHODS: { name: :name, has_external_dependencies: :worker_has_external_dependencies?, urgency: :get_urgency, resource_boundary: :get_worker_resource_boundary, idempotent: :idempotent?, weight: :get_weight, tags: :get_tags }

      def initialize: (?::Hash[untyped, untyped] attributes) -> void

      def generated_queue_name: () -> untyped

      def queue: () -> untyped

      def queue_namespace: () -> nil

      # All dummy workers are unowned; get the feature category from the
      # context if available.
      def get_feature_category: () -> untyped

      def feature_category_not_owned?: () -> true

      def get_worker_context: () -> nil

      def context_for_arguments: (*untyped) -> nil
    end
  end
end
