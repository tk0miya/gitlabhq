module Gitlab
  module ErrorTracking
    class LogFormatter
      # Note: all the accesses to Sentry's contexts here are to keep the
      # backward-compatibility to Sentry's built-in integrations. In the future,
      # they can be removed.
      def generate_log: (untyped exception, untyped context_payload) -> untyped

      private

      def append_user_to_log!: (untyped payload, untyped context_payload) -> untyped

      def append_tags_to_log!: (untyped payload, untyped context_payload) -> untyped

      def append_extra_to_log!: (untyped payload, untyped context_payload) -> untyped
    end
  end
end
