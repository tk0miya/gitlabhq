module Gitlab
  module ErrorTracking
    module Processor
      module GrpcErrorProcessor
        extend Gitlab::ErrorTracking::Processor::Concerns::ProcessesExceptions

        # Braces added by gRPC Ruby code: https://github.com/grpc/grpc/blob/0e38b075ffff72ab2ad5326e3f60ba6dcc234f46/src/ruby/lib/grpc/errors.rb#L46
        DEBUG_ERROR_STRING_REGEX: untyped

        def self.call: (untyped event) -> untyped

        # Sentry can report multiple exceptions in an event. Sanitize
        # only the first one since that's what is used for grouping.
        def self.process_first_exception_value: (untyped event) -> (nil | untyped)

        def self.process_custom_fingerprint: (untyped event) -> untyped

        def self.custom_grpc_fingerprint?: (untyped fingerprint) -> untyped

        def self.split_debug_error_string: (untyped message) -> (nil | ::Array[untyped])
      end
    end
  end
end
