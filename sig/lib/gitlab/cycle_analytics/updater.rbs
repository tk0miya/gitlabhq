module Gitlab
  module CycleAnalytics
    class Updater
      @event_result: untyped

      @klass: untyped

      @from: untyped

      @to: untyped

      @items: untyped

      def self.update!: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      def initialize: (untyped event_result, from: untyped, to: untyped, klass: untyped) -> void

      def update!: () -> untyped

      def result_ids: () -> untyped

      def items: () -> untyped
    end
  end
end
