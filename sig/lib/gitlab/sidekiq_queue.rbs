module Gitlab
  class SidekiqQueue
    @queue_name: untyped

    @sidekiq_queues: untyped

    include Gitlab::Utils::StrongMemoize

    NoMetadataError: untyped

    InvalidQueueError: untyped

    WORKER_KEY: "worker_class"

    ALLOWED_KEYS: untyped

    attr_reader queue_name: untyped

    def initialize: (untyped queue_name) -> void

    def drop_jobs!: (untyped search_metadata, timeout: untyped) -> { completed: untyped, deleted_jobs: untyped, queue_size: untyped }

    private

    def transform_key: (untyped key) -> (::String | "class" | nil)

    def sidekiq_queues: () -> untyped

    def queue_size: () -> untyped

    def job_matches?: (untyped job, untyped job_search_metadata) -> untyped

    def timeout_exceeded?: (untyped start_time, untyped timeout) -> untyped

    def monotonic_time: () -> untyped
  end
end
