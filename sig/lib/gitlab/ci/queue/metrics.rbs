module Gitlab
  module Ci
    module Queue
      class Metrics
        @runner: untyped

        extend Gitlab::Utils::StrongMemoize

        QUEUE_DURATION_SECONDS_BUCKETS: ::Array[1 | 3 | 10 | 30 | 60 | 300 | 900 | 1800 | 3600]

        QUEUE_ACTIVE_RUNNERS_BUCKETS: ::Array[1 | 3 | 10 | 30 | 60 | 300 | 900 | 1800 | 3600]

        QUEUE_DEPTH_TOTAL_BUCKETS: ::Array[1 | 2 | 3 | 5 | 8 | 16 | 32 | 50 | 100 | 250 | 500 | 1000 | 2000 | 5000]

        QUEUE_SIZE_TOTAL_BUCKETS: ::Array[1 | 5 | 10 | 50 | 100 | 500 | 1000 | 2000 | 5000 | 7500 | 10000 | 15000 | 20000]

        QUEUE_PROCESSING_DURATION_SECONDS_BUCKETS: ::Array[::Float | 1 | 5 | 10 | 15 | 20 | 30 | 60]

        METRICS_SHARD_TAG_PREFIX: "metrics_shard::"

        DEFAULT_METRICS_SHARD: "default"

        OPERATION_COUNTERS: untyped

        QUEUE_DEPTH_HISTOGRAMS: untyped

        attr_reader runner: untyped

        def initialize: (untyped runner) -> void

        def register_failure: () -> untyped

        def register_success: (untyped job) -> untyped

        def increment_queue_operation: (untyped operation) -> untyped

        def observe_queue_depth: (untyped queue, untyped size) -> (nil | untyped)

        def observe_queue_size: (untyped size_proc, untyped runner_type) -> (nil | untyped)

        def observe_queue_time: (untyped metric, untyped runner_type) { () -> untyped } -> untyped

        def self.increment_queue_operation: (untyped operation) -> untyped

        def self.observe_active_runners: (untyped runners_proc) -> (nil | untyped)

        def self.increment_runner_tick: (untyped runner) -> untyped

        def self.failed_attempt_counter: () -> untyped

        def self.attempt_counter: () -> untyped

        def self.job_queue_duration_seconds: () -> untyped

        def self.queue_operations_total: () -> untyped

        def self.queue_depth_total: () -> untyped

        def self.queue_size_total: () -> untyped

        def self.current_queue_size: () -> untyped

        def self.queue_iteration_duration_seconds: () -> untyped

        def self.queue_retrieval_duration_seconds: () -> untyped

        def self.queue_active_runners_total: () -> untyped
      end
    end
  end
end
