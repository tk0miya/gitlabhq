module Gitlab
  module Ci
    class Config
      module External
        class Mapper
          # Fetches file contents and verifies them
          class Verifier < Base
            def skip_load_content!: () -> untyped

            private

            def process_without_instrumentation: (untyped files) -> untyped

            def verify_max_includes!: () -> (nil | untyped)

            def verify_execution_time!: () -> untyped

            def verify_max_total_pipeline_size!: () -> (nil | untyped)
          end
        end
      end
    end
  end
end
