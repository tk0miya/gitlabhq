module Gitlab
  module Ci
    class Config
      module External
        class Mapper
          # Base class for mapper classes
          class Base
            @context: untyped

            def initialize: (untyped context) -> void

            def process: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

            private

            attr_reader context: untyped

            def process_without_instrumentation: () -> untyped

            def mapper_instrumentation_key: () -> ::Symbol
          end
        end
      end
    end
  end
end
