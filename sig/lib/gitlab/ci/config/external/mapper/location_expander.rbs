module Gitlab
  module Ci
    class Config
      module External
        class Mapper
          # Expands locations to include all files matching the pattern
          class LocationExpander < Base
            private

            def process_without_instrumentation: (untyped locations) -> untyped

            def expand_project_files: (untyped location) -> untyped

            def expand_wildcard_paths: (untyped location) -> untyped
          end
        end
      end
    end
  end
end
