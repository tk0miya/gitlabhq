module Gitlab
  module Ci
    class Config
      module External
        class Mapper
          # Converts locations to canonical form (local:/remote:) if String
          class Normalizer < Base
            @variables_expander: untyped

            def initialize: (untyped context) -> void

            private

            attr_reader variables_expander: untyped

            def process_without_instrumentation: (untyped locations) -> untyped

            def normalize_location_string: (untyped location) -> ({ remote: untyped } | { local: untyped })
          end
        end
      end
    end
  end
end
