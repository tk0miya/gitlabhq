module Gitlab
  module Ci
    class Config
      module External
        class Mapper
          # Handles variable expansion
          class VariablesExpander < Base
            @variables: untyped

            def expand: (untyped data) -> untyped

            private

            def process_without_instrumentation: (untyped locations) -> untyped

            def transform_and_expand_variable: (untyped data) -> untyped

            def expand_variable: (untyped data) -> untyped

            def variables: () -> untyped
          end
        end
      end
    end
  end
end
