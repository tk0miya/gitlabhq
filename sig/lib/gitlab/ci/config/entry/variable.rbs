module Gitlab
  module Ci
    class Config
      module Entry
        #
        # Entry that represents a CI/CD variable.
        #
        class Variable < ::Gitlab::Config::Entry::Simplifiable
          class SimpleVariable < ::Gitlab::Config::Entry::Node
            include ::Gitlab::Config::Entry::Validatable

            def self.applies_to?: (untyped config) -> untyped

            def value: () -> untyped

            def value_with_data: () -> { value: untyped }

            def value_with_prefill_data: () -> untyped
          end

          class ComplexVariable < ::Gitlab::Config::Entry::Node
            include ::Gitlab::Config::Entry::Validatable

            include ::Gitlab::Config::Entry::Attributable

            def self.applies_to?: (untyped config) -> untyped

            def value: () -> untyped

            def value_with_data: () -> untyped

            def value_with_prefill_data: () -> untyped
          end

          class UnknownStrategy < ::Gitlab::Config::Entry::Node
            def errors: () -> ::Array["variable definition must be either a string or a hash"]
          end
        end
      end
    end
  end
end
