module Gitlab
  module Ci
    class Config
      module Entry
        #
        # Entry that represents a configuration of job artifacts.
        #
        class Reports < ::Gitlab::Config::Entry::Node
          include ::Gitlab::Config::Entry::Configurable

          include ::Gitlab::Config::Entry::Validatable

          include ::Gitlab::Config::Entry::Attributable

          ALLOWED_KEYS: ::Array[:junit | :codequality | :sast | :secret_detection | :dependency_scanning | :container_scanning | :dast | :performance | :browser_performance | :load_performance | :license_scanning | :metrics | :lsif | :dotenv | :terraform | :accessibility | :coverage_fuzzing | :api_fuzzing | :cluster_image_scanning | :requirements | :requirements_v2 | :coverage_report | :cyclonedx | :annotations | :repository_xray | :sarif]

          def value: () -> untyped
        end
      end
    end
  end
end
