module Gitlab
  module Ci
    class Config
      module Entry
        #
        # Entry that represents a hidden CI/CD key.
        #
        class Hidden < ::Gitlab::Config::Entry::Node
          include ::Gitlab::Config::Entry::Validatable

          def self.matching?: (untyped name, untyped config) -> untyped

          def self.visible?: () -> false

          def relevant?: () -> false
        end
      end
    end
  end
end
