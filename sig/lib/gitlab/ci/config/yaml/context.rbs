module Gitlab
  module Ci
    class Config
      module Yaml
        class Context
          @variables: untyped

          @component: untyped

          attr_reader variables: untyped

          attr_reader component: untyped

          def initialize: (?variables: untyped, ?component: ::Hash[untyped, untyped]) -> void
        end
      end
    end
  end
end
