module Gitlab
  module Ci
    module Build
      class Hook
        @name: untyped

        @script: untyped

        attr_reader name: untyped

        attr_reader script: untyped

        def self.from_hooks: (untyped job) -> untyped

        def initialize: (untyped name, untyped script) -> void
      end
    end
  end
end
