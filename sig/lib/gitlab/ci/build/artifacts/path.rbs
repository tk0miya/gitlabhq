module Gitlab
  module Ci
    module Build
      module Artifacts
        class Path
          @path: untyped

          def initialize: (untyped path) -> void

          def valid?: () -> untyped

          def directory?: () -> untyped

          def name: () -> untyped

          def nodes: () -> untyped

          def to_s: () -> untyped

          private

          def nonzero?: () -> untyped

          def utf8?: () -> untyped
        end
      end
    end
  end
end
