module Gitlab
  module Ci
    module Build
      module Artifacts
        module Adapters
          class GzipStream
            @stream: untyped

            attr_reader stream: untyped

            InvalidStreamError: untyped

            def initialize: (untyped stream) -> void

            def each_blob: () { (untyped, untyped) -> untyped } -> untyped

            private

            def gzip: (untyped stream) { (untyped) -> untyped } -> untyped
          end
        end
      end
    end
  end
end
