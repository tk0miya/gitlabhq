module Gitlab
  module Ci
    module Build
      module Credentials
        module Registry
          class GitlabRegistry < Credentials::Base
            @username: untyped

            @password: untyped

            attr_reader username: untyped

            attr_reader password: untyped

            def initialize: (untyped build) -> void

            def url: () -> untyped

            def valid?: () -> untyped

            def type: () -> "registry"
          end
        end
      end
    end
  end
end
