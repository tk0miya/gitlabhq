module Gitlab
  module Ci
    module Build
      class Port
        @name: untyped

        @protocol: untyped

        @number: untyped

        DEFAULT_PORT_NAME: "default_port"

        DEFAULT_PORT_PROTOCOL: "http"

        attr_reader number: untyped

        attr_reader protocol: untyped

        attr_reader name: untyped

        def initialize: (untyped port) -> void

        def valid?: () -> untyped
      end
    end
  end
end
