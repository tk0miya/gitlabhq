module Gitlab
  module Ci
    module Reports
      module Security
        class Link
          @name: untyped

          @url: untyped

          attr_accessor name: untyped

          attr_accessor url: untyped

          def initialize: (?name: untyped?, ?url: untyped?) -> void

          def to_hash: () -> untyped

          def ==: (untyped other) -> untyped
        end
      end
    end
  end
end
