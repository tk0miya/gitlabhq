module Gitlab
  module Ci
    module Reports
      module Security
        class Scan
          @type: untyped

          @status: untyped

          @start_time: untyped

          @end_time: untyped

          @partial_scan_mode: untyped

          attr_accessor type: untyped

          attr_accessor status: untyped

          attr_accessor start_time: untyped

          attr_accessor end_time: untyped

          attr_accessor partial_scan_mode: untyped

          def initialize: (?::Hash[untyped, untyped] params) -> void

          def to_hash: () -> untyped
        end
      end
    end
  end
end
