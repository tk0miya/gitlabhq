module Gitlab
  module Ci
    module Reports
      module Security
        module Locations
          class Sast < Base
            @class_name: untyped

            @end_line: untyped

            @file_path: untyped

            @method_name: untyped

            @start_line: untyped

            include Security::Concerns::FingerprintPathFromFile

            attr_reader class_name: untyped

            attr_reader end_line: untyped

            attr_reader file_path: untyped

            attr_reader method_name: untyped

            attr_reader start_line: untyped

            def initialize: (file_path: untyped, start_line: untyped, ?end_line: untyped?, ?class_name: untyped?, ?method_name: untyped?) -> void

            def fingerprint_data: () -> ::String
          end
        end
      end
    end
  end
end
