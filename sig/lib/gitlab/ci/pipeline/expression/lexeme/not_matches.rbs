module Gitlab
  module Ci
    module Pipeline
      module Expression
        module Lexeme
          class NotMatches < Lexeme::LogicalOperator
            PATTERN: ::Regexp

            def evaluate: (?::Hash[untyped, untyped] variables) -> (true | untyped)

            def self.build: (untyped _value, untyped behind, untyped ahead) -> untyped

            def self.precedence: () -> 10
          end
        end
      end
    end
  end
end
