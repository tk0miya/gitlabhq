module Gitlab
  module Ci
    module Pipeline
      module Expression
        module Lexeme
          class LogicalOperator < Lexeme::Operator
            @left: untyped

            @right: untyped

            attr_reader left: untyped

            attr_reader right: untyped

            def initialize: (untyped left, untyped right) -> void

            def inspect: () -> ::String

            def self.type: () -> :logical_operator

            private

            def compare_with_coercion: (untyped left, untyped right) -> untyped

            def boolean_string_comparison?: (untyped left, untyped right) -> untyped

            def boolean?: (untyped value) -> untyped

            def string?: (untyped value) -> untyped

            def coerce_to_string: (untyped value) -> untyped
          end
        end
      end
    end
  end
end
