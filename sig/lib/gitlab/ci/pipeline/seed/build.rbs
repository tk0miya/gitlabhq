module Gitlab
  module Ci
    module Pipeline
      module Seed
        class Build < Seed::Base
          @context: untyped

          @pipeline: untyped

          @seed_attributes: untyped

          @stages_for_needs_lookup: untyped

          @needs_attributes: untyped

          @resource_group_key: untyped

          @job_variables: untyped

          @execution_config_attribute: untyped

          @root_variables_inheritance: untyped

          @inputs: untyped

          @using_rules: untyped

          @using_only: untyped

          @using_except: untyped

          @only: untyped

          @except: untyped

          @rules: untyped

          @cache: untyped

          include Gitlab::Utils::StrongMemoize

          def initialize: (untyped context, untyped attributes, untyped stages_for_needs_lookup) -> void

          def name: () -> untyped

          def included?: () -> untyped

          def errors: () -> untyped

          def attributes: () -> untyped

          def bridge?: () -> untyped

          def to_resource: () -> untyped

          private

          def all_of_only?: () -> untyped

          def none_of_except?: () -> untyped

          def needs_errors: () -> (nil | ::Array[::String] | untyped)

          def need_present?: (untyped need) -> untyped

          def max_needs_allowed: () -> untyped

          def variable_expansion_errors: () -> untyped

          def pipeline_attributes: () -> { pipeline: untyped, project: untyped, user: untyped, ref: untyped, tag: untyped, protected: untyped, partition_id: untyped }

          # Scoped user is present when the user creating the pipeline supports composite identity.
          # For example: a service account like GitLab Duo. The scoped user is used to further restrict
          # the permissions of the CI job token associated to the `job.user`.
          def scoped_user_id_attribute: () -> (::Hash[untyped, untyped] | { scoped_user_id: untyped })

          def rules_attributes: () -> (::Hash[untyped, untyped] | untyped)

          def rules_result: () -> untyped

          def rules_errors: () -> (::Array[::String] | nil)

          def evaluate_context: () -> untyped

          def runner_tags: () -> untyped

          def evaluate_runner_tags: () -> untyped

          # If a job uses `allow_failure:exit_codes` and `rules:allow_failure`
          # we need to prevent the exit codes from being persisted because they
          # would break the behavior defined by `rules:allow_failure`.
          def allow_failure_criteria_attributes: () -> (::Hash[untyped, untyped] | { options: { allow_failure_criteria: nil } })

          def inputs_attributes: () -> (::Hash[untyped, untyped] | { options: { inputs: untyped } })

          def suspend_options_attributes: () -> (::Hash[untyped, untyped] | { options: { suspend_options: untyped } })

          def calculate_yaml_variables!: () -> untyped

          def add_execution_config: (untyped attrs) -> untyped
        end
      end
    end
  end
end
