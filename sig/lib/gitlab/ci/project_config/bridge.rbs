module Gitlab
  module Ci
    class ProjectConfig
      class Bridge < Source
        extend ::Gitlab::Utils::Override

        def content: () -> (nil | untyped)

        # Bridge.yaml_for_downstream injects an `include`
        def internal_include_prepended?: () -> true

        def source: () -> :bridge_source

        def url: () -> untyped
      end
    end
  end
end
