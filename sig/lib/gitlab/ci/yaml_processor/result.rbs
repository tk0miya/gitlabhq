# A data object that wraps `Ci::Config` and any messages
# (errors, warnings) generated by the YamlProcessor.
module Gitlab
  module Ci
    class YamlProcessor
      class Result
        @ci_config: untyped

        @errors: untyped

        @warnings: untyped

        @included_templates: untyped

        @jobs: untyped

        @root_variables: untyped

        @root_variables_with_prefill_data: untyped

        @stages: untyped

        @job_name_mappings: untyped

        @workflow_rules: untyped

        @workflow_name: untyped

        @workflow_auto_cancel: untyped

        include Gitlab::Utils::StrongMemoize

        attr_reader ci_config: untyped

        attr_reader errors: untyped

        attr_reader warnings: untyped

        attr_reader root_variables: untyped

        attr_reader root_variables_with_prefill_data: untyped

        attr_reader stages: untyped

        attr_reader jobs: untyped

        attr_reader job_name_mappings: untyped

        attr_reader workflow_rules: untyped

        attr_reader workflow_name: untyped

        attr_reader workflow_auto_cancel: untyped

        def initialize: (?ci_config: untyped?, ?errors: untyped, ?warnings: untyped) -> void

        def valid?: () -> untyped

        def stages_attributes: () -> untyped

        def builds: () -> untyped

        def included_templates: () -> untyped

        def uses_keyword?: (untyped keyword) -> untyped

        def uses_nested_keyword?: (untyped path) -> untyped

        def uses_inputs?: () -> (false | untyped)

        def uses_input_rules?: () -> (false | untyped)

        def included_components: () -> untyped

        def yaml_variables_for: (untyped job_name) -> (::Array[untyped] | untyped)

        def stage_for: (untyped job_name) -> untyped

        def config_metadata: () -> untyped

        def clear_jobs!: () -> untyped

        private

        def has_nested_key?: (untyped hash, *untyped keys) -> (false | true)

        def assign_valid_attributes: () -> untyped

        def stage_builds_attributes: (untyped stage) -> untyped

        def build_attributes: (untyped name) -> untyped

        def transform_to_array: (untyped variables) -> untyped

        def build_execution_config: (untyped job) -> untyped
      end
    end
  end
end
