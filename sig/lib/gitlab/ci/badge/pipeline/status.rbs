module Gitlab::Ci
  module Badge
    module Pipeline
      #
      # Pipeline status badge
      #
      class Status < Badge::Base
        @project: untyped

        @ref: untyped

        @ignore_skipped: untyped

        @customization: untyped

        @metadata: untyped

        @template: untyped

        attr_reader project: untyped

        attr_reader ref: untyped

        attr_reader customization: untyped

        def initialize: (untyped project, untyped ref, ?opts: ::Hash[untyped, untyped]) -> void

        def entity: () -> "pipeline"

        def status: () -> untyped

        def metadata: () -> untyped

        def template: () -> untyped
      end
    end
  end
end
