module Gitlab::Ci
  module Badge
    #
    # Abstract class for badge metadata
    #
    class Metadata
      @badge: untyped

      include Gitlab::Routing

      include ActionView::Helpers::AssetTagHelper

      def initialize: (untyped badge) -> void

      def to_html: () -> untyped

      def to_markdown: () -> ::String

      def to_asciidoc: () -> ::String

      def title: () -> untyped

      def image_url: () -> untyped

      def link_url: () -> untyped
    end
  end
end
