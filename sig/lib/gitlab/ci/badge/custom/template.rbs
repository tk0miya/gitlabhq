module Gitlab
  module Ci
    module Badge
      module Custom
        #
        # Class that represents a custom badge template.
        #
        # Template object will be passed to badge.svg.erb template.
        #
        class Template < Badge::Template
          @badge: untyped

          @key_color: untyped

          @value_width: untyped

          @value_color: untyped

          @value_text: untyped

          VALUE_WIDTH_DEFAULT: 54

          VALUE_WIDTH_MAXIMUM: 200

          KEY_COLOR_DEFAULT: "#9f9f9f"

          VALUE_COLOR_DEFAULT: "#e05d44"

          VALUE_TEXT_DEFAULT: "none"

          MAX_VALUE_TEXT_SIZE: 128

          HEX_COLOR_3_REGEX: ::Regexp

          HEX_COLOR_6_REGEX: ::Regexp

          NAMED_COLOR_REGEX: ::Regexp

          MAX_COLOR_LENGTH: 22

          def initialize: (untyped badge) -> void

          def value_width: () -> untyped

          def key_color: () -> untyped

          def value_text: () -> untyped

          def value_color: () -> untyped

          private

          def parse_color: (untyped input_color, untyped default_color) -> (::String | untyped)
        end
      end
    end
  end
end
