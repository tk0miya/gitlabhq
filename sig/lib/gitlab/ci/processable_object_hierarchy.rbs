module Gitlab
  module Ci
    class ProcessableObjectHierarchy < ::Gitlab::ObjectHierarchy
      private

      def middle_table: () -> untyped

      def from_tables: (untyped cte) -> ::Array[untyped]

      def parent_id_column: (untyped _cte) -> untyped

      def ancestor_conditions: (untyped cte) -> untyped

      def descendant_conditions: (untyped cte) -> untyped
    end
  end
end
