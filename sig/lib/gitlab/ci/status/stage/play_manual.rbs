module Gitlab
  module Ci
    module Status
      module Stage
        class PlayManual < Status::Extended
          include Gitlab::Routing

          def action_icon: () -> "play"

          def action_title: () -> "Run all manual"

          def action_path: () -> untyped

          def action_method: () -> :post

          def action_button_title: () -> untyped

          def self.matches?: (untyped stage, untyped user) -> untyped

          def confirmation_message: () -> (nil | untyped)

          def has_action?: () -> true
        end
      end
    end
  end
end
