module Gitlab
  module Ci
    module Status
      module Build
        class Erased < Status::Extended
          def illustration: () -> { image: "illustrations/empty-state/empty-projects-deleted-md.svg", size: "", title: untyped }

          def self.matches?: (untyped build, untyped user) -> untyped
        end
      end
    end
  end
end
