module Gitlab
  module Ci
    module Status
      module Build
        class Skipped < Status::Extended
          def illustration: () -> { image: "illustrations/empty-state/empty-job-skipped-md.svg", size: "", title: untyped }

          def self.matches?: (untyped build, untyped user) -> untyped
        end
      end
    end
  end
end
