# frozen_string_literal: true
#
module Gitlab
  module RelativePositioning
    class Gap
      @start_pos: untyped

      @end_pos: untyped

      @ideal_distance: untyped

      attr_reader start_pos: untyped

      attr_reader end_pos: untyped

      def initialize: (untyped start_pos, untyped end_pos, ?ideal_distance: untyped) -> void

      def ==: (untyped other) -> untyped

      def delta: () -> untyped
    end
  end
end
