# handles merge request creation emails with these formats:
#   incoming+gitlab-org-gitlab-ce-20-Author_Token12345678-merge-request@incoming.gitlab.com
#   incoming+gitlab-org/gitlab-ce+merge-request+Author_Token12345678@incoming.gitlab.com (legacy)
module Gitlab
  module Email
    module Handler
      class CreateMergeRequestHandler < BaseHandler
        @project_slug: untyped

        @project_id: untyped

        @incoming_email_token: untyped

        @project_path: untyped

        @author: untyped

        # reset the message, so it needs to be reprocessed when the attachments
        # have been modified
        @message: untyped

        @patches: untyped

        @source_branch: untyped

        include ReplyProcessing

        HANDLER_REGEX: ::Regexp

        HANDLER_REGEX_LEGACY: ::Regexp

        def initialize: (untyped mail, untyped mail_key) -> void

        def can_handle?: () -> untyped

        def execute: () -> untyped

        # rubocop: disable CodeReuse/ActiveRecord
        def author: () -> untyped

        def metrics_params: () -> untyped

        def metrics_event: () -> :receive_email_create_merge_request

        private

        def build_merge_request: () -> untyped

        def create_merge_request: () -> untyped

        def merge_request_params: () -> untyped

        def apply_patches_to_source_branch: (start_branch: untyped) -> untyped

        def remove_patch_attachments: () -> untyped

        def patch_attachments: () -> untyped

        def source_branch: () -> untyped
      end
    end
  end
end
