# Handles comment creation emails when sent/forwarded by an authorized
# user. Attachments are allowed. Quoted material is _not_ stripped, just like
# create issue emails
# Supports these formats:
#   incoming+gitlab-org-gitlab-ce-20-Author_Token12345678-issue-34@incoming.gitlab.com
module Gitlab
  module Email
    module Handler
      class CreateNoteOnIssuableHandler < BaseHandler
        @project_slug: untyped

        @project_id: untyped

        @incoming_email_token: untyped

        @issuable_iid: untyped

        @noteable: untyped

        @author: untyped

        include ReplyProcessing

        attr_reader issuable_iid: untyped

        HANDLER_REGEX: ::Regexp

        def initialize: (untyped mail, untyped mail_key) -> void

        def can_handle?: () -> untyped

        def execute: () -> untyped

        def metrics_event: () -> :receive_email_create_note_issuable

        def noteable: () -> (nil | untyped)

        private

        # rubocop: disable CodeReuse/ActiveRecord
        def author: () -> untyped

        def create_note: () -> untyped

        def note_params: () -> { noteable_type: untyped, noteable_id: untyped, note: untyped }
      end
    end
  end
end
