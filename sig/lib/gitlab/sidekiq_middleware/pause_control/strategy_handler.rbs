module Gitlab
  module SidekiqMiddleware
    module PauseControl
      class StrategyHandler
        @worker_class: untyped

        @job: untyped

        def initialize: (untyped worker_class, untyped job) -> void

        # This will continue the middleware chain if the job should be scheduled
        # It will return false if the job needs to be cancelled
        def schedule: () { (?) -> untyped } -> untyped

        # This will continue the server middleware chain if the job should be
        # executed.
        # It will return false if the job should not be executed.
        def perform: () { (?) -> untyped } -> untyped

        private

        attr_reader job: untyped

        attr_reader worker_class: untyped

        def strategy: () -> untyped
      end
    end
  end
end
