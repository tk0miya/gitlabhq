module Gitlab
  module SidekiqMiddleware
    module Identity
      class Passthrough
        include Sidekiq::ClientMiddleware

        def call: (untyped worker_class, untyped job, untyped _queue, untyped _redis_pool) { () -> untyped } -> untyped

        private

        def skip_composite_identity_passthrough?: (untyped worker_class) -> (false | untyped)
      end
    end
  end
end
