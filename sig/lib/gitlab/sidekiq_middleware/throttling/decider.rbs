module Gitlab
  module SidekiqMiddleware
    module Throttling
      class Decider
        @worker_name: untyped

        Decision: untyped

        MIN_STAT_ACTIVITY_SAMPLES: 4

        def initialize: (untyped worker_name) -> void

        # Returns a Decision on how to throttle the worker
        #
        # @return Decision
        def execute: () -> untyped

        private

        attr_reader worker_name: untyped

        def db_duration_exceeded_quota?: () -> untyped

        def dominant_in_pg_stat_activity?: () -> untyped

        def dominant_by_db?: (untyped load_balancing_base_model) -> untyped

        def db_connection_name: (untyped base_model) -> untyped
      end
    end
  end
end
