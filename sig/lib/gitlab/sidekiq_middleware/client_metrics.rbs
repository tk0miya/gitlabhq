module Gitlab
  module SidekiqMiddleware
    class ClientMetrics
      @metrics: untyped

      include ::Gitlab::SidekiqMiddleware::MetricsHelper

      ENQUEUED: :sidekiq_enqueued_jobs_total

      def initialize: () -> void

      def call: (untyped worker_class, untyped job, untyped queue, untyped _redis_pool) { () -> untyped } -> untyped

      private

      def init_metrics: () -> ::Hash[untyped, untyped]
    end
  end
end
