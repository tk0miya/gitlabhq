module Gitlab
  module Memory
    class Watchdog
      class Configuration
        @monitor_stack: untyped

        @handler: untyped

        @event_reporter: untyped

        @sleep_time_seconds: untyped

        class MonitorStack
          @monitors: untyped

          def initialize: () -> void

          def push: (untyped monitor_class, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

          def call_each: () { (untyped) -> untyped } -> untyped

          def empty?: () -> untyped

          private

          def build_monitor_state: (untyped monitor_class, *untyped args, max_strikes: untyped, ?monitor_name: untyped?, **untyped kwargs) { (?) -> untyped } -> untyped

          def build_monitor: (untyped monitor_class, *untyped, **untyped) ?{ (?) -> untyped } -> untyped
        end

        DEFAULT_SLEEP_TIME_SECONDS: 60

        attr_writer event_reporter: untyped

        attr_writer handler: untyped

        attr_writer sleep_time_seconds: untyped

        def monitors: () ?{ (untyped) -> untyped } -> untyped

        def handler: () -> untyped

        def event_reporter: () -> untyped

        # Used to control the frequency with which the watchdog will wake up and poll the GC.
        def sleep_time_seconds: () -> untyped
      end
    end
  end
end
