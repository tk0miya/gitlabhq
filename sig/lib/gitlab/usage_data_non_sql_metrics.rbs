module Gitlab
  class UsageDataNonSqlMetrics < UsageData
    SQL_METRIC_DEFAULT: -3

    def self.add_metric: (untyped metric, ?time_frame: ::String, ?options: ::Hash[untyped, untyped]) -> untyped

    def self.count: (untyped relation, ?untyped? column, ?batch: bool, ?batch_size: untyped?, ?start: untyped?, ?finish: untyped?) -> untyped

    def self.distinct_count: (untyped relation, ?untyped? column, ?batch: bool, ?batch_size: untyped?, ?start: untyped?, ?finish: untyped?) -> untyped

    def self.estimate_batch_distinct_count: (untyped relation, ?untyped? column, ?batch_size: untyped?, ?start: untyped?, ?finish: untyped?) -> untyped

    def self.sum: (untyped relation, untyped column, ?batch_size: untyped?, ?start: untyped?, ?finish: untyped?) -> untyped

    def self.histogram: (untyped relation, untyped column, buckets: untyped, ?bucket_size: untyped) -> untyped

    def self.add: (*untyped args) -> untyped

    def self.maximum_id: (untyped model, ?untyped? column) -> nil

    def self.minimum_id: (untyped model, ?untyped? column) -> nil
  end
end
