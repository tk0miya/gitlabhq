module Gitlab
  module Graphql
    module Tracers
      # This tracer writes logs for certain trace events.
      module InstrumentationTracer
        MUTATION_REGEXP: ::Regexp

        IGNORED_ERRORS: ::Array[untyped]

        # All queries pass through a multiplex, even if only one query is executed
        # https://github.com/rmosolgo/graphql-ruby/blob/43e377b5b743a9102381d6ad3adaaed13ff5b6dd/lib/graphql/schema.rb#L1303
        #
        # Instrumenting the multiplex ensures that all queries have been fully exectued
        # meaning that `query.result` is present.
        # We need `query.result` to know if the query was successful or not in metrics and
        # to include the errors in the logs.
        def execute_multiplex: (multiplex: untyped) -> untyped

        private

        def export_query_info: (query: untyped, duration_s: untyped, exception: untyped) -> untyped

        def increment_query_sli: (operation: untyped, duration_s: untyped, error_type: untyped) -> (nil | untyped)

        def error_type: (query: untyped, exception: untyped) -> (nil | untyped)

        def log_execute_query: (?query: untyped?, ?duration_s: ::Integer, ?exception: untyped?) -> (nil | untyped)

        def clean_variables: (untyped variables) -> untyped

        def clean_query_string: (untyped query) -> untyped

        def mutation?: (untyped query) -> untyped
      end
    end
  end
end
