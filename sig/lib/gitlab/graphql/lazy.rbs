module Gitlab
  module Graphql
    class Lazy
      @proc: untyped

      include Gitlab::Utils::StrongMemoize

      def initialize: () { (?) -> untyped } -> void

      def force: () -> untyped

      def then: () { (untyped) -> untyped } -> untyped

      def catch: (?untyped error_class) { (untyped) -> untyped } -> untyped

      # Force evaluation of a (possibly) lazy value
      def self.force: (untyped value) -> untyped

      def self.with_value: (untyped unforced) { (?) -> untyped } -> untyped
    end
  end
end
