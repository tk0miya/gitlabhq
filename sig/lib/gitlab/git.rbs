module Gitlab
  module Git
    # The ID of empty tree.
    # https://github.com/git/git/blob/3ad8b5bf26362ac67c9020bf8c30eee54a84f56d/cache.h#L1011-L1012
    SHA1_EMPTY_TREE_ID: "4b825dc642cb6eb9a060e54bf8d69288fbee4904"

    SHA256_EMPTY_TREE_ID: "6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321"

    SHA1_BLANK_SHA: untyped

    SHA256_BLANK_SHA: untyped

    COMMIT_ID: ::Regexp

    TAG_REF_PREFIX: "refs/tags/"

    BRANCH_REF_PREFIX: "refs/heads/"

    SHA_LIKE_REF: ::Regexp

    # NOTE: We don't use linguist anymore, but we'd still want to support it
    # to be backward/GitHub compatible. Using `gitlab-*` prefixed overrides
    # going forward would give us a better control and flexibility.
    ATTRIBUTE_OVERRIDES: { generated: ::Array["gitlab-generated" | "linguist-generated"] }

    CommandError: untyped

    CommitError: untyped

    OSError: untyped

    AmbiguousRef: untyped

    CommandTimedOut: untyped

    InvalidPageToken: untyped

    InvalidRefFormatError: untyped

    ReferencesLockedError: untyped

    ReferenceStateMismatchError: untyped

    class ResourceExhaustedError < BaseError
      @retry_after: untyped

      def initialize: (?untyped? msg, ?::Integer retry_after) -> void

      def headers: () -> ({ "Retry-After" => untyped } | ::Hash[untyped, untyped])
    end

    class ReferenceNotFoundError < BaseError
      @name: untyped

      attr_reader name: untyped

      def initialize: (?untyped? msg, ?::String name) -> void
    end

    extend Gitlab::EncodingHelper

    def self.ref_name: (untyped ref, ?types: ::String) -> untyped

    def self.branch_name: (untyped ref) -> untyped

    def self.tag_name: (untyped ref) -> untyped

    def self.tag_ref?: (untyped ref) -> untyped

    def self.branch_ref?: (untyped ref) -> untyped

    def self.blank_ref?: (untyped ref) -> untyped

    def self.commit_id?: (untyped ref) -> untyped

    def self.version: () -> untyped

    def self.check_namespace!: (*untyped objects) -> untyped

    def self.diff_line_code: (untyped file_path, untyped new_line_position, untyped old_line_position) -> ::String

    def self.shas_eql?: (untyped sha1, untyped sha2) -> (true | false | untyped)
  end
end
