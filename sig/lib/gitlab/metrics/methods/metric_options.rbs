module Gitlab
  module Metrics
    module Methods
      class MetricOptions
        @multiprocess_mode: untyped

        @buckets: untyped

        @docstring: untyped

        @with_feature: untyped

        @label_keys: untyped

        @base_labels: untyped

        def initialize: (?::Hash[untyped, untyped] options) -> void

        # Documentation describing metric in metrics endpoint '/-/metrics'
        def docstring: (?untyped? docstring) -> untyped

        # Gauge aggregation mode for multiprocess metrics
        # - :all (default) returns each gauge for every process
        # - :livesum all process'es gauges summed up
        # - :max maximum value of per process gauges
        # - :min minimum value of per process gauges
        def multiprocess_mode: (?untyped? mode) -> untyped

        # Measurement buckets for histograms
        def buckets: (?untyped? buckets) -> untyped

        # Base labels are merged with per metric labels
        def base_labels: () -> untyped

        def label_keys: (?untyped? label_keys) -> untyped

        # Use feature toggle to control whether certain metric is enabled/disabled
        def with_feature: (?untyped? name) -> untyped

        def evaluate: () ?{ (?) -> untyped } -> self
      end
    end
  end
end
