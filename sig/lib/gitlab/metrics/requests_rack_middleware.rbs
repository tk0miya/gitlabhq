module Gitlab
  module Metrics
    class RequestsRackMiddleware
      @app: untyped

      include Gitlab::Metrics::SliConfig

      HTTP_METHODS: ::Array["delete" | "get" | "head" | "options" | "patch" | "post" | "put"]

      HTTP_STATUS_CLASSES: ::Array["2xx" | "3xx" | "4xx" | "5xx"]

      HEALTH_ENDPOINT: ::Regexp

      FEATURE_CATEGORY_DEFAULT: untyped

      ENDPOINT_MISSING: "unknown"

      # These were the top 5 categories at a point in time, chosen as a
      # reasonable default. If we initialize every category we'll end up
      # with an explosion in unused metric combinations, but we want the
      # most common ones to be always present.
      FEATURE_CATEGORIES_TO_INITIALIZE: ::Array["system_access" | "code_review_workflow" | "continuous_integration" | "not_owned" | "source_code_management" | untyped]

      REQUEST_URGENCY_KEY: "gitlab.request_urgency"

      def initialize: (untyped app) -> void

      def self.http_requests_total: () -> untyped

      def self.rack_uncaught_errors_count: () -> untyped

      def self.http_request_duration_seconds: () -> untyped

      def self.http_health_requests_total: () -> untyped

      def self.initialize_slis!: () -> untyped

      def call: (untyped env) -> (::Array[untyped] | untyped)

      def health_endpoint?: (untyped path) -> (false | untyped)

      def feature_category: () -> untyped

      def endpoint_id: () -> untyped

      def record_apdex: (untyped urgency, untyped elapsed) -> untyped

      def record_error: (untyped urgency, untyped status) -> untyped

      def labels_from_context: () -> { feature_category: untyped, endpoint_id: untyped }

      def status_class: (untyped status) -> ("undefined" | ::String)

      def urgency_for_env: (untyped env) -> untyped
    end
  end
end
