# Detect user, keys, or deploy tokens based on identifier like
# key-13, user-36, or deploy-token-45
module Gitlab
  module Identifier
    @identification_cache: untyped

    def identify: (untyped identifier) -> untyped

    # Tries to identify a user based on a user identifier (e.g. "user-123").
    # rubocop: disable CodeReuse/ActiveRecord
    def identify_using_user: (untyped identifier) -> untyped

    # Tries to identify a deploy token based on a deploy token identifier (e.g. "deploy-token-123").
    def identify_using_deploy_token: (untyped identifier) -> untyped

    # Tries to identify a user based on an SSH key identifier (e.g. "key-123"). Deploy keys are excluded.
    def identify_using_ssh_key: (untyped identifier) -> untyped

    # Tries to identify a deploy key using a SSH key identifier (e.g. "key-123").
    def identify_using_deploy_key: (untyped identifier) -> untyped

    def identify_with_cache: (untyped category, untyped key) { () -> untyped } -> untyped

    def identification_cache: () -> untyped
  end
end
