module Gitlab
  class LanguageDetection
    @repository: untyped

    @repository_languages: untyped

    @previous_language_names: untyped

    @detection: untyped

    MAX_LANGUAGES: 5

    def initialize: (untyped repository, untyped repository_languages) -> void

    def languages: () -> untyped

    def language_color: (untyped name) -> untyped

    def language_gitaly_id: (untyped name) -> untyped

    # Newly detected languages, returned in a structure accepted by
    # ApplicationRecord.legacy_bulk_insert
    def insertions: (untyped programming_languages) -> untyped

    def updates: () -> untyped

    # Returns the ids of the programming languages that do not occur in the detection
    # as current repository languages
    def deletions: () -> untyped

    private

    def previous_language_names: () -> untyped

    def detection: () -> untyped
  end
end
