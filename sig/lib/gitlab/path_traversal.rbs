module Gitlab
  module PathTraversal
    @logger: untyped

    extend ::Gitlab::PathTraversal

    PathTraversalAttackError: untyped

    def logger: () -> untyped

    PATH_TRAVERSAL_REGEX: ::Regexp

    PATH_TRAVERSAL_REGEX_WITH_NEWLINE: ::Regexp

    # Ensure that the relative path will not traverse outside the base directory
    # We url decode the path to avoid passing invalid paths forward in url encoded format.
    # Also see https://gitlab.com/gitlab-org/gitlab/-/merge_requests/24223#note_284122580
    # It also checks for backslash '\', which is sometimes a File::ALT_SEPARATOR.
    def check_path_traversal!: (untyped path) -> (nil | untyped)

    def path_traversal?: (untyped decoded_path, ?match_new_line: bool) -> (false | untyped)

    def check_allowed_absolute_path!: (untyped path, untyped allowlist) -> (nil | untyped)

    def check_allowed_absolute_path_and_path_traversal!: (untyped path, untyped path_allowlist) -> untyped
  end
end
