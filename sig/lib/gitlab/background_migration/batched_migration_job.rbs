module Gitlab
  module BackgroundMigration
    # Base class for batched background migrations. Subclasses should implement the `#perform`
    # method as the entry point for the job's execution.
    #
    # Job arguments needed must be defined explicitly,
    # see https://docs.gitlab.com/ee/development/database/batched_background_migrations.html#use-job-arguments.
    # rubocop:disable Metrics/ClassLength
    # rubocop:disable Metrics/ParameterLists
    class BatchedMigrationJob
      @start_id: untyped

      @end_id: untyped

      @start_cursor: untyped

      @end_cursor: untyped

      @batch_table: untyped

      @batch_column: untyped

      @sub_batch_size: untyped

      @pause_ms: untyped

      @job_arguments: untyped

      @connection: untyped

      @sub_batch_exception: untyped

      @batch_metrics: untyped

      include Gitlab::Database::DynamicModelHelpers

      include Gitlab::ClassAttributes

      DEFAULT_FEATURE_CATEGORY: :database

      MINIMUM_PAUSE_MS: 100

      def self.generic_instance: (batch_table: untyped, batch_column: untyped, connection: untyped, ?job_arguments: untyped) -> untyped

      def self.job_arguments_count: () -> 0

      def self.operation_name: (untyped operation) -> untyped

      def self.job_arguments: (*untyped args) -> untyped

      def self.scope_to: (untyped scope) -> untyped

      def self.feature_category: (?untyped? feature_category_name) -> untyped

      def self.cursor_columns: () -> ::Array[untyped]

      def self.cursor?: () -> untyped

      def self.cursor: (*untyped args) -> untyped

      def self.health_context_tables: () -> ::Array[untyped]

      def self.tables_to_check_for_vacuum: (*untyped args) -> untyped

      def initialize: (batch_table: untyped, batch_column: untyped, sub_batch_size: untyped, pause_ms: untyped, connection: untyped, ?job_arguments: untyped, ?start_id: untyped?, ?end_id: untyped?, ?start_cursor: untyped?, ?end_cursor: untyped?, ?sub_batch_exception: untyped?) -> void

      def filter_batch: (untyped relation) -> untyped

      def perform: () -> untyped

      def batch_metrics: () -> untyped

      private

      attr_reader start_id: untyped

      attr_reader end_id: untyped

      attr_reader start_cursor: untyped

      attr_reader end_cursor: untyped

      attr_reader batch_table: untyped

      attr_reader batch_column: untyped

      attr_reader sub_batch_size: untyped

      attr_reader pause_ms: untyped

      attr_reader connection: untyped

      attr_reader sub_batch_exception: untyped

      def each_sub_batch: (?batching_arguments: ::Hash[untyped, untyped], ?batching_scope: untyped?) { (untyped) -> untyped } -> untyped

      def distinct_each_batch: (?batching_arguments: ::Hash[untyped, untyped]) { (untyped) -> untyped } -> untyped

      # For cursor-based migrations, the lower bound (>= start_cursor) is applied per sub-batch
      # by Gitlab::Database::Batch::InclusiveCursorIterator, not in this scope. See #599681.
      def base_relation: () -> untyped

      def arel_for_cursor: (untyped cursor, untyped arel_table) -> untyped

      def filter_sub_batch: (untyped relation, ?untyped? batching_scope) -> untyped

      def sub_batch_relation: (?batching_scope: untyped?) -> untyped

      def fetch_primary_key: () -> untyped

      def operation_name: () -> (untyped | nil)
    end
  end
end
