module Gitlab
  module TopologyServiceClient
    class ConcurrencyLimitInterceptor < GRPC::ClientInterceptor
      extend ::Gitlab::Utils::Override

      # Only track concurrency for these RPCs that hold database transactions
      TRACKED_RPCS: ::Array["BeginUpdate" | "CommitUpdate" | "RollbackUpdate"]

      # Class-level cache to avoid repeated O(n) string split operations across requests
      TRACKED_METHOD_CACHE: untyped

      def request_response: (?request: untyped?, ?call: untyped?, ?method: untyped?, ?metadata: untyped?) { () -> untyped } -> untyped

      def client_streamer: (?requests: untyped?, ?call: untyped?, ?method: untyped?, ?metadata: untyped?) { () -> untyped } -> untyped

      def server_streamer: (?request: untyped?, ?call: untyped?, ?method: untyped?, ?metadata: untyped?) { () -> untyped } -> untyped

      def bidi_streamer: (?requests: untyped?, ?call: untyped?, ?method: untyped?, ?metadata: untyped?) { () -> untyped } -> untyped

      private

      def intercept: (untyped method, ?streaming: bool) { () -> untyped } -> untyped

      def tracked_rpc?: (untyped method) -> (false | untyped)

      # @param method [String] the gRPC method being called
      # @param streaming [Boolean] whether this is a streaming RPC that returns an Enumerator
      def with_concurrency_limit: (untyped method, ?streaming: bool) { () -> untyped } -> untyped

      def wrap_streaming_response!: (untyped enum, untyped request_id) -> untyped

      def handle_rejected_request!: (untyped method) -> (nil | untyped)

      def log_rejection: (untyped method, mode: untyped) -> untyped
    end
  end
end
