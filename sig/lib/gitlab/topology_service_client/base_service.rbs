module Gitlab
  module TopologyServiceClient
    DEFAULT_TIMEOUT_IN_SECONDS: 1

    MAX_RECEIVE_MESSAGE_BYTES: untyped

    class BaseService
      @timeout: untyped

      @cell_id: untyped

      @client: untyped

      @topology_service_config: untyped

      def initialize: (?timeout: untyped?) -> void

      def cell_id: () -> untyped

      private

      def client: () -> untyped

      def build_interceptors: () -> untyped

      def options: () -> { timeout: untyped }

      def service_credentials: () -> untyped

      def topology_service_address: () -> untyped

      def enabled?: () -> untyped

      def topology_service_config: () -> untyped
    end
  end
end
