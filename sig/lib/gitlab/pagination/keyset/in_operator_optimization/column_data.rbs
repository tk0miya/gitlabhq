module Gitlab
  module Pagination
    module Keyset
      module InOperatorOptimization
        # This class is used for wrapping an Arel column with
        # convenient helper methods in order to make the query
        # building for the InOperatorOptimization a bit cleaner.
        class ColumnData
          @original_column_name: untyped

          @as: untyped

          @arel_table: untyped

          attr_reader original_column_name: untyped

          attr_reader as: untyped

          attr_reader arel_table: untyped

          # column - name of the DB column
          # as - custom alias for the column
          # arel_table - relation where the column is located
          def initialize: (untyped column, untyped as, untyped arel_table) -> void

          # Generates: `issues.name AS my_alias`
          def projection: () -> untyped

          # Generates: issues.name`
          def arel_column: () -> untyped

          # overridden in OrderByColumnData class
          alias column_expression arel_column

          # Generates: `issues.my_alias`
          def arel_column_as: () -> untyped

          def array_aggregated_column_name: () -> ::String

          # Generates: SELECT ARRAY_AGG(...) AS issues_name_array
          def array_aggregated_column: () -> untyped
        end
      end
    end
  end
end
