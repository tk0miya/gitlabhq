module Gitlab
  module Pagination
    module Keyset
      class CursorBasedRequestContext
        @request_context: untyped

        DEFAULT_SORT_DIRECTION: :desc

        DEFAULT_SORT_COLUMN: :id

        attr_reader request_context: untyped

        def initialize: (untyped request_context) -> void

        def per_page: () -> untyped

        def cursor: () -> untyped

        def apply_headers: (untyped cursor_for_next_page, untyped cursor_for_previous_page) -> untyped

        def order_by: () -> ::Hash[untyped, untyped]

        def order: () -> untyped

        def sort: () -> untyped
      end
    end
  end
end
