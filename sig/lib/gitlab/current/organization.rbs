module Gitlab
  module Current
    class Organization
      @params: untyped

      @user: untyped

      @headers: untyped

      attr_reader params: untyped

      attr_reader user: untyped

      attr_reader headers: untyped

      HTTP_HEADER: "X-GitLab-Organization-ID"

      def initialize: (?params: ::Hash[untyped, untyped], ?user: untyped?, ?rack_env: untyped?) -> void

      def organization: () -> untyped

      private

      def from_params: () -> untyped

      def from_headers: () -> (nil | untyped)

      def from_user: () -> (nil | untyped)

      def from_group_params: () -> (nil | untyped)

      def from_organization_params: () -> (nil | untyped)

      def fallback_organization: () -> untyped
    end
  end
end
