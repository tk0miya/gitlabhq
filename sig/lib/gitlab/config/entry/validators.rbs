        class PortUniqueValidator < ActiveModel::EachValidator
          def validate_each: (untyped record, untyped attribute, untyped value) -> (nil | untyped)

          private

          def ports: (untyped current_data) -> untyped

          def transform_ports: (untyped raw_ports) -> untyped
