        class ArrayOfStringsOrRegexpsValidator < RegexpValidator
          def validate_each: (untyped record, untyped attribute, untyped value) -> (untyped | nil)

          private

          def validation_message: () -> "should be an array of strings or regular expressions using re2 syntax"

          def validate_array_of_strings_or_regexps: (untyped values) -> untyped

          def validate_string_or_regexp: (untyped value) -> (false | untyped | true)
        end

