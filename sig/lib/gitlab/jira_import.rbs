module Gitlab
  module JiraImport
    JIRA_IMPORT_CACHE_TIMEOUT: untyped

    FAILED_ISSUES_COUNTER_KEY: "jira-import/failed/%{project_id}/%{collection_type}"

    NEXT_ITEMS_START_AT_KEY: "jira-import/paginator/%{project_id}/%{collection_type}"

    JIRA_IMPORT_LABEL: "jira-import/import-label/%{project_id}"

    ITEMS_MAPPER_CACHE_KEY: "jira-import/items-mapper/%{project_id}/%{collection_type}/%{jira_item_id}"

    USERS_MAPPER_KEY_PREFIX: "jira-import/items-mapper/%{project_id}/users/"

    ALREADY_IMPORTED_ITEMS_CACHE_KEY: "jira-importer/already-imported/%{project}/%{collection_type}"

    def self.validate_project_settings!: (untyped project, ?user: untyped?, ?configuration_check: bool) -> (nil | untyped)

    def self.jira_item_cache_key: (untyped project_id, untyped jira_item_id, untyped collection_type) -> untyped

    def self.jira_user_key_prefix: (untyped project_id) -> untyped

    def self.already_imported_cache_key: (untyped collection_type, untyped project_id) -> untyped

    def self.jira_issues_next_page_cache_key: (untyped project_id) -> untyped

    def self.failed_issues_counter_cache_key: (untyped project_id) -> untyped

    def self.import_label_cache_key: (untyped project_id) -> untyped

    def self.increment_issue_failures: (untyped project_id) -> untyped

    def self.issue_failures: (untyped project_id) -> untyped

    def self.get_import_label_id: (untyped project_id) -> untyped

    def self.cache_import_label_id: (untyped project_id, untyped label_id) -> untyped

    def self.cache_cleanup: (untyped project_id) -> untyped

    # Caches the mapping of jira_account_id -> gitlab user id
    # project_id - id of a project
    # mapping - hash in format of jira_account_id -> gitlab user id
    def self.cache_users_mapping: (untyped project_id, untyped mapping) -> untyped

    def self.get_user_mapping: (untyped project_id, untyped jira_account_id) -> untyped

    def self.cache_class: () -> untyped

    def self.jira_issues_pagination_state_cache_key: (untyped project_id) -> ::String

    def self.get_pagination_state: (untyped project_id) -> ({ is_last: false, next_page_token: nil, page: 1 } | untyped)

    def self.store_pagination_state: (untyped project_id, untyped state) -> untyped
  end
end
