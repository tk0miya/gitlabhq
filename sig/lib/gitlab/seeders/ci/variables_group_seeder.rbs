module Gitlab
  module Seeders
    module Ci
      class VariablesGroupSeeder
        @group: untyped

        @seed_count: untyped

        @environment_scope: untyped

        @prefix: untyped

        DEFAULT_SEED_COUNT: 10

        DEFAULT_PREFIX: "GROUP_VAR_"

        DEFAULT_ENV: "*"

        def initialize: (untyped params) -> void

        def seed: () -> (nil | untyped)

        private

        attr_reader environment_scope: untyped

        attr_reader group: untyped

        attr_reader prefix: untyped

        attr_reader seed_count: untyped

        def create_ci_variable: (untyped id) -> (nil | untyped)
      end
    end
  end
end
