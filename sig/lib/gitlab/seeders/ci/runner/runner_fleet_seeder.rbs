deck" | "taxonic" | "ios_10-0" | "n0004" | "data" | "fedora" | "rr-test" | "seedai_master_builds" | "geofence_master_builds"]

          attr_reader logger: untyped

          # Initializes the class
          #
          # @param [Gitlab::Logger] logger
          # @param [Hash] options
          # @option options [String] :username username of the user that will create the fleet
          # @option options [String] :registration_prefix string to use as prefix in group, project, and runner names
          # @option options [Integer] :runner_count number of runners to create across the groups and projects
          # @return [Array<Hash>] list of project IDs to respective runner IDs
          def initialize: (?untyped logger, **untyped options) -> void

          # seed returns an array of hashes of projects to its assigned runners
          def seed: () -> (nil | untyped)

          private

          def within_plan_limits?: () -> (false | true)

          def create_groups_and_projects: () -> { root_group_1: untyped, root_group_2: untyped, group_1_1: untyped, group_1_1_1: untyped, group_1_1_2: untyped, project_1_1_1_1: untyped, project_1_1_2_1: untyped, group_2_1: untyped, project_2_1_1: untyped }

          def create_runners: (untyped gp) -> { project_1_1_1_1: untyped, project_1_1_2_1: untyped, project_2_1_1: untyped }

          def ensure_group: (name: untyped, ?parent_id: untyped?, **untyped args) -> untyped

          def generate_name: (untyped name) -> ::String

          def create_group: (**untyped args) -> untyped

          def ensure_project: (name: untyped, namespace_id: untyped, **untyped args) -> untyped

          def create_project: (**untyped args) -> untyped

          def register_record: (untyped record, untyped records) -> untyped

          def ensure_success: (untyped record) -> untyped

          def execute_service!: (untyped service, ?untyped? payload_attr) -> untyped

          def create_runner: (name: untyped, ?scope: untyped?, **untyped args) -> untyped

          def additional_runner_args: (untyped name, untyped scope, untyped executor) -> untyped

          def assign_runner: (untyped runner, untyped project) -> untyped
        end
      end
    end
  end
end
