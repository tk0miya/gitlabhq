module Gitlab
  module Import
    class IidPreallocator
      @importable: untyped

      @max_iids: untyped

      # PostgreSQL integer type max value (2^31 - 1).
      # The internal_ids.last_value column is an integer, so we must reject
      # values that would overflow it. This also prevents DoS via extremely
      # large IID reservations from maliciously crafted export archives.
      MAX_VALID_IID: untyped

      # Maps each CE resource type to a tracker lambda and a scope_resolver lambda.
      #
      # tracker: called with (scope_value, max_iid) to pre-allocate the IID.
      #   Uses the track_*_iid! class methods generated by AtomicInternalId.
      #   See app/models/concerns/atomic_internal_id.rb
      #
      # scope_resolver: called with the importable (Project or Group) to resolve
      #   the correct scope object. Returns nil for inapplicable scopes (e.g.
      #   group_milestones on a project with no group) - execute skips those.
      #
      # valid_for: specifies which importable types this resource applies to.
      #   Array of symbols, e.g. [:project], [:group], or [:project, :group]
      #   This prevents malicious injection of project-scoped resources in group imports.
      TRACKABLE_RESOURCES: { issues: { tracker: untyped, scope_resolver: untyped, valid_for: ::Array[:project] }, merge_requests: { tracker: untyped, scope_resolver: untyped, valid_for: ::Array[:project] }, project_milestones: { tracker: untyped, scope_resolver: untyped, valid_for: ::Array[:project] }, group_milestones: { tracker: untyped, scope_resolver: untyped, valid_for: ::Array[:project | :group] }, ci_pipelines: { tracker: untyped, scope_resolver: untyped, valid_for: ::Array[:project] }, design_management_designs: { tracker: untyped, scope_resolver: untyped, valid_for: ::Array[:project] } }

      def self.trackable_resources: () -> untyped

      def self.valid_iid_value?: (untyped value) -> untyped

      def self.from_file: (untyped importable, untyped path) -> untyped

      # @param importable [Project, Group] the project or group being imported into
      # @param max_iids [Hash<Symbol, Integer>] resource type => max IID from source
      #   e.g. { issues: 142, merge_requests: 37, ci_pipelines: 891 }
      def initialize: (untyped importable, untyped max_iids) -> void

      def execute: () -> untyped

      private

      def valid_for_importable?: (untyped valid_for) -> untyped
    end
  end
end
