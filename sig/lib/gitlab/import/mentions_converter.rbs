module Gitlab
  module Import
    class MentionsConverter
      @importer: untyped

      @project_id: untyped

      @project_creator: untyped

      include UserFromMention

      # Captures anything in brackets after an @ but does not capture the @. It allows mentions
      # like @{1111:11-11} to be captured even though it doesn't match User.reference_pattern
      BITBUCKET_MENTIONS_REGEX: ::Regexp

      GITLAB_MENTIONS_REGEX: untyped

      MENTION_PLACEHOLDER: "~GITLAB_MENTION_PLACEHOLDER~"

      attr_reader importer: untyped

      attr_reader project_id: untyped

      attr_reader project_creator: untyped

      def initialize: (untyped importer, untyped project) -> void

      def convert: (untyped text) -> untyped

      private

      def replace_mentions: (untyped text) -> untyped

      def pluck_mentions_from_text: (untyped text) -> untyped
    end
  end
end
