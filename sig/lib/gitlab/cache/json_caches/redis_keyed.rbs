module Gitlab
  module Cache
    module JsonCaches
      class RedisKeyed < JsonCache
        private

        def expanded_cache_key: (untyped key) -> untyped

        def write_raw: (untyped key, untyped value, untyped options) -> untyped

        def read_raw: (untyped key) -> untyped

        def strategy_key_component: () -> untyped
      end
    end
  end
end
