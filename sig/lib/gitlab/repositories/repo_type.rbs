module Gitlab
  module Repositories
    class RepoType
      def name: () -> untyped

      def access_checker_class: () -> untyped

      def guest_read_ability: () -> untyped

      def suffix: () -> nil

      def container_class: () -> untyped

      def type_id: () -> untyped

      def identifier_for_container: (untyped container) -> ::String

      def wiki?: () -> untyped

      def project?: () -> untyped

      def snippet?: () -> untyped

      def design?: () -> untyped

      def path_suffix: () -> (::String | "")

      def repository_for: (untyped container) -> (nil | untyped)

      def project_for: (untyped container) -> untyped

      def valid?: (untyped repository_path) -> untyped

      private

      def repository_resolver: (untyped container) -> untyped

      def check_container: (untyped container) -> (nil | untyped)
    end
  end
end
