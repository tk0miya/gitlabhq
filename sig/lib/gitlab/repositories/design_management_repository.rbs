module Gitlab
  module Repositories
    class DesignManagementRepository < Gitlab::Repositories::RepoType
      include Singleton

      extend Gitlab::Utils::Override

      def name: () -> :design

      def suffix: () -> :design

      def access_checker_class: () -> untyped

      def guest_read_ability: () -> :download_code

      def container_class: () -> untyped

      def project_for: (untyped design_management_repository) -> untyped

      private

      def repository_resolver: (untyped design_management_repository) -> untyped
    end
  end
end
