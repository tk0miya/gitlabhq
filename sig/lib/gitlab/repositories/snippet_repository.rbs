module Gitlab
  module Repositories
    class SnippetRepository < Gitlab::Repositories::RepoType
      include Singleton

      extend Gitlab::Utils::Override

      def name: () -> :snippet

      def access_checker_class: () -> untyped

      def guest_read_ability: () -> :read_snippet

      def container_class: () -> untyped

      def project_for: (untyped snippet) -> untyped

      private

      def repository_resolver: (untyped snippet) -> untyped
    end
  end
end
