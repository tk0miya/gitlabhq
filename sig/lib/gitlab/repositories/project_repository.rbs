module Gitlab
  module Repositories
    class ProjectRepository < Gitlab::Repositories::RepoType
      include Singleton

      extend Gitlab::Utils::Override

      def name: () -> :project

      def access_checker_class: () -> untyped

      def guest_read_ability: () -> :download_code

      def container_class: () -> untyped

      def project_for: (untyped container) -> untyped

      private

      def repository_resolver: (untyped project) -> untyped

      def check_container: (untyped container) -> nil
    end
  end
end
