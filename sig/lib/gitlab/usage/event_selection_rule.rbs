#   Represents the relationship between a event definition and a metric definition.
#
#   Example usages:
#   EventSelectionRule.new('pull_package', time_framed: true, filter: { label: 'rubygems' })
#
#   The above rule represents a defines a metric that "counts weekly number of pull_package events with label rubygems"
#
#   EventSelectionRule.new('pull_package', time_framed: false)
#
#   The above rule represents a defines a metric that "counts the total number of pull_package events"
#
module Gitlab
  module Usage
    class EventSelectionRule
      @name: untyped

      @time_framed: untyped

      @filter: untyped

      @unique_identifier_name: untyped

      @operator: untyped

      @base_key: untyped

      include Gitlab::Usage::TimeSeriesStorable

      include Gitlab::Usage::TimeFrame

      extend Gitlab::Utils::StrongMemoize

      TOTAL_COUNTER_KEY_PREFIX: "event_counters"

      SUM_KEY_PREFIX: "event_sums"

      # We want to avoid reading the key_overrides every time a rule is used.
      def self.key_overrides: () -> untyped

      attr_reader filter: untyped

      attr_reader name: untyped

      attr_reader unique_identifier_name: untyped

      attr_reader operator: untyped

      def initialize: (name: untyped, time_framed: untyped, ?filter: ::Hash[untyped, untyped], ?unique_identifier_name: untyped?, ?operator: untyped?) -> void

      def redis_key_for_date: (?untyped date) -> untyped

      def redis_keys_for_time_frame: (untyped time_frame) -> (::Array[untyped] | untyped)

      def time_framed?: () -> untyped

      def total_counter?: () -> untyped

      def sum?: () -> untyped

      def unique_total?: () -> untyped

      def matches?: (untyped additional_properties) -> untyped

      # Implementing `==` to make sure that `a == b` is true if and only if `a` and `b` have equal properties
      # Checks equality by comparing each attribute.
      # @param [Object] Object to be compared
      def ==: (untyped other) -> untyped

      alias eql? ==

      # Calculates hash code according to all attributes.
      # @return [Integer] Hash code
      # Ensures 2 objects with the same attributes can't be keys
      # in the same hash twice
      def hash: () -> untyped

      private

      def redis_key: (?untyped? _event_name, ?untyped date, ?bool _used_in_aggregate_metric) -> untyped

      def base_key: () -> untyped

      def redis_slot: () -> untyped

      def time_constraint: (untyped time_frame) -> untyped

      def path_part_of_redis_key: () -> untyped
    end
  end
end
