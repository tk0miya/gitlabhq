module Gitlab
  module Usage
    module TimeFrame
      ALL_TIME_TIME_FRAME_NAME: "all"

      SEVEN_DAYS_TIME_FRAME_NAME: "7d"

      TWENTY_EIGHT_DAYS_TIME_FRAME_NAME: "28d"

      DEFAULT_TIMESTAMP_COLUMN: :created_at

      def weekly_time_range: () -> { start_date: untyped, end_date: untyped }

      def monthly_time_range: () -> { start_date: untyped, end_date: untyped }

      # This time range is skewed for batch counter performance.
      # See https://gitlab.com/gitlab-org/gitlab/-/merge_requests/42972
      def monthly_time_range_db_params: (?column: untyped?) -> ::Hash[untyped, ::Range[untyped]]

      def weekly_time_range_db_params: (?column: untyped?) -> ::Hash[untyped, ::Range[untyped]]
    end
  end
end
