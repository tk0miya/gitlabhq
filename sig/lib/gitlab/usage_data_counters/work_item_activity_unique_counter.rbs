module Gitlab
  module UsageDataCounters
    module WorkItemActivityUniqueCounter
      WORK_ITEM_TITLE_CHANGED: "users_updating_work_item_title"

      WORK_ITEM_DATE_CHANGED: "users_updating_work_item_dates"

      WORK_ITEM_LABELS_CHANGED: "users_updating_work_item_labels"

      WORK_ITEM_MILESTONE_CHANGED: "users_updating_work_item_milestone"

      WORK_ITEM_TODO_MARKED: "users_updating_work_item_todo"

      def self.track_work_item_title_changed_action: (author: untyped) -> untyped

      def self.track_work_item_date_changed_action: (author: untyped) -> untyped

      def self.track_work_item_labels_changed_action: (author: untyped) -> untyped

      def self.track_work_item_milestone_changed_action: (author: untyped) -> untyped

      def self.track_work_item_mark_todo_action: (author: untyped) -> untyped

      private

      def self.track_unique_action: (untyped action, untyped author) -> (nil | untyped)
    end
  end
end
