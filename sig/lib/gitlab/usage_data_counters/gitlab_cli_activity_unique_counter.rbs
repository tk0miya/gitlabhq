module Gitlab
  module UsageDataCounters
    module GitLabCliActivityUniqueCounter
      GITLAB_CLI_API_REQUEST_ACTION: "i_code_review_user_gitlab_cli_api_request"

      # This regex will match to user agents ending with GitLab CLI or starting with glab/v"
      GITLAB_CLI_USER_AGENT_REGEX: ::Regexp

      def self.track_api_request_when_trackable: (user_agent: untyped, user: untyped) -> untyped

      private

      def self.track_unique_action_by_user: (untyped action, untyped user) -> (nil | untyped)

      def self.track_unique_action: (untyped action, untyped value) -> untyped
    end
  end
end
