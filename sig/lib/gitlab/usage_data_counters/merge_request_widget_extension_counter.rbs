module Gitlab
  module UsageDataCounters
    class MergeRequestWidgetExtensionCounter < BaseCounter
      KNOWN_EVENTS: ::Array["view" | "full_report_clicked" | "expand" | "expand_success" | "expand_warning" | "expand_failed"]

      PREFIX: "i_code_review_merge_request_widget"

      WIDGETS: ::Array["accessibility" | "code_quality" | "license_compliance" | "status_checks" | "terraform" | "test_summary" | "metrics" | "security_reports"]

      private

      def self.known_events: () -> untyped
    end
  end
end
