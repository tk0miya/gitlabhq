module Gitlab
  module Reflections
    module Relationships
      module Handlers
        # Handles direct has_many and has_one associations (non-through)
        # Examples:
        #   has_many :posts
        #   has_one :profile
        #   has_many :comments, foreign_key: 'author_id'
        class HasAssociationHandler < BaseHandler
          def relationship_attributes: () -> untyped

          private

          def relationship_type: () -> untyped
        end
      end
    end
  end
end
