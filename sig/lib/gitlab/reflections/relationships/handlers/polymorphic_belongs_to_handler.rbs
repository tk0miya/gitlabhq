module Gitlab
  module Reflections
    module Relationships
      module Handlers
        # Handles polymorphic belongs_to associations
        # Examples:
        #   belongs_to :commentable, polymorphic: true
        #   belongs_to :imageable, polymorphic: true
        class PolymorphicBelongsToHandler < BaseHandler
          def relationship_attributes: () -> { parent_table: nil, child_table: untyped, primary_key: untyped, foreign_key: untyped, relationship_type: untyped, polymorphic: true, polymorphic_type_column: untyped, polymorphic_name: untyped, child_association: { name: untyped, type: untyped, model: untyped } }

          private

          def relationship_type: () -> "many_to_one"
        end
      end
    end
  end
end
