module Gitlab
  module Reflections
    module Relationships
      module Transformers
        # Filters out invalid relationships from the collection
        class Validate
          @relationships: untyped

          def self.call: (untyped relationships) -> untyped

          def initialize: (untyped relationships) -> void

          def transform: () -> untyped
        end
      end
    end
  end
end
