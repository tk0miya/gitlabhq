module Gitlab
  module HookData
    class NoteBuilder < BaseBuilder
      SAFE_HOOK_ATTRIBUTES: ::Array[:attachment | :author_id | :change_position | :commit_id | :created_at | :discussion_id | :id | :internal | :line_code | :note | :noteable_id | :noteable_type | :original_position | :position | :project_id | :resolved_at | :resolved_by_id | :resolved_by_push | :st_diff | :system | :type | :updated_at | :updated_by_id]

      alias note object

      def build: () -> untyped
    end
  end
end
