module Gitlab
  module RelativePositioning
    STEPS: 10

    IDEAL_DISTANCE: untyped

    MIN_POSITION: untyped

    START_POSITION: 0

    MAX_POSITION: untyped

    MAX_GAP: untyped

    MIN_GAP: 2

    NoSpaceLeft: untyped

    InvalidPosition: untyped

    IllegalRange: untyped

    IssuePositioningDisabled: untyped

    def self.range: (untyped lhs, untyped rhs) -> (untyped | untyped | untyped | untyped | nil)
  end
end
