module Gitlab
  module QuickActions
    class TimelineTextAndDateTimeSeparator
      @timeline_event_arg: untyped

      @timeline_text: untyped

      @timeline_date_string: untyped

      DATETIME_REGEX: ::Regexp

      MIXED_DELIMITER: ::Regexp

      TIME_REGEX: ::Regexp

      def initialize: (untyped timeline_event_arg) -> void

      def execute: () -> (nil | ::Array[untyped])

      private

      def get_text: () -> untyped

      def get_raw_date_string: () -> untyped

      def get_current_date_time: () -> untyped

      def get_actual_date_time: () -> untyped

      def date_time_present?: () -> untyped

      def date_contains_mixed_delimiters?: () -> untyped

      def valid_date?: () -> untyped
    end
  end
end
