module Gitlab
  module QuickActions
    # This class takes an array of commands that should be extracted from a
    # given text.
    #
    # ```
    # extractor = Gitlab::QuickActions::Extractor.new([:open, :assign, :labels])
    # ```
    class Extractor
      @command_definitions: untyped

      @commands_regex: untyped

      @keep_actions: untyped

      @substition_definitions: untyped

      INLINE_CODE_REGEX: ::Regexp

      HTML_BLOCK_REGEX: ::Regexp

      EXCLUSION_REGEX: ::Regexp

      attr_reader command_definitions: untyped

      attr_reader keep_actions: untyped

      def initialize: (untyped command_definitions, ?keep_actions: bool) -> void

      # Extracts commands from content and return an array of commands.
      # The array looks like the following:
      # [
      #   ['command1'],
      #   ['command3', 'arg1 arg2'],
      # ]
      # The original command text and arguments are removed from the given `content`,
      # unless `keep_actions` is true.
      #
      # Usage:
      # ```
      # extractor = Gitlab::QuickActions::Extractor.new([:open, :assign, :labels])
      # msg = %(hello\n/labels ~foo ~"bar baz"\nworld)
      # commands = extractor.extract_commands(msg) #=> [['labels', '~foo ~"bar baz"']]
      # msg #=> "hello\nworld"
      #
      # extractor = Gitlab::QuickActions::Extractor.new([:open, :assign, :labels], keep_actions: true)
      # msg = %(hello\n/labels ~foo ~"bar baz"\nworld)
      # commands = extractor.extract_commands(msg) #=> [['labels', '~foo ~"bar baz"']]
      # msg #=> "hello\n/labels ~foo ~"bar baz"\n\nworld"
      # ```
      def extract_commands: (untyped content, ?only: untyped?) -> (::Array[untyped | ::Array[untyped]] | untyped)

      # Encloses quick action commands into code span markdown
      # avoiding them being executed, for example, when sent via email
      # to GitLab service desk.
      # Example: /label ~label1 becomes `/label ~label1`
      def redact_commands: (untyped content) -> ("" | untyped)

      private

      def perform_regex: (untyped content, ?only: untyped?, ?redact: bool) -> ::Array[untyped]

      def process_commands: (untyped matched_text, untyped redact) -> ::Array[untyped]

      def process_substitutions: (untyped matched_text) -> ::Array[untyped]

      # Builds a regular expression to match known commands.
      # First match group captures the command name and
      # second match group captures its arguments.
      #
      # It looks something like:
      #
      #   /^\/(?<cmd>close|reopen|...)(?:( |$))(?<arg>[^\/\n]*)(?:\n|$)/
      def commands_regex: (names: untyped, sub_names: untyped) -> untyped

      def command_names: (limit_to_commands: untyped) -> untyped

      def substitution_names: () -> untyped

      def substitution_definitions: () -> untyped
    end
  end
end
