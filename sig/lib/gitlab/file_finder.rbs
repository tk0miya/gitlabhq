# This class finds files in a repository by name and content
# the result is joined and sorted by file name
module Gitlab
  class FileFinder
    @project: untyped

    @ref: untyped

    attr_reader project: untyped

    attr_reader ref: untyped

    def initialize: (untyped project, untyped ref) -> void

    def find: (untyped query, ?content_match_cutoff: untyped?) -> untyped

    private

    def find_by_content: (untyped query, untyped options) -> untyped

    def find_by_path: (untyped query) -> untyped

    # Overridden in Gitlab::WikiFileFinder
    def search_paths: (untyped query) -> (::Array[untyped] | untyped)
  end
end
