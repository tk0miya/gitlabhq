module Gitlab
  module Auth
    module Saml
      class Config
        @provider: untyped

        DEFAULT_NICKNAME_ATTRS: ::Array["username" | "nickname" | "urn:oid:0.9.2342.19200300.100.1.1"]

        DEFAULT_NAME_ATTRS: ::Array["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name" | "http://schemas.microsoft.com/ws/2008/06/identity/claims/name" | "urn:oid:2.16.840.1.113730.3.1.241" | "urn:oid:2.5.4.3"]

        DEFAULT_EMAIL_ATTRS: ::Array["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress" | "http://schemas.microsoft.com/ws/2008/06/identity/claims/emailaddress" | "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/email" | "http://schemas.microsoft.com/ws/2008/06/identity/claims/email" | "urn:oid:0.9.2342.19200300.100.1.3"]

        DEFAULT_FIRST_NAME_ATTRS: ::Array["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname" | "http://schemas.microsoft.com/ws/2008/06/identity/claims/givenname" | "urn:oid:2.5.4.42"]

        DEFAULT_LAST_NAME_ATTRS: ::Array["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname" | "http://schemas.microsoft.com/ws/2008/06/identity/claims/surname" | "urn:oid:2.5.4.4"]

        def self.enabled?: () -> untyped

        def self.default_attribute_statements: () -> untyped

        DEFAULT_PROVIDER_NAME: "saml"

        def initialize: (?untyped provider) -> void

        def options: () -> untyped

        def upstream_two_factor_authn_contexts: () -> untyped

        def groups: () -> untyped

        def external_groups: () -> untyped

        def admin_groups: () -> untyped
      end
    end
  end
end
