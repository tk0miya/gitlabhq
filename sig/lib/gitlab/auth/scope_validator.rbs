# Wrapper around a RequestAuthenticator to
# perform authorization of scopes. Access is limited to
# only those methods needed to validate that an API user
# has at least one permitted scope.
module Gitlab
  module Auth
    class ScopeValidator
      @api_user: untyped

      @request_authenticator: untyped

      attr_reader request_authenticator: untyped

      def initialize: (untyped api_user, untyped request_authenticator) -> void

      def valid_for?: (untyped permitted) -> (true | untyped)
    end
  end
end
