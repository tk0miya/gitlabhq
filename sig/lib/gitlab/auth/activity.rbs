module Gitlab
  module Auth
    #
    # Metrics and logging for user authentication activity.
    #
    class Activity
      @opts: untyped

      extend Gitlab::Utils::StrongMemoize

      COUNTERS: { user_authenticated: "Counter of successful authentication events", user_unauthenticated: "Counter of authentication failures", user_not_found: "Counter of failed log-ins when user is unknown", user_password_invalid: "Counter of failed log-ins with invalid password", user_session_override: "Counter of manual log-ins and sessions overrides", user_session_destroyed: "Counter of user sessions being destroyed", user_two_factor_authenticated: "Counter of two factor authentications", user_sessionless_authentication: "Counter of sessionless authentications", user_blocked: "Counter of sign in attempts when user is blocked", user_csrf_token_invalid: "Counter of CSRF token validation failures" }

      def initialize: (untyped opts) -> void

      def user_authentication_failed!: () -> untyped

      def user_authenticated!: () -> untyped

      def user_session_override!: () -> untyped

      def user_blocked!: () -> untyped

      def user_session_destroyed!: () -> untyped

      def user_csrf_token_mismatch!: () -> untyped

      def self.each_counter: () { (untyped, untyped, untyped) -> untyped } -> untyped
    end
  end
end
