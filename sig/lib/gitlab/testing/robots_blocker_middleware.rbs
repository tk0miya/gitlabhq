# rubocop:disable Style/ClassVars
module Gitlab
  module Testing
    class RobotsBlockerMiddleware
      @@block_requests: untyped

      @app: untyped

      # Block requests according to robots.txt.
      # Any new requests disallowed by robots.txt will return an HTTP 503 status.
      def self.block_requests!: () -> untyped

      # Allows the server to accept requests again.
      def self.allow_requests!: () -> untyped

      def initialize: (untyped app) -> void

      def call: (untyped env) -> untyped

      private

      def block_requests?: () -> untyped

      def block_request: (untyped env) -> ::Array[503 | ::Hash[untyped, untyped] | ::Array[untyped]]
    end
  end
end
