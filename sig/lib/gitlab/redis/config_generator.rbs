module Gitlab
  module Redis
    class ConfigGenerator
      @component: untyped

      CommandExecutionError: untyped

      InvalidPathError: untyped

      attr_reader component: untyped

      def self.parse_client_tls_options: (untyped config) -> untyped

      def initialize: (?::String component) -> void

