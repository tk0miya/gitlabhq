module Gitlab
  module BitbucketImport
    class ProjectCreator
      @repo: untyped

      @name: untyped

      @namespace: untyped

      @current_user: untyped

      @credentials: untyped

      attr_reader repo: untyped

      attr_reader name: untyped

      attr_reader namespace: untyped

      attr_reader current_user: untyped

      attr_reader credentials: untyped

      def initialize: (untyped repo, untyped name, untyped namespace, untyped current_user, untyped credentials) -> void

      def execute: () -> (nil | untyped)

      private

      def skip_wiki: () -> untyped

      def clone_url: () -> untyped
    end
  end
end
