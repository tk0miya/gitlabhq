module Gitlab
  module BitbucketImport
    module Importers
      class LfsObjectImporter
        @project: untyped

        @lfs_download_object: untyped

        include Loggable

        include ErrorTracking

        def initialize: (untyped project, untyped lfs_attributes) -> void

        def execute: () -> untyped

        private

        attr_reader lfs_download_object: untyped

        attr_reader project: untyped
      end
    end
  end
end
