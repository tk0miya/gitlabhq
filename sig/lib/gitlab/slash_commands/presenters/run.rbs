module Gitlab
  module SlashCommands
    module Presenters
      class Run < Presenters::Base
        # rubocop: disable CodeReuse/ActiveRecord
        def present: (untyped pipeline) -> untyped

        def unsupported_chat_service: () -> untyped

        def failed_to_schedule: (untyped command) -> untyped
      end
    end
  end
end
