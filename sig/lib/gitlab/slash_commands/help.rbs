module Gitlab
  module SlashCommands
    class Help < BaseCommand
      # This class has to be used last, as it always matches. It has to match
      # because other commands were not triggered and we want to show the help
      # command
      def self.match: (untyped _text) -> true

      def self.help_message: () -> "help"

      def self.allowed?: (untyped _project, untyped _user) -> true

      def execute: (untyped commands, untyped text) -> untyped

      def trigger: () -> untyped
    end
  end
end
