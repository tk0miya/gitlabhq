module Gitlab
  module SlashCommands
    class IssueComment < IssueCommand
      def self.match: (untyped text) -> untyped

      def self.help_message: () -> ::String

      def execute: (untyped match) -> untyped

      private

      def can_create_note?: (untyped issue) -> untyped

      def not_found: () -> untyped

      def access_denied: () -> untyped

      def create_note: (issue: untyped, note: untyped) -> untyped

      def presenter: (untyped note) -> untyped
    end
  end
end
