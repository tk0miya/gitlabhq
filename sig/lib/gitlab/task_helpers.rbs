# rubocop:disable Rails/Output
module Gitlab
  TaskFailedError: untyped

  TaskAbortedByUserError: untyped

  module TaskHelpers
    include Gitlab::Utils::StrongMemoize

    extend ::Gitlab::TaskHelpers

    # Write a line to stdout for rake task output
    def say: (?::String message) -> untyped

    def invoke_and_time_task: (untyped task) -> untyped

    # Ask if the user wants to continue
    #
    # Returns "yes" the user chose to continue
    # Raises Gitlab::TaskAbortedByUserError if the user chose *not* to continue
    def ask_to_continue: () -> (nil | untyped)

    # Check which OS is running
    #
    # It will primarily use lsb_relase to determine the OS.
    # It has fallbacks to Debian, SuSE, OS X and systems running systemd.
    def os_name: () -> untyped

    # Prompt the user to input something
    #
    # message - the message to display before input
    # choices - array of strings of acceptable answers or nil for any answer
    #
    # Returns the user's answer
    def prompt: (untyped message, ?untyped? choices) -> untyped

    # Prompt the user to input a password
    #
    # message - custom message to display before input
    def prompt_for_password: (?::String message) -> untyped

    # Runs the given command and matches the output against the given pattern
    #
    # Returns nil if nothing matched
    # Returns the MatchData if the pattern matched
    #
    # see also #run_command
    # see also String#match
    def run_and_match: (untyped command, untyped regexp) -> untyped

    # Runs the given command
    #
    # Returns '' if the command was not found
    # Returns the output of the command otherwise
    #
    # see also #run_and_match
    def run_command: (untyped command) -> untyped

    # Runs the given command and raises a Gitlab::TaskFailedError exception if
    # the command does not exit with 0
    #
    # Returns the output of the command otherwise
    def run_command!: (untyped command) -> untyped

    def uid_for: (untyped user_name) -> untyped

    def gid_for: (untyped group_name) -> untyped

    def gitlab_user: () -> untyped

    def gitlab_user?: () -> untyped

    def warn_user_is_not_gitlab: () -> (nil | untyped)

    def user_home: () -> untyped

    def download_package_file_version: (version: untyped, repo: untyped, package_name: untyped, package_file: untyped, package_checksums_sha256: untyped, target_path: untyped) -> untyped

    def checkout_or_clone_version: (version: untyped, repo: untyped, target_dir: untyped, ?clone_opts: untyped, ?checkout_opts: untyped) -> untyped

    # this function implements the same logic we have in omnibus for dealing with components version
    def get_version: (untyped component_version) -> (untyped | ::String)

    def clone_repo: (untyped repo, untyped target_dir, ?clone_opts: untyped) -> untyped

    def checkout_version: (untyped version, untyped target_dir, ?checkout_opts: untyped) -> untyped

    def get_partition_info: (untyped partition_name, untyped connection) -> (nil | untyped)
  end
end
