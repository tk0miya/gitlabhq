module Gitlab
  module ImportExport
    class Importer
      @archive_file: untyped

      @current_user: untyped

      @project: untyped

      @shared: untyped

      @project_tree: untyped

      include Gitlab::Allowable

      include Gitlab::Utils::StrongMemoize

      def self.imports_repository?: () -> true

      def initialize: (untyped project) -> void

      def execute: () -> untyped

      private

      attr_accessor archive_file: untyped

      attr_accessor current_user: untyped

      attr_accessor project: untyped

      attr_accessor shared: untyped

      def restorers: () -> untyped

      # Extension point for EE to add restorers that must run immediately after repo_restorer.
      def post_repo_restorers: () -> ::Array[untyped]

      # Extension point for EE to add restorers that must run at the end.
      def final_restorers: () -> ::Array[untyped]

      def preallocate_iids: () -> true

      def import_file: () -> untyped

      def check_version!: () -> untyped

      def project_tree: () -> untyped

      def project_tree_class: () -> untyped

      def sample_data_template?: () -> untyped

      def avatar_restorer: () -> untyped

      def repo_restorer: () -> untyped

      def wiki_restorer: () -> untyped

      def design_repo_restorer: () -> untyped

      def uploads_restorer: () -> untyped

      def lfs_restorer: () -> untyped

      def snippets_repo_restorer: () -> untyped

      def statistics_restorer: () -> untyped

      def path_with_namespace: () -> untyped

      def repo_path: () -> untyped

      def wiki_repo_path: () -> untyped

      def design_repo_path: () -> untyped

      def remove_import_file: () -> (nil | untyped)

      def overwrite_project: () -> (true | false)

      def original_path: () -> untyped

      def overwrite_project?: () -> untyped

      def project_to_overwrite: () -> untyped

      def remove_base_tmp_dir: () -> untyped

      def remove_non_migrated_snippets: () -> untyped
    end
  end
end
