module Gitlab
  module ImportExport
    class FileImporter
      @importable: untyped

      @archive_file: untyped

      @shared: untyped

      @user: untyped

      @tmpdir: untyped

      @tmpdir_valid: untyped

      @size_validator: untyped

      include Gitlab::ImportExport::CommandLineUtil

      ImporterError: untyped

      MAX_RETRIES: 8

      def self.import: (*untyped args, **untyped kwargs) -> untyped

      def initialize: (importable: untyped, archive_file: untyped, shared: untyped, user: untyped, ?tmpdir: untyped?) -> void

      def import: () -> untyped

      private

      def prepare_extraction_dir: () -> untyped

      # Exponentially sleep until I/O finishes copying the file
      def wait_for_archived_file: () { () -> untyped } -> untyped

      def decompress_archive: () -> untyped

      def copy_archive: () -> (nil | untyped)

      def source_directory: () -> untyped

      def target_directory: () -> untyped

      def remote_download_or_download_or_copy_upload: () -> untyped

      def file_size_limit: () -> untyped

      def remove_import_file: () -> (untyped | nil)

      def validate_decompressed_archive_size: () -> (untyped | nil)

      def size_validator: () -> untyped

      def validate_tmpdir!: () -> true

      attr_reader tmpdir_valid: untyped

      def should_clean_extraction_dir?: () -> (true | untyped)
    end
  end
end
