module Gitlab
  module ImportExport
    class StatisticsRestorer
      @project: untyped

      @shared: untyped

      include ::Import::Framework::ProgressTracking

      attr_reader project: untyped

      def initialize: (project: untyped, shared: untyped) -> void

      def restore: () -> untyped

