module API
  module Ci
    module Helpers
      module Runner
        @job_token: untyped

        include Gitlab::Utils::StrongMemoize

        JOB_TOKEN_HEADER: "HTTP_JOB_TOKEN"

        JOB_TOKEN_PARAM: :token

        LEGACY_SYSTEM_XID: "<legacy>"

        RUNNER_TOKEN_HEADER: "Runner-Token"

        def authenticate_runner!: (?ensure_runner_manager: bool, ?creation_state: untyped?) -> (nil | untyped)

        def authenticate_runner_from_header!: () -> untyped

        def get_runner_details_from_request: () -> untyped

        def get_system_id_from_request: () -> ({ system_id: untyped } | ::Hash[untyped, untyped])

        def get_runner_ip: () -> { ip_address: untyped }

        def current_runner: () -> untyped

        def current_runner_from_header: () -> untyped

        def current_runner_manager: () -> untyped

        def track_runner_authentication: () -> untyped

        # HTTP status codes to terminate the job on GitLab Runner:
        # - 403
        def authenticate_job!: (?heartbeat_runner: bool, ?fail_on_expired_token: bool) -> untyped

        def authenticate_job_via_dependent_job!: () -> untyped

        # current_job is queried by URL :id param with no authentication
        def current_job: () -> untyped

        # The token used by runner to authenticate a request.
        # In most cases, the runner uses the token belonging to the requested job.
        # However, when requesting for job artifacts, the runner would use
        # the token that belongs to downstream jobs that depend on the job that owns
        # the artifacts.
        def job_token: () -> untyped

        def job_from_token: () -> (nil | untyped)

        def job_forbidden!: (untyped job, untyped reason) -> untyped

        def set_application_context: () -> untyped

        def track_ci_minutes_usage!: (untyped _build) -> nil

        def audit_download: (untyped build, untyped filename) -> nil

        def check_if_backoff_required!: () -> (nil | untyped)

        def job_router_enabled?: (untyped runner) -> untyped

        private

        # rubocop:disable Gitlab/AvoidCurrentOrganization -- Runner API does not go
        # through standard set_current_organization
        def set_current_organization_from_runner: (untyped runner) -> (nil | untyped)

        def processing_on_runner?: (untyped job) -> untyped

        def get_runner_config_from_request: () -> { config: untyped }

        def get_runner_features_from_request: () -> untyped

        def metrics: () -> untyped

        def log_job_auth_failure: (untyped job, untyped reason) -> untyped
      end
    end
  end
end
