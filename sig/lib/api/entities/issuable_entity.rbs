module API
  module Entities
    class IssuableEntity < Grape::Entity
      def presented: () -> untyped

      def issuable_metadata: () -> untyped

      # This method will preload the `issuable_metadata` for the current
      # entity according to the current top-level entity options, such
      # as the current_user.
      def lazy_issuable_metadata: () -> untyped

      private

      def current_user: () -> untyped
    end
  end
end
