module API
  module Mcp
    class Base < ::API::Base
      include ::API::Helpers::HeadersHelpers

      include APIGuard

      include ::Mcp::Tools::VersionHelper

      # JSON-RPC Specification
      # See: https://www.jsonrpc.org/specification
      JSONRPC_VERSION: "2.0"

      # JSON-RPC Error Codes
      # See: https://www.jsonrpc.org/specification#error_object
      JSONRPC_ERRORS: { invalid_request: { code: -32600, message: "Invalid Request" }, method_not_found: { code: -32601, message: "Method not found" }, invalid_params: { code: -32602, message: "Invalid params" }, version_mismatch: { code: -32001, message: "Version not supported" } }

      # JSON-RPC Supported Requests
      # See: https://modelcontextprotocol.io/specification/2025-06-18/schema#common-types
      JSONRPC_METHOD_HANDLERS: { "initialize" => untyped, "notifications/initialized" => untyped }
    end
  end
end
