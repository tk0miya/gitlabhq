      def self.chat_notification_channels: () -> ::Array[{ required: false, name: :push_channel, type: untyped, desc: "The name of the channel to receive push_events notifications" } | { required: false, name: :issue_channel, type: untyped, desc: "The name of the channel to receive issues_events notifications" } | { required: false, name: :incident_channel, type: untyped, desc: "The name of the channel to receive incident_events notifications" } | { required: false, name: :alert_channel, type: untyped, desc: "The name of the channel to receive alert_events notifications" } | { required: false, name: :confidential_issue_channel, type: untyped, desc: "The name of the channel to receive confidential_issues_events notifications" } | { required: false, name: :merge_request_channel, type: untyped, desc: "The name of the channel to receive merge_requests_events notifications" } | { required: false, name: :note_channel, type: untyped, desc: "The name of the channel to receive note_events notifications" } | { required: false, name: :confidential_note_channel, type: untyped, desc: "The name of the channel to receive confidential_note_events notifications" } | { required: false, name: :tag_push_channel, type: untyped, desc: "The name of the channel to receive tag_push_events notifications" } | { required: false, name: :deployment_channel, type: untyped, desc: "The name of the channel to receive deployment_events notifications" } | { required: false, name: :pipeline_channel, type: untyped, desc: "The name of the channel to receive pipeline_events notifications" } | { required: false, name: :wiki_page_channel, type: untyped, desc: "The name of the channel to receive wiki_page_events notifications" }]

