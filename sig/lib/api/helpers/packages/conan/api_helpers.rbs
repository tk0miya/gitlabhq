module API
  module Helpers
    module Packages
      module Conan
        module ApiHelpers
          @current_authenticated_job: untyped

          include Gitlab::Utils::StrongMemoize

          def check_username_channel: () -> untyped

          def present_download_urls: (untyped entity) { (untyped) -> untyped } -> untyped

          def present_package_download_urls: () -> untyped

          def present_recipe_download_urls: () -> untyped

          def recipe_upload_urls: () -> { upload_urls: untyped }

          def package_upload_urls: () -> { upload_urls: untyped }

          def recipe_file?: (untyped file_name) -> untyped

          def package_file?: (untyped file_name) -> untyped

          def build_package_file_upload_url: (untyped file_name) -> untyped

          def build_recipe_file_upload_url: (untyped file_name) -> untyped

          def url_options: (untyped file_name) -> { package_name: untyped, package_version: untyped, package_username: untyped, package_channel: untyped, file_name: untyped, recipe_revision: untyped }

          def package_file_url: (untyped options) -> untyped

          def recipe_file_url: (untyped options) -> untyped

          def recipe: () -> untyped

          def project: () -> untyped

          def package: () -> untyped

          def token: () -> untyped

          def download_package_file: (untyped file_type) -> untyped

          def find_or_create_package: () -> untyped

          def track_push_package_event: () -> (untyped | nil)

          def file_names: () -> untyped

          def create_package_file_with_type: (untyped file_type, untyped current_package) -> untyped

          def verify_checksum_deploy_header!: () -> (untyped | nil)

          def upload_package_file: (untyped file_type) -> untyped

          private

          # We override this method from auth_finders because we need to
          # extract the token from the Conan JWT which is specific to the Conan API
          def find_personal_access_token: () -> untyped

          def access_token_from_request: () -> untyped

          def find_password_from_basic_auth: () -> (nil | untyped)

          def find_user_from_job_token: () -> (nil | untyped)

          def deploy_token_from_request: () -> untyped

          def find_job_from_token: () -> untyped

          # We need to override this one because it
          # looks into Bearer authorization header
          def find_oauth_access_token: () -> nil

          def find_personal_access_token_from_conan_jwt: () -> (nil | untyped)

          def find_deploy_token_from_conan_jwt: () -> (nil | untyped)

          def find_job_from_conan_jwt: () -> (nil | untyped)

          def decode_oauth_token_from_jwt: () -> (nil | untyped)

          def package_scope: () -> (:project | :instance)

          def search_project: () -> untyped

          def package_file_finder: (untyped file_type, ?untyped target_package) -> untyped
        end
      end
    end
  end
end
