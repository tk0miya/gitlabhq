module API
  module Helpers
    module AwardEmoji
      @awardable: untyped

      def self.awardables: () -> ::Array[{ type: "issue", resource: :projects, find_by: :iid, feature_category: :team_planning } | { type: "merge_request", resource: :projects, find_by: :iid, feature_category: :code_review_workflow } | { type: "snippet", resource: :projects, find_by: :id, feature_category: :source_code_management }]

      def self.awardable_id_desc: () -> "ID (`iid` for merge requests/issues, `id` for snippets) of an awardable."

      # rubocop: disable CodeReuse/ActiveRecord
      def awardable: () -> untyped
    end
  end
end
