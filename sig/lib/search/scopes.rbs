module Search
  # Central registry for search scopes across all search contexts
  # Provides a single source of truth for scope definitions, availability,
  # and validation logic
  class Scopes
    # API-only scopes for backward compatibility
    # These scopes are maintained for API backward compatibility but are being
    # phased out in favor of newer scopes (e.g., 'issues' -> 'work_items')
    API_ONLY_SCOPES: { issues: { availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic], project: ::Array[:advanced | :basic] } } }

    # Scope definitions with metadata
    # Format: { scope_key => { label:, sort:, availability: } }
    # availability maps context (:global, :group, :project) to supported search types
    # EE adds enhanced search types (zoekt, advanced) in ee/lib/ee/search/scopes.rb
    SCOPE_DEFINITIONS: { projects: { label: untyped, sort: 1, availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic] } }, blobs: { label: untyped, sort: 2, availability: { global: ::Array[:zoekt | :advanced], group: ::Array[:zoekt | :advanced], project: ::Array[:zoekt | :advanced | :basic] } }, work_items: { label: untyped, sort: 3, availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic], project: ::Array[:advanced | :basic] } }, merge_requests: { label: untyped, sort: 5, availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic], project: ::Array[:advanced | :basic] } }, wiki_blobs: { label: untyped, sort: 6, availability: { global: ::Array[:advanced], group: ::Array[:advanced], project: ::Array[:advanced | :basic] } }, commits: { label: untyped, sort: 7, availability: { global: ::Array[:advanced], group: ::Array[:advanced], project: ::Array[:advanced | :basic] } }, notes: { label: untyped, sort: 8, availability: { global: ::Array[:advanced], group: ::Array[:advanced], project: ::Array[:advanced | :basic] } }, milestones: { label: untyped, sort: 9, availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic], project: ::Array[:advanced | :basic] } }, users: { label: untyped, sort: 10, availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic], project: ::Array[:advanced | :basic] } }, snippet_titles: { label: untyped, sort: 11, availability: { global: ::Array[:advanced | :basic], group: ::Array[:advanced | :basic] } } }

    # Map of scopes to their required application setting for global search
    # EE settings are added in ee/lib/ee/search/scopes.rb
    GLOBAL_SEARCH_SETTING_MAP: { "issues" => :global_search_work_items_enabled?, "work_items" => :global_search_work_items_enabled?, "merge_requests" => :global_search_merge_requests_enabled?, "snippet_titles" => :global_search_snippet_titles_enabled?, "users" => :global_search_users_enabled? }

    # Get all scope names
    def self.all_scope_names: () -> untyped

    # Get scopes available for a specific context (global, group, project)
    # @param context [Symbol] :global, :group, or :project
    # @param container [Project, Group, nil] The container being searched (optional)
    # @param requested_search_type [String, Symbol] User's requested search type (optional)
    # @return [Array<String>] Array of scope names available for the context
    def self.available_for_context: (context: untyped, ?container: untyped?, ?requested_search_type: untyped?) -> untyped

    # Returns the scope definitions (can be overridden in EE)
    # @param include_api_only [Boolean] Whether to include API-only backward compatibility scopes
    # @return [Hash] Scope definitions hash
    def self.scope_definitions: (?include_api_only: bool) -> untyped

    private

    # Returns the global search setting map (can be overridden in EE)
    def self.global_search_setting_map: () -> untyped

    # Check if a scope definition is valid for the given context and search capabilities
    # @param scope [Symbol] Scope key (e.g., :issues, :epics)
    # @param definition [Hash] Scope definition
    # @param context [Symbol] :global, :group, or :project
    # @param container [Project, Group, nil] The container being searched
    # @param requested_search_type [String, Symbol] User's explicitly requested search type
    # @return [Boolean] True if the definition is valid
    def self.valid_definition?: (untyped scope, untyped definition, untyped context, untyped _container, ?untyped? _requested_search_type) -> (false | untyped)

    # Check if global search is disabled for a specific scope
    # @param scope [Symbol] Scope key to check
    # @return [Boolean] True if global search is disabled for this scope
    def self.global_search_disabled_for_scope?: (untyped scope) -> untyped

    # Normalize search type, returning nil for invalid values
    # This allows scope determination to work even with invalid search_type params
    # The actual validation of search_type happens later via search_type_errors
    # @param search_type [String, Symbol, nil] The search type to normalize
    # @return [Symbol, nil] Normalized search type or nil if invalid
    def self.normalize_search_type: (untyped search_type) -> (untyped | nil)
  end
end
