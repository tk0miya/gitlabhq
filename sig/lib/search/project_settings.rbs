module Search
  # Generates a list of all available setting sections of a project.
  # This list is used by the command palette's search functionality.
  class ProjectSettings
    @project: untyped

    attr_reader project: untyped

    def initialize: (untyped project) -> void

    def all: () -> untyped

    def general_settings: () -> untyped

    def repository_settings: () -> ::Array[{ text: untyped, href: untyped }]

    def merge_request_settings: () -> ::Array[{ text: untyped, href: untyped }]

    def ci_cd_settings: () -> ::Array[{ text: untyped, href: untyped }]

    def monitor_settings: () -> ::Array[{ text: untyped, href: untyped }]
  end
end
