module ReleaseHighlights
  class Validator
    self.@all_errors: untyped

    @file: untyped

    @errors: untyped

    attr_reader errors: untyped

    attr_reader file: untyped

    def initialize: (file: untyped) -> void

    def valid?: () -> untyped

    def self.validate_all!: () -> untyped

    def self.error_message: () -> untyped
  end
end
