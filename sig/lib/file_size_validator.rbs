class FileSizeValidator < ActiveModel::EachValidator
  MESSAGES: { is: :wrong_size, minimum: :size_too_small, maximum: :size_too_big }

  CHECKS: { is: :==, minimum: :>=, maximum: :<= }

  DEFAULT_TOKENIZER: untyped

  RESERVED_OPTIONS: ::Array[:minimum | :maximum | :within | :is | :tokenizer | :too_short | :too_long]

  def initialize: (untyped options) -> void

  def check_validity!: () -> untyped

  def validate_each: (untyped record, untyped attribute, untyped value) -> untyped

  def help: () -> untyped

  class Helper
    include Singleton

    include ActionView::Helpers::NumberHelper
  end
end
