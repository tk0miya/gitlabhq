module Security
  module CiConfiguration
    DEFAULT_TEST_STAGE: "test"

    class BaseBuildAction
      @auto_devops_enabled: untyped

      # Normalize keys to strings because Yaml.load! returns symbol keys,
      # but this class uses string keys to access and modify the config
      @existing_gitlab_ci_content: untyped

      @ci_config_path: untyped

      def initialize: (untyped auto_devops_enabled, untyped existing_gitlab_ci_content, ?untyped ci_config_path) -> void

      def generate: () -> { action: untyped, file_path: untyped, content: untyped, default_values_overwritten: untyped }

      private

      def generate_includes: () -> untyped

      def add_stages!: (untyped stages) -> untyped

      def auto_devops_stages: () -> untyped

      def prepare_existing_content: () -> untyped

      def remove_document_delimiter: (untyped content) -> untyped

      def comment: () -> "# You can override the included template(s) by including variable overrides\n# SAST customization: https://docs.gitlab.com/user/application_security/sast/#available-cicd-variables\n# Secret Detection customization: https://docs.gitlab.com/user/application_security/secret_detection/pipeline/configure/\n# Dependency Scanning customization: https://docs.gitlab.com/user/application_security/dependency_scanning/dependency_scanning_sbom/#customizing-analyzer-behavior\n# Container Scanning customization: https://docs.gitlab.com/user/application_security/container_scanning/#customizing-analyzer-behavior\n# Note that environment variables can be set in several places\n# See https://docs.gitlab.com/ci/variables/#cicd-variable-precedence\n"
    end
  end
end
