module Security
  module CiConfiguration
    class SecretDetectionBuildAction < BaseBuildAction
      @params: untyped

      @variables: untyped

      @default_values_overwritten: untyped

      def initialize: (untyped auto_devops_enabled, untyped params, untyped existing_gitlab_ci_content, ?untyped ci_config_path) -> void

      private

      def update_existing_content!: () -> untyped

      def set_stages: () -> untyped

      def auto_devops_stages: () -> untyped

      def set_variables: (untyped variables, ?::Hash[untyped, untyped] hash_to_update) -> untyped

      def set_secret_detection_block: () -> untyped

      def secret_detection_stage: () -> "secret-detection"

      def template: () -> ("Auto-DevOps.gitlab-ci.yml" | "Security/Secret-Detection.gitlab-ci.yml")

      def global_variables: () -> ::Array["SECRET_DETECTION_ENABLED" | "SECURE_ANALYZERS_PREFIX"]

      def secret_detection_variables: () -> ::Array["SECRET_DETECTION_HISTORIC_SCAN" | "SECRET_DETECTION_IMAGE_SUFFIX" | "SECRET_DETECTION_EXCLUDED_PATHS"]
    end
  end
end
