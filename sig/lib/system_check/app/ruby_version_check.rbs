module SystemCheck
  module App
    class RubyVersionCheck < SystemCheck::BaseCheck
      self.@required_version: untyped

      self.@current_version: untyped

      def self.required_version: () -> untyped

      def self.current_version: () -> untyped

      def check?: () -> untyped

      def show_error: () -> untyped
    end
  end
end
