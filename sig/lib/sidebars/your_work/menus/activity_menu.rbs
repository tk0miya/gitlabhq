module Sidebars
  module YourWork
    module Menus
      class ActivityMenu < ::Sidebars::Menu
        def link: () -> untyped

        def title: () -> untyped

        def sprite_icon: () -> "history"

        def render?: () -> untyped

        def active_routes: () -> { path: "dashboard#activity" }
      end
    end
  end
end
