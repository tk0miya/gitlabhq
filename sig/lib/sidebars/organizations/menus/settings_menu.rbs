module Sidebars
  module Organizations
    module Menus
      class SettingsMenu < ::Sidebars::Menu
        def title: () -> untyped

        def sprite_icon: () -> "settings"

        def pick_into_super_sidebar?: () -> true

        def render?: () -> untyped

        def configure_menu_items: () -> untyped
      end
    end
  end
end
