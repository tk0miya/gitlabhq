module Sidebars
  module UserSettings
    module Menus
      class ChatMenu < ::Sidebars::Menu
        include ::Sidebars::Concerns::RenderIfLoggedIn

        def link: () -> untyped

        def title: () -> untyped

        def sprite_icon: () -> "connected"

        def active_routes: () -> { controller: :chat_names }
      end
    end
  end
end
