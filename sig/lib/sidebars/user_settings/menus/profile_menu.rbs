module Sidebars
  module UserSettings
    module Menus
      class ProfileMenu < ::Sidebars::Menu
        include ::Sidebars::Concerns::RenderIfLoggedIn

        def link: () -> untyped

        def title: () -> untyped

        def sprite_icon: () -> "profile"

        def active_routes: () -> { path: "user_settings/profiles#show" }
      end
    end
  end
end
