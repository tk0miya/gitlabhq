module Sidebars
  module Projects
    module Menus
      class ScopeMenu < ::Sidebars::Menu
        def link: () -> untyped

        def title: () -> untyped

        def active_routes: () -> { path: "projects#show" }

        def extra_container_html_options: () -> { class: "shortcuts-project" }

        def render?: () -> true

        def serialize_as_menu_item_args: () -> untyped
      end
    end
  end
end
