module Sidebars
  module Projects
    module Menus
      class WikiMenu < ::Sidebars::Menu
        def link: () -> untyped

        def extra_container_html_options: () -> { class: "shortcuts-wiki" }

        def title: () -> untyped

        def sprite_icon: () -> "book"

        def render?: () -> untyped

        def active_routes: () -> { controller: :wikis }

        def serialize_as_menu_item_args: () -> untyped
      end
    end
  end
end
