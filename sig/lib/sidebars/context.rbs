# This class stores all the information needed to display and
# render the sidebar and menus.
# It usually stores information regarding the context and calculated
# values where the logic is in helpers.
module Sidebars
  class Context
    @current_user: untyped

    @container: untyped

    @is_super_sidebar: untyped

    @route_is_active: untyped

    attr_reader current_user: untyped

    attr_reader container: untyped

    attr_reader route_is_active: untyped

    attr_reader is_super_sidebar: untyped

    def initialize: (current_user: untyped, container: untyped, **untyped args) -> void
  end
end
