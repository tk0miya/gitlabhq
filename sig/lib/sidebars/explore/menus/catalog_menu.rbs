module Sidebars
  module Explore
    module Menus
      class CatalogMenu < ::Sidebars::Menu
        def link: () -> untyped

        def title: () -> untyped

        def sprite_icon: () -> "catalog-checkmark"

        def render?: () -> true

        def active_routes: () -> { controller: ::Array["explore/catalog"] }
      end
    end
  end
end
