module Sidebars
  module Explore
    module Menus
      class TopicsMenu < ::Sidebars::Menu
        def link: () -> untyped

        def title: () -> untyped

        def sprite_icon: () -> "labels"

        def render?: () -> true

        def active_routes: () -> { page: untyped, path: "projects#topic" }
      end
    end
  end
end
