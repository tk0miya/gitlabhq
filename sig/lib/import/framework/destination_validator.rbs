module Import
  module Framework
    # This class was extracted from BulkImport to serve as a generic utility.
    # It still relies on exception classes in the BulkImport namespace, which
    # we can make generic in a future change.
    class DestinationValidator
      @current_user: untyped

      def initialize: (current_user: untyped) -> void

      def validate!: (untyped destination_namespace, untyped destination_slug, untyped destination_name, untyped source_type) -> untyped

      def validate_destination_namespace!: (untyped destination_namespace, untyped source_type) -> (nil | untyped)

      def validate_destination_slug!: (untyped destination_slug) -> (nil | untyped)

      def validate_destination_full_path!: (untyped destination_namespace, untyped destination_slug, untyped destination_name, untyped source_type) -> (nil | untyped)

      private

      attr_reader current_user: untyped
    end
  end
end
