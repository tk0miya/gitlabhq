module Import
  module Clients
    class ObjectStorage
      @provider: untyped

      @bucket: untyped

      @credentials: untyped

      include Gitlab::Utils::StrongMemoize

      DownloadError: untyped

      UploadError: untyped

      ConnectionError: untyped

      LIST_OBJECT_KEYS_PAGE_SIZE: 1000

      MULTIPART_THRESHOLD: untyped

      PREFIX_SEPARATOR: "/"

      FOG_PROVIDER_MAP: untyped

      FOG_ERRORS: ::Array[untyped]

      def initialize: (provider: untyped, bucket: untyped, credentials: untyped) -> void

      def request_url: (untyped object_key) -> untyped

      def test_connection!: () -> untyped

      # Returns all object keys in the bucket matching the given prefix.
      #
      # Uses Fog's lazy pagination to fetch keys in batches of LIST_OBJECT_KEYS_PAGE_SIZE.
      # Only object metadata is retrieved; file contents are not downloaded.
      #
      # @param object_key_prefix [String] the prefix to filter object keys by
      # @return [Array<String>] list object keys with the provided prefix
      # @raise [ConnectionError] if the object storage bucket cannot be accessed
      def object_keys_for_prefix: (untyped object_key_prefix) -> untyped

      def store_file: (untyped object_key, untyped local_path) -> untyped

      def stream: (untyped object_key) { (?) -> untyped } -> untyped

      private

      attr_reader provider: untyped

      attr_reader credentials: untyped

      attr_reader bucket: untyped

      def validate_file_exists!: (untyped local_path) -> (nil | untyped)

      def storage: () -> untyped

      def check_for_path_traversal!: (untyped local_path) -> untyped

      def base_log_context: () -> { provider: untyped, bucket: untyped }

      def wrapped_object_storage_errors: (untyped error_class, untyped message, ?extra_log_context: ::Hash[untyped, untyped]) { () -> untyped } -> untyped
    end
  end
end
