module Gitlab
  module ClickHouse
    class MigrationGenerator < ActiveRecord::Generators::MigrationGenerator
      def db_migrate_path: () -> "db/click_house/migrate/main"

      # Override create_migration_file to ensure custom template is used
      def create_migration_file: () -> untyped

      private

      def template: () -> "migration.rb.template"
    end
  end
end
