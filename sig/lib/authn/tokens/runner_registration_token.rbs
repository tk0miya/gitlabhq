module Authn
  module Tokens
    class RunnerRegistrationToken
      @revocable: untyped

      @source: untyped

      def self.prefix?: (untyped plaintext) -> untyped

      attr_reader revocable: untyped

      attr_reader source: untyped

      def initialize: (untyped _plaintext, untyped source) -> void
    end
  end
end
