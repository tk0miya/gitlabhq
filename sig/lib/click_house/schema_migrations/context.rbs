module ClickHouse
  module SchemaMigrations
    class Context
      @connection: untyped

      @database: untyped

      @schema_directory: untyped

      attr_reader connection: untyped

      attr_reader database: untyped

      def initialize: (untyped connection, untyped database) -> void

      def schema_directory: () -> untyped

      def versions_to_create: () -> (::Array[untyped] | untyped)

      def current_schema_migration_files: () -> (::Array[untyped] | untyped)
    end
  end
end
