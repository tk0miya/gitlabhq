module BitbucketServer
  module Representation
    class Repo < Representation::Base
      def project_key: () -> untyped

      def project_name: () -> untyped

      def slug: () -> untyped

      def browse_url: () -> untyped

      def clone_url: () -> untyped

      def description: () -> untyped

      def full_name: () -> ::String

      def issues_enabled?: () -> true

      def name: () -> untyped

      def valid?: () -> untyped

      def visibility_level: () -> untyped

      def project: () -> untyped

      def to_s: () -> untyped
    end
  end
end
