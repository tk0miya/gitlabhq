module BitbucketServer
  class Connection
    @api_version: untyped

    @base_uri: untyped

    @username: untyped

    @token: untyped

    @auth: untyped

    @accept_headers: untyped

    @post_headers: untyped

    include ActionView::Helpers::SanitizeHelper

    include BitbucketServer::RetryWithDelay

    DEFAULT_API_VERSION: "1.0"

    SEPARATOR: "/"

    NETWORK_ERRORS: ::Array[untyped]

    attr_reader api_version: untyped

    attr_reader base_uri: untyped

    attr_reader username: untyped

    attr_reader token: untyped

    class ConnectionError < StandardError
      @http_status_code: untyped

      RETRYABLE_HTTP_STATUS_CODES: ::Array[408 | 429]

      attr_reader http_status_code: untyped

      def initialize: (?untyped? message, ?http_status_code: untyped?) -> void

      def retryable?: () -> (true | untyped)
    end

    def initialize: (?::Hash[untyped, untyped] options) -> void

    def get: (untyped path, ?::Hash[untyped, untyped] extra_query) -> untyped

    def post: (untyped path, untyped body) -> untyped

    # We need to support two different APIs for deletion:
    #
    # /rest/api/1.0/projects/{projectKey}/repos/{repositorySlug}/branches/default
    # /rest/branch-utils/1.0/projects/{projectKey}/repos/{repositorySlug}/branches
    def delete: (untyped resource, untyped path, untyped body) -> untyped

    private

    def check_errors!: (untyped response) -> untyped

    def auth: () -> untyped

    def accept_headers: () -> untyped

    def post_headers: () -> untyped

    def build_url: (untyped path) -> untyped

    def root_url: () -> untyped

    def delete_url: (untyped resource, untyped path) -> untyped

    def logger: () -> untyped
  end
end
