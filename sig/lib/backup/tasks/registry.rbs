module Backup
  module Tasks
    class Registry < Task
      @target: untyped

      def self.id: () -> "registry"

      def enabled: () -> untyped

      def human_name: () -> untyped

      def destination_path: () -> "registry.tar.gz"

      private

      def target: () -> untyped

      def storage_path: () -> untyped
    end
  end
end
