module Backup
  module Tasks
    class ExternalDiffs < Task
      @target: untyped

      def self.id: () -> "external_diffs"

      def human_name: () -> untyped

      def destination_path: () -> "external_diffs.tar.gz"

      private

      def target: () -> untyped

      def storage_path: () -> untyped
    end
  end
end
