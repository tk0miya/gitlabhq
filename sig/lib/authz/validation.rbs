module Authz
  class Validation
    PERMISSION_NAME_REGEX: ::Regexp

    COMMON_ACTIONS: { create: "Creates a new resource", read: "Views or retrieves a resource", update: "Modifies an existing resource", delete: "Removes a resource" }

    BOUNDARIES: ::Array["instance" | "group" | "project" | "user"]

    DISALLOWED_ACTIONS: { admin: "a granular action", change: "update", destroy: "delete", edit: "update", list: "read", manage: "a granular action", modify: "update", set: "update", view: "read", write: "a granular action" }
  end
end
