module Peek
  module Views
    class Zoekt < DetailedView
      self.@thresholds: untyped

      DEFAULT_THRESHOLDS: { calls: 3, duration: 500, individual_call: 500 }

      THRESHOLDS: { production: { calls: 5, duration: 1000, individual_call: 1000 } }

      def key: () -> "zkt"

      def self.thresholds: () -> untyped

      private

      def duration: () -> untyped

      def calls: () -> untyped

      def call_details: () -> untyped

      def format_call_details: (untyped call) -> untyped
    end
  end
end
