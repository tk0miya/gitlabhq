module ErrorTrackingOpenAPI
  class Error
    @status: untyped

    attr_accessor fingerprint: untyped

    attr_accessor project_id: untyped

    attr_accessor name: untyped

    attr_accessor description: untyped

    attr_accessor actor: untyped

    attr_accessor event_count: untyped

    attr_accessor approximated_user_count: untyped

    attr_accessor last_seen_at: untyped

    attr_accessor first_seen_at: untyped

    # Status of the error
    attr_accessor status: untyped

    attr_accessor stats: untyped

    class EnumAttributeValidator
      @allowable_values: untyped

      attr_reader datatype: untyped

      attr_reader allowable_values: untyped

      def initialize: (untyped datatype, untyped allowable_values) -> void

      def valid?: (untyped value) -> untyped
    end

    # Attribute mapping from ruby-style variable name to JSON key.
    def self.attribute_map: () -> { fingerprint: :fingerprint, project_id: :project_id, name: :name, description: :description, actor: :actor, event_count: :event_count, approximated_user_count: :approximated_user_count, last_seen_at: :last_seen_at, first_seen_at: :first_seen_at, status: :status, stats: :stats }

    # Returns all the JSON keys this model knows about
    def self.acceptable_attributes: () -> untyped

    # Attribute type mapping.
    def self.openapi_types: () -> { fingerprint: :Integer, project_id: :Integer, name: :String, description: :String, actor: :String, event_count: :Integer, approximated_user_count: :Integer, last_seen_at: :Time, first_seen_at: :Time, status: :String, stats: :ErrorStats }

    # List of attributes with nullable: true
    def self.openapi_nullable: () -> untyped

    # Initializes the object
    # @param [Hash] attributes Model attributes in the form of hash
    def initialize: (?::Hash[untyped, untyped] attributes) -> void

    # Show invalid properties with the reasons. Usually used together with valid?
    # @return Array for valid properties with the reasons
    def list_invalid_properties: () -> untyped

    # Check to see if the all the properties in the model are valid
    # @return true if the model is valid
    def valid?: () -> (false | true)

    # Custom attribute writer method checking allowed values (enum).
    # @param [Object] status Object to be assigned
    def status=: (untyped status) -> untyped

    # Checks equality by comparing each attribute.
    # @param [Object] Object to be compared
    def ==: (untyped o) -> (true | untyped)

    # @see the `==` method
    # @param [Object] Object to be compared
    def eql?: (untyped o) -> untyped

    # Calculates hash code according to all attributes.
    # @return [Integer] Hash code
    def hash: () -> untyped

    # Builds the object from hash
    # @param [Hash] attributes Model attributes in the form of hash
    # @return [Object] Returns the model itself
    def self.build_from_hash: (untyped attributes) -> untyped

    # Builds the object from hash
    # @param [Hash] attributes Model attributes in the form of hash
    # @return [Object] Returns the model itself
    def build_from_hash: (untyped attributes) -> (nil | self)

    # Deserializes the data based on type
    # @param string type Data type
    # @param string value Value to be deserialized
    # @return [Object] Deserialized data
    def _deserialize: (untyped type, untyped value) -> untyped

    # Returns the string representation of the object
    # @return [String] String presentation of the object
    def to_s: () -> untyped

    # to_body is an alias to to_hash (backward compatibility)
    # @return [Hash] Returns the object in the form of hash
    def to_body: () -> untyped

    # Returns the object in the form of hash
    # @return [Hash] Returns the object in the form of hash
    def to_hash: () -> untyped

    # Outputs non-array value in the form of hash
    # For object, use to_hash. Otherwise, just return the value
    # @param [Object] value Any valid value
    # @return [Hash] Returns the value in the form of hash
    def _to_hash: (untyped value) -> untyped
  end
end
