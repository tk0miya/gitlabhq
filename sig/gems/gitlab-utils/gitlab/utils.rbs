module Gitlab
  module Utils
    extend ::Gitlab::Utils

    DoubleEncodingError: untyped

    ConcurrentRubyThreadIsUsedError: untyped

    def allowlisted?: (untyped absolute_path, untyped allowlist) -> untyped

    def decode_path: (untyped encoded_path) -> untyped

    def force_utf8: (untyped str) -> untyped

    def ensure_utf8_size: (untyped str, bytes: untyped) -> untyped

    # Append path to host, making sure there's one single / in between
    def append_path: (untyped host, untyped path) -> ::String

    def remove_leading_slashes: (untyped str) -> untyped

    # A slugified version of the string, suitable for inclusion in URLs and
    # domain names. Rules:
    #
    #   * Lowercased
    #   * Anything not matching [a-z0-9-] is replaced with a -
    #   * Conditionally allows dots [a-z0-9-.]
    #   * Maximum length is 63 bytes
    #   * First/Last Character is not a hyphen or a dot
    def slugify: (untyped str, ?allow_dots: bool) -> untyped

    # Converts a class into the string representation of its name, following the ActiveModel naming convention
    # https://api.rubyonrails.org/classes/ActiveModel/Naming.html#method-c-param_key
    # param_key(Ci::SecureFile) returns "ci_secure_file"
    def param_key: (untyped klass) -> untyped

    # Converts newlines into HTML line break elements
    def nlbr: (untyped str) -> untyped

    def remove_line_breaks: (untyped str) -> untyped

    def to_boolean: (untyped value, ?default: untyped?) -> (untyped | true | false)

    def boolean_to_yes_no: (untyped bool) -> ("Yes" | "No")

    # Behaves like `which` on Linux machines: given PATH, try to resolve the given
    # executable name to an absolute path, or return nil.
    #
    #   which('ruby') #=> /usr/bin/ruby
    def which: (untyped filename) -> (untyped | nil)

    def try_megabytes_to_bytes: (untyped size) -> untyped

    def bytes_to_megabytes: (untyped bytes) -> untyped

    def ms_to_round_sec: (untyped ms) -> untyped

    # Used in EE
    # Accepts either an Array or a String and returns an array
    def ensure_array_from_string: (untyped string_or_array) -> untyped

    def deep_indifferent_access: (untyped data) -> untyped

    def deep_symbolized_access: (untyped data) -> untyped

    def string_to_ip_object: (untyped str) -> untyped

    # A safe alternative to String#downcase!
    #
    # This will make copies of frozen strings but downcase unfrozen
    # strings in place, reducing allocations.
    def safe_downcase!: (untyped str) -> untyped

    # Converts a string to an Addressable::URI object.
    # If the string is not a valid URI, it returns nil.
    # Param uri_string should be a String object.
    # This method returns an Addressable::URI object or nil.
    def parse_url: (untyped uri_string) -> untyped

    def add_url_parameters: (untyped url, untyped params) -> untyped

    def removes_sensitive_data_from_url: (untyped uri_string) -> (nil | untyped)

    # Invert a hash, collecting all keys that map to a given value in an array.
    #
    # Unlike `Hash#invert`, where the last encountered pair wins, and which has the
    # type `Hash[k, v] => Hash[v, k]`, `multiple_key_invert` does not lose any
    # information, has the type `Hash[k, v] => Hash[v, Array[k]]`, and the original
    # hash can always be reconstructed.
    #
    # example:
    #
    #   multiple_key_invert({ a: 1, b: 2, c: 1 })
    #   # => { 1 => [:a, :c], 2 => [:b] }
    #
    def multiple_key_invert: (untyped hash) -> untyped

    # This sort is stable (see https://en.wikipedia.org/wiki/Sorting_algorithm#Stability)
    # contrary to the bare Ruby sort_by method. Using just sort_by leads to
    # instability across different platforms (e.g., x86_64-linux and x86_64-darwin18)
    # which in turn leads to different sorting results for the equal elements across
    # these platforms.
    # This method uses a list item's original index position to break ties.
    def stable_sort_by: (untyped list) { (untyped) -> untyped } -> untyped

    # Check for valid brackets (`[` and `]`) in a string using this aspects:
    # * open brackets count == closed brackets count
    # * (optionally) reject nested brackets via `allow_nested: false`
    # * open / close brackets coherence, eg. ][[] -> invalid
    def valid_brackets?: (?::String string, ?allow_nested: bool) -> (true | false | untyped)

    # Use this method to set the `restrict_within_concurrent_ruby` to `true` for the block.
    # `raise_if_concurrent_ruby!` will use this flag to raise an error if it's set to `true`.
    def restrict_within_concurrent_ruby: () { () -> untyped } -> untyped

    # Use this method to disable the `restrict_within_concurrent_ruby` for the block.
    # It is mainly used to prevent infinite loop when `ConcurrentRubyThreadIsUsedError` is rescued and sent to Sentry.
    # More info: https://gitlab.com/gitlab-org/gitlab/-/issues/432145#note_1671305713
    def allow_within_concurrent_ruby: () { () -> untyped } -> untyped

    # Running external methods can allocate I/O bound resources (like PostgreSQL connection or Gitaly)
    # This is forbidden when running within a concurrent Ruby thread, for example `async` HTTP requests
    # provided by the `gitlab-http` gem.
    def raise_if_concurrent_ruby!: (untyped what) -> (nil | untyped)

    # Returns a valid Rails log_level, given a user input and an optional fallback
    #
    # `config.log_level=` does NOT accept integers, but Ruby Loggers do.
    #
    # @return [Symbol, nil]
    def to_rails_log_level: (untyped input, ?untyped? fallback) -> untyped

    # @param [Array, Hash] item - An Array or a Hash
    # @return [Array, Hash]
    #
    # Use this method to recursively sort any nested Hashes of a collection (an Array or Hash), with
    # the sort order based on the keys of the nested Hashes.
    #
    # - deeply nested Arrays are supported. For example: `[[[{b: 2, a: 1}]]]` will sort the nested Hash.
    # - The order of any nested Arrays is preserved. For example: `[1, {b: 2, a: 1}, 3]` will sort the
    #   nested Hash, but preserve the order of the Array.
    # - Any non-Array/non-Hash items are returned as-is without further recursion.
    def deep_sort_hashes: (untyped item) -> untyped

    alias deep_sort_hash deep_sort_hashes

    # Generate a random v7 UUID (Universally Unique IDentifier).
    # Ported from ruby 3.3.0's https://github.com/ruby/securerandom/commit/34ed1a2ec35dc8f00ff69665b373cef7484c937f
    # TODO remove when we support min ruby 3.3.0
    def uuid_v7: (?extra_timestamp_bits: ::Integer) -> untyped
  end
end
