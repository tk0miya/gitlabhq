module Gitlab
  module Utils
    module Email
      extend ::Gitlab::Utils::Email

      EMAIL_REGEXP: ::Regexp

      EMAIL_REGEXP_WITH_CAPTURING_GROUP: ::Regexp

      DEFAULT_EMAIL_VALIDATION_REGEXP: ::Regexp

      attr_writer self.email_validation_regexp: untyped

      def self.email_validation_regexp: () -> untyped

      # Replaces most visible characters with * to obfuscate an email address
      # deform adds a fix number of * to ensure the address cannot be guessed. Also obfuscates TLD with **
      def obfuscated_email: (untyped email, ?deform: bool) -> untyped

      # Runs email address obfuscation on the given text.
      def obfuscate_emails_in_text: (untyped text) -> untyped

      def normalize_email: (untyped email) -> untyped

      class Masker
        @original: untyped

        @local_part: untyped

        @at: untyped

        @sub_domain: untyped

        @dot: untyped

        @toplevel_domain: untyped

        attr_reader local_part: untyped

        attr_reader sub_domain: untyped

        attr_reader toplevel_domain: untyped

        attr_reader at: untyped

        attr_reader dot: untyped

        def initialize: (untyped original) -> void

        def masked: () -> untyped

        private

        def mask: (untyped plain, visible_length: untyped, ?star_length: untyped?) -> (nil | untyped | ::String)

        def enlarge_if_needed: (untyped string, untyped min) -> untyped
      end

      class Symmetrical < Masker
        def local_part: () -> untyped

        def sub_domain: () -> untyped
      end

      # Implements https://design.gitlab.com/patterns/obfuscation#email-addresses
      class Deform < Masker
        def local_part: () -> untyped

        def sub_domain: () -> untyped

        def toplevel_domain: () -> untyped
      end
    end
  end
end
