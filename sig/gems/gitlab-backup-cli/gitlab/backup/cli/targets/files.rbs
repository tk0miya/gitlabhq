module Gitlab
  module Backup
    module Cli
      module Targets
        class Files < Target
          @storage_path: untyped

          @excludes: untyped

          @storage_realpath: untyped

          DEFAULT_EXCLUDE: ::Array["lost+found"]

          attr_reader excludes: untyped

          # @param [String] storage_path
          # @param [Array] excludes
          def initialize: (untyped context, untyped storage_path, ?excludes: untyped) -> void

          def dump: (untyped destination) -> (nil | untyped)

          def restore: (untyped source) -> (nil | untyped)

          private

          def success?: (untyped result) -> (true | false)

          def noncritical_warning_matcher: () -> ::Regexp

          def ignore_non_success?: (untyped exitstatus, untyped output) -> (true | false)

          def storage_realpath: () -> untyped
        end
      end
    end
  end
end
