module Gitlab
  module Backup
    module Cli
      module Tasks
        class Artifacts < Task
          def self.id: () -> "artifacts"

          def human_name: () -> "Artifacts"

          def destination_path: () -> "artifacts.tar.gz"

          private

          def local: () -> untyped

          def storage_path: () -> untyped
        end
      end
    end
  end
end
