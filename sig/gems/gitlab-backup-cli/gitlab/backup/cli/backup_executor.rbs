module Gitlab
  module Backup
    module Cli
      # This is responsible for executing a Backup operation
      #
      # A Backup Executor handles the creation and deletion of
      # temporary environment necessary for a backup to happen
      #
      # It also allows for multiple backups to happen in parallel
      # without one overwriting data from another
      class BackupExecutor < BaseExecutor
        @context: untyped

        @metadata: untyped

        @workdir: untyped

        @archive_directory: untyped

        attr_reader context: untyped

        attr_reader metadata: untyped

        attr_reader workdir: untyped

        attr_reader archive_directory: untyped

        # @param [Gitlab::Backup::Cli::SourceContext, Context::OmnibusContext] context
        def initialize: (context: untyped, ?backup_bucket: untyped?, ?wait_for_completion: untyped?, ?registry_bucket: untyped?, ?service_account_file: untyped?) -> void

        def execute: () -> untyped

        # At the end of a successful backup, call this to release temporary resources
        def release!: () -> untyped

        private

        def initialize_database_connection!: () -> untyped

        def build_metadata: () -> untyped

        def execute_all_tasks: () -> untyped

        # Write the backup_information.json data to disk
        def write_metadata!: () -> (nil | untyped)

        def archive!: () -> untyped

        # @return [Pathname] temporary directory
        def create_temporary_workdir!: () -> untyped

        def measure_duration: () { () -> untyped } -> untyped

        def wait_for_task: (untyped task) -> (nil | untyped)
      end
    end
  end
end
