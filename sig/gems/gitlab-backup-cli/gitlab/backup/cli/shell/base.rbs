module Gitlab
  module Backup
    module Cli
      module Shell
        class Base
          private

          def typecast_input!: (untyped input) -> untyped

          # When providing an output to Open3.pipeline / spawn, we can't pass a Pathname.
          # It needs to be converted to a string, otherwise we get an error
          def typecast_output!: (untyped output) -> untyped
        end
      end
    end
  end
end
