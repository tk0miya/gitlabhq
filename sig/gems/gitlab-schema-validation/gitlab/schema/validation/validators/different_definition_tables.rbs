module Gitlab
  module Schema
    module Validation
      module Validators
        class DifferentDefinitionTables < Base
          ERROR_MESSAGE: "The table %s has a different column statement between structure.sql and database"

          def execute: () -> untyped

          private

          def column_diffs: (untyped db_table, untyped columns) -> ::Array[untyped]
        end
      end
    end
  end
end
