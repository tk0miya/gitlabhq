module Gitlab
  module Schema
    module Validation
      module Fixers
        def self.create_for: (untyped inconsistency) -> untyped

        class Base
          @table_name: untyped

          @structure_sql_statement: untyped

          attr_reader table_name: untyped

          def initialize: (untyped inconsistency) -> void

          def statement: () -> untyped

          private

          attr_reader structure_sql_statement: untyped
        end
      end
    end
  end
end
