module IpynbDiff
  # Creates a map from a symbol to the line number it appears in a Json file
  #
  # Example:
  #
  # Input:
  #
  # 1. {
  # 2.   'obj1': [
  # 3.     {
  # 4.       'obj2': 5
  # 5.     },
  # 6.     3,
  # 7.     {
  # 8.       'obj3': {
  # 9.         'obj4': 'b'
  # 10.      }
  # 11.    }
  # 12.  ]
  # 13.}
  #
  # Output:
  #
  # Symbol                Line Number
  # .obj1              -> 2
  # .obj1.0            -> 3
  # .obj1.0            -> 3
  # .obj1.0.obj2       -> 4
  # .obj1.1            -> 6
  # .obj1.2            -> 7
  # .obj1.2.obj3       -> 8
  # .obj1.2.obj3.obj4  -> 9
  #
  class SymbolMap
    self.@handler: untyped

    self.@parser: untyped

    @current_path: untyped

    @symbols: untyped

    @current_array_index: untyped

    def self.handler: () -> untyped

    def self.parser: () -> untyped

    def self.parse: (untyped notebook, *untyped args) -> untyped

    attr_accessor symbols: untyped

    def hash_start: (untyped key, untyped line, untyped column) -> untyped

    def hash_end: (untyped key, untyped line, untyped column) -> untyped

    def array_start: (untyped key, untyped line, untyped column) -> untyped

    def array_end: (untyped key, untyped line, untyped column) -> untyped

    def add_value: (untyped value, untyped key, untyped line, untyped column) -> untyped

    def add_symbol: (untyped symbol, untyped line) -> (untyped | nil)

    def key_or_index: (untyped key) -> (nil | untyped | untyped)

    def reset: () -> untyped
  end
end
