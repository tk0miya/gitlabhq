# Human Readable Jupyter Diffs
module IpynbDiff
  def self.diff: (untyped from, untyped to, ?raise_if_invalid_nb: bool, ?include_frontmatter: bool, ?hide_images: bool, ?diffy_opts: ::Hash[untyped, untyped]) -> untyped

  def self.transform: (untyped notebook, ?raise_errors: bool, ?include_frontmatter: bool, ?hide_images: bool) -> untyped
end
